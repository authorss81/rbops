insert='''
/// Joins one output reader if it finishes before `deadline`.
///
/// A reader that is still blocked when the deadline passes is detached, so a
/// process that inherited the pipe cannot turn a finished command into a hung
/// session. The empty result is marked truncated because output that was still
/// in the pipe was not read.
#[cfg(any(unix, windows))]
fn join_reader(
    handle: Option<thread::JoinHandle<(Vec<u8>, bool)>>,
    deadline: Instant,
) -> (Vec<u8>, bool) {
    let Some(handle) = handle else {
        return (Vec::new(), false);
    };
    while !handle.is_finished() {
        if Instant::now() >= deadline {
            return (Vec::new(), true);
        }
        thread::sleep(POLL_INTERVAL);
    }
    handle.join().unwrap_or_default()
}
'''
