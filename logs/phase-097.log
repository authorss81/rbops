        tree_walk(source),
        bytecode(source),
        "the two engines disagree about parsing or formatting a date"
    );

    let bad = "time.parse(\"2024-02-29T23:59:60Z\")";
    assert_eq!(
        tree_runtime_error(bad),
        bytecode_runtime_error(bad),
        "the two engines disagree about a parse refusal"
    );
}

