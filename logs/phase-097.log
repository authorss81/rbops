/// `<module>.<member>` is how a program reaches them.
pub const MODULE_MEMBERS: &[(&str, &[&str])] = &[
    ("bytes", &["from_text", "text", "write"]),
    ("console", &["log", "error", "clear"]),
    ("csv", &["parse"]),
