    /// Which engine this session runs source on.
    pub fn engine(&self) -> Engine {
        self.engine
    }

    /// The engine the most recent program actually ran on.
    ///
    /// A switch is session state, but a switch that silently failed to reach the
    /// run path would still look right in the prompt. This is the marker a test
    /// reads instead.
    pub fn last_engine(&self) -> Engine {
        self.last_engine
    }

    /// The name of the engine this session runs source on.
    pub fn engine_name(&self) -> &'static str {
        self.engine.label()
    }

    /// `.vm`: says which engine is in use, or switches to the one named.
    ///
    /// The choice is session state. The bindings cross with it — one direction
    /// by seeding the bytecode VM from the session, the other by adopting what
    /// that VM bound — so `.vm bytecode`, `set x to 9`, `.vm walker`, `say x`
    /// still answers 9 rather than starting again. History and the last result
    /// are engine-independent and are not touched by a switch.
    fn engine_command(&mut self, argument: Option<&str>) {
        match self.set_engine(argument) {
            Ok(()) => println!("Engine: {}", self.engine.label()),
            Err(message) => println!("{}", self.style.paint(Paint::Error, &message)),
        }
    }

    /// The state change behind `.vm`, split out so its refusals are testable.
    ///
    /// No argument is a question and changes nothing. A word that is not one of
    /// the two engines is refused with both valid words, because "Unknown
    /// command 'bytecod'" sends the user back to `:help` for a typo the command
    /// can name itself.
    fn set_engine(&mut self, argument: Option<&str>) -> Result<(), String> {
        let Some(word) = argument.map(str::trim).filter(|word| !word.is_empty()) else {
            return Ok(());
        };
        let Some(engine) = Engine::from_command_name(word) else {
            return Err(format!(
                "Error: .vm takes 'walker' or 'bytecode', not '{}'.",
                word
            ));
        };
        self.engine = engine;
        self.engine_named_in_prompt = true;
        Ok(())
    }

    /// Forgets everything the session has done: its bindings, its last result,
    /// and any block it is halfway through typing.
    ///
    /// The block is the half that is easy to leave out. `:reset` used to replace
    /// the VM and clear `variables` and nothing else, so `repeat 3 times` then
    /// `:reset` left the session in continuation mode with that line still
    /// buffered: the next line was appended to a block nobody was typing any
    /// more, so `say "hi"` waited for an `end` that was never coming and never
    /// ran. A session that has been reset is a session at a prompt, so the buffer
    /// goes with the bindings.
    ///
    /// The recorded definitions go with them, and that half was just as visible.
    /// They are a map from a name to the line that bound it, and a name a reset
    /// session no longer holds was still reported by `.which` as a session
    /// binding at `<session>:3` — a span pointing at a line of a session that had
    /// been thrown away, quoted at that. A reset forgets what it was; a `.which`
    /// that disagrees with it is worse than the stale binding it used to report,
    /// because it is a wrong answer rather than an absence.
    ///
    /// The history is left alone: it is the record of what was typed, and a reset
    /// is not a new session in the sense that the earlier lines were never typed.
    ///
    /// So is the tour, though, and that is the newer half of the same question. A
    /// step is taken by running its snippet and a snippet needs the bindings the
    /// step before it bound, so a session that has been reset mid-tour is a
    /// session holding a hint for a step of a program it no longer has: `set name
    /// to "World"`, `:reset`, and `:hint` answers as though `name` were about to
    /// be asked for. A reset forgets what it was, and where in the tour it was is
    /// part of what it was.
    fn reset_session(&mut self) {
        self.vm = Vm::new();
        self.engine = Engine::Walker;
        self.last_engine = Engine::Walker;
        self.engine_named_in_prompt = false;
        self.variables.clear();
        self.definitions.clear();
        self.last_file = None;
        self.cwd = Self::process_directory();
        self.multiline_buffer.clear();
        self.in_multiline = false;
        self.tutorial_step = None;
        self.tutorial_typed.clear();
        // A reset forgets the checkpoints and the undo history too: a checkpoint
        // of bindings the session no longer has would restore a state the reset
        // was asked to remove.
        self.checkpoints.clear();
        self.current_checkpoint = None;
        self.undo_stack.clear();
        self.redo_stack.clear();
        // The transcript with them: an export of a session that had forgotten the
        // lines it ran would claim a session that no longer exists ran them.
        self.transcript.clear();
        println!("REPL state reset.");
    }

    /// Captures the state every binding command can change, and the session
