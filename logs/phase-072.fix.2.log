/// after the line would otherwise disappear when the line was undone.
#[derive(Clone)]
struct UndoStep {
    snapshot: SessionSnapshot,
    full: bool,
}

/// One named in-memory checkpoint: the state it saved and how long the history
/// was when it was taken.
#[derive(Clone)]
struct Checkpoint {
    name: String,
    snapshot: SessionSnapshot,
    history_len: usize,
}

pub struct Repl {
    vm: Vm,
    /// The engine this session runs source on. Tree-walking by default, because
    /// that is the documented language semantics.
    engine: Engine,
    /// The engine the most recent program actually ran on, for callers that need
    /// proof of a switch rather than the prompt text that advertises one.
    last_engine: Engine,
    /// Whether a `.vm` has made the prompt name the engine.
    ///
    /// The default prompt is untouched for sessions that never switch: `>>> ` is
    /// the documented prompt and every existing script reads it. A session that
    /// has asked the question gets the answer in the prompt from then on.
    engine_named_in_prompt: bool,
    variables: HashMap<String, Value>,
    history: ReplHistory,
    completer: ReplCompleter,
    running: bool,
    multiline_buffer: Vec<String>,
    in_multiline: bool,
    /// The debugging session: its breakpoints, its pending step, and the frame
    /// the last program stopped in. Shared with the hook the VM calls, so a
    /// `:frame` typed after the program has run reads the frame that stop left.
    debug: SharedDebugSession,
    /// The debug sub-REPL, while one is open — see [`debug_repl`].
    ///
    /// `Some` from the `.debug` that opened it until the `.back` (or the end of
    /// input) that closed it. While it is, every typed line belongs to the
    /// sub-REPL: it is dispatched by [`Repl::debug_line`] and reaches neither
    /// this session's history, nor its transcript, nor its bindings.
    debug_repl: Option<debug_repl::DebugRepl>,
    /// How output is coloured. Detected once at startup, and `forced` in
    /// tests so a colour assertion can run without a TTY.
    style: Style,
    /// The format the primary prompt is rendered from, and what `:prompt` sets.
    ///
    /// Uncoloured text: the reader paints it, because a prompt carrying escape
    /// sequences into a line editor is the editor's problem to measure, not
    /// something to hand it raw.
    prompt_format: String,
    /// The file `.reload` re-runs, or `None` until a `:load` or `:run` names one.
    last_file: Option<LastFile>,
    /// Where this session resolves relative file arguments.
    ///
    /// Session state rather than process state: `.cd` moves the session, not
    /// the interpreter, so a relative path in `:load`, `:save`, `:run`,
    /// `:restore` or `.export` means the same thing at every prompt after it.
    cwd: PathBuf,
    /// Whether each entered source line is formatted before it runs.
    ///
    /// A session preference rather than session state: `:reset` forgets the
    /// bindings, and a user who turned formatting on did not ask to have it
    /// turned off by a reset.
    format_on_entry: bool,
    /// Where each name this session bound was written, for `.type` and `.which`.
    ///
    /// The VM knows *that* a name is bound and the session knows *where* it was
    /// typed, and neither knew the other's half: `:inspect x` printed the value
    /// and its kind and nothing about the line three prompts ago that made it.
    definitions: HashMap<String, Definition>,
    /// Every line this session ran and everything it said, which is what
    /// `.export` writes and what the terminal is not.
    ///
    /// The history is not this and cannot be: it holds every line *typed*,
    /// commands included, and holds no output at all. Sharing a session meant
    /// copy-pasting scrollback — prompts, colour and banner included — because
    /// this was the only record there was.
    transcript: Transcript,
    /// What the line just run said, before it is printed.
    ///
    /// Held between the VM printing it and the session recording it, because the
    /// VM prints `say` output itself ([`Vm::run`]) and the session needs the same
    /// lines as text. Cleared at the start of every line, so a line that failed to
    /// parse — and so never reached the VM — cannot inherit the last one's output.
    last_output: Vec<String>,
    /// Which step of [`TUTORIAL`] this session is on, or `None` when it is not
    /// in the tour at all.
    ///
    /// `Option` rather than an index that means "step one": `.hint` outside a
    /// tour has to say so, and an index cannot tell "on step one" from "not in
    /// the tour".
    tutorial_step: Option<usize>,
    /// What this session has run since it entered that step, so a step whose
    /// snippet is several programs can still be recognised as it is typed.
    ///
    /// `set name to "World"` and `say name` are each a whole program, and a
    /// session runs each as it is typed — so neither of them is step one of the
    /// tour, and the two of them together are.
    tutorial_typed: Vec<String>,
    /// The user's own command shortcuts: a name to the command text it stands
    /// for. Session state, not language state — the language has no word for
    /// either half, which is why they live here rather than in the VM.
    aliases: HashMap<String, String>,
    /// The named sequences this session has recorded, each a list of the lines
    /// between `.macro start <name>` and `.macro`.
    macros: HashMap<String, Vec<String>>,
    /// The macro being recorded, while one is: its name and the lines so far.
    ///
    /// `Option` rather than an empty list under a sentinel name because "not
    /// recording" is a state the stop command has to report, and a session whose
    /// recording was reset would otherwise stop a recording that is not there.
    macro_recording: Option<(String, Vec<String>)>,
    /// The named snapshots this session has taken, in creation order.
    ///
    /// A vector rather than a map because `.sessions` promises creation order,
    /// and a map's iteration order is not a result.
    checkpoints: Vec<Checkpoint>,
    /// Which checkpoint was most recently saved or restored, for `.sessions`.
    current_checkpoint: Option<String>,
    /// The states `.undo` can walk back to, oldest first.
    undo_stack: VecDeque<UndoStep>,
    /// The states `.redo` can walk forward to, oldest first.
    redo_stack: VecDeque<UndoStep>,
    /// The per-line timings the last multiline block left behind, if one has
    /// run. A single line has one figure and `.time` already answers that
    /// question; `.profile` is about the block.
    last_profile: Option<weight::BlockProfile>,
}

/// `path` as a session rooted at `dir` means it: a leading `~` expanded, an
/// absolute path unchanged, a relative one under `dir`.
///
/// Shared with the debug sub-REPL so `.debug <file>` reads exactly where
/// `:load` would, including the home-directory shorthand.
fn resolve_path_against(dir: &Path, path: &str) -> PathBuf {
    let path = Repl::expand_tilde_with_home(path, Repl::home_directory().as_deref());
    if path.is_absolute() {
        path
    } else {
        dir.join(path)
    }
}

/// Adds the shape label of every record and object reachable from `value` to
/// `shapes`, keyed by the rendered row so two equal shapes are one row.
///
/// Lists are walked because a record inside a list is still a shape the session
/// holds. The label names the field order the value carries, which is the order
/// `say` prints, so two records with the same fields in a different order are
/// two shapes rather than one.
fn collect_shape_labels(value: &Value, vm: &Vm, shapes: &mut BTreeMap<String, String>) {
    // An explicit worklist rather than recursion: a session can build a list
    // deeper than the call stack, and `.types` has to describe it rather than
    // overflow looking at it.
    let mut pending = vec![value];
    while let Some(value) = pending.pop() {
        match value {
            Value::Record(fields) => {
                let label = format!(
                    "record {{{}}}",
                    fields
                        .keys()
                        .map(String::as_str)
                        .collect::<Vec<_>>()
                        .join(", ")
                );
                shapes.entry(label.clone()).or_insert(label);
            }
            Value::Object(name, fields) => {
                let label = format!(
                    "object {} {{{}}}",
                    name,
                    fields
                        .keys()
                        .map(String::as_str)
                        .collect::<Vec<_>>()
                        .join(", ")
                );
                let methods = vm
                    .object_type_members(name)
                    .map(|(_, methods)| methods)
                    .unwrap_or_default();
                let rendered = if methods.is_empty() {
                    label.clone()
                } else {
                    format!("{} methods: {}", label, methods.join(", "))
                };
                shapes.entry(rendered.clone()).or_insert(rendered);
            }
            Value::List(items) => pending.extend(items.iter()),
            _ => {}
        }
    }
}

