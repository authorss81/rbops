            );

            let imports = repl.vm.imported_modules();
            assert!(
                imports.contains(&("M".to_string(), "MathUtils".to_string())),
                "the alias still names its module after the switch: {imports:?}"
            );
            let members = repl.vm.module_member_values("MathUtils");
            assert!(
