                (Opcode::Try, _) => depth += 1,
                (Opcode::Nop, END_TRY_MARKER) if depth == 0 => return Some(offset),
                (Opcode::Nop, END_TRY_MARKER) => depth -= 1,
                // A filler `NOP` closes nothing, so it is stepped over like any
                // other instruction.
                _ => {}
            }
        }
