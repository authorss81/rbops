                TokenKind::Minus => {
                    self.advance();
                    self.enter_nesting()?;
                    let expr = self.parse_unary()?;
                    self.leave_nesting(1);
                    return Ok(Expr::Unary {
                        op: UnaryOp::Neg,
                        expr: Box::new(expr),
                    });
                }
                _ => {}
