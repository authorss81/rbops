    fn parse_or(&mut self) -> Result<Expr> {
        let mut left = self.parse_and()?;
        let mut chained = 0usize;

        while let Some(Token {
            kind: TokenKind::Or,
            ..
        }) = self.current()
        {
            self.advance();
            let right = self.parse_and()?;
            chained += 1;
            self.enter_nesting()?;
            left = Expr::Binary {
                op: BinaryOp::Or,
                left: Box::new(left),
                right: Box::new(right),
            };
        }

        self.leave_nesting(chained);

        Ok(left)
    }

