new='''#[test]
fn unless_uses_the_same_condition_grammar_as_if_and_picks_opposite_branches() {
    // One program, one condition, read through both forms. `if` takes its body
    // when the condition holds; `unless` takes its body when it does not. Run
    // it once with the condition true and once false and the two forms must
    // swap: neither may ever take both bodies or neither.
    for (condition, if_branch, unless_branch) in
        [("yes", "if", "skipped"), ("no", "skipped", "unless")]
    {
        let source = format!(
            "set flag to {condition}\\n\\
             set via_if to \\"skipped\\"\\n\\
             set via_unless to \\"skipped\\"\\n\\
             if flag then\\n    set via_if to \\"if\\"\\nend\\n\\
             unless flag then\\n    set via_unless to \\"unless\\"\\nend\\n\\
             if via_if is not \\"skipped\\" then\\n    set verdict to \\"{if_branch}-taken\\"\\nelse\\n\\
             set verdict to \\"{if_branch}-skipped\\"\\nend\\n\\
             unless via_unless is not \\"skipped\\" then\\n\\
             set verdict to \\"{unless_branch}-taken\\"\\nend\\n"
        );

        let program = lex_and_parse(&source).unwrap_or_else(|e| {
            panic!("`if`/`unless` on condition {condition:?} should parse: {e}")
        });
        assert_eq!(
            program.statements.len(),
            6,
            "the paired program should hold six top-level statements, got {}",
            program.statements.len()
        );

        match run_source_value(&source) {
            Ok(Value::Text(verdict)) => {
                // `unless` only writes the verdict when it took its body, so a
                // `unless`-skipped run keeps the `if` form's verdict.
                let expected = if unless_branch == "skipped" {
                    format!("{if_branch}-taken")
                } else {
                    format!("{unless_branch}-taken")
                };
                assert_eq!(
                    verdict, expected,
                    "with condition {condition:?}, `if` and `unless` must pick opposite branches"
                );
            }
            Ok(other) => panic!("expected text for condition {condition:?}, got {other:?}"),
            Err(error) => panic!("condition {condition:?} should run, got {error:?}"),
        }
    }

    // The two forms are exact opposites: with the condition true exactly one
    // body ran, and with it false the other one did.
    for (condition, taken) in [("yes", "if"), ("no", "unless")] {
        let via_if = branch_taken_by(&format!(
            "set hit to \\"skipped\\"\\nset flag to {condition}\\n\\
             if flag then\\n    set hit to \\"if\\"\\nend\\n"
        ));
        let via_unless = branch_taken_by(&format!(
            "set hit to \\"skipped\\"\\nset flag to {condition}\\n\\
             unless flag then\\n    set hit to \\"unless\\"\\nend\\n"
        ));
        let ran = usize::from(via_if == "if") + usize::from(via_unless == "unless");
        assert_eq!(
            ran, 1,
            "with condition {condition:?} exactly one of `if`/`unless` must take its body, \\
             got if={via_if:?} unless={via_unless:?}"
        );
        assert_eq!(
            if condition == "no" {
                via_unless
            } else {
                via_if
            },
            taken,
            "the wrong form took its body for condition {condition:?}"
        );
    }
}

