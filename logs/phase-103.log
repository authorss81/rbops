            "the program failed: {}",
            String::from_utf8_lossy(&output.stderr)
        );
        assert_eq!(
            fs::read_to_string(&marker).expect("the catch wrote its marker"),
            "caught",
            "a closed stdout must be catchable, not silently discarded"
        );
    }

