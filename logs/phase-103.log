/// stderr.
///
/// The status is returned rather than raised, because the check that uses this
/// is ABOUT a non-zero status: `git check-ignore` answers "not ignored" with
/// status 1, and that answer is the one it needs.
///
/// stderr comes back as well as stdout because that is where git writes the
/// REASON: `git ls-files --error-unmatch` exits 1 with the reason on stderr
/// and nothing at all on stdout, so an error message built from stdout alone
/// says "failed with status 1: " and names no reason whatsoever.
fn git_run(args: &[&str]) -> Result<(i32, String, String), String> {
    let out = Command::new("git")
        .arg("-C")
        .arg(project_root())
        .args(args)
        .output()
        .map_err(|e| format!("could not run `git {}`: {e}", args.join(" ")))?;
    let status = out.status.code().unwrap_or(-1);
    Ok((
        status,
        String::from_utf8_lossy(&out.stdout).into_owned(),
            "rbops: phase-016 checkpoint",
        ),
        ("e97983a", "resume-path merge"),
        ("d664d3c", "resume-path merge"),
        ("2179034", "resume-path merge"),
        ("255816e", "resume-path merge"),
    ];

    for (sha, what) in eight {
        let out = Command::new("git")
            .arg("-C")
            .arg(repo_root())
            .args(["merge-base", "--is-ancestor", sha, "HEAD"])
            .output()
            .expect("`git merge-base` must run");
        assert!(
            out.status.success(),
            "{sha} ({what}) is NOT an ancestor of HEAD on a complete history. Phase-083 \
             claimed this for all eight of phase-078's commits and wanted to supersede \
             phase-078 on it; if this has genuinely become true the history was rewritten, \
             which AGENTS.md forbids — find out what happened before updating this test."
