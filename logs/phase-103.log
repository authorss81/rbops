    /// A stream with no reader is a failure the program can catch, not a
    /// record silently dropped on the floor. The socket pair is created and the
    /// read end dropped before the child starts, so the child's first write is
    /// a broken pipe rather than a race against the parent.
    #[cfg(unix)]
    fn closed_stream() -> std::process::Stdio {
        use std::os::fd::OwnedFd;
        use std::os::unix::io::{FromRawFd, IntoRawFd};
        use std::os::unix::net::UnixStream;
        use std::process::Stdio;

        let (write, read) = UnixStream::pair().expect("a socket pair");
        drop(read);
        // SAFETY: `write` is a live descriptor and `into_raw_fd` transfers its
        // ownership to the `OwnedFd`, which closes it after the spawn.
        let owned = unsafe { OwnedFd::from_raw_fd(write.into_raw_fd()) };
        Stdio::from(owned)
    }

    /// The default stderr destination handed to the child with no reader.
    #[cfg(unix)]
    #[test]
    fn edge_a_closed_stderr_is_a_catchable_error() {
        let dir = scratch("closed-stderr");
        let file = dir.join("program.rb");
        fs::write(
            &file,
            "logging.set_level(\"info\")\n\
             logging.set_timestamps(no)\n\
             try\n\
                 logging.info(\"to a closed stderr\")\n\
             catch error of Io\n\
                 say \"caught\"\n\
             end\n\
             say \"done\"\n",
        )
        .expect("program file");

        let output = std::process::Command::new(env!("CARGO_BIN_EXE_rb"))
            .arg("run")
            .arg(&file)
            .stdout(std::process::Stdio::piped())
            .stderr(closed_stream())
            .output()
            .expect("rb runs");

        assert!(
            output.status.success(),
            "the program failed: {}",
            String::from_utf8_lossy(&output.stderr)
        );
        assert_eq!(
            String::from_utf8_lossy(&output.stdout),
            "caught\ndone\n",
            "a closed stderr must be catchable, not silently discarded"
        );
    }

