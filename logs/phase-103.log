    old=blocks(subprocess.check_output(['git','show',f'HEAD:{doc}'], text=True))
    new=blocks(Path(doc).read_text())
    obodies=[b for _,b in old]; nbodies=[b for _,b in new]
    sm=difflib.SequenceMatcher(None, obodies, nbodies, autojunk=False)
    mapping={}
    new_entries=[]
    for tag,i1,i2,j1,j2 in sm.get_opcodes():
        if tag=='equal':
            for k in range(i2-i1):
                mapping[old[i1+k][0]]=new[j1+k][0]
        elif tag=='insert':
            for k in range(j1,j2):
                new_entries.append((new[k][0], new[k][1]))
        elif tag in ('replace','delete'):
            # fallback positional match
            for k in range(min(i2-i1,j2-j1)):
                mapping[old[i1+k][0]]=new[j1+k][0]
    new_blocks[doc]= (mapping,new_entries)
    print(doc,'old',len(old),'new',len(new),'mapped',len(mapping),'new entries',[e[0] for e in new_entries])

for fname in ['tests/doc_blocks_runs.txt','tests/doc_blocks_fragments.txt','tests/doc_blocks_known_fail.txt']:
