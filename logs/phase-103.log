def blocks(text):
    lines=text.splitlines()
    out=[]; i=0
    while i < len(lines):
        if lines[i].strip().startswith('```'):
            info=lines[i].strip()[3:].strip().split()
            if info and info[0]=='redblue':
                start=i+1; j=i+1; body=[]
                while j < len(lines):
                    if lines[j].strip().startswith('```'):
                        break
                    body.append(lines[j]); j+=1
                out.append((start,'\n'.join(body)))
                i=j+1; continue
        i+=1
    return out

new_blocks={}
