    /// the answer rather than a panic.
    fn run_in_debug(&mut self, code: &str, file: &str) -> Vec<String> {
        match self.debug_repl.as_mut() {
            Some(debug) => debug.run(code, file),
            None => vec![NO_DEBUG_SESSION.to_string()],
        }
    }
