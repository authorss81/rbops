        if !self.redo_stack.is_empty() {
            self.redo_stack.clear();
            println!("Redo history cleared by a new change.");
        }
        if self.undo_stack.len() >= MAX_UNDO {
        Some(functions.iter().map(|name| format!("  {}", name)).collect())
