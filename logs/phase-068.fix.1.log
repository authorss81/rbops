    /// `.reload`: runs the file the last `:load` or `:run` named, the same way
    /// that command ran it.
    ///
    /// A session that never named a file has nothing to reload, and saying so by
    /// naming `:load` is the answer: `.reload` is a shortcut through a command
    /// the user has not used yet, not a command with an empty path.
    fn reload_file(&mut self) {
        let Some(last) = self.last_file.clone() else {
            println!(
                "{}",
                self.style.paint(
                    Paint::Error,
                    "Error: .reload has nothing to reload: no file has been loaded \
                     with :load <filename> or :run <filename>."
                )
            );
            return;
        };

        match last {
            LastFile::Loaded(path) => self.load_file(&path),
            LastFile::Ran(path) => self.run_file(&path),
        }
    }

    /// Forgets everything the session has done: its bindings, its last result,
    /// and any block it is halfway through typing.
    ///
    /// The block is the half that is easy to leave out. `:reset` used to replace
    /// the VM and clear `variables` and nothing else, so `repeat 3 times` then
    /// `:reset` left the session in continuation mode with that line still
    /// buffered: the next line was appended to a block nobody was typing any
    /// more, so `say "hi"` waited for an `end` that was never coming and never
    /// ran. A session that has been reset is a session at a prompt, so the buffer
    /// goes with the bindings.
    ///
    /// The recorded definitions go with them, and that half was just as visible.
    /// They are a map from a name to the line that bound it, and a name a reset
    /// session no longer holds was still reported by `.which` as a session
    /// binding at `<session>:3` — a span pointing at a line of a session that had
    /// been thrown away, quoted at that. A reset forgets what it was; a `.which`
    /// that disagrees with it is worse than the stale binding it used to report,
    /// because it is a wrong answer rather than an absence.
    ///
    /// The history is left alone: it is the record of what was typed, and a reset
    /// is not a new session in the sense that the earlier lines were never typed.
    ///
    /// So is the tour, though, and that is the newer half of the same question. A
    /// step is taken by running its snippet and a snippet needs the bindings the
    /// step before it bound, so a session that has been reset mid-tour is a
    /// session holding a hint for a step of a program it no longer has: `set name
    /// to "World"`, `:reset`, and `:hint` answers as though `name` were about to
    /// be asked for. A reset forgets what it was, and where in the tour it was is
    /// part of what it was.
    fn reset_session(&mut self) {
        self.vm = Vm::new();
        self.variables.clear();
        self.definitions.clear();
        self.last_file = None;
        self.cwd = Self::process_directory();
        self.multiline_buffer.clear();
        self.in_multiline = false;
        self.tutorial_step = None;
        self.tutorial_typed.clear();
        // A reset forgets the checkpoints and the undo history too: a checkpoint
        // of bindings the session no longer has would restore a state the reset
        // was asked to remove.
        self.checkpoints.clear();
        self.current_checkpoint = None;
        self.undo_stack.clear();
        self.redo_stack.clear();
        // The transcript with them: an export of a session that had forgotten the
        // lines it ran would claim a session that no longer exists ran them.
        self.transcript.clear();
        println!("REPL state reset.");
    }

    /// Captures the state every binding command can change, and the session
    /// state a checkpoint promises to restore with it.
    fn snapshot_state(&self) -> SessionSnapshot {
        let (locals, globals) = self.vm.current_bindings();
        SessionSnapshot {
            globals: globals.clone(),
            locals: locals.to_vec(),
            context: self.vm.call_context().clone(),
            variables: self.variables.clone(),
            definitions: self.definitions.clone(),
            aliases: self.aliases.clone(),
            macros: self.macros.clone(),
            macro_recording: self.macro_recording.clone(),
            tutorial_step: self.tutorial_step,
            tutorial_typed: self.tutorial_typed.clone(),
            last_file: self.last_file.clone(),
            cwd: self.cwd.clone(),
            format_on_entry: self.format_on_entry,
            transcript: self.transcript.clone(),
        }
    }

    /// Whether two snapshots differ in anything a user can read as a binding.
    ///
    /// The context is left out on purpose: it changes only alongside a name in
    /// `globals` (an import publishes one), and comparing the syntax trees it
    /// holds would make every compare walk a module's whole program.
    fn bindings_changed(before: &SessionSnapshot, after: &SessionSnapshot) -> bool {
        before.globals != after.globals
            || before.locals != after.locals
            || before.variables != after.variables
            || before.definitions != after.definitions
    }

    /// Puts the bindings, last result and definitions of `snapshot` back.
    fn apply_bindings(&mut self, snapshot: &SessionSnapshot) {
        self.vm
            .observe_bindings(&snapshot.locals, &snapshot.globals);
        self.vm.observe_context(&snapshot.context);
        self.variables = snapshot.variables.clone();
        self.definitions = snapshot.definitions.clone();
    }

    /// Puts a whole snapshot back: its bindings and the session state a
    /// checkpoint saved alongside them.
    fn apply_snapshot(&mut self, snapshot: &SessionSnapshot) {
        self.apply_bindings(snapshot);
        self.aliases = snapshot.aliases.clone();
        self.macros = snapshot.macros.clone();
        self.macro_recording = snapshot.macro_recording.clone();
        self.tutorial_step = snapshot.tutorial_step;
        self.tutorial_typed = snapshot.tutorial_typed.clone();
        self.last_file = snapshot.last_file.clone();
        self.cwd = snapshot.cwd.clone();
        self.format_on_entry = snapshot.format_on_entry;
        self.transcript = snapshot.transcript.clone();
    }

