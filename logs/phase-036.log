old_a = '''/// A `break` the loop never reaches dispatches zero instructions.
///
/// The mirror of the first test, and the one that actually distinguishes the two
/// ways a no-op can hide: here the `break` is written *after* the statements that
/// would have ended the loop anyway, so a decoded-but-dropped `break` and a
/// working one are indistinguishable from the output. Only the count separates
/// them, and zero is right here — the loop ends at `break`, so the second one is
/// never evaluated.
#[test]
fn a_break_written_after_the_loop_ends_is_never_dispatched() {
    let source = concat!(
        "for each i in [1, 2, 3]\\n",
        "    if i is 3 then\\n",
        "        break\\n",
        "    end\\n",
        "    say i\\n",
        "end\\n",
        "break\\n",
    );

    assert_eq!(
        counts_on_both_engines(source),
        (1, 0),
        "only the break inside the loop runs; the one after it is never reached"
    );
}'''

new_a = '''/// A `break` that ends the loop on its *first* value still dispatches once — the
/// count is a statement count, not a per-element one.
///
/// The mirror of the first test, and the one that separates a working `break`
/// from a dropped one in the shape that hides best: here the loop would have
/// printed `1` and stopped either way if the instruction were dropped, because
/// `break` is the last statement reached before the third turn prints. Only the
/// instruction count shows that a handler ran at all.
#[test]
fn a_break_on_the_first_value_still_dispatches_exactly_once() {
