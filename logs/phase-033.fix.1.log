+
+    s.assert_exited_ok()
+        .assert_stdout_contains("LOADED AND RAN")
+        .assert_stdout_lacks("Error");
+}
+
+/// A command's argument is every word after it: a path with a space in it is the
+/// whole remainder, not the first word of it.
+#[test]
