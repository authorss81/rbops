+/// [`Style::paint`] writes and the only escape anything here produces. Anything
+/// else is left exactly as it was, because a caller that handed over a character
+/// it did not write should get it back unchanged.
+pub fn strip_escapes(text: &str) -> String {
+    let mut out = String::with_capacity(text.len());
+    let mut chars = text.chars();
+    while let Some(c) = chars.next() {
+        if c != '\u{1b}' {
+            out.push(c);
+            continue;
+        }
+        if chars.as_str().starts_with('[') {
+            chars.next();
+            for parameter in chars.by_ref() {
+                if parameter == 'm' {
+                    break;
+                }
+                // A control character that is not the final one is a broken
+                // sequence rather than a long one, and what is left of the string
+                // after it is text the caller wrote.
+                if parameter.is_control() {
+                    break;
+                }
+            }
+        }
+    }
+    out
+}
