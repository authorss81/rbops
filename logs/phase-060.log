+
+/// How long the fence around an exchange has to be to survive it.
+///
+/// Both halves of the exchange, not the input alone, because both are written
+/// into the document and both are read back out of it. An input holding three
+/// backticks closes the block it is written inside; an *output* holding
+/// ` ```redblue ` is the worse of the two, because a reader — and
+/// [`Transcript::read_markdown`] — takes it for the opening of a block, and the
+/// exchange written after it is read as the body of that block rather than as a
+/// line the session ran.
+fn exchange_fence_width(exchange: &Exchange) -> usize {
+    let longest = exchange
+        .output
+        .iter()
+        .fold(longest_backtick_run(&exchange.input), |longest, line| {
+            longest.max(longest_backtick_run(line))
+        });
+    longest.max(2) + 1
+}
