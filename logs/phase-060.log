+/// The cap, and the one name it may not take: a name the user has already
+/// typed whole.
+///
+/// The list stops at [`MAX_PATH_CANDIDATES`] because a directory of ten
+/// thousand entries is not a list anyone can read. It is cut from the sorted
+/// list, so what survives is the first of that order — which means the file
+/// that sorts last is the one that is never offered, and a user who typed its
+/// name whole (the only situation in which they already know it) was told there
+/// was nothing to offer. The cap is a rule about a *listing*; this is a rule
+/// about an *answer*, and the answer to "I have typed the whole name" is that
+/// name.
+///
+/// The name is offered, and offered in its sorted place, because a list that
+/// jumped the queue would be a list whose order depends on which entry the
+/// user had already found.
+#[test]
+fn edge_a_name_typed_whole_is_offered_past_the_cap() {
+    let dir = scratch_dir("exact");
+    for index in 0..MAX_PATH_CANDIDATES + 10 {
+        file_in(&dir, &format!("{index:04}.rb"));
+    }
+    file_in(&dir, "zz-the-one-the-user-typed.rb");
+
+    let offered = complete_path_in(&dir, "zz-the-one-the-user-typed.rb");
+
+    assert_eq!(
+        offered,
+        vec!["zz-the-one-the-user-typed.rb".to_string()],
+        "the one name that sorts last is the one name a user who typed it \
+         whole is asking for, and the cap must not take it"
+    );
+    assert_eq!(
+        complete_path_in(&dir, "").len(),
+        MAX_PATH_CANDIDATES,
+        "and a *listing* is still cut short: the cap is unchanged for a \
+         fragment that could be any of many"
+    );
+}
+
