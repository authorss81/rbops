+/// **A failure of the write, asserted on the file that stopped it.** The
+/// permissions of a file `.format` rewrites are the user's, and they are not
+/// carried across by a rename.
+///
+/// The write goes through a temporary file beside the target and renames it over
+/// the top ([`Repl::write_source_atomically`]), and a rename brings the *incoming*
+/// file's mode with it — the temporary is created `0644` whatever the umask and
+/// whatever the file it is about to replace was. So `.format` of an executable
+/// script came back as a plain file that could no longer be run, and `.format` of
+/// a `0600` file came back `0644` and readable by everyone, which is the half that
+/// matters: the session quietly widened a file's permissions while formatting it,
+/// and said only "Formatted 'x.rb'.".
+///
+/// Both directions are here, because the fix is "the mode the file had" rather
+/// than "the mode it had plus an execute bit": a mode that is loosened is the same
+/// defect as a mode that is dropped. The file itself is checked on every host;
+/// only the reading of the mode is unix's, so the content assertion below is the
+/// one that survives a host without mode bits.
+#[test]
+fn edge_format_keeps_the_permissions_the_file_had() {
+    let directory = scratch_dir().join("format-mode");
+    let _ = std::fs::remove_dir_all(&directory);
+    std::fs::create_dir_all(&directory).expect("the directory should be creatable");
+    let source = "if 1 is greater than 0 then\nsay \"a\"\nend\n";
+    let formatted = "if 1 is greater than 0 then\n    say \"a\"\nend\n";
+    let script = directory.join("script.rb");
+    let private = directory.join("private.rb");
+    std::fs::write(&script, source).expect("the script should be writable");
+    std::fs::write(&private, source).expect("the private file should be writable");
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        std::fs::set_permissions(&script, std::fs::Permissions::from_mode(0o755))
+            .expect("the script should be made executable");
+        std::fs::set_permissions(&private, std::fs::Permissions::from_mode(0o600))
+            .expect("the private file should be made private");
+    }
+
+    let s = session(&format!(
+        ":prompt {EXPORT_PROMPT}\n:format {}\n:format {}\nsay \"after\"\n:quit\n",
+        script.display(),
+        private.display()
+    ));
+    s.assert_exited_ok()
+        .assert_stdout_contains(&format!("Formatted '{}'", script.display()))
+        .assert_stdout_contains(&format!("Formatted '{}'", private.display()))
+        .assert_stdout_contains("after");
+
+    assert_eq!(
+        std::fs::read_to_string(&script).expect("the script is still readable"),
+        formatted,
+        "the script was formatted, which is what the command was asked to do"
+    );
+    assert_eq!(
+        std::fs::read_to_string(&private).expect("the private file is still readable"),
+        formatted,
+        "and so was the file nobody else may read"
+    );
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        let mode_of = |path: &Path| std::fs::metadata(path).expect("it is still there").permissions().mode() & 0o777;
+        assert_eq!(
+            mode_of(&script),
+            0o755,
+            "a script the user made executable is still executable after `.format`"
+        );
+        assert_eq!(
+            mode_of(&private),
+            0o600,
+            "and a file the user made private is still private: formatting a file \
+             must not widen who can read it"
+        );
+    }
+    let _ = std::fs::remove_dir_all(&directory);
+}
+
+/// **A failure is asserted.** The one name between the target and the write is
+/// the temporary's, and it is a name in the user's directory that nothing asked
+/// them about.
+///
+/// [`Repl::write_source_atomically`] puts its temporary beside the target, so
+/// `prog.rb` is written through `prog.rb.tmp`. A user who already has a
+/// *directory* by that name — a build step's scratch, a mount point, anything at
+/// all — cannot have the temporary created, and the write must fail with the
+/// reason and leave `prog.rb` exactly as it was rather than truncating it or
+/// reporting a success that did not happen. It is the same all-or-nothing promise
+/// the unreadable-directory case above makes, one step earlier.
+#[test]
+fn edge_format_of_a_file_whose_temporary_name_is_taken_leaves_it_alone() {
+    let directory = scratch_dir().join("format-taken-temporary");
+    let _ = std::fs::remove_dir_all(&directory);
+    std::fs::create_dir_all(&directory).expect("the directory should be creatable");
+    let path = directory.join("prog.rb");
+    let source = "if 1 is greater than 0 then\nsay \"a\"\nend\n";
+    std::fs::write(&path, source).expect("the program should be writable");
+    std::fs::create_dir(directory.join("prog.rb.tmp"))
+        .expect("the occupying directory should be creatable");
+
+    let s = session(&format!(
+        ":prompt {EXPORT_PROMPT}\n:format {}\nsay \"after the failure\"\n:quit\n",
+        path.display()
+    ));
+    let after = std::fs::read_to_string(&path).expect("the program is still readable");
+
+    s.assert_exited_ok()
+        .assert_stdout_contains(&format!("Could not format '{}'", path.display()))
+        .assert_stdout_contains("It is unchanged")
+        .assert_stdout_contains("after the failure");
+    assert_eq!(
+        source, after,
+        "a file whose temporary name was taken is byte-for-byte as it was"
+    );
+    assert!(
+        !s.stdout.contains("Formatted '"),
+        "and it was not reported as formatted:\n{}",
+        s.stdout
+    );
+    assert!(
+        directory.join("prog.rb.tmp").is_dir(),
+        "the directory that was in the way is still there: this is about the \
+         write, not about cleaning up after it"
+    );
+    let _ = std::fs::remove_dir_all(&directory);
+}
