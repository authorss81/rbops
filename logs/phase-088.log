import re, pathlib
src=open('target/tmp/scan_noassert.py').read()
exec(src.split('total=0')[0])

ASSERT=re.compile(r'\b(assert(_eq|_ne)?!|panic!|assert_failed|should_panic)')
def blocks(clean):
    lines=clean.split('\n')
    res=[]
    for idx,l in enumerate(lines):
        m=re.match(r'\s*(?:#\[[^\]]*\]\s*)*(?:pub )?fn\s+(\w+)', l)
        if not m: continue
        depth=0; started=False; body=[]; k=idx
        while k<len(lines):
            for ch in lines[k]:
                if ch=='{': depth+=1; started=True
                elif ch=='}': depth-=1
            body.append(lines[k])
            if started and depth==0: break
            k+=1
