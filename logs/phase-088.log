    mkdir -p "$RBOPS_ROOT/phases/$phase"
    cp "$PROJECT_DIR/phases/$phase/$artefact" "$RBOPS_ROOT/phases/$phase/$artefact"
    log "harvested $artefact from the project"
  fi
done

  # --- classify -------------------------------------------------------------
  # A dead model chain (75) or an infra-shaped log is a RETRYABLE infra fault.
  # It must never be counted as a phase attempt: nothing was attempted, so
  # burning MAX_ATTEMPTS on it would block a phase that never even ran.
  if [ "$code" = "75" ] || infra_failure "$LOG_DIR/$phase.log"; then
    tail -6 "$LOG_DIR/$phase.log" | sed 's/^/    | /'
    defer_phase "$phase" "infra"
    return $?
  fi

  # --- THE GATE -------------------------------------------------------------
  normalize_tree
  log "running verify gate for $phase"
  # Capture the gate's own verdict to a file the NEXT attempt can read, while
  # still printing it. verify.sh writes both streams, and the diagnostic that
  # matters - the FAIL lines - is the part that gets lost: the next attempt
  # receives the previous REPORT.md (which claims success) plus a warning not to
  # trust it, and nothing about what actually failed. Phase-082 burned three
  # attempts and ~4.5 hours re-deriving a failure the gate had already named in
