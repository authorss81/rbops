        "the step budget ({}) must be larger than one loop's cap ({}), or the \
         budget would stop a loop that is inside its own limit",
        steps,
        iterations
    );
}

/// A limit of zero would make every loop illegal, which is never what an
/// operator means, so a zero or non-numeric setting falls back to the default.
#[test]
fn a_zero_limit_falls_back_to_the_default() {
    assert_eq!(
        redblue::resolve_max_iterations_from(Some(0)),
        MAX_ITERATIONS,
        "a zero cap must not be honoured"
    );
    assert_eq!(
        redblue::resolve_max_iterations_from(Some(42)),
        42,
        "a positive cap must be honoured"
    );
    assert_eq!(
        redblue::resolve_max_steps_from(Some(0)),
        MAX_STEPS,
        "a zero budget must not be honoured"
    );
}

/// Every example the repository ships must still fit inside the published
/// limits, or the bound would reject programs the language itself documents.
///
/// `modules/` is walked too: a module file is a program the loader runs, and
/// `modules/MathUtils.rb` used to be left out because its `constant`
/// declarations did not parse.
#[test]
fn shipped_examples_fit_inside_the_published_limits() {
    let root = PathBuf::from(env!("CARGO_MANIFEST_DIR"));
    let mut checked = 0;

    // Sorted so that a failure names the same file every run.
    let mut files: Vec<std::path::PathBuf> = Vec::new();
    for dir in ["examples", "modules"] {
        let entries = std::fs::read_dir(root.join(dir))
            .unwrap_or_else(|e| panic!("{dir}/ should be readable: {e}"));
        for entry in entries.flatten() {
            let path = entry.path();
            if path.extension().and_then(|e| e.to_str()) == Some("rb") {
                files.push(path);
            }
        }
    }
    files.sort();

    for path in files {
        let source = std::fs::read_to_string(&path).expect("example should be readable");
        let program = parse(&source);
        let mut vm = Vm::new();
        vm.run(&program).unwrap_or_else(|error| {
            panic!(
                "{} must run inside the published limits, failed with {:?}",
                path.display(),
                error
            )
        });
        checked += 1;
    }

    assert!(checked > 0, "the repository ships no examples to check");
}

// ---------------------------------------------------------------------------
// edge: counts at the numeric edges
// ---------------------------------------------------------------------------

/// Edge: a count beyond `i64`, and one beyond any representable number, must be
/// a clean iteration-cap error. Before the cap these were `as i64` saturations
/// fed into an unbounded loop, so the number's size decided only how long the
/// program hung.
#[test]
fn edge_count_beyond_i64_is_a_clean_error_not_a_panic() {
    for count in ["99999999999999999999", "1e300"] {
        let source = format!(
            "set n to 0\nrepeat {} times\n    set n to n + 1\nend",
            count
        );

        let error = run_capped(&source, 100)
            .expect_err("a count past i64 must be bounded, not hang or panic");
        assert!(
            matches!(error, Error::Limit(..)),
            "count {} produced {:?}, which is not a clean bounded error",
            count,
            error
        );
    }
}

/// Edge: a fractional count truncates to zero iterations and is not an error.
/// The negative direction of the same boundary: `0..-5` is empty, not a run of
/// five backwards.
///
/// The variable the body would have changed is the last statement, so the run
/// answers the count of turns taken: zero. A count of `0.5` that ran one turn
/// would leave the variable at `1`, and the answer would say so.
#[test]
fn edge_fractional_and_negative_counts_run_zero_times() {
    for count in ["0.5", "0", "-5"] {
        let source = format!(
            "set n to 0\nrepeat {} times\n    set n to n + 1\nend\nn",
            count
        );

        let value = run_capped(&source, 5)
            .unwrap_or_else(|error| panic!("count {} must run zero times: {:?}", count, error));
        assert_eq!(
            value,
            redblue::Value::Number(0.0),
            "count {} must run zero turns, not one",
            count
        );
    }
}

/// Edge: a count that is not a number is not a loop at all. This is the
/// pre-existing behaviour and the cap must not change it into an error or a
/// hang.
///
/// The literal `never` in the body is what makes the assertion possible: without
/// a line only this run could print, "did not run" and "ran and said nothing" are
/// the same observation, and a loop that ran its body zero times out of luck would
/// pass. Reading the output is the difference between a reachability check and a
            "the walker must answer `{source}` with `{expected}`"
        );

        let mut vm = BytecodeVm::new();
        vm.set_echo(false);
        vm.run(&chunk)
            .unwrap_or_else(|error| panic!("the bytecode VM refused `{source}`: {error:?}"));
        assert_eq!(
            vm.take_output(),
            vec![expected.to_string()],
            "the bytecode VM must answer `{source}` with `{expected}`"
        );
    }
}

/// A builtin given the wrong type is refused by **name**, on both engines, and
/// says nothing first.
///
/// The counterpart to the two tests above: a builtin that answered a wrong value
/// for the wrong type would satisfy "produced a line" and fail this, so the pair
/// together is "the right answer, or a named refusal — never anything else".
#[test]
fn edge_a_builtin_given_a_text_says_nothing_and_names_the_refusal() {
    for (source, name) in [
        ("say sqrt(\"nine\")", "sqrt"),
        ("say abs(\"three\")", "abs"),
        ("say text.split(1, \",\")", "split"),
    ] {
        let tokens = redblue::lexer::Lexer::tokenize(source)
            .unwrap_or_else(|error| panic!("{source} should lex: {error:?}"));
        let program = redblue::parser::parse(tokens)
            .unwrap_or_else(|error| panic!("{source} should parse: {error:?}"));
        let chunk = redblue::bytecode::compile_program(&program)
            .unwrap_or_else(|error| panic!("{source} should compile: {error:?}"));

        let (mut walker, walked) = redblue::run_isolated(&program);
        assert!(
            walked.is_err(),
            "`{source}` must be refused by the walker: {walked:?}"
        );
        let walker_error = walked.expect_err(&format!("`{source}` must be refused by the walker"));
        let said_by_walker = walker.take_output();
        assert!(
            said_by_walker.is_empty(),
            "`{source}` said {said_by_walker:?} before refusing"
        );

        let mut vm = BytecodeVm::new();
        vm.set_echo(false);
        let vm_result = vm.run(&chunk);
        assert!(
            vm_result.is_err(),
            "`{source}` must be refused by the bytecode VM: {vm_result:?}"
        );
        let vm_error =
            vm_result.expect_err(&format!("`{source}` must be refused by the bytecode VM"));
        let said_by_vm = vm.take_output();
        assert!(
            said_by_vm.is_empty(),
            "`{source}` said {said_by_vm:?} before refusing"
        );

        // Both engines refuse it, and both name it the same way: the refusal
        // says which builtin could not answer, not merely that something could
        // not.
        assert!(
            walker_error.message().contains(name),
            "`{source}` should name `{name}` in its refusal, got: {}",
            walker_error.message()
        );
        assert!(
            walker_error.message().contains("argument"),
            "`{source}` should say its arguments were the problem, got: {}",
            walker_error.message()
        );
        assert_eq!(
            vm_error.message(),
            walker_error.message(),
            "`{source}` must be refused the same way on both engines"
        );
    }
}

/// A builtin that cannot answer is refused **by the library**, and the refusal
/// is a `Result` a caller can act on — not a wrong answer and not a panic.
///
/// The test above asks the two VMs directly. This one asks
/// [`redblue::run_source`], the entry point an embedding application calls, and
/// requires three things of a bad argument:
///
/// 1. the call comes back `Err`, so a caller can branch on it;
/// 2. the error is a runtime error and names the builtin that could not answer,
///    so a reader of the message knows which one to look at;
/// 3. nothing was printed before the refusal, on either engine — a program that
///    printed a line and *then* failed has not answered the question.
///
/// Point 3 is the reachability point of this phase in the negative direction:
/// "it did not print the answer" and "it printed a wrong answer and then
/// complained" are the same observation to a test that only counts lines.
#[test]
fn edge_a_builtin_that_cannot_answer_is_refused_by_the_library_not_answered_wrongly() {
    for (source, name) in [
        ("say sqrt(\"nine\")", "sqrt"),
        ("say abs(\"three\")", "abs"),
        ("say text.split(1, \",\")", "split"),
        ("say nosuchfunction(1)", "nosuchfunction"),
    ] {
        let result = redblue::run_source(source);
        assert!(
            result.is_err(),
            "`{source}` must be refused, not answered: {result:?}"
        );
        let error = result.expect_err(&format!("`{source}` must be refused, not answered"));
        assert!(
            matches!(error, redblue::Error::Runtime(..)),
            "`{source}` should fail at runtime, got: {error:?}"
        );
        assert!(
            error.message().contains(name),
            "`{source}` should name `{name}` in its refusal, got: {}",
            error.message()
        );

        // The same program, asked of each engine directly, so the refusal is
        // read from the run rather than from the library's plumbing.
        let tokens = redblue::lexer::Lexer::tokenize(source)
            .unwrap_or_else(|error| panic!("{source} should lex: {error:?}"));
        let program = redblue::parser::parse(tokens)
            .unwrap_or_else(|error| panic!("{source} should parse: {error:?}"));
        let chunk = redblue::bytecode::compile_program(&program)
            .unwrap_or_else(|error| panic!("{source} should compile: {error:?}"));

        let (mut walker, walked) = redblue::run_isolated(&program);
        assert!(
            walked.is_err(),
            "`{source}` must be refused by the walker: {walked:?}"
        );
        let walker_error = walked.expect_err(&format!("`{source}` must be refused by the walker"));
        assert_eq!(
            walker_error.message(),
            error.message(),
            "`{source}` must be refused the same way by the library and by the walker"
        );
        let said_by_walker = walker.take_output();
        assert!(
            said_by_walker.is_empty(),
            "`{source}` said {said_by_walker:?} before refusing"
        );

        let mut vm = BytecodeVm::new();
        vm.set_echo(false);
        let vm_result = vm.run(&chunk);
        assert!(
            vm_result.is_err(),
            "`{source}` must be refused by the bytecode VM: {vm_result:?}"
        );
        let vm_error =
            vm_result.expect_err(&format!("`{source}` must be refused by the bytecode VM"));
        assert_eq!(
            vm_error.message(),
            error.message(),
            "`{source}` must be refused the same way by the library and by the bytecode VM"
        );
        let said_by_vm = vm.take_output();
        assert!(
            said_by_vm.is_empty(),
            "`{source}` said {said_by_vm:?} before refusing"
        );
    }
}

