import re, pathlib, sys

def strip_comments_strings(s):
    out=[]
    i=0
    while i < len(s):
        c=s[i]
        if c=='"':
            # raw string r#"..."# or "..."
            m=re.match(r'r(#*)"', s[i:])
            if m:
                hashes=m.group(1); end='"'+hashes
                j=s.find(end, i+len(m.group(0)))
                j = len(s) if j<0 else j+len(end)
                out.append(re.sub(r'[^\n]','',s[i:j])); i=j; continue
            j=i+1
            while j<len(s):
                if s[j]=='\\': j+=2; continue
                if s[j]=='"': j+=1; break
                j+=1
            out.append(re.sub(r'[^\n]','',s[i:j])); i=j; continue
        if c=='/' and i+1<len(s) and s[i+1]=='/':
            j=s.find('\n', i); j=len(s) if j<0 else j
            out.append(' '*0); i=j; continue
        if c=='/' and i+1<len(s) and s[i+1]=='*':
            j=s.find('*/', i+2); j=len(s) if j<0 else j+2
            out.append(re.sub(r'[^\n]','',s[i:j])); i=j; continue
        out.append(c); i+=1
    return ''.join(out)

total=0
noassert=[]
for p in sorted(pathlib.Path('tests').glob('*.rs')):
    src=p.read_text()
    clean=strip_comments_strings(src)
    lines=clean.split('\n')
    for idx,l in enumerate(lines):
        if re.match(r'\s*#\[test\]', l):
            total+=1
            # find fn start then brace-match
            j=idx
            while j<len(lines) and 'fn ' not in lines[j]:
                j+=1
            # brace match from j
            depth=0; started=False; body=[]
            k=j
            while k<len(lines):
                for ch in lines[k]:
                    if ch=='{':
                        depth+=1; started=True
                    elif ch=='}':
                        depth-=1
                body.append(lines[k])
                if started and depth==0: break
                k+=1
            name=re.search(r'fn\s+(\w+)', lines[j]).group(1)
            bodytext='\n'.join(body)
            has_assert = ('assert' in bodytext) or ('panic!' in bodytext) or ('unwrap_or_else(|| panic' in bodytext)
            has_expect_panic = '#[should_panic]' in lines[max(0,idx-3):idx+1]
            if not has_assert and not has_expect_panic:
                noassert.append((str(p), idx+1, name))
print("total #[test]:", total)
print("no assert/panic:", len(noassert))
for f,ln,n in noassert:
    print(f"{f}:{ln} {n}")
