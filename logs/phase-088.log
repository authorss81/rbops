import re, pathlib
exec(open('target/tmp/scan_noassert.py').read().split('total=0')[0])

def blocks(clean):
    lines=clean.split('\n')
    res=[]
    for idx,l in enumerate(lines):
        m=re.match(r'\s*(?:#\[[^\]]*\]\s*)*(?:pub )?fn\s+(\w+)', l)
        if not m: continue
        depth=0; started=False; body=[]; k=idx
        while k<len(lines):
            for ch in lines[k]:
                if ch=='{': depth+=1; started=True
                elif ch=='}': depth-=1
            body.append(lines[k])
            if started and depth==0: break
            k+=1
        res.append((m.group(1), '\n'.join(body), idx+1, '#[test]' in clean.split('\n')[idx] or any('#[test]' in x for x in clean.split('\n')[max(0,idx-3):idx])))
    return res

out=[]
for p in sorted(pathlib.Path('tests').glob('*.rs')):
    clean=strip_comments_strings(p.read_text())
    bs=blocks(clean)
    asserting={n for n,b,_,_ in bs if re.search(r'\b(assert|panic!|unreachable)[\s!(]', b)}
    for n,b,ln,is_test in bs:
        if not is_test: continue
        if re.search(r'\b(assert|panic!)[\s!(]', b): continue
        calls=set(re.findall(r'\b([a-z_][a-z0-9_]*)\s*\(', b))
        helpers={c for c in calls if c in asserting and c not in ('if','for','while','match','fn','vec','format','unwrap_or_else','expect_err','map')}
        if not helpers:
            out.append((str(p), ln, n, sorted(helpers)))
print(len(out))
for f,ln,n,h in out: print(f"{f}:{ln} {n}")
