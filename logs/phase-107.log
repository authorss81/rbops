    /// The decimal with the opposite sign.
    pub fn negated(self) -> Result<Decimal, String> {
        Ok(Decimal {
            mantissa: self
                .mantissa
                .checked_neg()
                .ok_or_else(|| "the decimal is too large to negate".to_string())?,
