    decimal_text("decimal.from_text(\"1\") / decimal.from_text(\"2\")", "0.5");
    let message = runtime_message("decimal.from_text(\"1\") / decimal.from_text(\"0\")");
    assert_eq!(message, "Division by zero");
}

