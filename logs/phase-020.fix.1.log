use redblue::bytecode::compile_source;
use redblue::bytecode::vm::BytecodeVm;

fn bc(source: &str) -> String {
    let chunk = match compile_source(source) { Ok(c) => c, Err(e) => return format!("ERR {}", e.message()) };
    let mut vm = BytecodeVm::new();
    let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
        let r = vm.run(&chunk); let out = vm.take_output(); format!("result={r:?} output={out:?}") }));
    match r { Ok(s) => s, Err(_) => "PANIC".to_string() }
}
fn tw(source: &str) -> String {
    let tokens = match redblue::lexer::Lexer::tokenize(source) { Ok(t) => t, Err(e) => return format!("ERR {}", e.message()) };
    let ast = match redblue::parser::parse(tokens) { Ok(a) => a, Err(e) => return format!("ERR {}", e.message()) };
