+                expected.label
+            )
+        });
+        let name = path.display();
+        assert!(
+            span.line >= 1 && span.line <= source.lines().count(),
+            "{name}: the failure reports line {} of a {}-line program",
+            span.line,
+            source.lines().count()
+        );
+        let line = source.lines().nth(span.line - 1).unwrap_or_default();
+        assert!(
+            span.column >= 1 && span.column <= line.chars().count() + 1,
+            "{name}: the failure reports column {} of a {}-character line: {line:?}",
+            span.column,
+            line.chars().count()
+        );
+    }
+    assert!(
+        checked >= 20,
+        "only {checked} corpus programs record a failure, so nothing here checked a position"
+    );
+}
