+/// Where the tree-walking VM said the failure happened, when it said one.
+///
+/// [`Outcome`] compares a failure by label and message and leaves the position
+/// out on purpose: a `.rbc` carries no source text, so the bytecode VM has
+/// nothing to render a column from and the two cannot be compared on it. That
+/// makes the position invisible to both halves of the differential runner, so it
+/// is available here to be asserted on its own — an error reported at a line
+/// that is not in the program is a wrong answer even when the message matches.
+pub fn tree_walk_span(source: &str) -> Option<Span> {
+    let tokens = match redblue::lexer::Lexer::tokenize(source) {
+        Ok(tokens) => tokens,
+        Err(error) => return error.span().copied(),
+    };
+    let ast = match redblue::parser::parse(tokens) {
+        Ok(ast) => ast,
+        Err(error) => return error.span().copied(),
+    };
+    if let Err(error) = redblue::analyzer::analyze(&ast) {
+        return error.span().copied();
+    }
+    let (_vm, result) = run_isolated(&ast);
+    result.err().and_then(|error| error.span().copied())
+}
