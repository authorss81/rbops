use redblue::bytecode::compile_source;
use redblue::bytecode::vm::BytecodeVm;

#[test]
fn scratch_nested_object() {
    let source = "object Outer\nhas a default 1\n\nobject Inner\nhas b default 2\nend\n\nto describe\ngive back \"outer\"\nend\nend\n\nsay Outer.a\n";
    let chunk = match compile_source(source) {
        Ok(c) => c,
        Err(e) => panic!("compile failed: {e}"),
    };
    let mut vm = BytecodeVm::new();
    let r = vm.run(&chunk);
    println!("result = {r:?}");
    println!("output = {:?}", vm.take_output());
}
EOF
