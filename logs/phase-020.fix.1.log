+    /// Reading a program's value must not cost a second run of it.
+    ///
+    /// The value used to be recovered by re-lexing, re-parsing and re-executing
+    /// the program, because the first run handed back only its failure. A pure
+    /// program cannot tell the difference — which is why the bug survived a
+    /// corpus of 315 of them — but a program with a side effect is run twice,
+    /// and the second run is a different run.
+    #[test]
+    fn edge_one_run_of_a_program_is_all_the_harness_asks_for() {
+        let path = temp_file("one-run.txt");
+        let literal = text_literal(&path.to_string_lossy());
+        let source = format!(
+            "files.write({literal}, \"a\")\nfiles.append({literal}, \"b\")\n"
+        );
+        let outcome = tree_walk(&source);
+        assert_eq!(
+            outcome.result,
+            Ok("nothing".to_string()),
+            "the program ran to completion: {outcome:?}"
+        );
+        assert_eq!(
+            std::fs::read_to_string(&path).unwrap_or_else(|e| {
+                panic!("{} should have been written: {e}", path.display())
+            }),
+            "ab",
+            "the program appended once, so the harness ran it once; two runs \
+             would have written `abab`"
+        );
+        let _ = std::fs::remove_file(&path);
+    }
+
+    /// The failure a run reported is the failure *that* run reported.
+    ///
+    /// The other half of the same defect: `tree_walk_failure` used to come from
+    /// a separate call, so a program whose second run faulted differently from
+    /// its first would have had its position read off the wrong run.
+    #[test]
+    fn edge_a_failure_is_read_off_the_run_that_produced_it() {
+        let source = "say 1\nsay xs[9]\n";
+        let (output, result) = tree_walk_verbose(source);
+        assert_eq!(output, vec!["1".to_string()]);
+        let error = result.expect_err("the program should have faulted");
+        assert_eq!(error.label(), "RuntimeError");
+        assert_eq!(error.span().line, 2, "the second line is what faulted");
+    }
+
+    /// A nested `object` is a program, not an internal inconsistency.
+    ///
+    /// `object Inner` written inside `Outer`'s own body is accepted by the
+    /// analyzer and runs on the tree-walking VM: the type is registered first,
+    /// and the rest of the body — the nested declaration among it — runs in the
+    /// enclosing scope afterwards, which is the only reason `extends Outer` has
+    /// a parent to find. The bytecode VM kept a single pending declaration, so
+    /// the inner body took it and the outer body panicked reaching for it.
+    #[test]
+    fn edge_a_nested_object_runs_on_both_vms_and_neither_panics() {
+        for source in [
+            // A nested declaration of its own: the outer type is complete
+            // before the inner one starts.
+            "object Outer\nhas a default 1\n\nobject Inner\nhas b default 2\nend\nend\n\nsay Outer.a\n",
+            // A nested declaration that extends the one it is written inside,
+            // which only resolves if the outer type is registered first.
+            "object Outer\nhas a default 1\n\nobject Inner extends Outer\nhas b default 2\nend\nend\n\nsay Outer.a\n",
+            // Three deep, and the two middle types are unnameable afterwards —
+            // the analyzer does not carry them out of the body — so what is
+            // being pinned is that running the program panics nothing.
+            "object A\nhas a default 1\nobject B\nhas b default 2\nobject C\nhas c default 3\nend\nend\nend\nsay A.a\n",
+            // The rest of a body runs in the enclosing scope, so a variable it
+            // binds outlives the declaration that carried it.
+            "object A\nhas v default 1\nset carried to 41\nend\nsay carried + 1\n",
+            // ...and it runs after the type is bound, not before.
+            "object A\nhas v default 1\nsay A.v\nend\n",
+            // A bare `to` in an object body is a method of the type, not a
+            // function of the enclosing scope.
+            "object A\nhas v default 1\nto can get()\ngive back this.v * 2\nend\nend\nsay A.get()\n",
+        ] {
+            let tree = tree_walk(source);
+            let byte = bytecode(source);
+            assert_eq!(
+                tree, byte,
+                "{source:?}: the two VMs disagree about an object body"
+            );
+        }
+    }
+
+    /// A declaration's remaining body statements are worth nothing.
+    ///
+    /// The tail is compiled into the enclosing block now, where a trailing
+    /// expression *is* the block's value when the block is a function's — and
+    /// an `object` statement is a statement, so `declare_object` answers
+    /// `nothing` on the tree-walking VM whatever ran in the body.
+    #[test]
+    fn edge_an_object_declaration_is_worth_nothing_even_when_its_body_ends_in_a_value() {
+        let source = "to outer()\nobject A\nhas v default 1\n1 + 1\nend\ngive back 7\nend\nsay outer()\n";
+        let tree = tree_walk(source);
+        let byte = bytecode(source);
+        assert_eq!(tree, byte, "{tree:?} vs {byte:?}");
+        assert_eq!(tree.result, Ok("7".to_string()));
+        assert_eq!(tree.output, vec!["7".to_string()]);
+    }
 }

