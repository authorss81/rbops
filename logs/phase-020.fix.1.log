use redblue::bytecode::compile_source;
use redblue::bytecode::vm::BytecodeVm;

fn bc(source: &str) -> String {
    let chunk = match compile_source(source) {
        Ok(c) => c,
        Err(e) => return format!("COMPILE ERR: {e}"),
    };
    let mut vm = BytecodeVm::new();
    let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
        let r = vm.run(&chunk);
        let out = vm.take_output();
        format!("result={r:?} output={out:?}")
    }));
    match r {
        Ok(s) => s,
        Err(_) => "PANIC".to_string(),
    }
}

fn tw(source: &str) -> String {
    match redblue::run_source_value(source) {
        Ok(_) => {
            let t = redblue::lexer::Lexer::tokenize(source);
            match t {
                Ok(t) => {
                    let ast = match redblue::parser::parse(t) { Ok(a) => a, Err(e) => return format!("PARSE ERR {e}") };
                    let (mut vm, r) = redblue::run_isolated(&ast);
                    format!("result={r:?} output={:?}", vm.take_output())
                }
                Err(e) => format!("LEX ERR {e}"),
            }
        }
        Err(e) => format!("ERR {e}"),
    }
}

#[test]
fn scratch_obj() {
    let cases: Vec<(&str, &str)> = vec![
        ("nested plain", "object Outer\nhas a default 1\n\nobject Inner\nhas b default 2\nend\nend\n\nsay Outer.a\nsay Inner.b\n"),
        ("nested extends outer", "object Outer\nhas a default 1\n\nobject Inner extends Outer\nhas b default 2\nend\nend\n\nsay Inner.b\nsay Inner.a\n"),
        ("set inside object body", "object Outer\nhas a default 1\nset tmp to 5\nend\nsay tmp\n"),
        ("say inside object body", "object Outer\nhas a default 1\nsay \"inside\"\nend\nsay \"after\"\n"),
        ("rest before has", "object Outer\nsay \"before\"\nhas a default 1\nend\nsay Outer.a\n"),
    ];
    for (name, src) in cases {
        println!("--- {name}\n  tree: {}\n  bc:   {}", tw(src), bc(src));
    }
}
EOF
