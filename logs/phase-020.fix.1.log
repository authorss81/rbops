 #[test]
+fn edge_a_changed_return_value_is_a_runner_failure() {
+    // A return value is part of what a program *does*. The two VMs can print the
+    // same lines and still disagree about what the program was worth — `say 1 2
+    // 3` is `Ok("3")` on one and `Ok("nothing")` on the other
+    // (phases/phase-020/FINDINGS.md §4) — so the value is recorded rather than
+    // dropped, and the same lines with a different value must fail.
+    let path = Path::new("corpus/edge_return_value.rb");
+    let outcome = tree_walk("set total to 2\nsay total\nset total to total + 1\n");
+    assert_eq!(outcome.output, vec!["2".to_string()]);
+    assert_eq!(outcome.result.as_deref(), Ok("3"));
+
+    let recorded = parse_expected(&format_expected(&outcome));
+    assert_eq!(recorded.label, "none");
+    assert_eq!(
+        recorded.value.as_deref(),
+        Some("3"),
+        "a program ending in a `set` ends with the value it bound, and that is what \
+         the file has to record"
+    );
+    assert_outcome_matches(path, &outcome, &recorded);
+
+    let changed = Outcome {
+        output: outcome.output.clone(),
+        result: Ok("nothing".to_string()),
+    };
+    let diverged = std::panic::catch_unwind(|| assert_outcome_matches(path, &changed, &recorded));
+    assert!(
+        diverged.is_err(),
+        "the same lines printed with a different value is a different outcome, and \
+         the runner has to say so"
+    );
+}
