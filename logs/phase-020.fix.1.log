+/// The statements a block is compiled from.
+///
+/// Every kind but one is a slice of the body it was given. An `object` body is
+/// two lists, because the body has two halves: the `has` and `to can` that
+/// declare the type, and everything else — an ordinary statement that runs in
+/// the *enclosing* scope, in order, and after the type is registered and bound.
+/// The tree-walking VM's rule (`declare_object` in `src/vm.rs`) and this one
+/// have to agree, because the two VMs run the same program and a divergence
+/// here is a divergence in what the program *is*:
+///
+/// - one block for the whole body would run the second half *before* the type
+///   existed, so an `object Inner extends Outer` nested in `Outer`'s own body
+///   would find no `Outer` to extend;
+/// - and a nested `object` would execute inside the block that assembles the
+///   enclosing declaration, overwriting it — the enclosing body would then have
+///   nothing left to register.
+#[derive(Clone, Copy)]
+enum Declared<'a> {
+    /// The whole body, as written.
+    Every(&'a [Stmt]),
+    /// Only the statements that declare a type: an object body's `has` and
+    /// `to can`, and nothing else.
+    These(&'a [&'a Stmt]),
+}
+
