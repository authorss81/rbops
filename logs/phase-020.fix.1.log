+#[test]
+fn edge_a_changed_return_value_is_a_runner_failure() {
+    // A return value is part of what a program *does*, and it is the half of the
+    // outcome a golden file used to drop: the two VMs can print the same lines
+    // and still disagree about what the program was worth — `set t to 5 / say t
+    // / t` is `Ok("5")` on one and `Ok("nothing")` on the other
+    // (phases/phase-020/FINDINGS.md §4) — so the value is recorded, and the
+    // same lines with a different value must fail.
+    let path = Path::new("corpus/edge_return_value.rb");
+
+    let recorded_outcome = tree_walk("set total to 5\nsay total\nset total to total + 1\n");
+    assert_eq!(
+        recorded_outcome.result,
+        Ok("nothing".to_string()),
+        "a program ending in `set` has no value to end with"
+    );
+    let recorded = parse_expected(&format_expected(&recorded_outcome));
+    assert_eq!(recorded.label, "none");
+    assert_eq!(recorded.value.as_deref(), Some("nothing"));
+    assert_outcome_matches(path, &recorded_outcome, &recorded);
+
+    // The same lines printed, a different value: the comparison has to say so.
+    let valued = tree_walk("set t to 5\nsay t\nt\n");
+    assert_eq!(
+        valued.output, recorded_outcome.output,
+        "the two programs print the same line, so only the value can tell them apart"
+    );
+    let diverged = std::panic::catch_unwind(|| assert_outcome_matches(path, &valued, &recorded));
+    assert!(
+        diverged.is_err(),
+        "a recorded value that no longer comes out is a changed outcome, and the \
+         runner has to report it"
+    );
+
+    // Recorded as what it is, the same outcome passes.
+    let revalued = parse_expected(&format_expected(&valued));
+    assert_eq!(
+        revalued.value.as_deref(),
+        Some("5"),
+        "a program ending in an expression ends with the value of that expression"
+    );
+    assert_outcome_matches(path, &valued, &revalued);
+}
+
+#[test]
+fn edge_a_printed_line_that_looks_like_a_directive_round_trips() {
+    // `#` starts every directive in the file format, so a program that printed
+    // one would be read back as a program recording a message or a value —
+    // describing a different program, silently.
+    let outcome = Outcome {
+        output: vec![
+            "#message not a directive".to_string(),
+            "#value 3".to_string(),
+            "#label RuntimeError".to_string(),
+        ],
+        result: Ok("7".to_string()),
+    };
+    let rendered = format_expected(&outcome);
+    assert_eq!(
+        rendered.lines().count(),
+        5,
+        "a header of two lines plus three printed lines, no more: {rendered}"
+    );
+    assert!(
+        rendered.lines().skip(2).all(|line| !line.starts_with('#')),
+        "no printed line may begin the character a directive begins with: {rendered}"
+    );
+
+    let parsed = parse_expected(&rendered);
+    assert_eq!(parsed.label, "none");
+    assert_eq!(
+        parsed.value.as_deref(),
+        Some("7"),
+        "a printed `#value 3` must not be mistaken for the value the program ended with"
+    );
+    assert_eq!(
+        parsed.output, outcome.output,
+        "printed lines that look like directives must survive the round trip"
+    );
+    let path = Path::new("corpus/edge_directive_looking_output.rb");
+    assert_outcome_matches(path, &outcome, &parsed);
+}
+
+#[test]
+fn edge_a_program_that_prints_before_it_faults_is_recorded_not_asserted_away() {
+    // "A program that fails prints nothing" is false: a `say` before an uncaught
+    // fault has already printed, which is what `try ... catch` is for. The lines
+    // before the failure are recorded and compared like any other output.
+    let outcome = tree_walk("say \"before\"\nsay [1, 2][9]\n");
+    let parsed = parse_expected(&format_expected(&outcome));
+    assert_eq!(parsed.label, "RuntimeError");
+    assert_eq!(
+        parsed.output,
+        vec!["before".to_string()],
+        "what a program printed before it faulted is part of what it did"
+    );
+    let path = Path::new("corpus/edge_prints_then_faults.rb");
+    assert_outcome_matches(path, &outcome, &parsed);
+
+    // What may not happen is a *frontend* failure printing: nothing ran.
+    let unlexed = tree_walk("say 1\nsay \"unterminated\n");
+    assert_eq!(unlexed.output, Vec::<String>::new());
+    let recorded = parse_expected(&format_expected(&unlexed));
+    assert_eq!(recorded.label, "LexerError");
+    assert_outcome_matches(path, &unlexed, &recorded);
+}
+
+#[test]
+fn edge_every_recorded_failure_points_at_a_line_of_its_own_program() {
+    // `Outcome` compares a failure by label and message and leaves the position
+    // out, because a `.rbc` carries no source text for the bytecode VM to
+    // render a column from. That makes the position unchecked by both halves of
+    // this runner, so it is asserted here: a failure pointing at a line the
+    // program does not have is a wrong answer even when the message matches.
+    let mut checked = 0usize;
+    for (path, source, expected) in loaded_corpus() {
+        if expected.label == "none" {
+            continue;
+        }
+        checked += 1;
+        let span = tree_walk_span(&source).unwrap_or_else(|| {
+            panic!(
+                "{} records {} but the failure carries no source position",
+                path.display(),
+                expected.label
+            )
+        });
+        let name = path.display();
+        let lines = source.lines().count();
+        // A failure found at the end of the source points one line past the last
+        // one — an unterminated block is reported where the `end` would have
+        // been, which is the position after the final newline. Anywhere else,
+        // the position has to be a real line with a real column.
+        let at_end = span.line == lines + 1 && source.ends_with('\n') && span.column == 1;
+        assert!(
+            at_end || (span.line >= 1 && span.line <= lines),
+            "{name}: the failure reports line {} of a {lines}-line program",
+            span.line
+        );
+        assert!(
+            span.column >= 1,
+            "{name}: the failure reports column {}, and columns are 1-based",
+            span.column
+        );
+        if !at_end {
+            let line = source.lines().nth(span.line - 1).unwrap_or_default();
+            assert!(
+                span.column <= line.chars().count() + 1,
+                "{name}: the failure reports column {} of a {}-character line: {line:?}",
+                span.column,
+                line.chars().count()
+            );
+        }
+    }
+    assert!(
+        checked >= 20,
+        "only {checked} corpus programs record a failure, so nothing here checked a position"
+    );
+}
