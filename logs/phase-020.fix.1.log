use redblue::bytecode::compile_source;
use redblue::bytecode::vm::BytecodeVm;

fn bc(source: &str) -> String {
    let chunk = match compile_source(source) {
        Ok(c) => c,
        Err(e) => return format!("COMPILE ERR: {}", e.message()),
    };
    let mut vm = BytecodeVm::new();
    let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
        let r = vm.run(&chunk);
        let out = vm.take_output();
        format!("result={r:?} output={out:?}")
    }));
    match r { Ok(s) => s, Err(_) => "PANIC".to_string() }
}

fn tw(source: &str) -> String {
    let tokens = match redblue::lexer::Lexer::tokenize(source) { Ok(t) => t, Err(e) => return format!("LEX ERR {}", e.message()) };
    let ast = match redblue::parser::parse(tokens) { Ok(a) => a, Err(e) => return format!("PARSE ERR {}", e.message()) };
    if let Err(e) = redblue::analyzer::analyze(&ast) { return format!("ANALYZE ERR {}", e.message()); }
    let (mut vm, r) = redblue::run_isolated(&ast);
    format!("result={r:?} output={:?}", vm.take_output())
}

#[test]
fn scratch_obj() {
    let cases: Vec<(&str, &str)> = vec![
        ("nested plain", "object Outer\nhas a default 1\n\nobject Inner\nhas b default 2\nend\nend\n\nsay Outer.a\n"),
        ("nested extends outer", "object Base\nhas kind default \"base\"\n\nobject Child extends Base\nhas extra default 1\nend\nend\n\nset Base.kind to \"changed\"\nsay Base.kind\n"),
        ("nested extends missing", "object Outer\nhas a default 1\n\nobject Inner extends Nope\nhas b default 2\nend\nend\n\nsay Outer.a\n"),
        ("nested twice", "object Outer\nobject Inner\nhas b default 1\nend\nobject Inner\nhas b default 2\nend\nend\nsay Outer.a\n"),
        ("say inside object body", "object A\nhas v default 1\nsay \"inside\"\nend\nsay A.v\n"),
        ("set inside object body", "object A\nhas v default 1\nset tmp to 5\nend\nsay tmp\nsay A.v\n"),
        ("rest before has", "object A\nsay \"before\"\nhas v default 1\nend\nsay A.v\n"),
        ("tail expr discarded", "to outer()\nobject A\nhas v default 1\n1 + 1\nend\ngive back 7\nend\nsay outer()\n"),
        ("tail is last stmt of fn", "to outer()\nobject A\nhas v default 1\nend\ngive back 7\nend\nsay outer()\n"),
        ("plain object", "object A\nhas v default 1\nto can get()\ngive back this.v\nend\nend\nset A.v to 9\nsay A.get()\n"),
        ("three deep nest", "object A\nhas a default 1\nobject B\nhas b default 2\nobject C\nhas c default 3\nend\nend\nend\nsay A.a\n"),
        ("object in try", "try\nobject A\nhas v default 1\nsay \"in try\"\nend\nend\nsay A.v\n"),
        ("object in test body", "test \"t\"\nobject A\nhas v default 1\nend\nsay A.v\nend\n"),
        ("has outside object", "has v default 1\nsay v\n"),
        ("import in body", "object A\nhas v default 1\nimport MathUtils\nend\nsay A.v\nsay MathUtils.square(4)\n"),
    ];
    for (name, src) in cases {
        let (t, b) = (tw(src), bc(src));
        println!("--- {name} {}\n  tree: {t}\n  bc:   {b}", if t == b { "[AGREE]" } else { "[*** DIFFER ***]" });
    }
}
