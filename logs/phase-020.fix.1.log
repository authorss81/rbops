///
/// Sorted by file name, so a failure names the same program first on every
/// machine. The count is over `.rb` files and is unconditional: a corpus that
/// shrank must fail the size check whether or not anything asked to write.
///
/// An entry that cannot be read is a failure naming the directory, not a
/// program that quietly does not exist. `DirEntry::ok()` would swallow one, and
/// a corpus entry the harness cannot see is a hole in the coverage rather than
/// a smaller corpus — which is the one thing a coverage assertion must not be
/// able to mistake.
pub fn corpus() -> Vec<PathBuf> {
    let dir = corpus_dir();
    let mut files: Vec<PathBuf> = match fs::read_dir(&dir) {
        Ok(entries) => entries
            .map(|entry| {
                entry
                    .unwrap_or_else(|error| {
                        panic!(
                            "corpus directory {} should be readable: {error}",
                            dir.display()
                        )
                    })
                    .path()
            })
            .filter(|path| path.extension().and_then(|e| e.to_str()) == Some("rb"))
            .collect(),
        Err(error) => panic!(
            "corpus directory {} should be readable: {error}",
            dir.display()
        ),
    };
