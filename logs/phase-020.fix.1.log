 #[test]
+fn edge_the_generator_emits_every_statement_form_it_lists() {
+    // A generator with an unreachable arm still generates — it just generates
+    // less, and every property above goes on passing over the smaller set. The
+    // loop arm is the one that can go missing this way: it is the only arm that
+    // recurses, so a depth guard written as an early arm shadows it and no
+    // program contains a loop at all. Counted over the statement region rather
+    // than the whole program, so a form cannot be satisfied by the bindings
+    // every generated program already starts with.
+    const FORMS: &[(&str, &str)] = &[
+        ("bind a number", "\nset n to "),
+        ("bind text", "\nset t to "),
+        ("test a yes/no", "\nsay (b is yes)\n"),
+        ("call a builtin", "\nsay length(t)\n"),
+        ("say a pair", "\nsay t\nsay "),
+        ("a conditional", "\nif b is yes\n"),
+        ("a loop", "\nrepeat "),
+    ];
+
+    let mut seen: BTreeMap<&str, usize> = BTreeMap::new();
+    for seed in SEEDS {
+        for source in generated(*seed) {
+            // The header is eight lines; the region after it is what
+            // `random_statement` and `random_fault` wrote, framed by newlines so
+            // that a marker can name a whole line rather than a substring.
+            let region = format!("\n{}\n", statements_of(&source));
+            for (form, marker) in FORMS {
+                if region.contains(marker) {
+                    *seen.entry(form).or_default() += 1;
+                }
+            }
+        }
+    }
+
+    for (form, _) in FORMS {
+        assert!(
+            seen.get(form).copied().unwrap_or_default() > 0,
+            "the generator emitted no program containing {form:?}; an arm of \
+             `random_statement` is unreachable, so the properties above are \
+             asserting over a smaller language than they claim to. Saw {seen:?}"
+        );
+    }
+}
+
+/// The statements of a generated program: everything `random_program` wrote
+/// after the eight header lines, without the trailing newline.
+fn statements_of(source: &str) -> String {
+    source.lines().skip(8).collect::<Vec<_>>().join("\n")
+}
