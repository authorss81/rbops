// ---------------------------------------------------------------------------
// A conflict inside a body is the same conflict, and stops the walk there
// ---------------------------------------------------------------------------

/// The shapes an `import` can be written in below the top level. Every one of
/// them holds a body the walk enters, and a body the walk entered and then kept
/// walking after the conflict was recorded is how one unanswerable import
/// became a page of consequences again — a function, an `if`, a loop, a `try` and
/// a declared `module` are all of it.
const BODIES: &[(&str, &str)] = &[
    (
        "function",
        "function read_it\n    import Fixture\n    say VALUE\nend\nread_it\n",
    ),
    ("if", "if yes then\n    import Fixture\n    say VALUE\nend\n"),
    ("unless", "unless no then\n    import Fixture\n    say VALUE\nend\n"),
    ("for each", "for each n in [1] do\n    import Fixture\n    say VALUE\nend\n"),
    ("repeat", "repeat 1 times\n    import Fixture\n    say VALUE\nend\n"),
    (
        "repeat until",
        "repeat\n    import Fixture\n    say VALUE\nuntil yes\n",
    ),
    ("while", "while no do\n    import Fixture\n    say VALUE\nend\n"),
    (
        "object",
        "has name\nobject Reporter\n    has name\n    method report\n        import Fixture\n        say VALUE\n    end\nend\n",
    ),
    ("try", "try\n    import Fixture\n    say VALUE\ncatch err\n    say VALUE\nend\n"),
    ("module", "module Report\n    import Fixture\n    say VALUE\nend\n"),
    ("test", "test \"a body\"\n    import Fixture\n    say VALUE\nend\n"),
];

/// An `import` inside a body is an import: when the manifest cannot be resolved,
/// the failure the user is shown is the conflict, not the names that went
/// missing because of it.
///
/// The stop was written for the top-level loop only, so every shape below it kept
/// walking after the conflict was recorded and each read of a name the failed
/// import would have bound answered "unknown variable" — which is a message
/// about a variable, pointing at a variable, for a program whose real problem
/// is in its manifest.
#[test]
fn edge_an_import_in_a_body_reports_the_conflict_not_its_consequences() {
    let root = scratch("manifest_body_conflict");
    publish(&root, "Fixture", "1.0.0", "set VALUE to 1\n");
    manifest_file(
        &root,
        "name report\nversion 1.0.0\ndependency Ghost =1.0.0\n",
    );

    for (shape, source) in BODIES {
        let error = redblue::analyzer::analyze_in(&program(source), &root)
            .unwrap_or_else(|_| panic!("a {shape} body should analyze"));
        // The shape above is the *healthy* program: it must analyze cleanly, so
        // that the failure asserted below is the broken manifest's doing rather
        // than the body's shape.
        assert!(error.is_ok(), "a {shape} body should analyze");
    }
}

/// The same shapes against the manifest that cannot be resolved: every one of
/// them has to stop at the conflict.
#[test]
fn edge_an_unresolvable_pin_inside_a_body_is_the_conflict() {
    let root = scratch("manifest_body_unresolvable");
    manifest_file(
        &root,
        "name report\nversion 1.0.0\ndependency Ghost =1.0.0\n",
    );

    for (shape, source) in BODIES {
        let error = redblue::analyzer::analyze_in(&program(source), &root)
            .expect_err(&format!(
                "an import inside a {shape} body is an import, and a pin nothing publishes \
                 is still a failure"
            ));
        assert!(
            error.message().contains("Ghost"),
            "a {shape} body has to name the conflict it found, got: {}",
            error.message()
        );
        assert!(
            !error.message().contains("Unknown variable"),
            "a {shape} body has to report the conflict rather than the names that went \
             missing because of it, got: {}",
            error.message()
        );
    }
}

/// The conflict is reported once. A body that kept walking after it recorded the
/// conflict produced one error per unread name in the body, which is the "page of
/// consequences" the whole mechanism exists to avoid.
#[test]
fn edge_a_conflict_in_a_body_is_reported_once() {
    let root = scratch("manifest_body_once");
    manifest_file(&root, "dependency Ghost =1.0.0\n");

    let error = redblue::analyzer::analyze_in(
        &program(
            "function read_it\n    import Fixture\n    say VALUE\n    say OTHER\n    say THIRD\nend\nread_it\n",
        ),
        &root,
    )
    .expect_err("the conflict is still a failure");

    assert_eq!(
        error.message().lines().count(),
        1,
        "one conflict is one error, not one error per unread name: {}",
        error.message()
    );
}

// ---------------------------------------------------------------------------
// Depth is how deep the chain goes, not how wide the module is
// ---------------------------------------------------------------------------

/// A chain one pin wide and deeper than the limit is refused, even though it is
/// only a handful of steps wide.
///
/// `MAX_RESOLUTION_DEPTH` is documented as "how deep one module's chain of
/// dependencies may go". It was enforced as how many pins one module's manifest
/// held, so a hundred-long chain passed and a module with seventy pins was
/// refused — the two opposite of what the sentence says.
#[test]
fn edge_a_chain_deeper_than_the_limit_is_refused() {
    let message = resolve_err(&format!("dependency Link0 =1.0.0\n"), &chain(70));
    assert!(
        message.contains("70 steps from this program"),
        "the refusal has to say how deep the chain was, got: {message}"
    );
    assert!(
        message.contains("64"),
        "the refusal has to name the limit it hit, got: {message}"
    );
}

/// The same chain, one link shorter, resolves: the limit is the boundary and
/// both sides of it have to hold.
#[test]
fn edge_a_chain_exactly_at_the_depth_limit_resolves() {
    let resolved = resolve(&format!("dependency Link0 =1.0.0\n"), &chain(64));
    assert_eq!(
        resolved.modules().count(),
        64,
        "every link of the chain is resolved, not just the first"
    );
    assert_eq!(
        version_of(&resolved, "Link63"),
        "1.0.0",
        "the deepest link in the chain is the one the limit is about"
    );
}

/// A module with more pins than the depth limit is *wide*, not deep, and a wide
/// manifest is one somebody wrote on purpose. It is answered by the step budget
/// rather than refused for being deep.
#[test]
fn edge_a_module_with_more_pins_than_the_depth_limit_resolves() {
    let mut registry = Memory::default().publish("Wide", "1.0.0");
    let mut text = String::from("name Wide\nversion 1.0.0\n");
    for index in 0..100 {
        text.push_str(&format!("dependency Leaf{index} =1.0.0\n"));
        registry = registry.publish(&format!("Leaf{index}"), "1.0.0");
    }
    registry = registry.with_manifest("Wide", "1.0.0", &text);

    let resolved = resolve("dependency Wide =1.0.0\n", &registry);

    assert_eq!(
        resolved.modules().count(),
        101,
        "a hundred pins one module holds is width, and width is the step budget's question"
    );
}

// ---------------------------------------------------------------------------
// Both engines resolve an import against the same root
// ---------------------------------------------------------------------------

/// The two programs of the finding, loaded through the bytecode VM from their
/// own directory: each imports the version *its* manifest pins, not the version
/// the other one does and not whichever version the working directory holds.
///
/// The VM resolved its imports against the working directory while the analyzer
/// resolved the same program's against the root it was handed, so the two
/// engines disagreed about every program not run from its own directory — and
/// nothing exercised that against a scratch root, which is why it survived.
#[test]
fn two_programs_load_their_pinned_version_on_the_bytecode_vm() {
    let one = scratch("manifest_bytecode_v1");
    let two = scratch("manifest_bytecode_v2");
    manifest_file(&one, "name old\nversion 0.1.0\ndependency Fixture =1.0.0\n");
    manifest_file(&two, "name new\nversion 0.1.0\ndependency Fixture =2.0.0\n");
    for root in [&one, &two] {
        publish(root, "Fixture", "1.0.0", "say \"one\"\n");
        publish(root, "Fixture", "2.0.0", "say \"two\"\n");
    }

    assert_eq!(
        run_on_bytecode_vm(&one, "import Fixture\n"),
        vec!["one".to_string()],
        "the first program's pin decides what its import loads"
    );
    assert_eq!(
        run_on_bytecode_vm(&two, "import Fixture\n"),
        vec!["two".to_string()],
        "the second program's pin decides what its import loads, not the first's"
    );
    // Back to the first, in the same process: nothing about the second run is
    // allowed to have stuck to it.
    assert_eq!(
        run_on_bytecode_vm(&one, "import Fixture\n"),
        vec!["one".to_string()],
        "a program run again after another one is answered from its own manifest"
    );
}

/// A manifest whose pins cannot be resolved is refused by the loader too, under
/// the root it was given — the same failure, the same message, whichever engine
/// runs it first.
#[test]
fn edge_the_bytecode_vm_refuses_an_unresolvable_pin_from_its_own_root() {
    let root = scratch("manifest_bytecode_refusal");
    manifest_file(&root, "name report\nversion 1.0.0\ndependency Ghost =1.0.0\n");

    let chunk = redblue::bytecode::compile_source("import Fixture\n")
        .expect("a bare import compiles");
    let mut vm = redblue::bytecode::vm::BytecodeVm::new_in(&root);
    let error = vm.run(&chunk).expect_err("the pin cannot be resolved");

    assert_eq!(error.label(), "RuntimeError");
    assert!(
        error.message().contains("Ghost") && !error.message().contains("Cannot find module"),
        "a pin nothing publishes is a manifest failure, not a missing file, got: {}",
        error.message()
    );
}

// ---------------------------------------------------------------------------
// A static pass reads; it does not resolve
// ---------------------------------------------------------------------------

/// Analyzing a program whose manifest resolves writes nothing. The analysis
/// resolves the pins to know which version each import binds names from, and
/// every resolve went through the writing path — so `rb lint`, `rb format` and
/// `analyze_in` left a `redblue.lock` beside a program they were only reading.
#[test]
fn edge_analysing_a_program_writes_no_lockfile() {
    let root = scratch("manifest_analysis_writes_nothing");
    manifest_file(&root, "name report\nversion 1.0.0\ndependency Fixture =1.0.0\n");
    publish(&root, "Fixture", "1.0.0", "set VALUE to 1\n");
    publish(&root, "Fixture", "2.0.0", "set VALUE to 2\n");

    redblue::analyzer::analyze_in(&program("import Fixture\nsay VALUE\n"), &root)
        .expect("the manifest resolves, so the program analyzes");
    assert!(
        !root.join(manifest::LOCKFILE).exists(),
        "a static pass answers its question by reading; it does not write a lockfile"
    );

    // The writing path is still the one that writes, so this is a pass that
    // stopped writing rather than a pass that stopped resolving.
    manifest::resolve_in(&root).expect("the resolving path still resolves");
    assert!(
        root.join(manifest::LOCKFILE).exists(),
        "resolving is what writes the lockfile"
    );
}

/// A failure the analyzer reports is one failure, not a failure carrying the
/// label of the error it came from.
///
/// The manifest's error was rendered with `Error::to_string` — `RuntimeError:
/// Cannot resolve …` — and stored in an `Analyzer` error, so the user read
/// `AnalyzerError: RuntimeError: Cannot resolve dependency 'Ghost' …` for one
/// conflict. The message is the manifest's own; the label belongs to whichever
/// error is reporting it, and there is only one.
#[test]
fn edge_a_manifest_failure_is_reported_once_without_a_second_label() {
    let root = scratch("manifest_one_label");
    manifest_file(&root, "name report\nversion 1.0.0\ndependency Ghost =1.0.0\n");

    let error = redblue::analyzer::analyze_in(&program("import Fixture\nsay VALUE\n"), &root)
        .expect_err("the pin cannot be resolved");

    assert_eq!(
        error.label(),
        "AnalyzerError",
        "the analyzer reports this, so it is an analyzer failure"
    );
    assert!(
        !error.message().contains("RuntimeError"),
        "the label of the error the message came from must not be printed inside it, got: {}",
        error.message()
    );
    assert!(
        error.message().starts_with("Cannot resolve dependency 'Ghost'"),
        "the message is the manifest's own, unprefixed, got: {}",
        error.message()
    );
    let span = error
        .span()
        .expect("a failure found at an import is reported at that import");
    assert_eq!(span.line, 1, "the caret points at the import that found it");
}

/// A manifest whose *syntax* is wrong is reported against the line it is wrong
/// on, in the message, with no second label either — and the caret stays on the
/// program, because that is the text a caller renders.
#[test]
fn edge_a_malformed_manifest_keeps_its_line_and_the_import_keeps_the_caret() {
    let root = scratch("manifest_malformed_line");
    manifest_file(&root, "name report\nnmae other\n");

    let error = redblue::analyzer::analyze_in(&program("import Fixture\n"), &root)
        .expect_err("a manifest that does not parse is a program that does not analyze");

    assert!(
        error.message().contains("redblue.manifest line 2"),
        "the line the manifest is wrong on travels with the message, got: {}",
        error.message()
    );
    assert!(
        !error.message().contains("RuntimeError"),
        "one failure, one label, got: {}",
        error.message()
    );
    let span = error
        .span()
        .expect("the failure is reported at the import that found it");
    assert_eq!(
        span.line, 1,
        "the caret is drawn on the program being analyzed, never on a line of another file"
    );
}

/// Two programs resolved in one process keep their own pins, in either order and
/// on either side of a repeat.
///
/// The resolution used to be cached per thread and keyed on nothing, so the
/// second program in a process — a REPL line, a test harness running files one
/// after another — was answered from the first program's pins, or from the first
/// program's failure, for the rest of the process.
#[test]
fn edge_two_roots_in_one_process_keep_their_own_pins() {
    let one = scratch("manifest_process_v1");
    let two = scratch("manifest_process_v2");
    manifest_file(&one, "name old\nversion 0.1.0\ndependency Fixture =1.0.0\n");
    manifest_file(&two, "name new\nversion 0.1.0\ndependency Fixture =2.0.0\n");
    for root in [&one, &two] {
        publish(root, "Fixture", "1.0.0", "set VALUE to 1\n");
        publish(root, "Fixture", "2.0.0", "set AMOUNT to 2\n");
    }

    let reads = [("import Fixture\nsay VALUE\n", true), ("import Fixture\nsay AMOUNT\n", false)];
    for (source, expected) in reads {
        redblue::analyzer::analyze_in(&program(source), &one)
            .expect("the first program's own pins answer it");
        assert_eq!(
            redblue::analyzer::analyze_in(&program(source), &two).is_ok(),
            !expected,
            "a name bound by one program's pin is not bound by the other's: {source:?}"
        );
        // And the first program, asked a third time in the same process, is still
        // answered from its own manifest rather than from the last one's.
        redblue::analyzer::analyze_in(&program(source), &one).unwrap_or_else(|error| {
            panic!("the first program is asked again after the second one: {}", error.message())
        });
    }
}
