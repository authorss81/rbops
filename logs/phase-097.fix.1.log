#[test]
fn edge_time_from_unix_agrees_with_time_unix_on_literal_instants() {
    for (seconds, expected) in [
        ("0", "1970-01-01 00:00:00"),
        ("1704067200", "2024-01-01 00:00:00"),
        ("-1", "1969-12-31 23:59:59"),
        ("1709164800", "2024-02-29 00:00:00"),
