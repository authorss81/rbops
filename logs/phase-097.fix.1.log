#[test]
fn edge_time_unix_refuses_malformed_text_and_wrong_types() {
    for source in [
        "time.unix(\"not a timestamp\")",
        "time.unix(5)",
        "time.unix([\"2024-02-29\"])",
        "time.unix()",
    ] {
