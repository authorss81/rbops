+            .any(|line| line == "Watching 1 expression(s):"),
+        "one watch is one watch; it answered:\n{}",
         answers.join("\n")
     );
     assert!(
-        answers.iter().any(|line| line == "  x")
-            && answers.iter().any(|line| line == "  y + 1"),
