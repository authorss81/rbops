            .map_err(|error| failure_line(&self.style, code, &error))?;
        let mut scratch = self.vm.fork();
        scratch.ask_questions(true);
        scratch
            .run_quietly(program)
            .map_err(|error| failure_line(&self.style, code, &error))
    }

