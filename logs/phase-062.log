    /// answer `2 + 3` with "Unknown command" and never evaluate it.
    #[test]
    fn parse_of_plain_source_is_not_a_command() {
        for line in [
            "2 + 3",
            "say \"hi\"",
            "set x to 1",
            "if 1 is greater than 0 then",
        ] {
            assert_eq!(
                ReplCommand::parse(line),
                ReplCommand::NotACommand,
                "{:?} is source, not a command",
