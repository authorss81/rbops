    fn edge_the_offered_names_are_the_table_s_words_and_nothing_else() {
        let offered = ReplCommand::names();

        assert_eq!(
            offered,
            ReplCommand::bare_names()
                .into_iter()
                .map(|name| format!(":{}", name))
                .collect::<Vec<String>>(),
            "the same words, once each, under the canonical sigil"
