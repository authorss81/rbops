+        ".watch",
+        ".watch x",
+        ".watch",
+        ".watch x",
+        ".watch \"héllo\"",
+        ".watch",
+    ]);
 
     assert!(
         answers.iter().any(|line| line == "No watches."),
         "a session that holds no watch says so rather than nothing; it \
@@ -3203,18 +3215,32 @@
