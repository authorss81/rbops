use redblue::lexer::Lexer;
use redblue::parser::parse;

fn try_stack(size: usize, source: String) -> bool {
    match std::thread::Builder::new().stack_size(size).spawn(move || {
        let tokens = Lexer::tokenize(&source).expect("lex");
        let _ = parse(tokens);
    }).unwrap().join() {
        Ok(()) => true,
        Err(_) => false,
    }
}

fn scan(kind: &str, depth: usize) {
    let source = match kind {
        "list" => format!("set x to {}1{}", "[".repeat(depth), "]".repeat(depth)),
        "paren" => format!("set x to {}1{}", "(".repeat(depth), ")".repeat(depth)),
        _ => format!("{}give back 1{}", "set f to to ()".repeat(depth), " end".repeat(depth)),
    };
    if try_stack(2 * 1024 * 1024, source) {
        println!("{kind}: {depth} fits on 2MiB");
    } else {
        println!("{kind}: {depth} OVERFLOWS 2MiB");
    }
}

fn main() {
    let _ = std::io::Write::flush(&mut std::io::stdout());
    for depth in [50usize, 100, 150, 200, 250] { scan("list", depth); }
    for depth in [50usize, 100, 150, 200] { scan("paren", depth); }
    for depth in [40usize, 48, 52, 56, 60] { scan("lit", depth); }
}
EOF
