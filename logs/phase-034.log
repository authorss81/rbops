+    /// every other `... end` form and cannot nest past [`MAX_BLOCK_DEPTH`].
+    fn parse_function_literal(&mut self) -> Result<Expr> {
+        self.enter_block()?;
+        let result = self.parse_function_literal_inner();
+        self.leave_block();
+        result
+    }
