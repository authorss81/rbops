/// The index just past the `}` that closes the `{` at `start`.
fn match_brace(text: &[char], start: usize) -> usize {
    let mut depth = 0i64;
    for (offset, ch) in text[start..].iter().enumerate() {
        if *ch == '{' {
            depth += 1;
        } else if *ch == '}' {
            depth -= 1;
            if depth == 0 {
                return start + offset + 1;
            }
        }
    }
    text.len()
}

/// The index just past the `)` that closes the `(` at `start`.
fn match_paren(text: &[char], start: usize) -> usize {
    let mut depth = 0i64;
    for (offset, ch) in text[start..].iter().enumerate() {
        if *ch == '(' {
            depth += 1;
        } else if *ch == ')' {
            depth -= 1;
            if depth == 0 {
                return start + offset + 1;
            }
        }
    }
    text.len()
}

