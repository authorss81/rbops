/// captures compare equal. `groups[0]` is the whole match and `groups[n]` is
/// capture group `n`; a group that did not participate is `nothing`.
fn regex_builtin(
    span: crate::error::Span,
    name: &str,
    args: &[Value],
) -> crate::error::Result<Value> {
