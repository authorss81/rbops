fn every_top_ten_entry_blocks_a_program_and_says_how_it_would_be_built() {
    let doc = survey();
    let labels = ["implementable-in-Redblue", "binding-required"];

    for entry in top_ten(&doc).into_iter().take(10) {
        let block = redblue_block(&entry.body);
