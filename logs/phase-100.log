from pathlib import Path
import re

def bump(path, cutoff=1314, delta=28):
    p=Path(path)
    out=[]
    for line in p.read_text().splitlines(keepends=True):
        m=re.match(r'^(SPEC\.md:)(\d+)(.*)$', line, re.S)
        if m and int(m.group(2))>cutoff:
            line=f"{m.group(1)}{int(m.group(2))+delta}{m.group(3)}"
        out.append(line)
    p.write_text(''.join(out))

bump('tests/doc_blocks_runs.txt')
bump('tests/doc_blocks_fragments.txt')
bump('tests/doc_blocks_known_fail.txt')
