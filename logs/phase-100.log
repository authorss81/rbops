            Ok(regex_match_value(text, &expression))
        }
        "regex_is_match" => {
            let (text, pattern) = regex_text_and_pattern(span, name, args)?;
            let expression = regex_compile(span, pattern)?;
            Ok(Value::YesNo(expression.is_match(text)))
        }
