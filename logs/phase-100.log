        // not exit 0.
        let claimed_ok = Outcome {
            exit_ok: true,
            first_error_line: row.value.clone(),
        };
        let verdict =
            std::panic::catch_unwind(|| check_known_fail(&row.key, &row.value, &claimed_ok));
        assert!(
            verdict.is_err(),
            "{}: a block that failed was accepted as having exited 0",
            row.key
        );
    }
