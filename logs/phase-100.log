        if !is_ident_start(code[i]) {
            i += 1;
            continue;
        }
        let start = i;
        let end = identifier_end(code, start);
        let is_let = code[start..end] == ['l', 'e', 't'];
        i = end;
        if !is_let {
            continue;
        }
