      - name: README examples run green
        run: |
          python3 - <<'EOF'
          import re, os, subprocess, sys, tempfile
          text = open('README.md', encoding='utf-8').read()
          fence = chr(96) * 3
          parts = text.split(fence + 'redblue\n')
          blocks = [p.split(fence)[0] for p in parts[1:]]
      - name: Run this shard's targets
        shell: bash
        run: |
          if [ -z "${TARGETS// /}" ]; then
            echo "shard $SHARD has no targets"
            exit 0
          fi
          rc=0
          for t in $TARGETS; do
            echo "::group::$t"
            if ! cargo test --test "$t"; then
              echo "::endgroup::"
              echo "::error::target $t failed"
              rc=1
            fi
            echo "::endgroup::"
          done
          exit $rc

  # The corpus differential harness on its own, because it is the long pole and
  # sharing it with 50 other targets would serialise the whole suite behind it.
  corpus:
    needs: fast
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          # Full history is REQUIRED, not an optimisation.
          # unreviewed_work_ack_test audits every commit in git log HEAD, and
          # actions/checkout defaults to a depth-1 clone. A truncated log reads
          # as a clean one, so that test refuses to read it rather than pass.
          fetch-depth: 0
      - uses: actions-rust-lang/setup-rust-toolchain@v1
      - uses: actions/cache@v4
        with:
          path: target
          key: cargo-target-${{ hashFiles('Cargo.lock') }}-${{ github.sha }}
          restore-keys: |
            cargo-target-${{ hashFiles('Cargo.lock') }}-
      - run: cargo test --test differential_test
      - run: cargo test --test bootstrap_selfhost_test
      - run: cargo test --test bootstrap_ship_test

