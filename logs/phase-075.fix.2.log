+                        '\\'
+                    }
+                    '"' => {
+                        cursor += 1;
+                        '"'
+                    }
+                    'u' => {
+                        let mut value = 0u32;
+                        let mut index = cursor + 1;
+                        for _ in 0..4 {
+                            value = value * 16 + chars.get(index)?.to_digit(16)?;
+                            index += 1;
+                        }
+                        cursor = index;
+                        char::from_u32(value)?
+                    }
+                    _ => return None,
+                };
+                decoded.push(decoded_char);
+                sources.push(escape);
+            }
+            c => {
+                decoded.push(c);
+                sources.push(cursor);
+                cursor += 1;
+            }
+        }
+    }
+
+    None
+}
