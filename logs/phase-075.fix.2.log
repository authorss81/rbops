/// Every brace pair in `literal` that the parser reads as an interpolation.
///
/// A pair nested inside another is visited in its own right so a text literal
/// written inside an interpolated expression still contributes its own
/// substitution; duplicate answers are removed when locations are merged.
fn interpolations_in(literal: &TextLiteral) -> Vec<Interpolation> {
    let unmatched = unmatched_opens(&literal.chars);
    let mut found = Vec::new();

    for (open, (&ch, &unmatched)) in literal.chars.iter().zip(&unmatched).enumerate() {
        if ch != '{' || unmatched {
            continue;
        }
        let Some(close) = matching_close(&literal.chars, open) else {
            continue;
        };
        let inner: String = literal.chars[open + 1..close].iter().collect();
        if is_complete_expression(&inner) {
            found.push(Interpolation { open, close });
        }
    }

    found
}
'''
