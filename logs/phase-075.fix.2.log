        .expect("a position inside the file is valid")
        .into_iter()
        .map(|location| (location.line, location.column))
        .collect();
    assert_eq!(
        references,
        vec![(2, 9), (8, 11)],
        "a grandchild read joins the grandparent declaration"
    );
}

