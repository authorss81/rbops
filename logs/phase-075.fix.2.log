    fn parse_method(&mut self) -> Result<Option<Stmt>> {
        let span = self.span();
        self.advance(); // consume 'to'

        if self.current().map(|t| &t.kind) == Some(&TokenKind::Can) {
            self.advance();
        }

        let (name, params, body) = self.parse_callable()?;
        Ok(Some(Stmt {
            span,
            statement: Statement::Method {
                name,
                params,
                body,
                cache: None,
            },
        }))
    }

