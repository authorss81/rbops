        for (binding, scope) in binding_scopes.iter().enumerate() {
            if !bindings[binding].lexical {
                continue;
            }
            scope_decls[*scope]
                .entry(bindings[binding].name.clone())
                .or_insert(binding);
        }

        for index in 0..tokens.len() {
            let Some(name) = name_of(&tokens[index]) else {
                continue;
            };
            if declarations.contains(&index)
                || type_names.contains(&index)
                || syntax_names.contains(&index)
                || member_names.contains(&index)
            {
                continue;
            }

            let is_call = call_follows(&tokens, index);
            if let Some(current) = token_binding[index] {
                // A name resolved during the walk keeps that binding. This
                // pass exists for names written before their declaration;
                // re-resolving every name would replace an earlier binding
                // with a later same-spelling declaration (`set x` followed by
                // `constant x`). The one correction still made here is the
                // field/method distinction: a bare read prefers the
                // non-function and a call prefers the function, whichever was
                // declared first.
                let matches_shape = if is_call {
                    bindings[current].kind == DefinitionKind::Function
                } else {
                    bindings[current].kind != DefinitionKind::Function
                };
                if matches_shape {
                    continue;
                }
            }
            let mut scope = Some(token_scope[index]);
            while let Some(scope_id) = scope {
                if let Some(binding) = scope_decls
                    .get(scope_id)
                    .and_then(|scope| scope.get(name))
                    .copied()
                {
                    if is_builtin_name(name)
                        && !deferred_builtin_binds_to(&bindings[binding], &tokens[index])
                    {
                        break;
                    }
                    token_binding[index] = if is_call {
                        scope_function_binding(name, binding, scope_id, &bindings, &binding_scopes)
                            .or(Some(binding))
                    } else {
                        scope_plain_binding(name, binding, scope_id, &bindings, &binding_scopes)
                    };
                    break;
                }
                scope = scope_parents.get(scope_id).copied().flatten();
            }
        }

        // Attach each child to the binding its `extends` name resolved to, but
        // only when the parent was already declared at the child's `object`
        // token. The interpreter resolves the chain at declaration time and
        // refuses an undeclared parent, so a parent written below its child is
        // not an inheritance edge here either. An unknown parent has no entry
        // and member lookup stops there.
        for index in 0..tokens.len() {
            if !matches!(
                tokens.get(index).map(|token| &token.kind),
                Some(TokenKind::Object)
            ) || !matches!(
                tokens.get(index + 2).map(|token| &token.kind),
                Some(TokenKind::Extends)
            ) {
                continue;
            }
            let (Some(child), Some(parent)) = (
                token_binding.get(index + 1).copied().flatten(),
                token_binding.get(index + 3).copied().flatten(),
            ) else {
                continue;
            };
            if parent == child
                || bindings[parent].kind != DefinitionKind::Object
                || (
                    bindings[parent].location.line,
                    bindings[parent].location.column,
                ) >= (
                    bindings[child].location.line,
                    bindings[child].location.column,
