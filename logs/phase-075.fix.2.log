use redblue::{find_references, goto_definition};

#[test]
fn probe_parent_in_uncalled_function() {
    let source = concat!(
        "to make()\n",
        "    object Person\n",
        "        has age default 1\n",
        "    end\n",
        "end\n",
        "object Employee extends Person\n",
        "end\n",
        "say Employee.age\n",
    );
    let got = goto_definition(source, 8, 14).expect("ok");
    eprintln!("GOTO = {:?}", got);
    let refs = find_references(source, 8, 14).expect("ok");
    eprintln!("REFS = {:?}", refs);
}

#[test]
fn probe_parent_in_untaken_branch() {
    let source = concat!(
        "if no then\n",
        "    object Person\n",
        "        has age default 1\n",
        "    end\n",
        "end\n",
        "object Employee extends Person\n",
        "end\n",
        "say Employee.age\n",
    );
    let got = goto_definition(source, 8, 14).expect("ok");
    eprintln!("BRANCH GOTO = {:?}", got);
    let refs = find_references(source, 8, 14).expect("ok");
    eprintln!("BRANCH REFS = {:?}", refs);
}

#[test]
fn probe_this_override() {
    let source = concat!(
        "object Person\n",
        "    has age default 1\n",
        "    to can describe()\n",
        "        give back this.age\n",
        "    end\n",
        "end\n",
        "object Child extends Person\n",
        "    has age default 2\n",
        "end\n",
    );
    let got = goto_definition(source, 4, 24).expect("ok");
    eprintln!("THIS GOTO = {:?}", got);
    let refs = find_references(source, 4, 24).expect("ok");
    eprintln!("THIS REFS = {:?}", refs);
}
