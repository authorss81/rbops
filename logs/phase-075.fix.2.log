                        expected_name("a name to export after 'export'", self.current()),
                        self.span(),
                    ))
                }
            }

            if let Some(Token {
                kind: TokenKind::Comma,
                ..
            }) = self.current()
            {
                self.advance();
                continue;
            }
            break;
        }

        Ok(Some(Statement::Export { names, all }))
    }

