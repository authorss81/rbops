820:            TokenKind::RightParen => return cursor,
821:            TokenKind::Identifier(name) => {
822:                let location = Location::of_name(&tokens[cursor], name);
823:                let binding = declare(scopes, bindings, name, location, DefinitionKind::Parameter);
824:                mark_declaration(token_binding, declarations, cursor, binding);
825:            }
826:            _ => {}
827:        }
828:        cursor += 1;
829:    }
830:
831:    cursor
832:}
