    /// swallowed as an alternative branch.
    fn parse_unless(&mut self) -> Result<Option<Statement>> {
        self.advance(); // consume 'unless'
        let condition = self.parse_expression()?;

        self.skip_newlines();
        self.expect(&TokenKind::Then)?;
        self.skip_newlines();

