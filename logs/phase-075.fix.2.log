+#[derive(Debug, Clone)]
+struct Binding {
+    name: String,
+    location: Location,
+    kind: DefinitionKind,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum FrameKind {
+    If,
+    Unless,
+    For,
+    While,
+    Repeat,
+    To,
+    Literal,
+    Object,
+    Module,
+    Test,
+    Try,
+}
+
+#[derive(Debug, Clone, Copy)]
+struct Frame {
+    kind: FrameKind,
+    opens_scope: bool,
+    catch_scope: bool,
+    closes_at_newline: Option<usize>,
+}
+
+impl Frame {
+    fn block(kind: FrameKind) -> Self {
+        Self {
+            kind,
+            opens_scope: false,
+            catch_scope: false,
+            closes_at_newline: None,
+        }
+    }
+
+    fn scoped(kind: FrameKind) -> Self {
+        Self {
+            kind,
+            opens_scope: true,
+            catch_scope: false,
+            closes_at_newline: None,
