+/// Whether a child that inherits from `object` declares `name` on itself.
+///
+/// A method's body is written inside its own object, but the runtime receiver
+/// can be a child that inherited the method, and the child's copied table
+/// keeps its own entries ahead of every inherited one. When a descendant
+/// declares `name`, the read's answer depends on which object the method runs
+/// against, so navigation must not claim the lexical object's declaration.
+/// Every child of `object` is checked along its own chain, so a grandchild
+/// that overrides through an intermediate object counts too.
+fn descendant_overrides(
+    object: usize,
+    name: &str,
+    object_fields: &HashMap<usize, HashMap<String, usize>>,
+    object_methods: &HashMap<usize, HashMap<String, usize>>,
+    object_parents: &HashMap<usize, usize>,
+) -> bool {
+    object_parents.keys().any(|child| {
+        let mut current = Some(*child);
+        let mut seen = HashSet::new();
+        while let Some(current_object) = current {
+            if current_object == object || !seen.insert(current_object) {
+                break;
+            }
+            let declares = object_fields
+                .get(&current_object)
+                .is_some_and(|fields| fields.contains_key(name))
+                || object_methods
+                    .get(&current_object)
+                    .is_some_and(|methods| methods.contains_key(name));
+            if declares {
+                return true;
+            }
+            current = object_parents.get(&current_object).copied();
+        }
+        false
+    })
+}
