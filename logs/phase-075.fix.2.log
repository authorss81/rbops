  for _pat in $MUST_TOUCH; do
    if printf '%s\n' "$CHANGED" | grep -q "^$_pat"; then _hit="$_pat"; break; fi
  done
  if [ -n "$_hit" ]; then
    ok "implementation touched ${_hit} (must_touch: ${MUST_TOUCH})"
  else
