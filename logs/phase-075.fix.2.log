+        let start = self.line_starts[line - 1];
+        let mut end = start;
+        while end < self.chars.len() && self.chars[end] != '\n' {
+            end += 1;
+        }
+        if column > end - start + 1 {
+            return Err(format!("column {column} is past the end of line {line}"));
+        }
