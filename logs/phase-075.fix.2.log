    let mut scope_parents: Vec<Option<usize>> = vec![None];
    let mut next_scope_id = 1usize;
    let mut binding_scopes: Vec<usize> = Vec::new();
    let mut token_scope: Vec<usize> = vec![0; tokens.len()];
