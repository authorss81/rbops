+/// The nearest member table entry for `name`, walking the object's parent
+/// chain.
+///
+/// The runtime copies a parent's fields and methods into the child's own
+/// tables, nearest declaration first, so a child member shadows the same-named
+/// member of every ancestor. Navigation walks the chain instead of copying it,
+/// which keeps the declaration span on the object that actually wrote it. A
+/// malformed `extends` cycle stops at the first object it revisits rather than
+/// looping forever.
+fn nearest_object_member(
+    receiver: usize,
+    name: &str,
+    table: &HashMap<usize, HashMap<String, usize>>,
+    object_parents: &HashMap<usize, usize>,
+) -> Option<usize> {
+    let mut current = Some(receiver);
+    let mut seen = HashSet::new();
+    while let Some(object) = current {
+        if !seen.insert(object) {
+            return None;
+        }
+        if let Some(binding) = table.get(&object).and_then(|members| members.get(name)) {
+            return Some(*binding);
+        }
+        current = object_parents.get(&object).copied();
+    }
+    None
