+impl SourceMap {
+    fn new(source: &str) -> Self {
+        let chars: Vec<char> = source.chars().collect();
+        let mut line_starts = vec![0];
+        for (index, c) in chars.iter().enumerate() {
+            if *c == '\n' {
+                line_starts.push(index + 1);
+            }
+        }
+        Self { chars, line_starts }
+    }
