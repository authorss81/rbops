    name: &str,
    first: usize,
    scope_id: usize,
    bindings: &[Binding],
    binding_scopes: &[usize],
) -> Option<usize> {
    if bindings[first].kind != DefinitionKind::Function {
        return Some(first);
    }
    binding_scopes
        .iter()
        .enumerate()
        .find(|(id, scope)| {
            **scope == scope_id
                && bindings[*id].name == name
                && bindings[*id].kind != DefinitionKind::Function
        })
        .map(|(id, _)| id)
        .or(Some(first))
}

