    bindings.push(Binding {
        name: name.to_string(),
        location,
        kind: DefinitionKind::Constant,
    });
    binding_scopes.push(scope_id);
    let scope = scopes.last_mut().expect("the root scope always exists");
    scope.insert(name.to_string(), id);
    id
}

