    bindings: &mut Vec<Binding>,
    binding_scopes: &mut Vec<usize>,
    scope_id: usize,
    name: &str,
    location: Location,
) -> usize {
    if let Some(existing) = scopes.last().and_then(|scope| scope.get(name).copied()) {
        if bindings[existing].kind == DefinitionKind::Constant {
