#[test]
fn edge_completions_after_a_same_named_module_alias_keep_the_imported_modules_members() {
    let source = concat!(
        "module M\n",
        "    to first()\n",
        "        give back 1\n",
        "    end\n",
        "    export first\n",
        "end\n",
        "import M as A\n",
        "module M\n",
        "    to second()\n",
        "        give back 2\n",
        "    end\n",
        "    export second\n",
        "end\n",
        "A.\n",
    );

    let offered = completions(source, 14, 3).expect("the member slot is a valid position");
    assert!(
        offered.contains(&"first".to_string()),
        "the alias offers the members of the module its import named, got {offered:?}"
    );
    assert!(
        !offered.contains(&"second".to_string()),
        "a later same-named module must not add its members to an earlier import alias, got {offered:?}"
    );
}

#[test]
fn edge_bare_module_member_read_resolves_to_the_published_function() {
    let source = concat!(
        "module M\n",
        "    to f()\n",
        "        give back 1\n",
        "    end\n",
        "    export f\n",
        "end\n",
        "say M.f\n",
    );

    let found = goto_definition(source, 7, 7)
        .expect("a position inside the file is valid")
        .expect("a bare member read names the published function value");
    assert_eq!(
        (found.line, found.column),
        (2, 8),
        "the function value is exposed by a bare member read just as by a call"
    );

    let references: Vec<(usize, usize)> = find_references(source, 2, 8)
        .expect("a position inside the file is valid")
        .into_iter()
        .map(|location| (location.line, location.column))
        .collect();
    assert_eq!(
        references,
        vec![(2, 8), (5, 12), (7, 7)],
        "the declaration, its export and the bare member read share one binding"
    );
}

#[test]
fn edge_goto_definition_inside_an_interpolation_resolves_to_the_outer_binding() {
    let source = "set greeting to \"hi\"\nsay \"message: {greeting}\"\n";

    let found = goto_definition(source, 2, 18)
        .expect("a position inside the file is valid")
        .expect("the name inside an interpolation is a lexical use");

    assert_eq!(
        (
            found.line,
            found.column,
            found.end_column,
            found.kind.as_str()
        ),
        (1, 5, 12, "variable"),
        "the interpolated use must point at the `set` declaration, not at the literal"
    );
    assert_eq!(found.name, "greeting");
}

#[test]
fn edge_find_references_inside_an_interpolation_join_the_binding() {
    let source = "set greeting to \"hi\"\nsay \"message: {greeting}\"\n";

    let references: Vec<(usize, usize)> = find_references(source, 2, 18)
        .expect("a position inside the file is valid")
        .into_iter()
        .map(|location| (location.line, location.column))
        .collect();

    assert_eq!(
        references,
        vec![(1, 5), (2, 16)],
        "the declaration and the interpolated use share one binding, and the surrounding text is not a use"
    );
}

#[test]
fn edge_goto_definition_on_a_builtin_inside_an_interpolation_resolves_to_the_registry() {
    let source = "say \"{abs(-3)}\"\n";

    let found = goto_definition(source, 1, 8)
        .expect("a position inside the file is valid")
        .expect("`abs` is a builtin inside the interpolated expression");

    assert_eq!(
        (
            found.kind.as_str(),
            found.name.as_str(),
            found.line,
            found.column,
        ),
        ("builtin", "abs", 0, 0),
        "a builtin resolves through the registry even when it is written inside text"
    );
}

#[test]
fn edge_navigation_inside_an_interpolation_rejects_malformed_positions() {
    let source = "say \"{abs(-3)}\"\n";

    assert!(
        goto_definition(source, 0, 1).is_err(),
        "line 0 is not a source position"
    );
    assert!(
        find_references(source, 1, 99).is_err(),
        "a column past the line is not a source position"
    );
    assert!(
        completions(source, 3, 1).is_err(),
        "a line past the file is not a source position"
    );
}

#[test]
fn edge_navigation_inside_escaped_interpolation_braces_maps_the_original_span() {
    let source = "set greeting to \"hi\"\nsay \"\\u007Bgreeting\\u007D\"\n";

    let found = goto_definition(source, 2, 15)
        .expect("a position inside the file is valid")
        .expect("the escaped braces open an interpolation exactly as the lexer reads them");

    assert_eq!(
        (found.line, found.column, found.kind.as_str()),
        (1, 5, "variable"),
        "the decoded name maps back to the declaration outside the literal"
    );

    let references: Vec<(usize, usize)> = find_references(source, 2, 15)
        .expect("a position inside the file is valid")
        .into_iter()
        .map(|location| (location.line, location.column))
        .collect();
    assert_eq!(
        references,
        vec![(1, 5), (2, 12)],
        "the interpolated use is reported at its own source position, not at the escape"
    );
}

#[test]
fn edge_interpolated_use_prefers_the_shadowing_binding() {
    let source = concat!(
        "to f()\n",
        "    give back 2\n",
        "end\n",
        "to g()\n",
        "    set f to 1\n",
        "    say \"{f}\"\n",
        "end\n",
        "say f\n",
    );

    let found = goto_definition(source, 6, 11)
        .expect("a position inside the file is valid")
        .expect("the interpolated name names the local variable");
    assert_eq!(
        (found.line, found.column, found.kind.as_str()),
        (5, 9, "variable"),
        "the use inside the function must not jump to the outer function"
    );

    let inner: Vec<(usize, usize)> = find_references(source, 6, 11)
        .expect("a position inside the file is valid")
        .into_iter()
        .map(|location| (location.line, location.column))
        .collect();
    let outer: Vec<(usize, usize)> = find_references(source, 1, 4)
        .expect("a position inside the file is valid")
        .into_iter()
        .map(|location| (location.line, location.column))
        .collect();

    assert_eq!(inner, vec![(5, 9), (6, 11)]);
    assert_eq!(outer, vec![(1, 4), (8, 5)]);
}

