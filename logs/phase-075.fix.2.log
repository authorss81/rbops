        (items.line, items.column, items.kind.as_str()),
        (1, 10, "parameter")
    );

    let list = goto_definition(source, 1, 19)
        .expect("a position inside the file is valid")
        .expect("`list` is a module name, not a parameter");
    assert_eq!(
        (list.kind.as_str(), list.name.as_str()),
