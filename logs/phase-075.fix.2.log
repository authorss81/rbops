    receiver: usize,
    prefix: String,
    assert!(
        offered.contains(&"greet".to_string()),
        "`this.` names the enclosing object's method, got {offered:?}"
    );
}

#[test]
fn edge_completions_after_a_child_object_dot_include_inherited_members() {
    let source = concat!(
        "object Parent\n",
        "    has age\n",
        "end\n",
        "object Child extends Parent\n",
        "    has name\n",
        "end\n",
        "Child.\n",
    );

    let offered = completions(source, 7, 7).expect("the member slot is a valid position");
    for expected in ["age", "name"] {
        assert!(
            offered.contains(&expected.to_string()),
            "an inherited member completes after the dot: missing {expected:?} in {offered:?}"
        );
    }
    assert!(
        !offered.contains(&"abs".to_string()),
        "an object member slot must not offer the builtin registry, got {offered:?}"
    );
}

#[test]
fn edge_completions_after_a_module_dot_offer_its_published_members() {
    let source = "import files\nfiles.\n";

    let offered = completions(source, 2, 7).expect("the member slot is a valid position");
    for expected in ["read", "write", "exists"] {
        assert!(
            offered.contains(&expected.to_string()),
            "a module offers its published member {expected:?}, got {offered:?}"
        );
    }
    assert!(
        !offered.contains(&"files_read".to_string()),
        "a module member is offered by its dotted spelling, not its registry encoding, got \
         {offered:?}"
    );
    assert!(
        !offered.contains(&"set".to_string()),
        "a module member slot must not fall back to the language keywords, got {offered:?}"
    );
}

#[test]
fn edge_completions_after_an_aliased_module_dot_offer_its_published_members() {
    let source = "import files as f\nf.\n";

    let offered = completions(source, 2, 3).expect("the member slot is a valid position");
    for expected in ["read", "write", "exists"] {
        assert!(
            offered.contains(&expected.to_string()),
            "an aliased module offers its published member {expected:?}, got {offered:?}"
        );
    }
    assert!(
        !offered.contains(&"set".to_string()),
        "an aliased module member slot must not fall back to the language keywords, got \
         {offered:?}"
    );
}

#[test]
fn edge_completions_after_an_object_dot_declared_below_offer_its_members() {
    let source = concat!(
        "Person.\n",
        "object Person\n",
        "    has name\n",
        "    to can greet()\n",
        "        say this.name\n",
        "    end\n",
        "end\n",
    );

    let offered = completions(source, 1, 8).expect("the member slot is a valid position");
    assert!(
        offered.contains(&"name".to_string()),
        "a forward object offers its field, got {offered:?}"
    );
    assert!(
        offered.contains(&"greet".to_string()),
        "a forward object offers its method, got {offered:?}"
    let references: Vec<(usize, usize)> = find_references(source, 2, 5)
        .expect("a position inside the file is valid")
        .into_iter()
        .map(|location| (location.line, location.column))
        .collect();

    assert_eq!(
        references,
        vec![(1, 8), (2, 5)],
        "the import declaration is the binding site, not a module definition file"
    );
}

#[test]
fn edge_nested_import_stays_in_its_block() {
    let source = concat!(
        "to load()\n",
        "    import MathUtils\n",
        "    say MathUtils\n",
        "end\n",
        "say MathUtils\n",
    );

    let inside = goto_definition(source, 3, 9)
        .expect("a position inside the file is valid")
        .expect("the import binds its module inside the function body");
    assert_eq!(
        (inside.line, inside.column, inside.kind.as_str()),
        (2, 12, "import"),
        "the body's use resolves to the import written in the same scope"
    );

    assert_eq!(
        goto_definition(source, 5, 5).expect("a position inside the file is valid"),
        None,
        "an import declared in a function body must not leak past the function's `end`"
    );
}

#[test]
fn edge_import_alias_keeps_the_modules_own_name_a_binding() {
    // `import MathUtils as M` binds both spellings: the runtime and analyzer
    // leave the module's own name readable (`import json as J` then
    // `json.stringify(..)` still works), so navigation must offer both and
    // keep their references apart.
    let source = concat!(
        "import MathUtils as M\n",
        "say MathUtils.circle_area(2)\n",
        "say M.circle_area(2)\n",
    );

    for (line, column, expected_column) in [(2, 5, 8), (3, 5, 21)] {
        let definition = goto_definition(source, line, column)
            .expect("a position inside the file is valid")
            .expect("both the module name and its alias name the import");
        assert_eq!(
            (definition.line, definition.column, definition.kind.as_str()),
            (1, expected_column, "import"),
            "line {line} resolves to its own import binding"
        );
    }

    let module_references: Vec<(usize, usize)> = find_references(source, 2, 5)
        .expect("a position inside the file is valid")
        .into_iter()
        .map(|location| (location.line, location.column))
        .collect();
    assert_eq!(
        module_references,
        vec![(1, 8), (2, 5)],
        "the module's own name has only its import declaration and uses"
    );

    let alias_references: Vec<(usize, usize)> = find_references(source, 3, 5)
        .expect("a position inside the file is valid")
        .into_iter()
        .map(|location| (location.line, location.column))
        .collect();
    assert_eq!(
        alias_references,
        vec![(1, 21), (3, 5)],
        "the alias has only its import declaration and uses"
    );
}

