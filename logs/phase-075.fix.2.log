800:/// Declares every identifier in the parameter list starting at `start`, and
801:/// answers the index of the closing `)` (or `start` when there is no list).
802:fn declare_params(
803:    tokens: &[Token],
804:    start: usize,
805:    scopes: &mut [HashMap<String, usize>],
806:    bindings: &mut Vec<Binding>,
807:    token_binding: &mut [Option<usize>],
808:    declarations: &mut HashSet<usize>,
809:) -> usize {
810:    if !matches!(
811:        tokens.get(start).map(|token| &token.kind),
812:        Some(TokenKind::LeftParen)
813:    ) {
814:        return start;
815:    }
