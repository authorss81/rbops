+    );
+    assert!(
+        find_references(source, 99, 1).is_err(),
+        "a line past the unless body is a clean error"
+    );
+    assert!(
+        completions(source, 99, 1).is_err(),
+        "a line past the unless body is a clean error"
+    );
+}
