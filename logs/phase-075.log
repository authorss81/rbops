#[test]
fn edge_navigation_inside_escaped_interpolation_braces_maps_the_original_span() {
    let source = "set greeting to \"hi\"\nsay \"\\u007Bgreeting\\u007D\"\n";

    let found = goto_definition(source, 2, 15)
        .expect("a position inside the file is valid")
        .expect("the escaped braces open an interpolation exactly as the lexer reads them");

    assert_eq!(
        (found.line, found.column, found.kind.as_str()),
        (1, 5, "variable"),
        "the decoded name maps back to the declaration outside the literal"
    );

    let references: Vec<(usize, usize)> = find_references(source, 2, 15)
        .expect("a position inside the file is valid")
        .into_iter()
        .map(|location| (location.line, location.column))
        .collect();
    assert_eq!(
        references,
        vec![(1, 5), (2, 12)],
        "the interpolated use is reported at its own source position, not at the escape"
    );
}

#[test]
fn edge_interpolated_use_prefers_the_shadowing_binding() {
    let source = concat!(
        "set x to 1\n",
        "to show()\n",
        "    set x to 2\n",
        "    say \"{x}\"\n",
        "end\n",
        "say x\n",
    );

    let found = goto_definition(source, 4, 11)
        .expect("a position inside the file is valid")
        .expect("the interpolated name names the inner variable");
    assert_eq!(
        (found.line, found.column, found.kind.as_str()),
        (3, 9, "variable"),
        "the use inside the function must not jump to the outer declaration"
    );

    let inner: Vec<(usize, usize)> = find_references(source, 4, 11)
        .expect("a position inside the file is valid")
        .into_iter()
        .map(|location| (location.line, location.column))
        .collect();
    let outer: Vec<(usize, usize)> = find_references(source, 1, 5)
        .expect("a position inside the file is valid")
        .into_iter()
        .map(|location| (location.line, location.column))
        .collect();

    assert_eq!(inner, vec![(3, 9), (4, 11)]);
    assert_eq!(outer, vec![(1, 5), (6, 5)]);
}
