    object_fields: &HashMap<usize, HashMap<String, usize>>,
    object_methods: &HashMap<usize, HashMap<String, usize>>,
    object_parents: &HashMap<usize, usize>,
    name: &str,
) -> Option<usize> {
    let field = nearest_object_member(receiver, name, object_fields, object_parents);
    let method = nearest_object_member(receiver, name, object_methods, object_parents);
    let is_call = call_follows(tokens, index);

    if is_call {
        method.or(field)
    } else {
        field.or(method)
    }
}
