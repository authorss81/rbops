                    }
                } else {
                    let is_call = call_follows(&tokens, index);
                    for (scope, scope_id) in scopes.iter().zip(scope_ids.iter()).rev() {
                        let Some(&first) = scope.get(name) else {
                            continue;
                        };
                        token_binding[index] = if is_call {
                            scope_function_binding(
