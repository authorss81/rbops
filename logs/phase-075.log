                    let name = name_of(&tokens[binder]).expect("the binder is a name");
                    let location = Location::of_name(&tokens[binder], name);
                    let binding = declare(
                        &mut scopes,
                        &mut bindings,
                        &mut binding_scopes,
                        *scope_ids.last().expect("the root scope always exists"),
                        name,
                        location,
