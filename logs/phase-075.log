 #[test]
+fn edge_unless_body_binding_joins_the_enclosing_bindings_references() {
+    let source = concat!(
+        "set marker to 1\n",
+        "unless no\n",
+        "    set local to 2\n",
+        "    say local\n",
+        "end\n",
+        "say local\n",
+    );
+
+    let declared = goto_definition(source, 6, 5)
+        .expect("a position inside the file is valid")
+        .expect("the unless body's declaration outlives its `end`");
+    assert_eq!(
+        (declared.line, declared.column, declared.kind.as_str()),
+        (3, 9, "variable"),
+        "goto after an `unless` must answer the declaration the interpreter still has bound"
+    );
+
+    let references: Vec<(usize, usize)> = find_references(source, 6, 5)
+        .expect("a position inside the file is valid")
+        .into_iter()
+        .map(|location| (location.line, location.column))
+        .collect();
+    assert_eq!(
+        references,
+        vec![(3, 9), (4, 9), (6, 5)],
+        "the declaration and both uses are the same binding"
+    );
+}
+
+#[test]
+fn edge_test_body_declaration_is_offered_by_completion_after_end() {
+    let source = concat!(
+        "test \"scope\"\n",
+        "    for each item in values\n",
+        "        set inner to 1\n",
+        "    end\n",
+        "    set local to 2\n",
+        "end\n",
+    );
+
+    let offered = completions(source, 7, 1).expect("the blank line after the test is valid");
+
+    assert!(
+        offered.contains(&"local".to_string()),
+        "the interpreter keeps a test body's own declaration bound after `end`, got {offered:?}"
+    );
+    assert!(
+        !offered.contains(&"item".to_string()),
+        "a loop variable inside the test body still closes with its loop, got {offered:?}"
+    );
+    assert!(
+        !offered.contains(&"inner".to_string()),
+        "the loop body's declaration also closes with its loop, got {offered:?}"
+    );
+}
+
+#[test]
+fn edge_unless_nested_in_a_function_does_not_leak_out_of_the_function() {
+    let source = concat!(
+        "to show()\n",
+        "    unless no\n",
+        "        set local to 1\n",
+        "    end\n",
+        "    say local\n",
+        "end\n",
+        "say local\n",
+    );
+
+    let inside = goto_definition(source, 5, 9)
+        .expect("a position inside the file is valid")
+        .expect("an unless body shares the function scope, so the binding is visible there");
+    assert_eq!(
+        (inside.line, inside.column, inside.kind.as_str()),
+        (3, 13, "variable"),
+        "the unless body's declaration stays in the function scope, not in the root scope"
+    );
+
+    assert_eq!(
+        goto_definition(source, 7, 5).expect("a position inside the file is valid"),
+        None,
+        "the function's `end` must close the scope the unless body wrote into"
+    );
+}
+
+#[test]
+fn edge_navigation_rejects_a_position_past_an_unless_body() {
+    let source = "unless no\n    set local to 1\nend\n";
+
+    assert!(
