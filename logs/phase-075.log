 /// Whether `offset` falls inside a string literal's source text.
+/// The source offset of the opening quote of the text literal holding `offset`.
+fn text_start_at(tokens: &[Token], map: &SourceMap, offset: usize) -> Option<usize> {
+    tokens.iter().find_map(|token| {
+        if !matches!(token.kind, TokenKind::Text(_)) {
+            return None;
+        }
+        let start = map.offset(token.line, token.column);
+        let mut cursor = start + 1;
+        while cursor < map.chars.len() {
+            match map.chars[cursor] {
+                '\\' => cursor += 2,
+                '"' => return (offset >= start && offset <= cursor).then_some(start),
+                _ => cursor += 1,
+            }
+        }
+        (offset >= start).then_some(start)
+    })
+}
+
+/// The offset just inside the innermost `{` whose pair is still open at
+/// `offset`, when `offset` sits inside a text interpolation.
+///
+/// A brace pair inside a text literal is code, not text, so the caret is
+/// naming an expression there. A `{` with no matching `}` is literal text to
+/// the parser, so it answers `None` just as it does to the parser. Escapes are
+/// skipped so an escaped quote cannot end the literal early.
+fn interpolation_inner_start(map: &SourceMap, text_start: usize, offset: usize) -> Option<usize> {
+    let chars = &map.chars;
+    let mut opens: Vec<usize> = Vec::new();
+    let mut cursor = text_start + 1;
+    while cursor < chars.len() && cursor <= offset {
+        match chars[cursor] {
+            '\\' => {
+                cursor += 2;
+                continue;
+            }
+            '"' => return None,
+            '{' => opens.push(cursor),
+            '}' => {
+                opens.pop();
+            }
+            _ => {}
+        }
+        cursor += 1;
+    }
+
+    let open = *opens.last()?;
+    let mut depth = 1usize;
+    let mut scan = offset.saturating_add(1);
+    while scan < chars.len() {
+        match chars[scan] {
+            '\\' => {
+                scan += 2;
+                continue;
+            }
+            '"' => return None,
+            '{' => depth += 1,
+            '}' => {
+                depth -= 1;
+                if depth == 0 {
+                    return Some(open + 1);
+                }
+            }
+            _ => {}
+        }
+        scan += 1;
+    }
+    None
+}
+
+/// Completion for the expression written inside a text interpolation.
+///
+/// Only what an expression can use is offered: the names in scope, builtins,
+/// modules and constants, and the operator/literal keywords. A statement
+/// keyword such as `say`, `set` or `end` cannot start an interpolated
+/// expression, so it is not offered in a position that is code inside text.
+fn interpolation_completions(analysis: &Analysis) -> Vec<String> {
+    const EXPRESSION_KEYWORDS: &[&str] = &["and", "is", "mod", "no", "not", "nothing", "or", "yes"];
+
+    let mut names = analysis.visible.clone();
+    names.extend(EXPRESSION_KEYWORDS.iter().map(|word| (*word).to_string()));
+    names.extend(BUILTIN_NAMES.iter().map(|name| (*name).to_string()));
+    names.extend(MODULES.iter().map(|name| (*name).to_string()));
+    names.push("PI".to_string());
+    names.push("E".to_string());
+    names.sort();
+    names.dedup();
+    names
+}
