                    frames.push(frame);
                }
            }
            TokenKind::Import => {
                let mut cursor = index + 1;
                while cursor < tokens.len() {
                    match tokens[cursor].kind.clone() {
                        TokenKind::Newline | TokenKind::Eof => break,
                        TokenKind::Identifier(name) => {
                            let location = Location::of_name(&tokens[cursor], &name);
                            let binding = declare(
