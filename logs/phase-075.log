    if let Some(workload) = WORKLOADS.iter().find(|workload| workload.name == name) {
        return Ok(workload);
    }
    #[cfg(test)]
    if name == HANG_WORKLOAD_NAME {
        return Ok(&HANG_WORKLOAD);
    }
    Err(BenchError::Usage(unknown_workload(name)))
}

