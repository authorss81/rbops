/// `give`/`back`, `might`/`fail` and `mod`/`%` are one kind each. See
/// [`crate::lexer::Token::word`].
fn name_of(token: &Token) -> Option<&'static str> {
    token.word
}

pub fn parse(tokens: Vec<Token>) -> Result<Program> {
    let mut parser = Parser::new(tokens);
    parser.parse()
}

