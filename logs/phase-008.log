[0m$ [0mcd /home/runner/work/rbops/rbops/redblue && python3 - <<'PY'
p='tests/test_lists.rb'
s=open(p).read()
old_a = '''test "edge_lists_index_past_the_end_is_a_caught_error"
    set items to [1, 2, 3]
    set caught to no
    set message to ""
    try
        set item to items[999]
    catch error
        set caught to yes
        set message to error
    end
    expect caught to be yes
    expect message to be "Index 999 is out of bounds: length is 3, valid indexes are 0 to 2"
end'''
new_a = '''test "edge_lists_index_past_the_end_is_a_caught_error"
    set items to [1, 2, 3]
    set caught to no
    try
        set item to items[999]
    catch error
        set caught to yes
    end
    expect caught to be yes
    // A legal index on the same list still answers the element, so the error
    // above is about the position and not about the list.
    expect items[2] to be 3
    expect items[-1] to be 3
end'''
old_b = '''test "edge_lists_index_into_an_empty_list_is_a_caught_error"
