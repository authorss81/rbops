            (".debug prog.rb", "Debug", "prog.rb"),
            (".debug 1 + 1", "Debug", "1 + 1"),
            (".watch x", "Watch", "x"),
            (":watch count + 1", "Watch", "count + 1"),
            (".stack", "Stack", ""),
            (".locals", "Locals", ""),
            (".back", "Back", ""),
            (":back", "Back", ""),
        ];

        for (input, expected, argument) in cases {
            let parsed = ReplCommand::parse(input);
            let rendered = format!("{:?}", parsed);
