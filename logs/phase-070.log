                variant, expected,
                "parsing {:?} should give {}",
                input, expected
            );
            let carried = parsed.argument_text().unwrap_or_default();
            assert_eq!(
                carried, argument,
                "parsing {:?} should carry the argument {:?}",
                input, argument
            );
