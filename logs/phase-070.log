/// Shared storage is walked once per call: a list that appears twice inside one
/// value is one allocation and is counted once. The `seen` set is keyed by the
/// `Arc` address, which is stable for the lifetime of the value, and is what
/// keeps a value that reaches itself from being walked forever.
pub fn value_bytes(value: &Value) -> usize {
    let mut seen = HashSet::new();
    value_bytes_seen(value, &mut seen)
}

fn value_bytes_seen(value: &Value, seen: &mut HashSet<usize>) -> usize {
    match value {
        Value::Nothing | Value::Number(_) | Value::YesNo(_) => 0,
        Value::Text(text) => text.len(),
        Value::Builtin(name) => name.len(),
        Value::List(items) => {
            let address = std::sync::Arc::as_ptr(items) as *const () as usize;
            if !seen.insert(address) {
                return 0;
            }
            items.iter().map(|item| value_bytes_seen(item, seen)).sum()
        }
        Value::Record(fields) => fields_bytes(fields, seen),
        Value::Object(name, fields) => name.len() + fields_bytes(fields, seen),
        Value::Function(function) => {
            let mut bytes =
                function.name.len() + function.params.iter().map(String::len).sum::<usize>();
            let address = std::sync::Arc::as_ptr(&function.captured) as *const () as usize;
            if seen.insert(address) {
                for scope in function.captured.iter() {
                    for (name, value) in scope {
                        bytes += name.len() + value_bytes_seen(value, seen);
                    }
                }
            }
            bytes
        }
    }
}

fn fields_bytes(fields: &crate::value::Fields, seen: &mut HashSet<usize>) -> usize {
    let address = std::sync::Arc::as_ptr(fields) as *const () as usize;
    if !seen.insert(address) {
        return 0;
    }
    fields
        .iter()
        .map(|(name, value)| name.len() + value_bytes_seen(value, seen))
        .sum()
}

/// A byte count in human units, with the raw count in parentheses.
///
/// The raw count is always present so a small session and a large one read
/// alike: `0 B (0 B)`, `512 B (512 B)`, `10.0 KB (10240 B)` and
/// `5.0 MB (5242880 B)` each say exactly what they mean. Base 1024, because a
/// reader comparing this to what they typed is comparing memory, not disk.
