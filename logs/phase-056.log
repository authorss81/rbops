import re,subprocess
files=["src/repl/introspect.rs","src/repl/commands.rs","src/repl/mod.rs","tests/repl_test.rs"]
def tests(text):
    out={}; lines=text.splitlines(); i=0
    while i<len(lines):
        if re.match(r'\s*#\[(test|test_case)', lines[i]):
            j=i+1
            while j<len(lines) and not re.match(r'\s*(pub )?fn ', lines[j]): j+=1
            m=re.match(r'\s*(?:pub )?fn ([A-Za-z0-9_]+)', lines[j])
            if m:
                # body until next line starting with "    }" at col 4 or next fn
                k=j+1; body=[]
                while k<len(lines) and not re.match(r'^\    \}', lines[k]):
                    body.append(lines[k]); k+=1
                out[m.group(1)]="\n".join(body)
            i=j
        i+=1
    return out
allnew={}
for f in files:
    cur=tests(subprocess.run(["git","show",f"HEAD:{f}"],capture_output=True,text=True).stdout)
    base=tests(subprocess.run(["git","show",f"14824b9:{f}"],capture_output=True,text=True).stdout)
    for k in set(cur)-set(base): allnew[k]=cur[k]
pat=re.compile(r'is_err\(\)|expect_err|is_ok\(\)\s*==\s*false|assert!\(!\s*\w+\.is_ok|Error:|is a clean|refus')
hits=[k for k,v in allnew.items() if pat.search(v)]
