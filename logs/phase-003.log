+/// Line numbers (1-based, file-relative) of every `expect` that sits inside an
+/// open `try` block.
+///
+/// A failed `expect` is an ordinary `Error::Runtime`, so `try ... catch error`
+/// around an assertion turns a red test green. Asserting inside `try` is
+/// therefore a test that cannot fail.
+fn expects_swallowed_by_try(source: &str) -> Vec<usize> {
+    let mut depth = 0usize;
+    let mut try_depths: Vec<usize> = Vec::new();
+    let mut swallowed = Vec::new();
+
+    for (n, line) in source.lines().enumerate() {
+        let t = line.trim();
+        if t.is_empty() || t.starts_with("//") {
+            continue;
+        }
+
+        if t.contains("expect ") && !try_depths.is_empty() {
+            swallowed.push(n + 1);
+        }
+
+        let first = t.split_whitespace().next().unwrap_or("");
+        if BLOCK_OPENERS.contains(&first) {
+            if first == "try" {
+                try_depths.push(depth);
+            }
+            depth += 1;
+        } else if t == "end" && depth > 0 {
+            depth -= 1;
+            if try_depths.last() == Some(&depth) {
+                try_depths.pop();
+            }
+        }
+    }
+
+    swallowed
+}
+
 #[test]
+fn edge_suite_never_asserts_inside_a_try_block() {
+    let mut checked = 0usize;
+
+    for path in suite_files() {
+        let source = read(&path);
+        checked += test_blocks(&source).len();
+        for line in expects_swallowed_by_try(&source) {
+            panic!(
+                "{}:{} asserts inside `try`; `catch error` would swallow the \
+                 failure and the test could never fail",
+                path, line
+            );
+        }
+    }
+
+    assert!(checked >= 40, "only {} test blocks were inspected", checked);
+}
