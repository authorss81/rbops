+/// `map(list, function)` — the higher-order builtin, in the three spellings
+/// `SPEC.md` § list enumerates: `map(xs, f)`, `list.map(xs, f)` and
+/// `[1, 2, 3].map(f)`.
+///
+/// It lives here rather than in `runtime::builtin` because applying a
+/// Redblue function needs this VM's frames, its captured scopes and its
+/// call-depth budget. The tree-walking VM answers the same builtin the same
+/// way; see [`crate::interpreter::Vm::map_builtin`].
+fn map_builtin(&mut self, args: &[Value]) -> Result<Value> {
+    let [Value::List(items), Value::Function(function)] = args else {
+        return Err(Error::Runtime(
+            "map requires a list and a function".to_string(),
+            self.span(),
+        ));
+    };
+    self.apply_map(&items.clone(), function)
+}
+
+/// Applies `function` to every element of `items`, in order.
+///
+/// Each element is one call this VM drives to completion before the next
+/// starts: [`Self::drive`] runs the frames above `base` and stops when they
+/// are gone, and the callee leaves its value on the stack for whoever called
+/// it. A failure inside an element fails the whole call, and the call-depth
+/// budget is charged and released once per element by
+/// [`Self::call_function`], exactly as it is for a call a program writes.
+fn apply_map(&mut self, items: &[Value], function: &FunctionValue) -> Result<Value> {
+    let base = self.frames.len();
+    let mut mapped = Vec::with_capacity(items.len());
+    for item in items {
+        self.call_function(function, std::slice::from_ref(item), None)?;
+        self.drive(base)?;
+        mapped.push(self.stack.pop().unwrap_or(Value::Nothing));
+    }
+    Ok(Value::list(mapped))
+}
+
