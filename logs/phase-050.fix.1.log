+/// it, because a document wraps: SPEC.md writes `is refused as` on one line and
+/// the message on the next.
+fn documented_refusal(body: &str, spelling: &str) -> Option<String> {
+    let lines: Vec<&str> = body.lines().collect();
+    let index = lines
+        .iter()
+        .position(|line| line.contains(spelling) && mentions_a_refusal(line))?;
+    let window: Vec<&str> = lines[index..(index + 3).min(lines.len())].to_vec();
+    let quoted: Vec<&str> = window
+        .iter()
+        .flat_map(|line| backticked_runs(line))
+        .filter(|run| !run.contains('('))
+        .collect();
+    let _ = quoted;
+    None.or_else(|| {
+        // The caller has already run the program, so the message is checked
+        // against its stderr there; here the *candidate* messages are what the
+        // gate offers to match. A candidate is any backticked run in the window
+        // that is not itself a call.
+        let candidates: Vec<String> = window
+            .iter()
+            .flat_map(|line| backticked_runs(line))
+            .filter(|run| !run.contains('('))
+            .map(|run| run.to_string())
+            .collect();
+        candidates.into_iter().next()
