fn dump(label: &str, source: &str) {
    let tokens = redblue::lexer::Lexer::tokenize(source).unwrap();
    match redblue::parser::parse(tokens) {
        Ok(program) => {
            println!("=== {label}: {} top-level statements", program.statements.len());
            for stmt in &program.statements {
                println!("  {:?}", std::mem::discriminant(&stmt.statement));
            }
        }
        Err(error) => println!("=== {label}: parse error: {error}"),
    }
}

#[test]
fn dbg_ast() {
    dump("top-level give back index", "set xs to [1,2]\ngive back xs at 0\n");
    dump("top-level give back this index", "set xs to [1,2]\ngive back xs at this\n");
    dump("in a to-function", "to f()\n    give back xs at this\nend\n");
    dump("object method", "object B\n    has xs default [1,2]\n    to can pick()\n        give back this.xs at 0\n    end\nend\n");
    dump("object method with this", "object B\n    has xs default [1,2]\n    to can pick()\n        give back this.xs at this\n    end\nend\n");
    dump("object method length of this", "object B\n    has xs default [1,2]\n    to can pick()\n        give back length of this\n    end\nend\n");
    dump("object method length of this at 0", "object B\n    has xs default [1,2]\n    to can pick()\n        give back length of this at 0\n    end\nend\n");
}
EOF
