/// The audit, against this repository's `HEAD`.
fn audit_head() -> Result<(Scan, String), String> {
    ensure_full_history()?;
    let log = check_history(is_shallow()?, read_head_log())?;
    let scan = scan(&log, ACKNOWLEDGED)?;
    Ok((scan, log))
}

