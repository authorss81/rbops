use redblue::lexer::Lexer;
use redblue::parser::{parse, Statement};

fn body_of(label: &str, source: &str) {
    let tokens = Lexer::tokenize(source).unwrap();
    let kinds: Vec<String> = tokens
        .iter()
        .map(|t| format!("{:?}", std::mem::discriminant(&t.kind)))
        .collect();
    match parse(tokens) {
        Ok(program) => {
            let inner: Vec<String> = program
                .statements
                .iter()
                .flat_map(|stmt| match &stmt.statement {
                    Statement::Function { body, .. } | Statement::Method { body, .. } => body
                        .iter()
                        .map(|s| format!("{:?}", std::mem::discriminant(&s.statement)))
                        .collect::<Vec<_>>(),
                    _ => Vec::new(),
                })
                .collect();
            println!("=== {label}: tokens={kinds:?} body={inner:?}");
        }
        Err(error) => println!("=== {label}: tokens={kinds:?} parse error: {error}"),
    }
}

#[test]
fn dbg_give_back() {
    body_of("to-function give back 1", "to f()\n    give back 1\nend\n");
    body_of("to-function say 1", "to f()\n    say 1\nend\n");
    body_of("method give back 1", "object B\n    to can pick()\n        give back 1\n    end\nend\n");
    body_of("top-level give back 1", "give back 1\n");
}
EOF
