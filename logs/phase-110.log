        "edge_worded_index_then_a_worded_comparison",
        "set xs to [10, 20, 30]\nsay xs at 0 is greater than 5\n",
    );
    assert_identical(
        "edge_worded_index_then_a_conjunction",
        "set xs to [10, 20, 30]\nsay xs at 1 is 20 and xs at 2 is 30\n",
