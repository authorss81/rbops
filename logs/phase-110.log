use redblue::parser::{Statement, Expr};

fn count(label: &str, source: &str) {
    let tokens = redblue::lexer::Lexer::tokenize(source).unwrap();
    match redblue::parser::parse(tokens) {
        Ok(program) => {
            println!("=== {label}: {} top-level", program.statements.len());
            for stmt in &program.statements {
                match &stmt.statement {
                    Statement::Object { name, body, .. } => {
                        println!("  object {name}: {} body statements", body.len());
                        for inner in body {
                            match &inner.statement {
                                Statement::Method { name, body, .. } => {
                                    println!("    method {name}: {} body statements", body.len());
                                    for m in body {
                                        println!("      {}", describe(&m.statement));
                                    }
                                }
                                other => println!("    {}", describe(other)),
                            }
                        }
                    }
                    other => println!("  {}", describe(other)),
                }
            }
        }
        Err(error) => println!("=== {label}: parse error: {error}"),
    }
}

fn describe(s: &Statement) -> String {
    match s {
        Statement::GiveBack(Some(Expr::Index { index, .. })) => {
            format!("give back index of {:?}", index)
        }
        Statement::GiveBack(Some(Expr::Call { name, args, .. })) => {
            format!("give back call {name} with {args:?}")
        }
        Statement::GiveBack(None) => "give back (no value)".to_string(),
        Statement::Say(e) => format!("say {e:?}"),
        Statement::Expr(e) => format!("expr {e:?}"),
        other => format!("{other:?}").lines().next().unwrap_or("").to_string(),
    }
}

#[test]
fn dbg_ast() {
    count("method: this.xs at 0", "object B\n    has xs default [1,2]\n    to can pick()\n        give back this.xs at 0\n    end\nend\n");
    count("method: this.xs at this", "object B\n    has xs default [1,2]\n    to can pick()\n        give back this.xs at this\n    end\nend\n");
    count("method: length of this", "object B\n    has xs default [1,2]\n    to can pick()\n        give back length of this\n    end\nend\n");
    count("method: length of this at 0", "object B\n    has xs default [1,2]\n    to can pick()\n        give back length of this at 0\n    end\nend\n");
}
EOF
