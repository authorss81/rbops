use redblue::parser::Statement;

#[test]
fn dbg_method_bodies() {
    for (label, body) in [
        ("give back 1", "        give back 1\n"),
        ("say 1", "        say 1\n"),
        ("give back this.xs at 0", "        give back this.xs at 0\n"),
        ("give back length of this", "        give back length of this\n"),
    ] {
        let source = format!("object B\n    has xs default [1,2]\n    to can pick()\n{body}    end\nend\n");
        let tokens = redblue::lexer::Lexer::tokenize(&source).unwrap();
        let program = redblue::parser::parse(tokens).unwrap();
        let kinds: Vec<String> = program
            .statements
            .iter()
            .filter_map(|stmt| match &stmt.statement {
                Statement::Object { body, .. } => Some(
                    body.iter()
                        .filter_map(|inner| match &inner.statement {
                            Statement::Method { body, .. } => Some(
                                body.iter()
                                    .map(|s| format!("{:?}", std::mem::discriminant(&s.statement))
                                        .split_whitespace().collect::<Vec<_>>().join(" "))
                                    .collect::<Vec<_>>(),
                            ),
                            _ => None,
                        })
                        .collect::<Vec<_>>(),
                ),
                _ => None,
            })
            .flatten()
            .collect();
        println!("=== {label}: {kinds:?}");
    }
}
