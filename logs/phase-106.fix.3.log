import math
M=1.7976931348623157e308
def comp(xs):
    s=0.0;c=0.0
    for x in xs:
        t=s+x
        if not math.isfinite(t): return None
        if abs(s)>=abs(x): c+=(s-t)+x
        else: c+=(x-t)+s
        s=t
    return s+c
def mean_hybrid(xs):
    n=len(xs)
    k=math.ceil(math.log2(n))+1
    sc=float(2**k)
    ss=comp([x/sc for x in xs])
    if ss is None: return None
    scaled=ss*sc
    if math.isfinite(scaled):
        return scaled/n
    return (ss/n)*sc
