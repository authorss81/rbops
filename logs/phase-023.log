+/// `rb bootstrap [compiler.rb] [out-dir] [--rollback]` — the S4 release build.
+///
+/// Two paths, and they are the whole of the ladder's operational story:
+///
+/// - the default builds stage 1 with the Rust frontend, stage 2 by running
+///   stage 1 on the compiler's own source, checks the fixed point and writes
+///   stage 2's bytes as the compiler the release carries. A stage 2 that is not
+///   the fixed point is a non-zero exit and nothing shipped;
+/// - `--rollback` is `rb compile` and nothing else, for a machine that cannot
+///   afford the self-compilation. It writes the same bytes.
+fn bootstrap_args(rest: &[String]) -> Result<(), String> {
+    let mut rollback = false;
+    let mut positional: Vec<&str> = Vec::new();
+    for arg in rest {
+        match arg.as_str() {
+            "--rollback" | "-r" => rollback = true,
+            other => positional.push(other),
+        }
+    }
+    if positional.len() > 2 {
+        return Err(format!(
+            "rb bootstrap takes a compiler and an output directory, not {} arguments",
+            positional.len()
+        ));
+    }
+    let compiler = positional.first().copied().unwrap_or("bootstrap/compiler.rb");
+    let out_dir = positional.get(1).copied().unwrap_or("target/bootstrap");
+
+    bootstrap_command(compiler, Some(out_dir)).map_err(|error| error.to_string())?;
+    if rollback {
+        // Cut the release from the Rust frontend instead, and say so: the two
+        // produce the same file, so the difference is which run proved it.
+        let bytes = bootstrap::rollback(Path::new(compiler)).map_err(|e| e.to_string())?;
+        let target = bootstrap::Build::shipped_path(Path::new(out_dir));
+        fs::write(&target, &bytes)
+            .map_err(|e| format!("Error: cannot write {}: {e}", target.display()))?;
+        println!(
+            "Rolled back to the Rust compiler: {} bytes written to {}",
+            bytes.len(),
+            target.display()
+        );
+    }
+    Ok(())
+}
+
+/// The build itself, shared by `rb bootstrap` and the flag handling above.
+fn bootstrap_command(compiler: &str, out_dir: Option<&str>) -> Result<(), String> {
+    let out_dir = out_dir.unwrap_or("target/bootstrap");
+    let built = bootstrap::build(
+        Path::new(compiler),
+        Path::new(out_dir),
+    )
+    .map_err(|error| error.to_string())?;
+
+    println!(
+        "Fixed point holds: stage 1 and stage 2 are one file ({} bytes)",
+        built.stage1.len()
+    );
+    println!(
+        "Shipped compiler: {}",
+        bootstrap::Build::shipped_path(Path::new(out_dir)).display()
+    );
+    Ok(())
+}
+
