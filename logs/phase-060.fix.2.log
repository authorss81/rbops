    fn save_session(&self, path: &str) {
        match self.history.save_to_file(path) {
            Ok(()) => println!(
                "Session saved to '{}' ({} line(s)).",
                path,
                self.history.len()
            ),
            Err(e) => println!("Could not save session: {}", e),
        }
    }

