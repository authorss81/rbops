+    /// Runs the module function `name`, which answers the builtin it is a
+    /// second spelling of, and names a refusal the way the program spelled it.
+    fn call_module_function(&mut self, name: &str, args: &[Value]) -> Result<Value> {
+        let span = self.span();
+        let (builtin, written) = stdlib::resolve_module_function(name)
+            .expect("a module function is one MODULE_FUNCTIONS names");
+        // Too few or too many arguments is refused before the builtin runs, so
+        // a call of one argument with two is an error rather than a call of the
+        // first argument alone.
+        if let (Some(expected), given) = (stdlib::arity(builtin), args.len()) {
+            if given != expected {
+                return Err(Error::Runtime(
+                    format!("{written} takes {expected} argument(s), given {given}"),
+                    span,
+                ));
+            }
+        }
+        match runtime::builtin(span, builtin, args) {
+            Ok(Some(value)) => return Ok(value),
+            Ok(None) => {}
+            Err(Error::Runtime(message, span)) => {
+                return Err(Error::Runtime(
+                    stdlib::named_as(&message, builtin, &written),
+                    span,
+                ));
+            }
+            Err(other) => return Err(other),
+        }
+        match stdlib::builtin_function(builtin, args.to_vec()) {
+            Some(value) => Ok(value),
+            // A builtin with no requirement to state is one that does not
+            // exist, so it is reported as the unknown function it is.
+            None => Err(Error::Runtime(
+                stdlib::requirement(builtin).map_or_else(
+                    || format!("Unknown function '{name}'"),
+                    |needs| format!("{written} requires {needs}"),
+                ),
+                span,
+            )),
+        }
