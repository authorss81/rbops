+pub fn resolve_module_function(name: &str) -> Option<(&'static str, String)> {
+    MODULE_FUNCTIONS.iter().find_map(|(qualified, builtin)| {
+        (*qualified == name).then(|| (*builtin, dotted(name)))
+    })
