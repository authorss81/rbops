+/// A draw in `[0, 1)`, from the top 53 bits — the most an `f64` can name without
+/// rounding, so every one of the `2^53` steps is equally likely to produce it.
+fn next_unit() -> f64 {
+    (next_bits() >> 11) as f64 * (1.0 / (1u64 << 53) as f64)
