use redblue::Value;

fn draws(expr: &str, count: usize) -> Vec<f64> {
    let source = format!(
        "random_seed(12345.0)\nset xs to []\nfor each i from 1 to {count}\n    append(\"xs\", {expr})\nend\nxs"
    );
    let tokens = redblue::lexer::Lexer::tokenize(&source).unwrap();
    let ast = redblue::parser::parse(tokens).unwrap();
    let Value::List(items) = redblue::Vm::new().run(&ast).unwrap() else { panic!() };
    items.iter().map(|v| match v { Value::Number(n) => *n, o => panic!("{o:?}") }).collect()
}

#[test]
fn measure_deciles() {
    for n in [1000usize, 5000, 20000] {
        let mut buckets = [0usize; 10];
        for v in draws("random_number(0, 100)", n) {
            buckets[((v / 10.0).floor() as usize).min(9)] += 1;
        }
        println!("n={n} buckets={buckets:?} min={} max={}", buckets.iter().min().unwrap(), buckets.iter().max().unwrap());
    }
    let v = draws("random_number(0, 100)", 200);
    let distinct: std::collections::BTreeSet<u64> = v.iter().map(|n| n.to_bits()).collect();
    println!("random_number(0,100) 200 draws -> {} distinct", distinct.len());
    let v = draws("random(0, 100)", 200);
    let distinct: std::collections::BTreeSet<i64> = v.iter().map(|n| *n as i64).collect();
    println!("random(0,100) 200 draws -> {} distinct", distinct.len());
}
EOF
