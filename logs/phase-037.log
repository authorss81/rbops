/// a `set` that says nothing about what it did.
pub fn append_through(
    span: Span,
    name: &str,
    current: Option<&mut Value>,
    value: Value,
) -> Result<()> {
    let Some(list) = current else {
        return Err(Error::Runtime(
            format!("Cannot append to '{name}': no name '{name}' is bound to a list"),
            span,
        ));
    };
