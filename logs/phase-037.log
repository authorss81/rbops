name: release

# Binaries for people without Rust installed. Triggered by pushing a version
# tag (v0.1.0 matches Cargo.toml). Native target per runner — no cross-compile
# toolchain juggling. Tests run first in the same job so an artifact can never
# be cut from untested code.
#
# `bootstrap/build.sh` runs the ladder before the binary is uploaded: stage 1
# with the Rust frontend, stage 2 by running stage 1 on the compiler's own
# source, the fixed point compared, and stage 2's bytes written as
# `compiler.rbc`. It exits non-zero on any disagreement, so a release can only
# be cut from a compiler that compiled itself — and `compiler.rbc` is shipped
# alongside `rb`, because the compiler the release carries is part of it.
on:
  push:
    tags: ['v*']

permissions:
  contents: write

jobs:
  build:
