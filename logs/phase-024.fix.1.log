///
/// A `constant` binds a name of the whole program, so it is collected before
/// the statements are walked and read by [`Analyzer::bound_later`]. The walk
/// covers every body — a declaration inside a loop, an `if`, a function or a
/// `try` binds the same program-level name every time it runs, which is why one
/// declaration inside a function body counts.
fn collect_constant_names(statements: &[Stmt], out: &mut HashSet<String>) {
    for stmt in statements {
        match &stmt.statement {
            Statement::Constant { name, .. } => {
                out.insert(name.clone());
            }
            Statement::If {
                then_branch,
                else_branch,
                ..
            } => {
                collect_constant_names(then_branch, out);
                collect_constant_names(else_branch, out);
            }
            Statement::ForEach { body, .. }
            | Statement::ForRange { body, .. }
            | Statement::Repeat { body, .. }
            | Statement::While { body, .. } => collect_constant_names(body, out),
            Statement::Function { body, .. }
            | Statement::Method { body, .. }
            | Statement::Object { body, .. }
            | Statement::Test { body, .. } => collect_constant_names(body, out),
            Statement::Try {
                body,
                catch_body,
                finally_body,
                ..
            } => {
                collect_constant_names(body, out);
                collect_constant_names(catch_body, out);
                collect_constant_names(finally_body, out);
            }
            Statement::Say(_)
            | Statement::Print(_)
            | Statement::Set { .. }
            | Statement::SetProperty { .. }
            | Statement::Return(_)
            | Statement::GiveBack(_)
            | Statement::Break
            | Statement::Skip
            | Statement::Has { .. }
            | Statement::Import(_)
            | Statement::Expr(_) => {}
        }
    }
}"""
