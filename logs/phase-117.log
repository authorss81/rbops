+        (Paint::Heading, "1;34"),
+        (Paint::Result, "0;32"),
+        (Paint::Error, "1;31"),
+        (Paint::Dim, "2;30"),
+        (Paint::BrandRed, "1;31"),
+        (Paint::BrandBlue, "1;34"),
+        (Paint::BrandMid, "1;35"),
+        (Paint::Keyword, "0;35"),
+        (Paint::Str, "0;32"),
+        (Paint::Number, "0;34"),
+        (Paint::Comment, "0;90"),
+        (Paint::Builtin, "4;34"),
+        (Paint::Operator, "0;30"),
+    ],
