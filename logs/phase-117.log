        assert!(
            self.stdout.contains(needle),
            "stdout should contain {:?}\n--- actual ---\n{}",
            needle,
            self.stdout
        );
        self
    }

    fn assert_stdout_lacks(&self, needle: &str) -> &Self {
        assert!(
            !self.stdout.contains(needle),
            "stdout should not contain {:?}\n--- actual ---\n{}",
            needle,
            self.stdout
        );
        self
