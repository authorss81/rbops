import re, subprocess

docs = ["SPEC.md", "README.md", "PHILOSOPHY.md", "HANDOUT.md", "docs/GRAMMAR.md"]
old = {d: subprocess.run(["git","show",f"HEAD:{d}"],capture_output=True,text=True).stdout for d in docs}
new = {d: open(d).read() for d in docs}

def fences(text):
    return [i+1 for i,l in enumerate(text.split("\n")) if l.strip().startswith("```redblue")]

mapping = {}
for d in docs:
    o, n = fences(old[d]), fences(new[d])
    assert len(o) == len(n), (d, len(o), len(n))
    for a, b in zip(o, n):
        mapping[f"{d}:{a}"] = f"{d}:{b}"

pattern = re.compile(r"^(" + "|".join(re.escape(d) for d in docs) + r"):(\d+)(\t.*)?$")
total = 0
for f in ["tests/doc_blocks_runs.txt","tests/doc_blocks_fragments.txt","tests/doc_blocks_known_fail.txt"]:
    out = []
    for line in open(f).read().split("\n"):
        m = pattern.match(line)
        if m:
            key = f"{m.group(1)}:{m.group(2)}"
            assert key in mapping, (f, key)
            line = mapping[key] + (m.group(3) or "")
            total += 1
        out.append(line)
    open(f,"w").write("\n".join(out))
print("renumbered", total, "entries")
