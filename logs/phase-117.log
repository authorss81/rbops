+/// rather than yellow — yellow is the one bright colour with no readable dark
+/// equivalent, and an underline reads against any background.
+const LIGHT: Palette = Palette {
+    name: "light",
+    description: "Light terminal background: dark foreground colours.",
+    sgr: &[
