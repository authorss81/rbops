    /// Asserts the session exited cleanly, quoting both streams.
    fn assert_exited_ok(&self) -> &Self {
        assert_eq!(
            self.code,
            Some(0),
            "the REPL should exit 0\nstdout:\n{}\nstderr:\n{}",
            self.stdout,
            self.stderr
        );
        self
    }

