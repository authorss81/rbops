import re, subprocess

docs = ["SPEC.md", "README.md", "PHILOSOPHY.md", "HANDOUT.md", "docs/GRAMMAR.md"]
old = {}
for d in docs:
    old[d] = subprocess.run(["git","show",f"HEAD:{d}"],capture_output=True,text=True).stdout
new = {d: open(d).read() for d in docs}

def fences(text):
    lines = text.split("\n")
    return [i+1 for i,l in enumerate(lines) if l.strip().startswith("```redblue")]

for d in docs:
    o, n = fences(old[d]), fences(new[d])
    assert len(o) == len(n), (d, len(o), len(n))
print("block counts unchanged:", {d: len(fences(new[d])) for d in docs})

for f in ["tests/doc_blocks_runs.txt","tests/doc_blocks_fragments.txt","tests/doc_blocks_known_fail.txt"]:
    lines = open(f).read().split("\n")
    counts = {d:0 for d in docs}
    out = []
    for line in lines:
        m = re.match(r"^(" + "|".join(re.escape(d) for d in docs) + r"):(\d+)(\t.*)?$", line)
        if m:
            d = m.group(1)
            idx = counts[d]
            counts[d] += 1
            line = f"{d}:{fences(new[d])[idx]}{m.group(3) or ''}"
        out.append(line)
    for d in docs:
        assert counts[d] == len(fences(new[d])), (f, d, counts[d])
    open(f,"w").write("\n".join(out))
    print("rewrote", f)
