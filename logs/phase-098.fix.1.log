            Some(Constant::Text(text)) => Ok(text.clone()),
            Some(other) => Err(Error::Runtime(
                format!("bytecode expects a name at constant {index}, found {other}"),
                self.span(),
            )),
            None => Err(Error::Runtime(
                format!(
