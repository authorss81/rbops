    let mut input = String::from("repeat 3 times\n");
    for index in 0..600 {
        input.push_str(&format!("    say \"LINE {}\"\n", index));
    }
    input.push_str("say \"AFTER THE BLOCK\"\n:quit\n");

    let s = session(&input);

