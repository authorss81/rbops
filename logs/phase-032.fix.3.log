+    ("formats_parse_json", "json_parse"),
+    ("formats_to_json", "json_stringify"),
+    ("json_parse", "json_parse"),
+    ("json_stringify", "json_stringify"),
+    ("list_length", "length"),
+    ("math_abs", "abs"),
+    ("math_ceil", "ceil"),
+    ("math_floor", "floor"),
+    ("math_random", "random_number"),
+    ("math_round", "round"),
+    ("math_seed", "random_seed"),
