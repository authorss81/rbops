        let mut history = ReplHistory::new(1);
        history.push("say \"Hello\"".to_string());
        history.push("say \"hello\"".to_string());

        assert_eq!(history.len(), 1);
        assert_eq!(history.get(0).map(String::as_str), Some("say \"hello\""));
