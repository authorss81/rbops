                Ok(Line::Text(text)) => text,
                // Ctrl-C throws away the line being written, not the session.
                Ok(Line::Interrupted) => continue,
                Ok(Line::Eof) => {
                    // A block the sub-REPL was holding is the sub-REPL's to
                    // report: the parent's buffer never saw it.
