        /// nothing left over from the first.
        #[test]
        fn profile_reports_only_the_last_block_not_the_earlier_one() {
            let mut repl = Repl::new();
            feed(
                &mut repl,
                &[
                    "set left to 0",
                    "for each i from 1 to 3",
                    "    set left to left + i",
                    "end",
                ],
            );
            feed(
                &mut repl,
                &[
                    "set right to 7",
                    "if right is greater than 0 then",
                    "    set right to right - 1",
