diff --git a/src/interpreter.rs b/src/interpreter.rs
index edcb93f..0d6f68e 100644
--- a/src/interpreter.rs
+++ b/src/interpreter.rs
@@ -2941,4 +2941,45 @@ mod tests {
              restarted with it"
         );
     }
+
+    /// A user function's body is not part of the block being profiled, so its
+    /// time belongs to the line that called it. The body's own lines are never
+    /// timed, even though they run inside the call-site statement.
+    #[test]
+    fn profile_keeps_a_user_function_body_at_its_call_site() {
+        let source = "\
+to add_up(n)
+    set total to 0
+    for each i from 1 to n
+        set total to total + i
+    end
+    give back total
+end
+set answer to add_up(20000)
+";
+        let program = crate::lexer::Lexer::tokenize(source)
+            .and_then(|tokens| crate::parser::Parser::new(tokens).parse())
+            .expect("the profiling fixture is a valid program");
+
+        let mut vm = Vm::new();
+        vm.start_line_profile();
+        vm.run(&program).expect("the fixture runs");
+
+        let timings = vm
+            .take_line_profile()
+            .expect("a profile was started and not yet taken");
+        assert!(
+            timings.iter().any(|(line, _)| *line == 8),
+            "the call-site line is timed: {:?}",
+            timings
+        );
+        for body_line in 2..=6 {
+            assert!(
+                !timings.iter().any(|(line, _)| *line == body_line),
+                "line {body_line} is inside the function body and must stay \
+                 attributed to the call site, not itself: {:?}",
+                timings
+            );
+        }
+    }
 }
diff --git a/src/repl/mod.rs b/src/repl/mod.rs
index a38716b..4c2bcd3 100644
--- a/src/repl/mod.rs
+++ b/src/repl/mod.rs
@@ -9496,7 +9496,7 @@ mod tests {
                 .unwrap_or_else(|| panic!("{:?} should carry a figure", line))
         }
 
-        /// A 10 KB text is the largest binding, named with a human size whose
+        /// A 10 KiB text is the largest binding, named with a human size whose
         /// raw byte count is within 10% of what was put in.
         #[test]
         fn mem_reports_the_largest_binding_and_its_size() {
@@ -9518,7 +9518,7 @@ mod tests {
                 .unwrap_or_else(|| panic!("the binding is named: {}", joined));
 
             assert!(
-                payload_line.contains("10.0 KB (10240 B)"),
+                payload_line.contains("10.0 KiB (10240 B)"),
                 "the size is human-readable with raw bytes: {}",
                 payload_line
             );
@@ -9599,7 +9599,7 @@ mod tests {
 
             assert!(joined.contains("huge"), "{}", joined);
             assert!(
-                joined.contains("5.0 MB (5242880 B)"),
+                joined.contains("5.0 MiB (5242880 B)"),
                 "the largest binding's logical size is reported: {}",
                 joined
             );
@@ -9679,6 +9679,75 @@ mod tests {
                 rows
             );
         }
+
+        /// `.profile` answers about the block that just ran, not about every
+        /// block the session has run. A four-line block followed by a
+        /// three-line one reports the second alone: its lines, its timings and
+        /// nothing left over from the first.
+        #[test]
+        fn profile_reports_only_the_last_block_not_the_earlier_one() {
+            let mut repl = Repl::new();
+            feed(
+                &mut repl,
+                &[
+                    "set left to 0",
+                    "for each i from 1 to 3",
+                    "    set left to left + i",
+                    "end",
+                ],
+            );
+            feed(
+                &mut repl,
+                &[
+                    "set right to 7",
+                    "if right is greater than 0 then",
+                    "    set right to right - 1",
+                    "end",
+                ],
+            );
+
+            let block = repl
+                .last_profile
+                .as_ref()
+                .expect("the second block just ran");
+            assert_eq!(
+                block.lines,
+                vec![
+                    "if right is greater than 0 then".to_string(),
+                    "    set right to right - 1".to_string(),
+                    "end".to_string(),
+                ],
+                "the profile keeps the last block's source, not the first's"
+            );
+            assert!(
+                block
+                    .timings
+                    .iter()
+                    .all(|(line, _)| (1..=block.lines.len()).contains(line)),
+                "every timing belongs to a line of the last block: {:?}",
+                block.timings
+            );
+
+            let lines = repl
+                .profile_answer()
+                .expect("the second block just ran, so it has a profile");
+            let joined = lines.join("\n");
+            assert!(
+                lines[0].contains("3 line(s)"),
+                "the report is about the last block: {:?}",
+                lines
+            );
+            assert!(
+                joined.contains("if right is greater than 0 then"),
+                "the last block's source is quoted: {}",
+                joined
+            );
+            assert!(
+                !joined.contains("left"),
+                "nothing from the earlier block survives: {}",
+                joined
+            );
+        }
     }
 
     /// A failure a session reports points at the line the user typed.
