pub fn non_finite_display(n: f64) -> Option<&'static str> {
    if n.is_finite() {
        None
    } else if n.is_nan() {
        Some("not a number")
    } else if n > 0.0 {
        Some("infinity")
    } else {
        Some("negative infinity")
    }
}

