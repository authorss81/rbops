+fn human_unit(bytes: usize, unit: usize, name: &str) -> String {
+    let unit = unit as u128;
+    let mut whole = bytes as u128 / unit;
+    let remainder = bytes as u128 % unit;
+    let mut tenths = (remainder * 10 + unit / 2) / unit;
+    if tenths == 10 {
+        whole += 1;
+        tenths = 0;
+    }
+    format!("{whole}.{tenths} {name} ({} B)", bytes)
