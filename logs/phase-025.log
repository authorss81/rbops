test "loop control: a break ends a range loop at the value that broke"
    // `for each i from a to b [by s]` is in the grammar and in the parser, so this
    // is the loop form a program writes rather than one built by hand.
    set seen to ""
    for each i from 1 to 5
        if i is 3 then
            break
        end
        set seen to seen + i
    end
    expect seen to be "12"
end

test "loop control: a skip advances a range loop to its next value"
    set seen to ""
    for each i from 1 to 5 by 2
        if i is 2 then
            skip
        end
        set seen to seen + i
    end
    // 0 is not visited, 2 is skipped, and the stride never lands on 4 again.
    expect seen to be "024"
end

test "loop control_edge_a_break_in_a_nested_range_loop_leaves_only_the_inner_one"
    set outer to ""
    set inner to ""
    for each i from 1 to 3
        for each j from 1 to 3
            if j is 2 then
                break
            end
            set inner to inner + j
        end
        set outer to outer + i
    end
    // Each outer turn ran the inner body once, and the outer loop still reached 3.
    expect outer to be "123"
    expect inner to be "111"
end

test "loop_control_edge_a_range_loop_that_runs_no_turns_is_unaffected_by_both"
    set turned to 0
    for each i from 5 to 1
        set turned to turned + 1
        break
    end
    for each j from 1 to 3
        if j is 2 then
            skip
        end
        set turned to turned + 1
    end
    expect turned to be 2
end
