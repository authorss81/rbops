+    &mut self,
+    variable: Option<&str>,
+    value: Option<Value>,
+    body: &[Stmt],
+) -> Result<Option<LoopControl>> {
+    self.push_scope();
+    if let Some(variable) = variable {
+        self.declare(variable);
+        self.set_var(variable, value.unwrap_or(Value::Nothing))?;
+    }
+    for stmt in body {
+        self.execute_statement(stmt)?;
