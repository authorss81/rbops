+/// A `while` that ends because its condition went false has spent turns, not
+/// tried to spend one more.
+///
+/// The cap is checked when a turn is *about to run*: the tree-walking VM charges
+/// at the top of every turn, and the bytecode VM charges in the same two places —
+/// the backward `JUMP` a completed turn takes, and `turn_over_to` for the turn a
+/// `skip` starts. Both are reached only on a turn that ran. A `while` whose
+/// condition is false on arrival therefore spends no turn at the cap, which is
+/// what makes a cap of N allow N turns rather than N − 1.
+#[test]
+fn edge_a_cap_allows_a_while_exactly_that_many_turns() {
+    // `turns` counts in the body's first statement, so the number the program
+    // prints is the number of turns the cap allowed.
+    let looping = |statement: &str| {
+        format!(
+            "set turns to 0\nwhile turns is not {CAP_TURNS}\n    set turns to turns + 1\n\
+             {statement}end\nsay turns\n"
+        )
+    };
+
+    for (name, source) in [
+        ("plain", looping("")),
+        ("skipping", looping("    skip\n")),
+    ] {
+        for cap in [1, 2, 3, 4] {
+            let (tree, _) = assert_agrees_capped(&source, cap);
+            assert_eq!(
+                tree.output,
+                vec![cap.to_string()],
+                "a cap of {cap} must be exactly {cap} turns of a {name} `while` on both \
+                 VMs, not {cap} on one and {} on the other",
+                cap.saturating_sub(1),
+            );
+        }
+    }
+}
+
+/// The turn count a `while` is allowed at a cap is the same on both engines, and
+/// the same as a sequence loop's.
+const CAP_TURNS: usize = 5;
+
