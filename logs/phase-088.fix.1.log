+/// Whether the text holds the words, in order, each on a word boundary.
+///
+/// `expect x to be y` holds `["t", "o", "b", "e"]`: the words `to` and `be`,
+/// separated by one space, each standing on its own.
+fn has_word_sequence(text: &[char], words: &[char]) -> bool {
+    let mut from = 0;
+    while let Some(offset) = find_sub(&text[from..], words) {
+        let at = from + offset;
+        let before_ok = at == 0 || !is_ident_continue(text[at - 1]);
+        let after = at + words.len();
+        let after_ok = after >= text.len() || !is_ident_continue(text[after]);
+        if before_ok && after_ok {
+            return true;
+        }
+        from = at + 1;
+    }
+    false
+}
