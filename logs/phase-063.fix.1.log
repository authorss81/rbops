+    let line = format!("set read_back to json.parse({})", literal);
+    feed(&mut repl, &[line.as_str()]);
+
+    assert_eq!(
+        repl.lookup("read_back").cloned(),
+        repl.lookup("original").cloned(),
+        "the document the REPL printed reads back as the value it came from:\n{}",
+        shown
+    );
