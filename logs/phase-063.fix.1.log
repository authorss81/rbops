+/// The text as a JSON string, with the characters a terminal acts on spelled
+/// out.
+///
+/// The language's own writer escapes what JSON must escape — the quote, the
+/// backslash, the line break — and leaves the rest of the text as it is. Two
+/// families are left raw by it and are not left raw here: the C1 controls, and
+/// the bidi and zero-width marks. A terminal acts on both of them: a
+/// right-to-left override reorders the line it is on, and a zero-width mark
+/// takes no room at all while still changing what is around it.
+///
+/// The escape is JSON's own — `\uXXXX` — and not the table's `\u{XXXX}`: the
+/// document is still a document, so `json.parse` reads the character back and
+/// the value the document came from is the value that comes back.
+///
+/// `.json` does **not** do this, and the difference is deliberate: `.json` is
+/// the document `json.stringify` writes, byte for byte, and a document that
+/// differed from the language's own writer would be a document a program
+/// could not reproduce. `.pretty` is a rendering, and a rendering is what the
+/// reader looks at.
+fn json_text(text: &str) -> String {
+    let escaped = crate::runtime::json_escape_text(text);
+    let mut out = String::with_capacity(escaped.len());
+    for c in escaped.chars() {
+        if mangles_the_terminal(c) {
+            out.push_str(&format!("\\u{:04x}", c as u32));
+        } else {
+            out.push(c);
+        }
+    }
