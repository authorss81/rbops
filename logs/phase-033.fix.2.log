+/// Runs `program` in this session's VM and prints what it printed.
+///
+/// [`Vm::run`] prints the VM's whole output buffer at the end of a program,
+/// and that buffer belongs to the VM, not to one line. Printing it again here
+/// meant every line re-printed everything the lines before it had said —
+/// `say "A"` on the second line came back on every line after it, so a
+/// session's output grew quadratically with its length.
+///
+/// Draining it first also means a program that fails half way through does
+/// not lose the `say` it had already run: its output is printed with the
+/// error rather than appearing several lines later, in the next program.
+fn run_program(&mut self, program: &Program) -> Result<Value, crate::error::Error> {
+    self.vm.take_output();
+    let result = self.vm.run(program);
+    for line in self.vm.take_output() {
+        println!("{}", line);
+    }
+    result
