+    /// added to the table cannot be missing from the help.
+    pub fn help_lines() -> Vec<String> {
+        COMMAND_TABLE
+            .iter()
+            .map(|spec| match spec.usage {
+                Some(usage) => format!("  :{} {}  {}", spec.names[0], usage, spec.describe()),
+                None => format!("  :{}  {}", spec.names[0], spec.describe()),
