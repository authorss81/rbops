    push_u16(out, 20);
    push_u16(out, 20);
    push_u16(out, 0x0800);
    push_u16(out, 0);
    push_u16(out, 0);
    push_u16(out, 0);
    push_u32(out, entry.crc);
    push_u32(out, size);
    push_u32(out, size);
    push_u16(out, name_len);
    push_u16(out, 0);
    push_u16(out, 0);
    push_u16(out, 0);
    push_u16(out, 0);
    push_u32(out, 0);
    push_u32(out, entry.offset);
    out.extend_from_slice(name);
    Ok(())
}

