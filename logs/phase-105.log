from pathlib import Path
p=Path('src/formats.rs')
s=p.read_text()
start=s.index('    fn open_table(&mut self, root: &mut Toml, path: &[String], array: bool) -> Result<Vec<Step>, String> {')
end=s.index('    fn parse_value(&mut self)', start)
new='''    fn open_table(
        &mut self,
        root: &mut Toml,
        path: &[String],
        array: bool,
    ) -> Result<Vec<Step>, String> {
        let mut steps = Vec::new();
        let mut table = match root {
            Toml::Table(fields) => fields,
            _ => return self.error("the document root is not a table"),
        };

        for (index, key) in path.iter().enumerate() {
            let last = index + 1 == path.len();
            if last && array {
                if !table.contains_key(key) {
                    table.insert(key.clone(), Toml::Array(Vec::new()));
                }
                let length = match table.get_mut(key).expect("just inserted") {
                    Toml::Array(items) => {
                        items.push(Toml::Table(TomlTable::new()));
                        items.len()
                    }
                    _ => {
                        return self.error(format!(
                            "'{key}' is already defined and is not an array of tables"
                        ))
                    }
                };
                steps.push(Step::Key(key.clone()));
                steps.push(Step::Index(length - 1));
                return Ok(steps);
            }

            if !table.contains_key(key) {
                table.insert(key.clone(), Toml::Table(TomlTable::new()));
            }
            let entry = table.get_mut(key).expect("just inserted");
            match entry {
                Toml::Table(fields) => {
                    steps.push(Step::Key(key.clone()));
                    table = fields;
                }
                Toml::Array(items) => {
                    let length = items.len();
                    let Some(Toml::Table(fields)) = items.last_mut() else {
                        return self.error(format!("'{key}' is not a table"));
                    };
                    steps.push(Step::Key(key.clone()));
                    steps.push(Step::Index(length - 1));
                    table = fields;
                }
                _ => {
                    return self.error(format!("'{key}' is already a value, not a table"));
                }
            }
        }
        Ok(steps)
    }

