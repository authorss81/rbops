[0m$ [0mcd /tmp/opencode/sweep && rm -f *.rb *.rbc && python3 - <<'PY'
import itertools
loops = [
    ("repeat {n} times", ["set c to c + 1", "say c", "skip"]),
    ("while c is 0", ["set c to c + 1", "say c", "skip"]),
    ("for each v in [1, 2, 3]", ["set c to c + 1", "say c", "skip"]),
    ("for each v from 1 to 3", ["set c to c + 1", "say c", "skip"]),
    ("repeat {n} times\n    repeat 2 times\n        set c to c + 1\n        skip\n    end", ["set c to c + 1"]),
]
counts = ["1", "2", "2.5", "0.5", "-1", "-0.5", "3"]
extras = ["", "break", "skip", "if c is 2 then\n        break\n    end"]
n = 0
for (head, body), count, extra in itertools.product(loops, counts, extras):
    h = head.replace("{n}", count)
    src = "set c to 0\n%s\n" % h
    for b in body:
        src += "    %s\n" % b
    if extra:
        src += "    " + extra + "\n"
    src += "end\nsay c\n"
    open("p%04d.rb" % n, "w").write(src)
    n += 1
print(n)
