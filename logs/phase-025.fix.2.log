[0m$ [0mcat > target/tmp/diffcheck.sh <<'SH'
#!/bin/bash
# Runs every probe on both VMs and reports any disagreement.
cd /home/runner/work/rbops/rbops/redblue
for f in "$@"; do
  t=$(cargo run -q --bin rb -- run "$f" 2>&1; echo "exit=$?")
  cargo run -q --bin rb -- compile "$f" -o "${f%.rb}.rbc" >/dev/null 2>&1
  b=$(cargo run -q --bin rb -- vm "${f%.rb}.rbc" 2>&1; echo "exit=$?")
  # strip rendered positions, which differ by design (a .rbc has no source)
  tn=$(printf '%s' "$t" | sed -E 's/^ *--> .*$/--> pos/; s/^ *[0-9]+ \|.*$//; s/^ *\| *$//; s/=+$/=/')
  bn=$(printf '%s' "$b" | sed -E 's/^ *--> .*$/--> pos/')
  if [ "$tn" = "$bn" ]; then
    echo "AGREE  $f"
  else
    echo "DIFFER $f"
    printf '%s\n' "--- tree ---\n$tn\n--- bytecode ---\n$bn\n"
  fi
done
SH
chmod +x target/tmp/diffcheck.sh && echo ok
ok
