import re
text=open('docs/GRAMMAR.md').read()
lines=text.split('\n')
# fenced blocks (no language tag)
blocks=[]
cur=None
for i,l in enumerate(lines,1):
    t=l.strip()
    if t.startswith('```'):
        if cur is None:
            cur=(i,[])
        else:
            blocks.append((cur[0],cur[1]))
            cur=None
    elif cur is not None:
        cur[1].append(l)
# sections
heads=[]
for i,l in enumerate(lines):
    if l.startswith('#'): heads.append((i+1,l))
def section_of(line):
    h=''
    for n,t in heads:
        if n<=line: h=t
        else: break
    return h
kw=set()
# keywords table
m=text.split('### 1.3 Keywords (Reserved)')[1].split('```')[1]
kw=set(w for w in re.findall(r"'([^']+)'",m) if ' ' not in w)
print("KEYWORDS:",sorted(kw))
seen={}
for start,body in blocks:
    if start<130: pass
    for l in body:
        for w in re.findall(r"'([^']+)'",l):
            if w in kw: continue
            if not re.fullmatch(r"[a-z][a-z /]*",w): continue
            seen.setdefault(w,set()).add(section_of(start))
for w,s in sorted(seen.items()):
    print(repr(w), sorted(s))
