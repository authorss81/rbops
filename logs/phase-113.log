import subprocess,re
def blocks(text):
    lines=text.split('\n'); out=[]; fence=False
    for i,l in enumerate(lines,1):
        t=l.strip()
        if t.startswith('```'):
            if not fence:
                info=t[3:].split()
                if info and info[0]=='redblue': out.append(i)
            fence = not fence
    return out
mapping={}
for doc in ['SPEC.md','docs/GRAMMAR.md']:
    old=subprocess.run(['git','show','HEAD:'+doc],capture_output=True,text=True).stdout
    o=blocks(old); n=blocks(open(doc).read())
    assert len(o)==len(n), (doc,len(o),len(n))
    for a,b in zip(o,n):
        if a!=b: mapping[(doc,a)]=b
for f in ['tests/doc_blocks_runs.txt','tests/doc_blocks_fragments.txt','tests/doc_blocks_known_fail.txt']:
    out=[]
    for line in open(f).read().split('\n'):
        m=re.match(r'^((?:docs/)?[A-Za-z0-9_.]+\.md):(\d+)(\t.*)?$',line)
        if m:
            key=(m.group(1),int(m.group(2)))
            if key in mapping: line=f"{key[0]}:{mapping[key]}{m.group(3) or ''}"
        out.append(line)
    open(f,'w').write('\n'.join(out))
print("remapped", len(mapping))
