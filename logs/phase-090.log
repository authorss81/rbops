fn main() {
    let cases: Vec<(&str, &str)> = vec![
        ("empty", ""),
        ("unterminated string", "set x to \"abc\nsay x\n"),
        ("unclosed if", "if 1 > 0 then\n  say \"hi\"\n"),
        ("stray close paren", "say (1 + 2))\n"),
        ("unclosed list", "set xs to [1, 2, 3\nsay xs\n"),
        ("empty list index", "set xs to []\nsay xs[0]\n"),
        ("bad number", "set x to 1 + \"two\"\nsay x\n"),
        ("division by zero", "set x to 1 / 0\nsay x\n"),
        ("interp of nothing", "say \"a{nothing}b\"\n"),
    ];
    for (name, src) in cases {
        let lex = redblue::lexer::Lexer::tokenize(src);
        match lex {
            Err(e) => println!("{name:22} LEX-ERR  {e}"),
            Ok(toks) => match redblue::parser::parse(toks) {
                Err(e) => println!("{name:22} PARSE-ERR {e}"),
                Ok(ast) => match redblue::analyzer::analyze(&ast) {
                    Err(e) => println!("{name:22} ANALYZE-ERR {e}"),
                    Ok(()) => {
                        let (_vm, r) = redblue::run_isolated(&ast);
                        match r {
                            Ok(v) => println!("{name:22} OK        {v:?}"),
                            Err(e) => println!("{name:22} RUN-ERR   {e}"),
                        }
                    }
                },
            },
        }
    }
}
