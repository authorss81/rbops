+            Error::Io(format!(
+                "Cannot read test directory '{}': {}",
+                dir.display(),
+                error
+            ))
+        })?;
+        let path = entry.path();
+        if path.is_dir() {
+            files.extend(collect_test_files(&path)?);
+        } else if path.extension() == Some("rb".as_ref()) {
+            files.push(path);
         }
     }
 
