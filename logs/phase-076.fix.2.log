# The benchmark harness. It is a plain binary, not a `[[bench]]` target: a
# `[[bench]]` is built and executed by `cargo test --all-targets`, and a
# measurement that writes `BENCH.md` must not run inside the test gate. The
# workloads' correctness checks do run there, via `tests/bench_test.rs`.
[[bin]]
name = "rb-bench"
path = "tests/bench/runner.rs"

# `cdylib` is what makes the WebAssembly playground module: it is the crate type
# that emits a `.wasm` and exports every `#[no_mangle]` symbol the library
# defines, which is what `wasm/redblue.js` calls. Built with:
#
#   rustup target add wasm32-unknown-unknown
#   cargo build --release --target wasm32-unknown-unknown --lib
#
# writing `target/wasm32-unknown-unknown/release/redblue.wasm`. `rlib` is kept
# so the native `rb` binary and the test suite link exactly as they did.
[lib]
name = "redblue"
path = "src/lib.rs"
crate-type = ["rlib", "cdylib"]

[dependencies]
regex = "1.10"
chrono = "0.4"
reqwest = { version = "0.11", features = ["blocking"] }
indexmap = "2"
rustyline = "18"
base64 = "0.21"
hex = "0.4"
sha2 = "0.10"
uuid = { version = "1", features = ["v4"] }
getrandom = "0.4"
ndarray = "0.15"
unicode-width = "0.2"

[target.'cfg(unix)'.dependencies]
libc = "0.2"

[dev-dependencies]
regex = "1.10"
serde_json = "1.0"

[profile.release]
opt-level = 3
lto = true
