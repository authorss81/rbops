pub fn run_source_value(source: &str) -> Result<Value, Error> {
    run_source_value_in(source, Path::new("."))
}

/// [`run_source_value`] against `root` — see [`run_source_in`].
pub fn run_source_value_in(source: &str, root: &Path) -> Result<Value, Error> {
    // A program starts from the documented defaults. The configuration is
    // thread-local: this reset reaches the inline wasm path, and the interpreter
    // resets again on the thread it actually runs the program on, so a native
    // run cannot inherit an earlier program's threshold, destination or
    // timestamp mode.
    logging::reset();
    let tokens = Lexer::tokenize(source)?;
    let ast = parser::parse(tokens)?;
    analyzer::analyze_in(&ast, root)?;

    let (_vm, result) = interpreter::run_isolated_in(&ast, root);
    result
}

pub fn run_repl() {
    let mut repl = repl::Repl::new();
    repl.run();
}

pub fn run_test(path: Option<&str>) -> Result<(), Error> {
    match path {
        Some(p) => {
            let mut harness = testing::TestHarness::new();
            harness.run_file(p)?;
            // Report the failures and exit non-zero. Without this a failing
            // `expect` printed only a dot/F and still exited 0.
            testing::PrettyReporter::new().report(&harness.results());
        }
        None => {
            // Bare `rb test` is about the project the caller is standing in,
            // not about whichever `tests/` happens to be in the working
            // directory. The walk finds the nearest manifest at or above the
            // working directory, so `rb test` from `src/` still runs the
            // project's own suite.
            let cwd = env::current_dir().map_err(|error| {
                Error::Io(format!("Cannot read the working directory: {error}"))
            })?;
            let root = project::find_project_root(&cwd).ok_or_else(|| {
                Error::Runtime(
                    "No Redblue project found here: run `rb new <name>` to create one".to_string(),
                    Span::unknown(),
                )
            })?;
            project::check_manifest(&root)?;

            let results = testing::run_tests_in(&project::tests_dir(&root).to_string_lossy())?;
            println!("Tests run: {}", results.total);
            println!("Passed: {}", results.passed);
            println!("Failed: {}", results.failed);
            if results.failed > 0 {
                process::exit(1);
            }
        }
    }

    Ok(())
}

pub fn run_cli() {
    let args: Vec<String> = env::args().collect();

    match args.len() {
        1 => run_repl(),
        2 => {
            let cmd = &args[1];
            match cmd.as_str() {
                "help" | "--help" | "-h" => print_help(),
                "version" | "--version" | "-v" => print_version(),
                "test" => {
                    if let Err(e) = run_test(None) {
