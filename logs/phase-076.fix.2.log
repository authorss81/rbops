        root.join("passing.rb"),
        "test \"explicit\"\n    expect 1 + 1 to be 2\nend\n",
    )
    .expect("fixture file");

    let ran = run_in(&root, &["test", "passing.rb"]);
    assert!(
        ran.status.success(),
        "`rb test <path>` must run only the named file: {}{}",
        stdout(&ran),
        stderr(&ran)
    );
}
