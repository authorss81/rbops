pub fn run_repl() {
    let mut repl = repl::Repl::new();
    repl.run();
}

pub fn run_test(path: Option<&str>) -> Result<(), Error> {
    match path {
        Some(p) => {
            let mut harness = testing::TestHarness::new();
            harness.run_file(p)?;
            // Report the failures and exit non-zero. Without this a failing
            // `expect` printed only a dot/F and still exited 0.
            testing::PrettyReporter::new().report(&harness.results());
        }
        None => {
            // Bare `rb test` is about the project the caller is standing in,
            // not about whichever `tests/` happens to be in the working
            // directory. The walk finds the nearest manifest at or above the
            // working directory, so `rb test` from `src/` still runs the
            // project's own suite.
            let cwd = env::current_dir().map_err(|error| {
                Error::Io(format!("Cannot read the working directory: {error}"))
            })?;
            let root = project::find_project_root(&cwd).ok_or_else(|| {
                Error::Runtime(
                    "No Redblue project found here: run `rb new <name>` to create one".to_string(),
                    Span::unknown(),
                )
            })?;
            project::check_manifest(&root)?;

            let results = testing::run_tests_in(&project::tests_dir(&root).to_string_lossy())?;
            println!("Tests run: {}", results.total);
            println!("Passed: {}", results.passed);
            println!("Failed: {}", results.failed);
            if results.failed > 0 {
                process::exit(1);
            }
        }
    }

    Ok(())
}

pub fn run_cli() {
    let args: Vec<String> = env::args().collect();

    match args.len() {
        1 => run_repl(),
        2 => {
            let cmd = &args[1];
            match cmd.as_str() {
                "help" | "--help" | "-h" => print_help(),
                "version" | "--version" | "-v" => print_version(),
                "test" => {
                    if let Err(e) = run_test(None) {
                        eprintln!("Error: {}", e);
                        process::exit(1);
                    }
                }
                // Bare `rb new` names no project, and guessing one would create
---
    let mut harness = TestHarness::new();
    harness.run_source(&source)?;

    Ok(harness.results())
}

pub fn run_all_tests() -> Result<TestResults> {
    run_tests_in("tests/")
}

/// Runs every Redblue test file under `dir`, recursively.
///
/// [`run_all_tests`] is this against the checkout's own `tests/`; a project's
/// bare `rb test` is this against the `tests/` beside its manifest.
pub fn run_tests_in(dir: &str) -> Result<TestResults> {
    let mut harness = TestHarness::new();

    let test_files = find_test_files(dir)?;

    for file in test_files {
        if let Err(e) = harness.run_file(&file) {
            harness.add_error(e.to_string());
        }
    }

    Ok(harness.results())
}

/// Collects every Redblue test file under `dir`, recursively.
///
/// Only `.rb` is collectable. The Redblue harness parses its input as
/// Redblue, so handing it Rust source — the `tests/*_test.rs` files that
/// belong to `cargo test` — can only ever produce noise.
///
/// The result is sorted. `read_dir` yields entries in filesystem hash order,
/// which differs between machines and filesystems; an unsorted list would make
/// the reported test order — and therefore the failure output — unstable.
pub fn find_test_files(dir: &str) -> Result<Vec<String>> {
    let mut files = collect_test_files(dir);
    files.sort();
    Ok(files)
}

fn collect_test_files(dir: &str) -> Vec<String> {
    let mut files = Vec::new();

    if let Ok(entries) = std::fs::read_dir(dir) {
        for entry in entries.filter_map(|e| e.ok()) {
            let path = entry.path();
            if path.is_dir() {
                files.extend(collect_test_files(&path.to_string_lossy()));
            } else if path.extension() == Some("rb".as_ref()) {
                files.push(path.to_string_lossy().to_string());
            }
        }
    }

    files
}

#[derive(Debug, Clone)]
pub struct TestResults {
    pub total: usize,
    pub passed: usize,
    pub failed: usize,
    pub skipped: usize,
    pub errors: Vec<TestError>,
    pub duration_ms: u128,
}

impl TestResults {
    pub fn new() -> Self {
        Self {
            total: 0,
            passed: 0,
            failed: 0,
            skipped: 0,
            errors: Vec::new(),
            duration_ms: 0,
        }
    }

    pub fn add_pass(&mut self) {
        self.passed += 1;
        self.total += 1;
    }
