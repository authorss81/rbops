pub fn enabled(level: Level) -> bool {
    CONFIG.with(|config| {
        let config = config.borrow();
        level != Level::Off && config.threshold != Level::Off && level >= config.threshold
    })
}

/// A timestamp for the current record, from the same clock `time.now()` reads.
///
/// A host that has no clock — the playground before `rb_set_clock` — gets a
/// record without a timestamp rather than an abort. That is the one place the
/// two differ: `time.now()` answers an error when there is no clock, while a
/// logging call still has something to say and must not take the run down.
fn format_timestamp() -> Option<String> {
    let instant = crate::runtime::current_instant().ok()?;
    Some(
        chrono::DateTime::<chrono::Utc>::from(instant)
            .format("%Y-%m-%dT%H:%M:%S%.3fZ")
            .to_string(),
    )
}

pub fn write(level: Level, message: &str) -> io::Result<()> {
    let (destination, timestamps) = CONFIG.with(|config| {
        let config = config.borrow();
        (config.destination.clone(), config.timestamps)
    });
    if !enabled(level) {
        return Ok(());
    }

    let timestamp = if timestamps { format_timestamp() } else { None };
    let record = format_record(level, message, timestamp.as_deref());

    match destination {
        Destination::Stdout => write_stdout(&record),
        Destination::Stderr => write_stderr(&record),
        Destination::File(path) => crate::vfs::append(&path, &record),
    }
}

/// Writes a record to the real descriptor and reports a failed write.
///
/// `std::io::stderr().write_all` treats `EBADF` as success, so a descriptor
/// that is genuinely closed would still lose the record silently. Writing to
/// the descriptor directly keeps a closed stream a failure the program can
/// catch.
#[cfg(unix)]
fn write_descriptor(fd: libc::c_int, record: &str) -> io::Result<()> {
    let bytes = record.as_bytes();
    let mut written = 0;
    while written < bytes.len() {
        let chunk = &bytes[written..];
        // SAFETY: `chunk` is a valid slice for `chunk.len()` bytes and `fd` is
        // one of the process's standard stream descriptors.
        let count = unsafe { libc::write(fd, chunk.as_ptr().cast(), chunk.len()) };
        if count < 0 {
            let error = io::Error::last_os_error();
            if error.kind() == io::ErrorKind::Interrupted {
                continue;
            }
            return Err(error);
        }
        if count == 0 {
            return Err(io::Error::new(
                io::ErrorKind::WriteZero,
                "the log destination accepted no bytes",
            ));
        }
        written += count as usize;
    }
    Ok(())
}

#[cfg(unix)]
fn write_stdout(record: &str) -> io::Result<()> {
    if crate::wasm::is_capturing() {
        return crate::wasm::try_emit(record);
    }
    let _ = io::Write::flush(&mut io::stdout());
    write_descriptor(libc::STDOUT_FILENO, record)
}

#[cfg(unix)]
fn write_stderr(record: &str) -> io::Result<()> {
    write_descriptor(libc::STDERR_FILENO, record)
}

#[cfg(not(unix))]
fn write_stdout(record: &str) -> io::Result<()> {
    crate::wasm::try_emit(record)
}

#[cfg(not(unix))]
fn write_stderr(record: &str) -> io::Result<()> {
    io::Write::write_all(&mut io::stderr(), record.as_bytes())

/// Whether program output is being collected instead of written to stdout.
static CAPTURING: AtomicBool = AtomicBool::new(false);

/// Set when a run tried to [`emit`] past [`MAX_OUTPUT_BYTES`]. A run that
/// overflows is reported as a failure rather than silently losing the tail,
/// because a playground showing the first 4 MiB of an endless loop and calling
/// it a success would be lying about what the program did.
static OVERFLOW: AtomicBool = AtomicBool::new(false);

/// The buffer a capture collects into. A [`Mutex`] rather than a `RefCell`
/// because `say` runs on the interpreter thread, not the thread that opened the
/// capture, and on wasm there is only one thread anyway.
static CAPTURED: Mutex<Vec<u8>> = Mutex::new(Vec::new());

thread_local! {
    /// Whether this thread is part of the run that owns the open capture.
    ///
    /// The capture itself is process-global because the program runs on an
    /// interpreter thread of its own, but *membership* is not: a logging call
    /// on an unrelated host thread must not append into a capture some other
    /// run has open. [`begin_capture`] sets this on the thread that starts the
    /// run, and `run_isolated` carries it into the interpreter thread it
    /// spawns.
    static IN_CAPTURE: Cell<bool> = const { Cell::new(false) };
}

/// The most output one run may produce, in bytes.
///
/// The playground hands its output to a host as an *address*, not a copy, so the
/// bytes behind that address have to stay put — see [`HostBuffer`]. That buffer
/// is allocated once and reused, which is what makes the address stable, and a
/// reused buffer has to have a size. This is it. A program past it is refused
/// with a message, on the same `Error::Limit` channel [`crate::interpreter::MAX_CALL_DEPTH`]
/// uses, so a Redblue program can `catch` it like any other limit.
pub const MAX_OUTPUT_BYTES: usize = 4 * 1024 * 1024;

/// The most rendered error text one run may leave for a host. An error carries a
/// source line and a caret under it, so this is generous for anything a person
/// wrote and tight enough that one enormous generated line cannot use it up.
///
/// Public because a host has to size its own buffer with it — that is what makes
/// [`rb_run_into`]'s length cells worth anything.
pub const MAX_ERROR_BYTES: usize = 64 * 1024;

/// Appended to text that did not fit its buffer, so a host sees that it is
/// looking at part of a message rather than all of it. The first bytes are the
/// ones that name the failure, so a truncated error is still useful.
const TRUNCATION_MARKER: &str = "\n[truncated: the message does not fit the buffer]";

fn output_buffer() -> MutexGuard<'static, Vec<u8>> {
    CAPTURED
        .lock()
        .unwrap_or_else(|poisoned| poisoned.into_inner())
}

/// Writes a program's output.
///
/// This is what `say` and `print` call, as a statement and as the builtins of
/// the same names. Natively it is a plain write to stdout with no trailing
/// newline of its own — `say` supplies the newline in the text it hands over —
/// so the byte stream is exactly what `println!`/`print!` were producing,
/// including when stdout flushes, because a [`Write::write_all`] of `"line\n"`
/// reaches a [`LineWriter`](std::io::LineWriter) in the same shape `println!`
/// did.
pub fn emit(text: &str) {
    // `print!` ignores write failures too, and a Redblue program must not be
    // able to abort the host process over a closed pipe.
    let _ = try_emit(text);
}

/// Whether program output is being collected instead of written to a stream.
///
/// The logging module needs this to keep its `stdout` destination inside the
/// capture a host opened, while still writing to the real descriptor when no
/// capture is open. It is scoped to the threads that belong to the run, not to
/// the process: another thread's open capture must not collect this thread's
/// records.
pub fn is_capturing() -> bool {
    capture_member() && CAPTURING.load(Ordering::Relaxed)
}

/// Whether this thread belongs to the run that has the capture open.
pub(crate) fn capture_member() -> bool {
    IN_CAPTURE.with(|member| member.get())
}

/// Carries [`capture_member`] into the interpreter thread a run spawns.
///
/// The program does not run on the thread that called [`begin_capture`], so
/// without this the interpreter thread would write its records and output to
/// the real stream instead of the capture.
pub(crate) fn join_capture(member: bool) {
    IN_CAPTURE.with(|flag| flag.set(member));
}

/// Writes a program's output and reports a failed write.
///
/// [`emit`] is this function with the failure discarded, which is what `say`
/// and `print` have always done. A caller that must not lose a record — the
/// logging module — uses this instead, so a closed or unwritable stream reaches
/// the program as a catchable error rather than as output that vanished.
pub fn try_emit(text: &str) -> io::Result<()> {
    if is_capturing() {
        let mut buffer = output_buffer();
        if buffer.len().saturating_add(text.len()) > MAX_OUTPUT_BYTES {
            OVERFLOW.store(true, Ordering::SeqCst);
            return Ok(());
        }
        buffer.extend_from_slice(text.as_bytes());
        return Ok(());
    }
    std::io::stdout().write_all(text.as_bytes())
}

/// Serializes whole runs. There is one capture buffer and one program's output
/// goes in it, so two runs cannot overlap — on wasm there is one host thread
/// and the point is moot, but the module is also compiled natively where
/// `cargo test` runs its tests in parallel, and without this two of them would
/// divide one program's output between them. The lock is held across the run,
/// not around [`begin_capture`] and [`take_capture`] separately.
static RUN_LOCK: Mutex<()> = Mutex::new(());

/// The one lock every run, allocation and read of the ABI takes.
///
/// Not only `rb_run` and `run_program`. The *read* half has to be serialised
/// too, and it always was only half-serialised: `rb_run` held this while it
/// wrote both channels, and the accessors that hand out their addresses and
/// lengths held nothing, so two native tests could have one thread's `rb_run`
/// rewrite the bytes another thread was mid-way through reading. Every entry
/// point into the ABI now takes it, and the ones that copy ([`rb_read_output`],
/// [`rb_read_error`]) take it across the whole copy rather than across the
/// call that starts it.
fn run_lock() -> MutexGuard<'static, ()> {
    RUN_LOCK
        .lock()
        .unwrap_or_else(|poisoned| poisoned.into_inner())
}

/// Starts a capture. The buffer is emptied first, so a capture never inherits
/// the previous one's bytes. Callers go through [`run_program`] or [`rb_run`],
/// which hold [`RUN_LOCK`]; reaching for these directly is only for a caller
/// that has serialised its own runs.
pub fn begin_capture() {
    output_buffer().clear();
    OVERFLOW.store(false, Ordering::SeqCst);
    CAPTURING.store(true, Ordering::SeqCst);
    IN_CAPTURE.with(|flag| flag.set(true));
}
