#[test]
fn edge_bytes_write_accepts_a_path_value() {
    let dir = TempDir::new("path-bytes");
    let file = dir.file("path-value.bin");
    let source = format!(
        r#"set p to path.join("{}", "path-value.bin")
bytes.write(p, [104, 105])
say files.exists(p)
say files.read(p)"#,
        dir.path.to_string_lossy().replace('\\', "/")
    );
    let lines = both_engines(&source);
    assert_eq!(lines, ["yes", "hi"]);
    assert_eq!(
        std::fs::read(&file).expect("the path value must reach the filesystem"),
        b"hi",
        "bytes.write with a path value must write the same file as the text form"
    );
}

#[test]
fn files_append_delete_copy_and_rename_accept_path_values() {
    let dir = TempDir::new("path-files-routing");
    let source = format!(
        r#"set a to path.join("{dir}", "a.txt")
set b to path.join("{dir}", "b.txt")
set c to path.join("{dir}", "c.txt")
files.write(a, "one")
files.append(a, " two")
say files.read(a)
files.copy(a, b)
say files.read(b)
files.rename(b, c)
say files.exists(b)
say files.read(c)
files.delete(a)
say files.exists(a)"#,
        dir = dir.path.to_string_lossy().replace('\\', "/")
    );
    let lines = both_engines(&source);
    assert_eq!(
        lines,
        ["one two", "one two", "no", "one two", "no"],
        "every files function must accept the path value path.join answers"
    );
}

#[test]
fn edge_join_accepts_a_path_value_as_a_part() {
    let dir = TempDir::new("path-join-value");
    let source = format!(
        r#"set base to path.join("{dir}", "sub")
say path.join(base, "file.txt")
say path.filename(path.join(base, "file.txt"))"#,
        dir = dir.path.to_string_lossy().replace('\\', "/")
    );
    let lines = both_engines(&source);
    let expected = format!(
        "{}{sep}sub{sep}file.txt",
        dir.path.to_string_lossy().replace('\\', "/"),
        sep = std::path::MAIN_SEPARATOR
    );
    assert_eq!(lines, [expected, "file.txt".to_string()]);
}

#[test]
fn edge_path_join_with_no_parts_is_a_clean_failure() {
    let error = run_source_value("path.join()").expect_err("a join needs at least one part");
    assert_eq!(error.label(), "RuntimeError", "{error}");
    assert!(
        error.to_string().contains("at least one path"),
        "the refusal must say what is missing, got: {error}"
    );
}

#[test]
fn edge_listing_a_file_is_an_io_error_not_a_list() {
    let dir = TempDir::new("path-list-file");
    dir.write_file("plain.txt", "x");
    let source = format!(
        r#"path.list("{}")"#,
        dir.file("plain.txt").to_string_lossy().replace('\\', "/")
    );
    let error = run_source_value(&source).expect_err("a file is not a directory");
    assert_eq!(error.label(), "IoError", "{error}");
}

mod logging_module {
    use std::fs;

    use super::*;

    #[derive(Debug)]
    struct Run {
        output: Vec<String>,
        result: Result<Value, Error>,
    }

    fn tree_walk(source: &str) -> Run {
        let tokens = redblue::lexer::Lexer::tokenize(source).expect("source tokenizes");
        let ast = redblue::parser::parse(tokens).expect("source parses");
        redblue::analyzer::analyze(&ast).expect("source analyzes");
        let mut vm = redblue::Vm::new();
        let result = vm.run_quietly(&ast);
        Run {
            output: vm.take_output(),
            result,
        }
    }

    fn bytecode(source: &str) -> Run {
        let chunk = compile_source(source).expect("source compiles");
        let mut vm = BytecodeVm::new();
        vm.set_echo(false);
        let result = vm.run(&chunk);
        Run {
            output: vm.take_output(),
            result,
        }
    }

    fn scratch(name: &str) -> PathBuf {
        let dir = Path::new(env!("CARGO_MANIFEST_DIR"))
            .join("target/tmp/logging-tests")
            .join(name);
        let _ = fs::remove_dir_all(&dir);
        fs::create_dir_all(&dir).expect("scratch dir");
        dir
    }

    fn quoted(path: &Path) -> String {
        path.to_string_lossy().replace('\\', "\\\\")
    }

    fn runtime_message(error: Error) -> String {
        match error {
            Error::Runtime(message, _) => message,
            other => panic!("expected a Runtime error, got {other:?}"),
        }
    }

    #[test]
    fn records_at_or_above_the_threshold_reach_a_file_destination() {
        let dir = scratch("threshold");
        let log = dir.join("records.log");
        let source = format!(
            "logging.set_level(\"info\")\n\
             logging.set_timestamps(no)\n\
             logging.set_destination(\"{}\")\n\
             logging.debug(\"below\")\n\
             logging.info(\"at\")\n\
             logging.warn(\"above\")\n",
            quoted(&log)
        );

        let run = tree_walk(&source);
        assert!(run.result.is_ok(), "{:?}", run.result);
        assert_eq!(run.output.join("\n"), "");

        assert_eq!(
            fs::read_to_string(&log).expect("the destination holds the records"),
            "[INFO] at\n[WARN] above\n",
        );
    }

    #[test]
    fn edge_every_adjacent_threshold_pair_filters_exactly() {
        let dir = scratch("adjacent");
        for (threshold, expected) in [
