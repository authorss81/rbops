+/// Buffers output that the program's final flush will write, instead of
+/// writing it now.
+///
+/// Used for a `say` line and for a `stdout` log record while a capture is open,
+/// so the two interleave in call order. Outside a capture there is no final
+/// flush to join, so the text goes to the stream immediately.
+pub(crate) fn defer_capture(text: &str) -> io::Result<()> {
+    if !is_capturing() {
+        return try_emit(text);
+    }
+    DEFERRED.with(|deferred| {
+        let mut deferred = deferred.borrow_mut();
+        if deferred.len().saturating_add(text.len()) > MAX_OUTPUT_BYTES {
+            OVERFLOW.store(true, Ordering::SeqCst);
+            return Ok(());
+        }
+        deferred.extend_from_slice(text.as_bytes());
+        Ok(())
+    })
+}
+
+/// Writes everything [`defer_capture`] queued into the open capture.
+///
+/// Called at the end of a successful run, where the interpreter flushes its
+/// buffered `say` lines. A failed run never reaches that point, so its queued
+/// lines are cleared by the next [`begin_capture`] or by [`CaptureGuard`].
+pub(crate) fn flush_deferred() {
+    if !is_capturing() {
+        DEFERRED.with(|deferred| deferred.borrow_mut().clear());
+        return;
+    }
+    let queued = DEFERRED.with(|deferred| std::mem::take(&mut *deferred.borrow_mut()));
+    if queued.is_empty() {
+        return;
+    }
+    let text = String::from_utf8_lossy(&queued);
+    let _ = try_emit(&text);
+}
