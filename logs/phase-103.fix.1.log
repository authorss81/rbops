import re, subprocess, difflib
from pathlib import Path
old=subprocess.check_output(['git','show','HEAD:src/stdlib.rs'],text=True).splitlines()
new=Path('src/stdlib.rs').read_text().splitlines()
sm=difflib.SequenceMatcher(None, old, new, autojunk=False)
# build map old index (0-based) -> new index for matching blocks
mapping={}
for tag,i1,i2,j1,j2 in sm.get_opcodes():
    if tag=='equal':
        for k in range(i2-i1):
            mapping[i1+k]=j1+k
    elif tag=='replace':
        # map by matching stripped lines within block where possible
        for oi in range(i1,i2):
            text=old[oi].strip()
            candidates=[j for j in range(j1,j2) if new[j].strip()==text]
            if len(candidates)==1:
                mapping[oi]=candidates[0]
# show citations mapping
doc=Path('SURVEY.md').read_text()
for n in sorted(set(int(x) for x in re.findall(r'src/stdlib\.rs:(\d+)',doc))):
    print(n, '->', mapping.get(n-1, None)+1 if (n-1) in mapping else None)
