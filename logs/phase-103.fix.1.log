             logging.info(\"info\")\n\
             logging.warn(\"warn\")\n\
             logging.error(\"error\")\n\
             say \"result\"\n",
            quoted(&log)
        );

        let tree = tree_walk(&source);
        let byte = bytecode(&source);

        assert!(tree.result.is_ok(), "{:?}", tree.result);
        assert!(byte.result.is_ok(), "{:?}", byte.result);
