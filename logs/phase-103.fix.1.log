  1283	
  1284	```redblue
  1285	set upper to text.uppercase("hello")  // "HELLO"
  1286	set lower to text.lowercase("HELLO")  // "hello"
  1287	set trimmed to text.trim("  hi  ")    // "hi"
  1288	set parts to text.split("a,b,c", by ",")  // ["a", "b", "c"]
  1289	set joined to text.join(["a", "b", "c"], by ",")  // "a,b,c"
  1290	set holds to text.contains("abc", "b")  // yes
  1291	set starts to text.starts_with("abc", "ab")  // yes
  1292	set ends to text.ends_with("abc", "bc")  // yes
  1293	set swapped to text.replace("a-b", "-", "+")  // "a+b"
  1294	set size to text.length("héllo")  // 5
  1295	set wrapped to text.wrap("the quick brown fox", 9)  // ["the quick", "brown fox"]
  1296	set changes to text.diff("a\nb\n", "a\nB\n")  // a standard unified diff
  1297	set body to text.dedent("    one\n    two\n")  // "one\ntwo\n"
