const ARITHMETIC_OPS: &[&str] = &["+", "-", "*", "/", "%"];

fn arithmetic(out: &mut Vec<(String, String)>) {
    for (i, (a, b)) in ARITHMETIC_PAIRS.iter().enumerate() {
        let op = ARITHMETIC_OPS[i % ARITHMETIC_OPS.len()];
        push(
            out,
            "arithmetic",
            &format!("set a to {a}\nset b to {b}\nsay a {op} b\n"),
        );
    }
}

