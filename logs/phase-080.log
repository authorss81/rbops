+/// that an undeclared `extends` parent is reported as an unused child *and* not
+/// read as a declaration, on a program the analyzer refuses, so a linter that
+/// dropped its own findings to report someone else's would be a strictly worse
+/// linter than the one this replaces.
 pub fn lint(source: &str) -> (Vec<LintError>, Vec<LintWarning>) {
     let tokens = match Lexer::tokenize(source) {
