+/// The loop body statement owns the position — its **line**.
+///
+/// The column is 1, and that is the point of the test rather than an incidental
+/// of how the source is written. A runtime failure is reported against the
+/// statement that failed, and a statement knows its own column; this used to
+/// report column 5 for the indented `say` below. The bytecode engine cannot:
+/// one line per instruction and no column at all (`docs/BYTECODE.md`), so
+/// `src/bytecode/vm.rs` answers `line:1` for the same program. The two engines
+/// disagreeing about where the same failure happened is exactly what the
+/// bootstrap ladder's fixed point forbids, so the line is what a runtime failure
+/// names and the column is 1 on both. A *frontend* failure still carries the
+/// offending token's own column, which is the other half of
+/// `edge_parser_error_reports_line_and_column` above.
 #[test]
 fn edge_runtime_error_inside_a_loop_reports_the_inner_statement() {
     let source = "for each i in [1, 2, 3]\n    say i / 0\nend\n";
     let error = error_of(source);
@@ -161,10 +174,12 @@
         error
     );
     assert_eq!(
         error.span(),
-        Some(&Span::new(2, 5)),
-        "the loop body statement owns the position, got: {:?}",
+        Some(&Span::new(2, 1)),
+        "the loop body statement owns the position, by line: the bytecode \
+         instruction that divides has no column to carry, so a column here \
+         would be one the compiled engine cannot answer, got: {:?}",
         error.span()
     );
 }
 

