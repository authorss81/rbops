}

/// The source tail each injected fault is spliced in as.
///
/// A named list rather than a flag, so the generator and the assertion that
/// checks it cannot disagree about which faults were intended, and a *table*
/// rather than a `match` inside [`generate`], so the property test can run one
/// tail on its own and compare the failure it produces against the failure the
/// whole program produces. A generator that injected the right fault in the
/// wrong place — or that faulted on its prefix instead — cannot be told from a
/// correct one any other way.
pub const FAULTS: [&str; 6] = [
    "index past the end",
    "index before the start",
    "division by zero",
    "text minus a number",
    "index on a number",
    "property on nothing",
];

/// The tail [`generate`] splices in for `fault`, or `None` if `fault` is not a
/// declared fault.
///
/// One entry per [`FAULTS`] element, and `edge_every_declared_fault_has_a_tail`
/// says so — so a fault that got a name but no tail, or a tail that no fault
/// names, fails rather than silently producing a program that completes.
pub fn fault_tail(fault: &str) -> Option<&'static str> {
    match fault {
        "index past the end" => Some("set xs to [1, 2]\nsay xs[9]\n"),
        "index before the start" => Some("set xs to [1, 2]\nsay xs[-9]\n"),
        "division by zero" => Some("set n to 0\nsay 1 / n\n"),
        "text minus a number" => Some("say \"a\" - 1\n"),
        "index on a number" => Some("say 5[0]\n"),
        "property on nothing" => Some("say nothing.a\n"),
        _ => None,
    }
}

/// A generated program and the fault, if any, that was injected into it.
///
/// The fault travels with the program so the property test can assert the
/// causal direction: a program with no injected fault *must* run to completion,
/// and anything that faults without one is a generator defect rather than a
/// language finding.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct Generated {
    /// The whole program.
    pub source: String,
    /// One of [`FAULTS`], or `None` when nothing was injected.
    pub fault: Option<String>,
}

