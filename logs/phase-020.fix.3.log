///   three variables out of `BytecodeVm::new()`, so a harness that only ever
    ///   builds VMs with `with_limits` proves it for the tree-walking half and
    ///   says nothing about the compiled one.
    /// - the variables are put **back**, not removed. `remove_var` after a
    ///   `set_var` is not a restore: a developer who ran the suite with
    ///   `REDBLUE_MAX_STEPS` set to something of their own would find it gone.
    /// - the write is done under a **lock**. `cargo test` runs a binary's tests
    ///   in parallel threads over one process environment, so a test that
    ///   mutates it without a lock decides other tests' results by scheduling
    ///   order rather than by anything about the program under test.
    ///
    /// And the control: while the variables are pinned to `1`, a VM built the
    /// way the interpreter's own `run` builds one *does* come out differently.
    /// Without that half the assertion would also pass if the harness's limits
    /// had stopped being limits at all, which is the same class of claim that
    /// cannot fail.
    #[test]
    fn edge_a_limit_left_in_the_environment_cannot_change_an_outcome() {
        let program = "set n to 0\nrepeat 3 times\nset n to n + 1\nend\nsay n\nn\n";
        let before = tree_walk(program);
        let byte_before = bytecode(program);
        assert_eq!(before, byte_before);

        // What the interpreter itself builds, for the control below.
        let defaults_before = tree_walk_with_environment_defaults(program);

        let with_the_environment = {
            let _environment = EnvLimits::set_all_to("1");
            let tree = tree_walk(program);
            let byte = bytecode(program);
            let defaults = tree_walk_with_environment_defaults(program);
            assert_ne!(
                defaults, defaults_before,
                "the control did not move: a VM built with `new()` cannot be \
                 affected by the environment, so the two assertions below would \
                 be true for the wrong reason"
            );
            (tree, byte)
        };

        // The environment is whole again, so this test cannot have been the
        // reason a later one in this process sees something different. It has to
        // be observed with the *control*, because the harness's own runs are
        // built not to read the environment — they would look identical either
        // way, which is exactly what makes them useless as evidence here.
        assert_eq!(
            tree_walk_with_environment_defaults(program),
            defaults_before,
            "the guard did not put the environment back"
        );
        let after = tree_walk(program);
        assert_eq!(after, before);

        let (with_env_tree, with_env_byte) = with_the_environment;
        assert_eq!(
            before, with_env_tree,
            "the tree-walking outcome followed the environment, so it would not \
             reproduce anywhere else"
        );
        assert_eq!(
            byte_before, with_env_byte,
            "the bytecode outcome followed the environment, so it would not \
             reproduce anywhere else"
        );
        assert_eq!(
            with_env_tree.output,
            vec!["3".to_string()],
            "and the run really did happen: a program with no steps left would \
             have printed nothing"
        );
        assert_eq!(with_env_tree.result, Ok(Value::Number(3.0)));
        assert_eq!(with_env_byte.result, Ok(Value::Number(3.0)));
    }

