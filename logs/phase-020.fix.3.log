/// Names the entry a failure happened in, so a bad constant says which one.
fn annotate(what: &str, index: u32, error: Error) -> Error {
    match error {
        Error::Parser(message, span) => Error::Parser(format!("{what} {index}: {message}"), span),
        other => other,
    }
}
