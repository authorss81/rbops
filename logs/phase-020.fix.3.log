+/// The recorded value names a **type**, not only the word the value prints as.
+///
+/// `Number(5)`, `Text("5")`, `Nothing` and `Text("nothing")` all print as
+/// themselves with no type attached, and `YesNo(true)` and `Text("yes")` print
+/// alike as well. An `.expected` that recorded the rendering alone therefore
+/// called a type-confusion divergence *agreement* — the bytecode VM returning the
+/// text `"5"` where the tree-walking VM returned the number `5` would have been
+/// two matching `#value 5` lines. Four of those collisions are in the language's
+/// own value set, so this is not a corner case.
+///
+/// The assertion is the rejection, because the recording is what has to be
+/// checked: a `#value` line that spells a number's rendering with no type tag
+/// must not be accepted for a program worth that number.
+#[test]
+fn edge_a_recorded_value_names_the_type_and_not_only_what_it_prints() {
+    let pairs = [
+        ("set t to 5\nsay t\n5\n", "set t to \"5\"\nsay t\n\"5\"\n"),
+        (
+            "set t to nothing\nsay t\nnothing\n",
+            "set t to \"nothing\"\nsay t\n\"nothing\"\n",
+        ),
+        ("set t to yes\nsay t\nyes\n", "set t to \"yes\"\nsay t\n\"yes\"\n"),
+    ];
+    for (number, text) in pairs {
+        let two_numbers = vm::tree_walk(number);
+        let two_texts = vm::tree_walk(text);
+        let value = two_numbers.result.as_ref().expect("the first runs to completion");
+        let other = two_texts.result.as_ref().expect("the second runs to completion");
+
+        // The renderings collide...
+        assert_eq!(
+            value.to_string(),
+            other.to_string(),
+            "{number:?} and {text:?} print the same words, so a recording that \
+             holds only the rendering cannot tell the two values apart"
+        );
+        // ...and the tagged renderings do not.
+        assert_ne!(
+            corpus::tagged(value),
+            corpus::tagged(other),
+            "a Number and a Text that print alike are two recordings"
+        );
+
+        // And the untyped spelling is refused for a typed value.
+        let untagged = Recorded {
+            label: "none".to_string(),
+            value: value.to_string(),
+            message: String::new(),
+            position: None,
+            output: two_numbers.output.clone(),
+        };
+        let reported = panic::catch_unwind(AssertUnwindSafe(|| {
+            corpus::compare(Path::new("untagged-value.rb"), &two_numbers, &untagged)
+        }));
+        assert!(
+            reported.is_err(),
+            "an .expected recording {untagged:?} for a program worth {value:?} was \
+             accepted; the value is compared as the word it prints as"
+        );
+
+        // The tagged spelling round-trips through the writer and the reader.
+        let recorded = corpus::parse_recorded(&corpus::record(&two_numbers));
+        corpus::compare(Path::new("tagged-value.rb"), &two_numbers, &recorded);
+        assert_eq!(recorded.value, corpus::tagged(value));
+    }
+
+    // `nothing` is the one value left untagged, because it is what an absent
+    // `#value` means — so it has to stay the single spelling of itself.
+    assert_eq!(corpus::tagged(&Value::Nothing), "nothing");
+    let none_outcome = vm::tree_walk("say 1\n");
+    assert_eq!(
+        corpus::record(&none_outcome),
+        "#label none\n1\n",
+        "a program worth nothing records no #value line, and the absent line and \
+         the written one would collide if `nothing` were tagged too"
+    );
+}
+
