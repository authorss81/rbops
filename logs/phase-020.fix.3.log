+/// One way of building an expression of a given [`Kind`].
+///
+/// A table rather than a `match` inside [`expression`], and that is the whole
+/// point of the type. With a `match`, an arm is reachable only if `expression`
+/// happens to call `rng.below` with the right bound, and a dead arm — one whose
+/// index no longer comes up, or one left behind by an edit — looks exactly like a
+/// working one from outside. With a table, [`expression_arms`] *is* the set of
+/// arms: an arm is reachable because it is in the list, and the test can build
+/// every one of them by index and ask the interpreter what each is worth.
+pub struct Arm {
+    /// What the arm builds, in a form a failure message can name.
+    pub name: &'static str,
+    /// Builds one expression. Recurses into [`expression`] for its operands.
+    pub build: fn(&mut Rng) -> String,
+}
+
+/// A number expression's arms.
+static NUMBER_ARMS: [Arm; 5] = [
+    Arm {
+        name: "a literal",
+        build: number_literal,
+    },
+    Arm {
+        name: "a sum",
+        build: |rng| format!("({} + {})", number_literal(rng), number_literal(rng)),
+    },
+    Arm {
+        name: "a difference",
+        build: |rng| format!("({} - {})", number_literal(rng), number_literal(rng)),
+    },
+    Arm {
+        name: "a product",
+        build: |rng| format!("({} * {})", number_literal(rng), number_literal(rng)),
+    },
+    Arm {
+        // `length` is a *number*, which is why this arm is here and the
+        // corresponding one is absent from the text arms below.
+        name: "a length",
+        build: |rng| format!("length({})", text_literal(rng)),
+    },
+];
+
+/// A text expression's arms.
+static TEXT_ARMS: [Arm; 3] = [
+    Arm {
+        name: "a literal",
+        build: text_literal,
+    },
+    Arm {
+        name: "a concatenation",
+        build: |rng| format!("({} + {})", text_literal(rng), text_literal(rng)),
+    },
+    Arm {
+        // `type_of` answers text, so folding it into a text expression is what
+        // this arm is for.
+        name: "a type name",
+        build: |rng| format!("type_of({})", expression(rng, Kind::Number)),
+    },
+];
+
+/// A yes/no expression's arms.
+static YESNO_ARMS: [Arm; 3] = [
+    Arm {
+        name: "yes",
+        build: |_| "yes".to_string(),
+    },
+    Arm {
+        name: "no",
+        build: |_| "no".to_string(),
+    },
+    Arm {
+        name: "a comparison",
+        build: |rng| format!("({} is {})", number_literal(rng), number_literal(rng)),
+    },
+];
+
+/// A list expression's arms.
+static LIST_ARMS: [Arm; 3] = [
+    Arm {
+        name: "the empty list",
+        build: |_| "[]".to_string(),
+    },
+    Arm {
+        name: "a singleton",
+        build: |rng| format!("[{}]", number_literal(rng)),
+    },
+    Arm {
+        name: "a pair",
+        build: |rng| format!("[{}, {}]", number_literal(rng), number_literal(rng)),
+    },
+];
+
+/// A record expression's arms.
+static RECORD_ARMS: [Arm; 2] = [
+    Arm {
+        name: "the empty record",
+        build: |_| "{}".to_string(),
+    },
+    Arm {
+        name: "one field",
+        build: |rng| format!("{{a: {}}}", number_literal(rng)),
+    },
+];
+
+/// A `nothing` expression's arms.
+static NOTHING_ARMS: [Arm; 2] = [
+    Arm {
+        name: "the keyword",
+        build: |_| "nothing".to_string(),
+    },
+    Arm {
+        name: "a missing key",
+        build: |rng| format!("({}).missing", expression(rng, Kind::Record)),
+    },
+];
+
+/// Every arm [`expression`] can take for `kind`, in the order it indexes them.
+pub fn expression_arms(kind: Kind) -> &'static [Arm] {
+    match kind {
+        Kind::Number => &NUMBER_ARMS,
+        Kind::Text => &TEXT_ARMS,
+        Kind::YesNo => &YESNO_ARMS,
+        Kind::List => &LIST_ARMS,
+        Kind::Record => &RECORD_ARMS,
+        Kind::Nothing => &NOTHING_ARMS,
+    }
+}
+
+/// `type_of`'s answer for `kind`, as a Redblue text.
+pub fn type_name(kind: Kind) -> &'static str {
+    match kind {
+        Kind::Number => "number",
+        Kind::Text => "text",
+        Kind::YesNo => "yes/no",
+        Kind::List => "list",
+        Kind::Record => "record",
+        Kind::Nothing => "nothing",
+    }
+}
