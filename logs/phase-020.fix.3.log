+// --- the environment, under a lock ------------------------------------------
+
+/// The lock every mutation of the process environment goes through.
+///
+/// `std::env` is process-global and `cargo test` runs a binary's tests in
+/// parallel threads, so a test that sets a variable without holding this lock
+/// is not testing the environment — it is changing what every *other*
+/// concurrently-running test sees, and whether a given run fails is then a
+/// matter of which thread got there first. That is not a flake to be waited out:
+/// it makes every other test in the binary untrustworthy while it is in flight.
+///
+/// Holding the lock is not enough on its own, which is why [`EnvLimits`] both
+/// takes it and puts the variables back: the variables are the interpreter's
+/// own inputs (`Vm::new()` reads all three), so leaving them set at `1` would
+/// silently change every later test in the process.
+static ENV_LOCK: Mutex<()> = Mutex::new(());
+
+/// The `REDBLUE_MAX_*` variables, in the order they are set.
+pub const LIMIT_ENV_VARS: [&str; 3] = [
+    redblue::MAX_STEPS_ENV,
+    redblue::MAX_ITERATIONS_ENV,
+    redblue::MAX_CALL_DEPTH_ENV,
+];
+
+/// Exclusive, restoring access to the limit variables.
+///
+/// Takes [`ENV_LOCK`] on construction and releases it — after restoring every
+/// variable it changed, `set` to what it was or `remove`d if it was not there —
+/// on drop. Restoring is not cosmetic: a variable the developer had set for
+/// their own reasons is *their* setting, and a test that removes it has changed
+/// the machine rather than observed it.
+///
+/// Drop happens on the panicking path too, so a failing assertion does not leak
+/// the environment into the next test that happens to be running.
+pub struct EnvLimits {
+    /// The guard from [`ENV_LOCK`], kept alive for exactly this long.
+    _guard: MutexGuard<'static, ()>,
+    /// What each variable held while this guard was alive, so it can go back.
+    previous: Vec<(String, Option<String>)>,
+}
+
+impl EnvLimits {
+    /// Locks the environment and sets every `REDBLUE_MAX_*` variable to `value`.
+    pub fn set_all_to(value: &str) -> Self {
+        let guard = ENV_LOCK.lock().unwrap_or_else(|poisoned| {
+            // A panic in another test must not make this one panic for the
+            // wrong reason: the lock protects data, not correctness, and the
+            // data it protects is the environment, which this guard restores.
+            panicked::resume_unwind(poisoned)
+        });
+        let mut previous = Vec::with_capacity(LIMIT_ENV_VARS.len());
+        for name in LIMIT_ENV_VARS {
+            previous.push((name.to_string(), std::env::var(name).ok()));
+            std::env::set_var(name, value);
+        }
+        EnvLimits {
+            _guard: guard,
+            previous,
+        }
+    }
+}
+
+impl Drop for EnvLimits {
+    fn drop(&mut self) {
+        for (name, value) in &self.previous {
+            match value {
+                Some(value) => std::env::set_var(name, value),
+                None => std::env::remove_var(name),
+            }
+        }
+    }
+}
