 /// The environment variable that overrides [`MAX_STEPS`].
 pub const MAX_STEPS_ENV: &str = "REDBLUE_MAX_STEPS";
 
+/// The position a runtime failure inside `stmt` is reported against: the
+/// statement's **line**, at column 1.
+///
+/// The column is deliberately dropped, and this is the whole argument for it.
+/// The compiled engine carries one line per instruction and no column at all
+/// (`docs/BYTECODE.md`, and `Instruction` in `src/bytecode/format.rs`), so
+/// `src/bytecode/vm.rs` can only answer `line:1`. This VM used to answer the
+/// statement's own column instead, so a statement written inside an `if` or a
+/// loop body failed at `3:5` here and at `3:1` there — the same program, two
+/// engines, two different answers, which is the one thing the bootstrap ladder's
+/// fixed point forbids. The line is the part both formats carry, so the line is
+/// what a runtime failure names.
+///
+/// A frontend failure is unaffected: `src/lexer.rs` gives a token its own
+/// column, and that column is what `#position` records for the 25 corpus
+/// programs whose failure is a `LexerError`, a `ParserError` or an
+/// `AnalyzerError`. What is still missing is *expression*-granular runtime
+/// positions on both engines; that is FINDINGS.md §15.
+fn statement_span(stmt: &Stmt) -> Span {
+    Span::new(stmt.span.line, 1)
+}
