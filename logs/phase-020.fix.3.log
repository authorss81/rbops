//! ## The `.expected` format
//!
//! Line 1 is `#label <Label|none>`. Then, in this order and only when they
//! apply:
//!
//! ```text
//! #label none
//! #value number:5
//! #output 5
//! ```
//!
//! ```text
//! #label RuntimeError
//! #message Index 9 is out of bounds: length is 2, valid indexes are 0 to 1
//! #position 2:6
//! ```
//!
//! - `#label none` — the program ran to completion. Anything else is one of the
//!   five public `Error::label()` values.
//! - `#value <type>:<what it printed as>` — what the program was worth, as a
//!   **type and a rendering** rather than the rendering alone; see [`tagged`]
//!   for why the type has to be there. Absent means `nothing`; it is written
//!   whenever the value is not `nothing` so that a file recording `nothing` and
//!   a file that forgot to record a value do not look alike.
//! - `#message <m>` — required when the label is not `none`, and refused when it
//!   is: a program that ran and a program that recorded a message are
//!   different programs.
//! - `#position <line>:<column>` — **required** when the label is not `none`,
//!   and refused when it is. `none` means the failure carries no position at
//!   all, which only a failure that happened before any source text existed can
//!   do; every other failure names the line and column it happened at. This
//!   directive is what makes a moved line or column a difference rather than
//!   something the golden files are simply silent about.
//! - every remaining line is one printed line, escaped (below).
//!
//! # Escaping
//!
//! A printed line is arbitrary text, and arbitrary text can look like a
//! directive: `say "#value 3"` must not be read back as the program's value
//! being 3, or the file describes a *different* program from the one it was
//! recorded from. So a `#` is written `\#` when it is the first character of a
//! line, a `\` is written `\\`, and a newline inside a single printed line — a
//! `say` of text holding one — is written `\n`. Reading is the exact inverse,
//! and [`parse_recorded`] rejects a file carrying an escape it does not know
//! rather than guessing.
...
const MESSAGE_PREFIX: &str = "#message ";
/// The directive recording where a failure happened.
const POSITION_PREFIX: &str = "#position ";
/// The value standing for a program that was worth nothing.
const NOTHING: &str = "nothing";

/// A value as the `#value` directive records it: a **type tag**, then what the
/// value prints as.
///
/// The tag is the point. `Value`'s `Display` renders a `Text` bare, so the
/// corpus could not tell `Number(5)` from `Text("5")`, nor `Nothing` from
/// `Text("nothing")`, nor `YesNo(true)` from `Text("yes")` — and those are not
/// corner cases, they are the collisions the language's own value set makes.
/// Two *different* programs recording `#value 5` is a golden file that cannot
/// notice a type-confusion divergence between the two VMs, which is the whole
/// class of defect this harness exists to find.
///
/// `nothing` is deliberately left untagged: it is the value a file omits, and a
/// tag on the sentinel would make "recorded nothing" and "recorded nothing by
/// accident" two spellings of the same line. Every other value is tagged, so
/// nothing else can reach the sentinel by printing like it.
pub fn tagged(value: &Value) -> String {
    match value {
        Value::Nothing => NOTHING.to_string(),
        Value::Number(_) => format!("number:{value}"),
        Value::Text(_) => format!("text:{value}"),
        Value::YesNo(_) => format!("yes/no:{value}"),
        Value::List(_) => format!("list:{value}"),
        Value::Record(_) => format!("record:{value}"),
        Value::Object(name, _) => format!("object:{name}"),
        Value::Function(function) => format!("function:{}", function.name),
        Value::Builtin(name) => format!("builtin:{name}"),
