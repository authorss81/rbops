 /// The directive recording where a failure happened.
 const POSITION_PREFIX: &str = "#position ";
 /// The value standing for a program that was worth nothing.
 const NOTHING: &str = "nothing";
+
+/// A value as the `#value` directive records it: a **type tag**, then what the
+/// value prints as.
+///
+/// The tag is the point. `Value`'s `Display` renders a `Text` bare, so the
+/// corpus could not tell `Number(5)` from `Text("5")`, nor `Nothing` from
+/// `Text("nothing")`, nor `YesNo(true)` from `Text("yes")` — and those are not
+/// corner cases, they are the collisions the language's own value set makes.
+/// Two *different* programs recording `#value 5` is a golden file that cannot
+/// notice a type-confusion divergence between the two VMs, which is the whole
+/// class of defect this harness exists to find.
+///
+/// `nothing` is deliberately left untagged: it is the value a file omits, and a
+/// tag on the sentinel would make "recorded nothing" and "recorded nothing by
+/// accident" two spellings of the same line. Every other value is tagged, so
+/// nothing else can reach the sentinel by printing like it.
+pub fn tagged(value: &Value) -> String {
+    match value {
+        Value::Nothing => NOTHING.to_string(),
+        Value::Number(_) => format!("number:{value}"),
+        Value::Text(_) => format!("text:{value}"),
+        Value::YesNo(_) => format!("yes/no:{value}"),
+        Value::List(_) => format!("list:{value}"),
+        Value::Record(_) => format!("record:{value}"),
+        Value::Object(name, _) => format!("object:{name}"),
+        Value::Function(function) => format!("function:{}", function.name),
+        Value::Builtin(name) => format!("builtin:{name}"),
+    }
+}
 /// The position standing for a failure that carries none.
 const NO_POSITION: &str = "none";
 
