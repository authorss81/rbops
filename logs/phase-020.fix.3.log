+/// A runtime failure names the **line** it happened on — at column 1 — and
+/// both engines say so.
+///
+/// This is the half of the position the harness had been over-claiming. The
+/// corpus's `#position` column was compared, and it never varied for a
+/// runtime failure: every one of them was at column 1, because every corpus
+/// program writes its statements at column 1 and the tree-walking VM
+/// reported the *statement's* column. `line_span` in `src/bytecode/vm.rs`
+/// has always answered column 1, since a bytecode instruction carries a line
+/// and no column (`docs/BYTECODE.md`), so an **indented** runtime failure
+/// faulted at `3:5` on one engine and `3:1` on the other. The corpus held no
+/// indented failure, so `edge_both_vms_place_every_failure_at_the_same_line_
+/// and_column` agreed on all 75 recorded failures while the divergence stood
+/// one indented `say` away.
+///
+/// So this is stated rather than assumed, and it is stated as *both* engines
+/// at the same place. `statement_span` in `src/vm.rs` is what makes it true
+/// there; putting it back fails this test, and that is the mutation to
+/// believe. A *frontend* failure is the other matter: the lexer knows where
+/// the bad character was, and that column is real, varies, and is compared —
+/// which is the second half of this test.
+#[test]
+fn edge_a_runtime_failure_names_a_line_and_a_frontend_failure_names_a_column() {
+    for (source, line) in [
+        // Indented inside an `if`, inside a loop, and at column 1.
+        ("set xs to [1]\nif 1 is 1 then\n    say xs[9]\nend\n", 3),
+        ("set n to 0\nrepeat 2 times\n    say n[0]\nend\n", 3),
+        ("set xs to [1]\nsay xs[9]\n", 2),
+        // Indented inside a function body, where the frame differs too.
+        ("to f()\n    say 1 / 0\nend\nf()\n", 2),
+    ] {
+        let tree = tree_walk(source);
+        let byte = bytecode(source);
+        assert_eq!(tree, byte, "{source:?}: {tree:?} vs {byte:?}");
+        let failure = tree.result.as_ref().expect_err(&format!(
+            "{source:?} should fault: {tree:?}"
+        ));
+        assert_eq!(
+            failure.position,
+            Some(Span::new(line, 1)),
+            "{source:?}: a runtime failure names the line it happened on, at \
+             column 1 — the column is what the bytecode format cannot carry, \
+             so a column here is a column only one engine has"
+        );
+    }
+
+    // The other direction: a frontend failure *does* carry a column, on both
+    // engines, and it is not 1.
+    for (source, column) in [("say 1 ?\n", 7), ("say 1 < 2\n", 7)] {
+        let tree = tree_walk(source);
+        assert_eq!(tree, bytecode(source), "{source:?}: the two VMs disagree");
+        let failure = tree.result.as_ref().expect_err(&format!(
+            "{source:?} should not lex: {tree:?}"
+        ));
+        assert_eq!(
+            failure.position,
+            Some(Span::new(1, column)),
+            "{source:?}: the lexer knows where the bad character was"
+        );
+    }
+
+    // And the caret a user actually sees follows the column, so the position
+    // is not decoration that only the harness reads.
+    let source = "say 1 ?\n";
+    let error = tree_walk_verbose(source).1.expect_err("the program does not lex");
+    let rendered = error.render(source, Some("frontend.rb"));
+    assert!(
+        rendered.contains("1:7"),
+        "the rendered failure does not carry the position: {rendered:?}"
+    );
+    assert!(
+        rendered.contains("      ^"),
+        "the rendered failure draws no caret under the column: {rendered:?}"
+    );
+}
+
