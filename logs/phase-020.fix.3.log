+/// holds it up from the outside, while
+/// `edge_every_kind_is_reachable_and_its_arms_produce_it` holds up every *arm*
+/// from the inside.
+///
+/// The arm index is drawn from [`expression_arms`]'s length, so the number of
+/// arms and the number of choices can never drift apart: adding an arm widens
+/// the grammar, and deleting one narrows it, with nothing to update by hand.
+pub fn expression(rng: &mut Rng, kind: Kind) -> String {
+    let arms = expression_arms(kind);
+    let index = rng.below(arms.len());
+    (arms[index].build)(rng)
