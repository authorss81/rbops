+/// Every declared fault has a tail, and every tail faults.
+///
+/// [`fault_tail`] exists so the property test can run one fault on its own
+/// and compare the failure it produces with the failure the whole program
+/// produces. That only means something if the table is exhaustive *and* the
+/// entries really fault: a missing entry makes [`fault_tail`] answer `None`,
+/// which would turn the comparison into a silently skipped one, and a tail
+/// that completes would make it compare a completion with a failure.
 #[test]
+fn edge_every_declared_fault_has_a_tail_that_faults() {
+    for fault in FAULTS {
+        let tail = fault_tail(fault).unwrap_or_else(|| {
+            panic!("{fault:?} is a declared fault with no tail to splice in")
+        });
+        assert!(
+            !tail.is_empty(),
+            "{fault:?} has an empty tail, which is not a program"
+        );
+        for source in [tail.to_string(), format!("set lead to 1\n{tail}\n")] {
+            let outcome = crate::common::vm::tree_walk(&source);
+            assert!(
+                outcome.result.is_err(),
+                "the tail for {fault:?} completed instead of faulting: \
+                 {source:?} -> {outcome:?}"
+            );
+            assert_eq!(
+                outcome,
+                crate::common::vm::bytecode(&source),
+                "the two VMs disagree about the tail for {fault:?}: {source:?}"
+            );
+        }
+    }
+    for tail_source in [
+        "",
+        "say 1\n",
+        "set xs to [1, 2]\n",
+        "say nothing.a\nsay 1 / 0\n",
+        "say \"a\" - 1\nsay 5[0]\n",
+    ] {
+        assert_eq!(
+            fault_tail(tail_source),
+            None,
+            "{tail_source:?} is a tail no declared fault names, so the \
+             property test would compare a program that does not exist"
+        );
+    }
+}
