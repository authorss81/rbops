    Text(String),
    YesNo(bool),
    List(Shared<Vec<Value>>),
    Record(Shared<Fields>),
    Object(String, Shared<Fields>),
    Function(FunctionValue),
    Builtin(String),
    /// A timezone-naive calendar date and time.
