/// Moves every item from one stack to the other, reversing their order.
///
/// The stack is read in pop order once and the reversed stack is built in one
/// pass, so this is linear in the stack's length rather than paying a spine
/// copy for every item.
fn deque_reverse(span: Span, stack: &Value) -> Result<Value> {
    let mut values = stack_pop_order(span, stack)?;
    values.reverse();
    Ok(stack_from_values(&values))
}

