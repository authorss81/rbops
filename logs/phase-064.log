    fn arm_step(&self, mode: StepMode) {
        lock(&self.debug).arm_step(mode);
        println!(
            "{}",
            match mode {
                StepMode::Into => "Stepping into the next call.",
                StepMode::Over => "Stepping over the next call.",
                StepMode::None => "Continuing.",
            }
        );
