+/// whole of the message, and anything added to it is the divergence again.
+#[test]
+fn edge_bytes_that_are_not_text_say_the_same_thing_in_both_builds() {
+    use redblue::vfs::memory;
+
+    let _serialised = memory_filesystem();
+    memory::clear();
+
