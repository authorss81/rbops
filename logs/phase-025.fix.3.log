// Expression statement (for side effects)
    Expr(Expr),

    // print "Hello"
    Print(Expr),

    // set x to 10
    Set {
        name: String,
        value: Expr,
    },

    // constant NAME to <expr> — a name bound once, which no assignment may
    // rebind. A module file uses it for the values every function of the
    // module shares, as `modules/MathUtils.rb` does for `PI`.
    Constant {
        name: String,
        value: Expr,
    },

    // set x.y to 10
    SetProperty {
        object: String,
        property: String,
        value: Expr,
    },

    // if condition then ... end
    If {
        condition: Expr,
        then_branch: Vec<Stmt>,
        else_branch: Vec<Stmt>,
    },

    // for each x in list ... end
    ForEach {
        variable: String,
        iterable: Expr,
        body: Vec<Stmt>,
    },

    // for each i from 1 to 10 ... end
    ForRange {
        variable: String,
        start: Expr,
        end: Expr,
        step: Option<Expr>,
        body: Vec<Stmt>,
    },

    // repeat 10 times ... end
    Repeat {
        count: Expr,
        body: Vec<Stmt>,
