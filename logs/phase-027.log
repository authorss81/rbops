+            return strict_op;
+        }
+
+        match self.current() {
+            Some(Token {
+                kind: TokenKind::Equal,
+                ..
+            }) => {
+                self.advance();
+                BinaryOp::Equal
+            }
+            Some(Token {
+                kind: TokenKind::Not,
+                ..
+            }) => {
+                self.advance();
+                BinaryOp::NotEqual
+            }
+            // "is" alone means equality
+            _ => BinaryOp::Equal,
+        }
+    }
+
