+        for (adjective, strict_op) in [("greater", BinaryOp::Greater), ("less", BinaryOp::Less)] {
+            if !(self.is_word_ahead(0, adjective) && self.is_word_ahead(1, "than")) {
+                continue;
+            }
+            self.advance();
+            self.advance();
