+                match crate::path::object_text(name, fields) {
+                    Some(text) => write!(f, "{}", text),
+                    None => write!(f, "<object>"),
+                }
+            }
+        }
         Value::Date(date) => write!(f, "{}", date_text(*date)),
         Value::Duration(duration) => write!(f, "{}", display_duration(*duration)),
     }
 }

