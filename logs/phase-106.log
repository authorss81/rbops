        Error::Runtime(
            format!(
                "Index {} is out of bounds: length is {}, {}",
                Value::Number(n),
                items.len(),
                if items.is_empty() {
                    "the list is empty, so it has no valid index".to_string()
                } else {
                    format!("valid indexes are 0 to {}", items.len() - 1)
                }
            ),
            span,
        )
    })
}

