    try
        set x to 1e400
    catch error
        set caught to yes
    end
    expect caught to be yes
end

test "arithmetic: modulo keeps the sign of the dividend"
    set a to 5 % 3
    set b to -5 % 3
    set c to 5 % -3
    set d to 5 % 0.5
    expect a to be 2
    expect b to be -2
    expect c to be 2
    expect d to be 0
end

