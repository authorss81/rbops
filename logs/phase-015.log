#!/bin/bash
# probe: print formatted output + second-pass equality
RB=target/debug/rb
n=0
probe() {
  n=$((n+1))
  f=target/tmp/probe/p$n.rb
  printf '%s' "$1" > "$f"
  o1=$($RB format "$f" 2>&1); c1=$?
  if [ $c1 -ne 0 ]; then printf '### [%d] REJECTED: %s\n' "$n" "$(printf '%s' "$1" | head -c 60)"; printf '    %s\n' "$(printf '%s' "$o1" | head -1)"; return; fi
  printf '%s' "$o1" > "$f.1"
  o2=$($RB format "$f.1" 2>&1); c2=$?
  if [ $c2 -ne 0 ]; then printf '### [%d] SECOND PASS ERRORED: %s\n' "$n" "$o2"; return; fi
  if [ "$o1" != "$o2" ]; then printf '### [%d] NOT IDEMPOTENT: %s\n--- 1 ---\n%s\n--- 2 ---\n%s\n' "$n" "$(printf '%s' "$1" | head -c 60)" "$o1" "$o2"; return; fi
  # semantic: run original vs formatted
  r1=$($RB run "$f" 2>&1)
  r2=$($RB run "$f.1" 2>&1)
  if [ "$r1" != "$r2" ]; then printf '### [%d] SEMANTIC DRIFT: %s\n--- out1 ---\n%s\n--- out2 ---\n%s\n--- fmt ---\n%s\n' "$n" "$(printf '%s' "$1"|head -c 60)" "$r1" "$r2" "$o1"; fi
}
EOF
