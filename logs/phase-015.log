  # comment preservation: every source comment text must appear in output, exactly once more than...
  while IFS= read -r ln; do
    case "$ln" in
      //*) t="${ln}" ;;
      *) continue ;;
    esac
    a=$(printf '%s\n' "$o1" | grep -c -x -F -- "$t")
    if [ "$a" -lt 1 ]; then printf '### [%d] COMMENT LOST: %s\n' "$n" "$t"; FAIL=1; fi
  done < <(printf '%s\n' "$1" | sed 's/^[ \t]*//')
  # semantic drift, normalising the file path out of diagnostics
  r1=$($RB run "$f" 2>&1 | sed "s|$f|<p>|g")
  r2=$($RB run "$f.1" 2>&1 | sed "s|$f.1|<p>|g")
  if [ "$r1" != "$r2" ]; then printf '### [%d] SEMANTIC DRIFT\n--- in ---\n%s\n--- 1 ---\n%s\n--- 2 ---\n%s\n' "$n" "$1" "$r1" "$r2"; FAIL=1; fi
}
