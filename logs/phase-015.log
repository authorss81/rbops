                self.write(" from ");
                self.format_expression(start);
                self.write(" to ");
                self.format_expression(end);
                if let Some(s) = step {
                    self.write(" by ");
                    self.format_expression(s);
                }
                self.newline();
                self.format_block(body);
                self.write_keyword_line("end");
