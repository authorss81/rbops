    src = open(f).read()
    for _ in range(40):
        lines = src.split("\n")
        op = random.choice(["del","dup","blank","indent","comment","trail","crlf"])
        i = random.randrange(len(lines))
        if op=="del": del lines[i]
        elif op=="dup": lines.insert(i,lines[i])
        elif op=="blank": lines.insert(i,"")
        elif op=="indent": lines.insert(i, random.choice(["\t","  ","    "])+"x")
        elif op=="comment": lines.insert(i, random.choice(["//c","//","// a b c","   // x"]))
        elif op=="trail": lines[i]=lines[i]+"   "
        elif op=="crlf": src = src.replace("\n","\r\n")
        m = "\n".join(lines) if op!="crlf" else src
        tried += 1
        rc1,o1 = fmt_src(m)
        if rc1!=0: continue          # malformed input: correctly rejected
        rc2,o2 = fmt_src(o1)
        if rc2!=0:
            print("REFORMAT-ERR after format:",f,op,repr(m[:120])); bad+=1; continue
        if o1!=o2:
            print("NOT-IDEMPOTENT:",f,op,repr(m[:160])); bad+=1; continue
        # semantics: run original vs formatted
        ra=subprocess.run([RB,"run","target/tmp/p15/in.rb"],capture_output=True,text=True)
        open("target/tmp/p15/out.rb","w").write(o1)
        rb2=subprocess.run([RB,"run","target/tmp/p15/out.rb"],capture_output=True,text=True)
        if (ra.returncode,ra.stdout)!=(rb2.returncode,rb2.stdout):
            print("SEMANTIC DRIFT:",f,op,"rc",ra.returncode,rb2.returncode)
            print("  src:",repr(m[:160])); print("  fmt:",repr(o1[:160]))
            print("  out1:",repr(ra.stdout[:120])); print("  out2:",repr(rb2.stdout[:120]))
            bad+=1
print("tried=%d bad=%d"%(tried,bad))
