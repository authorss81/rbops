random.seed(7)
def fmt(src):
    p = subprocess.run([RB,"format","-"],capture_output=True,text=True,input=src) if False else None
    return p
def fmt_file(path):
    r = subprocess.run([RB,"format",path],capture_output=True,text=True)
    return r.returncode, r.stdout
def fmt_src(src):
    open("target/tmp/p15/in.rb","w").write(src)
    return fmt_file("target/tmp/p15/in.rb")
def strip_spans(x):
    # Program debug output; spans differ after reformat only by line/col, so strip them
    import re
    return re.sub(r'Span \{[^}]*\}','Span',x)
