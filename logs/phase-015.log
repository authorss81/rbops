fn strip(debug: &str) -> String {
    let mut out = String::new();
    let mut rest = debug;
    while let Some(start) = rest.find("Span { ") {
        let after = &rest[start + 7..];
        match after.find(" }") {
            Some(end) => { out.push_str(&rest[..start]); rest = &after[end + 2..]; }
            None => break,
        }
    }
    out.push_str(rest);
    out
}

#[test]
fn dump() {
    let mut files: Vec<String> = vec!["examples".into(), "tests".into()];
    let mut paths = vec![];
    for d in files.drain(..) {
        for e in std::fs::read_dir(&d).unwrap().flatten() {
            let p = e.path();
            if p.extension().and_then(|e| e.to_str()) == Some("rb") { paths.push(p.display().to_string()); }
        }
    }
    paths.sort();
    for f in paths {
        let src = std::fs::read_to_string(&f).unwrap();
        let fmt = match redblue::formatter::format(&src) { Ok(s)=>s, Err(e)=>{println!("{f}: format error {e}"); continue} };
        let p = |s: &str| { let t = redblue::lexer::Lexer::tokenize(s).unwrap(); redblue::parser::parse(t).unwrap() };
        let a = strip(&format!("{:?}", p(&src)));
        let b = strip(&format!("{:?}", p(&fmt)));
        if a != b {
            for (i,(x,y)) in a.chars().zip(b.chars()).enumerate() {
                if x != y {
                    let s = i.saturating_sub(100);
                    println!("{f}: DIFF at {i}\n  A: ...{}\n  B: ...{}", &a[s..(i+100).min(a.len())], &b[s..(i+100).min(b.len())]);
                    break;
                }
            }
        } else {
            let twice = redblue::formatter::format(&fmt).unwrap();
            if twice == fmt { println!("{f}: OK"); } else { println!("{f}: AST same but NOT idempotent"); }
        }
    }
}
