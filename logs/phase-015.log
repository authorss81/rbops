#!/bin/bash
RB=target/debug/rb
n=0
declare -A FAILC
probe() {
  n=$((n+1))
  f=target/tmp/probe/q$n.rb
  printf '%s' "$1" > "$f"
  o1=$($RB format "$f" 2>&1); c1=$?
  if [ $c1 -ne 0 ]; then return; fi
  printf '%s' "$o1" > "$f.1"
  o2=$($RB format "$f.1" 2>&1); c2=$?
  if [ $c2 -ne 0 ]; then FAILC[second_pass_errored]=$(( ${FAILC[second_pass_errored]:-0} + 1 )); printf '### [%d] SECOND PASS ERRORED: %s\n' "$n" "$o2"; return; fi
  if [ "$o1" != "$o2" ]; then FAILC[not_idempotent]=$(( ${FAILC[not_idempotent]:-0} + 1 )); printf '### [%d] NOT IDEMPOTENT\n--- in ---\n%s\n--- 1 ---\n%s\n--- 2 ---\n%s\n' "$n" "$1" "$o1" "$o2"; return; fi
  # every source comment's text (after //) must appear in the output
  while IFS= read -r t; do
    [ -z "$t" ] && continue
    case "$t" in //*) t="${t#//}";; *) continue;; esac
    t="$(printf '%s' "$t" | sed 's/[[:space:]]*$//')"
    [ -z "$t" ] && continue
    if ! printf '%s\n' "$o1" | sed 's/^[[:space:]]*//' | grep -q -x -F -- "//$t"; then
      FAILC[comment_lost]=$(( ${FAILC[comment_lost]:-0} + 1 )); printf '### [%d] COMMENT LOST: %s\n' "$n" "//$t"
    fi
  done < <(printf '%s\n' "$1" | sed 's/^[[:space:]]*//')
  r1=$($RB run "$f" 2>&1 | sed "s|$f|<p>|g")
  r2=$($RB run "$f.1" 2>&1 | sed "s|$f.1|<p>|g")
  if [ "$r1" != "$r2" ]; then FAILC[semantic_drift]=$(( ${FAILC[semantic_drift]:-0} + 1 )); printf '### [%d] SEMANTIC DRIFT\n--- in ---\n%s\n--- 1 ---\n%s\n--- 2 ---\n%s\n' "$n" "$1" "$r1" "$r2"; fi
}
report() {
  printf '\nPROBES=%s\n' "$n"
  for k in "${!FAILC[@]}"; do printf '  %s = %s\n' "$k" "${FAILC[$k]}"; done
  [ ${#FAILC[@]} -eq 0 ] && echo "  ALL CLEAN"
}
EOF
