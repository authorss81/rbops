fn loop_sites(block: &Block) -> Vec<LoopSite> {
    let mut sites = Vec::new();
    for (index, instruction) in block.code.iter().enumerate() {
        if instruction.opcode != Opcode::Jump || instruction.arg as usize >= index {
            continue;
