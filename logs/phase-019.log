+/// What the name at `site`'s `STORE` is bound to right now, or
+/// [`Shadowed::Unbound`] when the site is not an iterator's variable or the
+/// name is bound nowhere.
+///
+/// Recorded once, when the loop entry is created, so every turn of the loop
+/// displaces the same binding — the one that was there before the loop, not
+/// the one the previous turn wrote.
+fn shadow_of(&self, site: LoopSite, frame: usize) -> Shadowed {
+    if !site.iterator {
+        return Shadowed::Unbound;
+    }
+    let instruction = match self.block_at_frame(frame).and_then(|block| {
+        block.code.get(site.top as usize).copied()
+    }) {
+        Some(instruction) => instruction,
+        None => return Shadowed::Unbound,
+    };
+    let name = match self.constant_of(instruction.arg, frame) {
+        Some(text) => text,
+        None => return Shadowed::Unbound,
+    };
+    for (index, scope) in self.locals.iter().enumerate().rev() {
+        if let Some(value) = scope.get(&name) {
+            return Shadowed::Local(index, value.clone());
+        }
+    }
+    match self.globals.get(&name) {
+        Some(value) => Shadowed::Global(value.clone()),
+        None => Shadowed::Unbound,
+    }
+}
