    println!("  rb vm <file.rbc>  Run compiled bytecode");""")
rep("""    println!("  rb dis hello.rbc");""",
"""    println!("  rb dis hello.rbc");
    println!("  rb vm hello.rbc");""")
open(p,'w').write(s)
