+/// Puts back the binding a loop's variable displaced, as the tree-walking VM
+/// does when it pops the scope each turn of the loop ran in.
+///
+/// Only the loop's *own* binding is undone: the loop recorded the value that
+/// was there when the loop started, so a name the body assigned to a scope of
+/// its own is left alone.
+fn restore_shadowed(&mut self, frame: usize, shadowed: Shadowed) {
+    let name = match self.loop_variable(frame) {
+        Some(name) => name,
+        None => return,
+    };
+    match shadowed {
+        Shadowed::Unbound => {
+            if self.frames[frame].globals_only {
+                self.globals.remove(&name);
+                return;
+            }
+            for scope in self.locals.iter_mut().rev() {
+                if scope.remove(&name).is_some() {
+                    return;
+                }
+            }
+            self.globals.remove(&name);
+        }
+        Shadowed::Local(index, value) => {
+            if let Some(scope) = self.locals.get_mut(index) {
+                scope.insert(name, value);
+            }
+        }
+        Shadowed::Global(value) => {
+            self.globals.insert(name, value);
+        }
+    }
+}
