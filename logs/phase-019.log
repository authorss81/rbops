use redblue::bytecode::{compile_source, vm::BytecodeVm};

fn program(depth: usize) -> String {
    let mut s = String::from("set xs to 1\n");
    for _ in 0..depth {
        s.push_str("set xs to [xs, 1]\n");
    }
    s.push_str("say length(xs)\n");
    s
}

fn tree_deepest() -> usize {
    for depth in [2000usize, 4000, 6000, 8000, 10000, 12000, 14000] {
        let source = program(depth);
        let tokens = redblue::lexer::Lexer::tokenize(&source).unwrap();
        let ast = redblue::parser::parse(tokens).unwrap();
        redblue::analyzer::analyze(&ast).unwrap();
        let (vm, result) = redblue::run_isolated(&ast);
        println!("tree depth {depth} -> {:?} {:?}", result.map(|v| v.to_string()), vm.take_output().len());
    }
    0
}

#[test]
fn probe_tree_depths() {
    tree_deepest();
}

#[test]
fn probe_bytecode_depths() {
    for depth in [2000usize, 4000, 6000, 8000, 10000, 12000, 14000] {
        let chunk = compile_source(&program(depth)).unwrap();
        let mut vm = BytecodeVm::new();
        let result = vm.run(&chunk);
        println!("byte depth {depth} -> {:?}", result.map(|v| v.to_string()));
    }
}
EOF
