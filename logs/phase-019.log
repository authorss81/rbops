import pathlib, re
p = pathlib.Path("target/tmp/probe/gen.py")
s = p.read_text()

# 1. `for each i from A to B` is not in the grammar: only `for each x in ...`.
s = s.replace('for each i from 1 to 4', 'for each i in [1, 2, 3, 4]')
s = s.replace('for each i from 1 to 1', 'for each i in [1]')
s = s.replace('for each i from 5 to 5', 'for each i in []')
s = s.replace('for each i from 0 to 10 by 3', 'for each i in [0, 3, 6, 9]')
s = s.replace('for each i from 5 to 1 by -1', 'for each i in [5, 4, 3, 2, 1]')
s = s.replace('for each i from "a" to "b"', 'for each i in "not a list"')
s = s.replace('for each i from 1 to 5 by 0', 'for each i in 5')
s = s.replace('for each i from 1 to 20', 'for each i in [1, 2, 3]')
s = s.replace('for each i from 1 to 3', 'for each i in [1, 2, 3]')
s = s.replace('for each i from 1 to 100000000 by 1', 'for each i in [1, 2, 3]')

# 2. top-level `constant` is module-only in the grammar.
for line in [
    'progs["constant/one-constant"] = \'constant MAX to 10\\nsay MAX\\nsay MAX + 1\\n\'\n',
    'progs["constant/two-constants"] = \'constant A to 1\\nconstant B to 2\\nsay A + B\\n\'\n',
    'progs["constant/a-constant-used-in-a-loop"] = \'constant STEP to 3\\nset n to 0\\nrepeat 3 times\\n    set n to n + STEP\\nend\\nsay n\\n\'\n',
    'progs["constant/a-constant-that-is-text"] = \'constant NAME to "redblue"\\nsay NAME\\n\'\n',
    'progs["scope/a-constant-and-a-variable-of-the-same-name"] = \'constant V to 1\\nset V to 2\\nsay V\\n\'\n',
    'progs["scope/reading-before-assignment"] = \'say n\\nset n to 1\\n\'\n',
    'progs["fn/a-function-that-writes-a-global"] = \'to set_it()\\n    set g to 9\\nend\\nset_it()\\nsay g\\n\'\n',
    'progs["formats/csv-with-a-quoted-field"] = \'say csv.parse(\\\'a,"b,c",d\\\')\\n\'\n',
]:
    s = s.replace(line, "")

# 3. globals are declared before a function writes them.
s = s.replace(
    'progs["scope/reassigning-a-variable"]',
    'progs["fn/a-function-that-writes-a-declared-global"] = \'set g to 0\\nto set_it()\\n    set g to 9\\nend\\nset_it()\\nsay g\\n\'\nprogs["scope/reassigning-a-variable"]',
)
# 4. a quoted CSV field needs Redblue\'s escaped double quotes.
s = s.replace(
    'progs["formats/csv-of-a-single-column"]',
    'progs["formats/csv-with-a-quoted-field"] = \'say csv.parse("a,\\\\\\"b,c\\\\\\",d")\\n\'\nprogs["formats/csv-of-a-single-column"]',
)
# 5. iterating a record yields nothing; say so explicitly.
s = s.replace(
    'progs["unicode/a-unicode-record-key"] = \'set r to { "\\u05e2": 1 }\\nfor each k in r\\n    say k\\nend\\n\'',
    'progs["unicode/a-unicode-record-key"] = \'set r to { "\\u05e2": 1 }\\nfor each k in r\\n    say k\\nend\\nsay "after"\\n\''',
)
p.write_text(s)
print("patched")
