#[test]
fn edge_empty_workload_name_lists_the_four() {
    let refused = bench::run_workload("", 10, DEFAULT_BUDGET);
    assert!(
        refused.is_err(),
        "an empty workload name must produce an error"
    );
    let error = refused.expect_err("empty name must fail");
    let message = error.to_string();
    assert!(
        matches!(error, BenchError::Usage(_)),
        "an empty name is a usage error, got {error:?}"
    );
    for name in WORKLOAD_NAMES {
        assert!(
            message.contains(name),
            "the usage error should list `{name}`: {message}"
        );
    }
}

#[test]
fn edge_negative_and_malformed_sizes_are_refused() {
    let negative = bench::parse_size("-1").expect_err("a negative size must fail");
    assert!(matches!(negative, BenchError::Usage(_)), "{negative:?}");
    assert!(negative.to_string().contains("zero or greater"));

    let text = bench::parse_size("many").expect_err("text is not a size");
    assert!(matches!(text, BenchError::Usage(_)), "{text:?}");
    assert!(text.to_string().contains("many"));

    let workload = bench::run_workload("fibonacci", -1, DEFAULT_BUDGET)
        .expect_err("a negative workload size must fail");
    assert!(matches!(workload, BenchError::Usage(_)), "{workload:?}");
}

#[test]
fn edge_a_hung_workload_fails_loudly_at_its_budget() {
    assert_eq!(
        DEFAULT_BUDGET,
        Duration::from_secs(60),
        "the harness promises a 60-second budget"
    );

    let budget = Duration::from_millis(20);
    let error = bench::run_with_budget("hung", budget, || {
        thread::sleep(Duration::from_millis(250));
        Ok(Value::Number(1.0))
    })
    .expect_err("a workload past its budget must fail");

    match error {
        BenchError::BudgetExceeded { workload, budget } => {
            assert_eq!(workload, "hung");
            assert_eq!(budget, Duration::from_millis(20));
        }
        other => panic!("expected a budget error, got {other:?}"),
    }
}

#[test]
fn edge_a_hung_child_process_is_killed_at_its_budget() {
    let dir = unique_temp_dir("hung-child");
    let sentinel = dir.join("hang");
    let started_marker = sentinel.with_extension("started");
    let finished_marker = sentinel.with_extension("finished");

    let budget = Duration::from_millis(500);
    let child_sleep = Duration::from_secs(10);
    let sentinel_key = std::ffi::OsStr::new(bench::HANG_SENTINEL_ENV);
    let env = [(sentinel_key, sentinel.as_os_str())];

    let watcher_marker = started_marker.clone();
    let watcher = thread::spawn(move || {
        let deadline = Instant::now() + Duration::from_secs(30);
        while !watcher_marker.is_file() {
            if Instant::now() >= deadline {
                return false;
            }
            thread::sleep(Duration::from_millis(2));
        }
        true
    });

    let error = bench::run_workload_with_env(
        bench::HANG_WORKLOAD_NAME,
        child_sleep.as_millis() as i64,
        budget,
        &env,
        Some(&started_marker),
    )
    .expect_err("a child that outlives its budget must be killed");
    assert!(
        watcher.join().expect("the marker watcher should not panic"),
        "the hidden workload should have run in a child process"
    );

    match error {
        BenchError::BudgetExceeded {
            workload,
            budget: reported,
        } => {
            assert_eq!(workload, bench::HANG_WORKLOAD_NAME);
            assert_eq!(reported, budget);
        }
        other => panic!("expected the child's budget error, got {other:?}"),
    }

    assert!(
        started_marker.is_file(),
        "the hidden workload should have run in a child process and written {}",
        started_marker.display()
    );
    assert!(
        !finished_marker.exists(),
        "the child survived its budget and wrote {}",
        finished_marker.display()
    );

    let _ = fs::remove_dir_all(&dir);
}

    let tokens = Lexer::tokenize(&source).map_err(|error| error.to_string())?;
    let program = parser::parse(tokens).map_err(|error| error.to_string())?;
    analyzer::analyze(&program).map_err(|error| error.to_string())?;
    Ok(Value::Number(program.statements.len() as f64))
}

