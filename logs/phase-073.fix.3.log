/// The subject prefixes that identify the delivery commits of the phases whose
/// work is in flight.
///
/// The pipeline writes `resume <phase>: adopt preserved work` when it adopts a
/// preserved attempt, and `resume <phase>: adopt WIP checkpoint` when it adopts
/// a timed-out one. Both are the delivery commit of the phase they name, and
/// both are pinned by the prefix rather than by the whole subject, so the rule
/// survives the two shapes the pipeline uses.
///
/// The subject is what is pinned here and not a SHA, and the reason is
/// mechanical rather than stylistic: the pipeline creates this commit AFTER the
/// run that wrote the work, and re-creates it on every round, squashed onto
/// the same parent. The SHA one round recorded therefore leaves `HEAD`'s
/// ancestry the moment the next round lands, which made a SHA-pinned entry
/// stale by construction — the audit reported it as stale, and reported the
/// new commit as unreviewed, on every single round.
///
/// A prefix, not the whole subject, and a named phase's, not a general one: the
/// rule must acknowledge exactly the commits the pipeline creates for the
/// phases in flight, and nothing else. Another phase's `resume phase-083: …` is
/// still unreviewed work with nothing acknowledging it.
///
/// **The in-flight phases**, so there is one prefix per phase. The
/// pipeline keeps one recovery branch per phase and re-creates that phase's
/// delivery commit on top of the current `main` on every round: phase-084's
/// reviewer-permission work, phase-073's benchmark harness (`tests/bench/mod.rs`,
/// `tests/bench/runner.rs`, `tests/bench_test.rs`, and `BENCH.md`), phase-063's
/// REPL printing trio, phase-088's value assertions, and phase-096's date and
/// duration values are all in this history, arrived in a delivery commit, and
/// none of their delivery commits' SHAs are knowable while the work is being
/// written.
const DELIVERY_SUBJECT_PREFIXES: &[&str] = &[
    "resume phase-068:",
    "resume phase-073:",
    "resume phase-084:",
    "resume phase-063:",
    "resume phase-088:",
    "resume phase-090:",
    "resume phase-096:",
    "resume phase-097:",
    "resume phase-098:",
    "resume phase-099:",
    "resume phase-100:",
    "resume phase-101:",
    "resume phase-102:",
    "resume phase-103:",
    "resume phase-104:",
    "resume phase-105:",
    "resume phase-106:",
    "resume phase-107:",
];

/// The reason recorded for the delivery commits this rule acknowledges.
///
/// It says the two things every entry in [`ACKNOWLEDGED`] says — the commit
/// carries unreviewed code, and it was deliberately not rewritten — and it
/// says why this one is keyed on its subject rather than on its SHA.
///
/// One constant for all, because the commits' contents differ from round to
/// round: a reason that quoted last round's line counts would be a reason
/// about a commit that is not here. It names what each phase's delivery
/// carried instead.
const DELIVERY_REASON: &str = "resume phase-NNN: adopt preserved work. The delivery commit of a \
    phase in flight: it carries the unreviewed code that phase shipped — for phase-084 the \
    repository-root opencode.json that gives the reviewer its denied edit and bash permissions, the \
    phase's own suites (tests/agent_permissions_test.rs and tests/report_markdown_test.rs), the \
    acknowledgement data in tests/unreviewed_work_ack_test.rs, and the phase's REPORT.md and \
    FINDINGS.md; for phase-073 the benchmark harness (tests/bench/mod.rs, tests/bench/runner.rs, \
    and tests/bench_test.rs), the checked-in BENCH.md baseline, and the phase's REPORT.md; for \
    phase-063 the REPL printing trio `.pretty`/`.json`/`.table` (src/repl/render.rs \
    is new, plus the three command rows in src/repl/commands.rs, the dispatch and answer methods in \
    src/repl/mod.rs, the per-command refusal in src/repl/introspect.rs, and the phase's own tests); \
    for phase-088 the reachability-only assertion conversions to value contracts across 10 test suites \
    — Deliberately not rewritten: published history is immutable under AGENTS.md 1.6. Acknowledged by \
    SUBJECT rather than by SHA because the pipeline creates this commit after the run that wrote the \
    work and rebuilds it on the same parent on every round, so a SHA written here would name a commit \
    this history does not contain on the next round.";

    if line.trim().is_empty() {
        return Err(format!("log line {lineno} is blank"));
    }
    let fields: Vec<&str> = line.split('\t').collect();
    if fields.len() != 2 {
        return Err(format!(
            "log line {lineno} has {} tab-separated field(s), expected exactly 2 \
             (`<sha>\\t<subject>`): {line:?}",
            fields.len()
        ));
    }
    let (sha, subject) = (fields[0], fields[1]);
    if !is_object_id(sha) {
        return Err(format!(
            "log line {lineno}: {sha:?} is not a full lowercase object id"
        ));
    }
    if subject.is_empty() {
        return Err(format!("log line {lineno} has an empty subject"));
    }
    Ok((sha, subject))
}

/// Does this subject mark unreviewed work?
///
/// Deliberately a substring test, case-insensitive, over both shapes the
/// pipeline writes: `rbops: phase-NNN checkpoint` and
/// `resume phase-NNN: adopt preserved work`. An exact-prefix test would let a
/// commit through by adding a word in front, which is the whole failure mode.
fn is_unreviewed_subject(subject: &str) -> bool {
    let lower = subject.to_lowercase();
    lower.contains("checkpoint") || lower.contains("resume phase-")
}

/// Is this the delivery commit of a phase whose work is in flight?
///
/// A prefix test on [`DELIVERY_SUBJECT_PREFIXES`], so it matches the two shapes
/// the pipeline writes for those phases and nothing else.
fn is_delivery_subject(subject: &str) -> bool {
    DELIVERY_SUBJECT_PREFIXES
        .iter()
        .any(|prefix| subject.starts_with(prefix))
}

/// The delivery commits in `log`, resolved by subject, each with the reason it
/// is tolerated.
///
/// This is the repair for a rule that could not be satisfied: the pipeline
/// creates the delivery commit after the run that wrote the work, and rebuilds
/// it on the same parent on every round, so the SHA is not knowable when the
/// work is written and is stale by the time the next round's tree is
/// committed. The subject is the part that survives the rebuild, so the
/// subject is what is pinned, and the SHA is read out of the log here.
///
/// A commit resolved this way is acknowledged by construction: it is not
/// unreviewed, and it cannot be stale, because no SHA is pinned that could
/// point at nothing.
///
/// The reason is a constant, not a per-commit string, because the commit's
/// contents differ from round to round and a reason that quoted last round's
/// line counts would be a reason about a commit that is not here. It says what
/// every entry in [`ACKNOWLEDGED`] says — the commit carries unreviewed code,
/// and it was deliberately not rewritten.
///
/// The SHAs come out of the log itself, so a subject that matches nothing
/// resolves to nothing and the commit it named — if there is one — is reported
/// as unreviewed like any other. The rule cannot hide a commit; it can only
/// cover the one it names.
fn delivery_acknowledgements(log: &str) -> Vec<(&str, &str)> {
    let mut found: Vec<(&str, &str)> = Vec::new();
    for (idx, raw) in log.lines().enumerate() {
        let (sha, subject) = match parse_log_line(raw, idx + 1) {
            Ok(parsed) => parsed,
            // A malformed line is `scan`'s error to raise, not this function's
            // to swallow: it is reported by the caller with its line number.
            Err(_) => continue,
        };
        if is_delivery_subject(subject) && !found.iter().any(|(entry, _)| *entry == sha) {
            found.push((sha, DELIVERY_REASON));
        }
    }
    found
}

/// The delivery commits in `log`, by SHA.
fn delivery_commits(log: &str) -> Vec<&str> {
    delivery_acknowledgements(log)
        .into_iter()
        .map(|(sha, _)| sha)
        .collect()
}

