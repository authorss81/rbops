printf '\033[31m╔══════════════════════════════════════╗\033[0m\n'
printf '\033[31m║ VERIFY FAIL — %-24s ║\033[0m\n' "$PHASE"
printf '\033[31m║ %d check(s) failed                    ║\033[0m\n' "$FAIL"
printf '\033[31m╚══════════════════════════════════════╝\033[0m\n'
