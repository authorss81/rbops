    fn parse_set(&mut self) -> Result<Option<Statement>> {
        self.advance(); // consume 'set'

        let name = match self.current() {
            Some(Token {
                kind: TokenKind::Identifier(name),
                ..
            }) => {
                let n = name.clone();
                self.advance();
                n
