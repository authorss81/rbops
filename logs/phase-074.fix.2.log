                if each_patch.at is "here" then
                    set apply_patches_arg to length(code)
                else
                    set apply_patches_arg to each_patch.value - start
                end
            end
        end
        append("G_PATCHED", {o: code[apply_patches_i].o, a: apply_patches_arg, x: code[apply_patches_i].x, l: code[apply_patches_i].l})
        set apply_patches_i to apply_patches_i + 1
    end
    give back G_PATCHED
end

// The intern table. A name used a hundred times is one entry, so the pool is
// the same whichever way round the source used them.
//
// A lookup used to walk every entry, and a self-compilation walks the table for
// every name it emits, so the cost was the number of names times the number of
// entries. `intern_hash` names a bucket instead, and only that bucket's entries
// are compared. The entries stay in `G_INTERN` in insertion order, so a new
// name still takes the next pool index and the emitted bytes are unchanged.
to intern(raw)
    intern_init()
    set intern_bucket to intern_hash(raw) mod INTERN_BUCKETS
    set intern_chain to G_INTERN_BUCKETS[intern_bucket]
    set intern_found to -1
    set intern_i to 0
    while intern_i < length(intern_chain)
        if intern_found < 0 then
            if G_INTERN[intern_chain[intern_i]].k is raw then
                set intern_found to intern_chain[intern_i]
            end
        end
        set intern_i to intern_i + 1
    end
    set intern_result to 0
    if intern_found >= 0 then
        set intern_result to G_INTERN[intern_found].n
    end
    if intern_found < 0 then
        set intern_index to length(G_POOL)
        append("G_POOL", {t: 3, b: raw})
        append("G_INTERN", {k: raw, n: intern_index})
        set G_INTERN_COUNT to G_INTERN_COUNT + 1
        intern_bucket_add(intern_bucket, length(G_INTERN) - 1)
        set intern_result to intern_index
    end
    give back intern_result
end

// A polynomial rolling hash over the name's bytes, reduced so every
// intermediate below the multiply is exact in an `f64`. The exact value does not matter; what matters
// is that the same bytes give the same bucket on every run, in both the
// tree-walker and the bytecode VM.
to intern_hash(raw)
    set intern_hash_value to 0
    set intern_hash_i to 0
    while intern_hash_i < length(raw)
        set intern_hash_value to (intern_hash_value * 31 + raw[intern_hash_i]) mod 2147483647
        set intern_hash_i to intern_hash_i + 1
    end
    give back intern_hash_value
end

// The bucket array, built on the first lookup. Every bucket starts empty.
to intern_init()
    if length(G_INTERN_BUCKETS) is 0 then
        set intern_init_i to 0
        while intern_init_i < INTERN_BUCKETS
            append("G_INTERN_BUCKETS", [])
            set intern_init_i to intern_init_i + 1
        end
    end
end

// The index is added to one bucket. The bucket is rebuilt rather than changed
// in place because Redblue has no index assignment, and the table is rebuilt
// with it because a bucket is held by value. Rebuilding the table costs one
// `append` per bucket, paid only when a name is new; a lookup still reads its
// bucket directly.
to intern_bucket_add(bucket, entry_index)
    set intern_bucket_add_chain to push(G_INTERN_BUCKETS[bucket], entry_index)
    set G_INTERN_BUCKETS_NEXT to []
    set intern_bucket_add_i to 0
    while intern_bucket_add_i < length(G_INTERN_BUCKETS)
        if intern_bucket_add_i is bucket then
            append("G_INTERN_BUCKETS_NEXT", intern_bucket_add_chain)
        else
            append("G_INTERN_BUCKETS_NEXT", G_INTERN_BUCKETS[intern_bucket_add_i])
        end
        set intern_bucket_add_i to intern_bucket_add_i + 1
    end
    set G_INTERN_BUCKETS to G_INTERN_BUCKETS_NEXT
end

// The direct tests in `tests/bootstrap_selfhost_test.rs` drive the table through
// this mode instead of hoping a source program happens to exercise one bucket.
// It runs only for `--intern-selftest`; a normal invocation takes the two-path
// branch in `main` and never reaches it.
to intern_selftest()
    set intern_selftest_start to G_INTERN_COUNT

    // One name, a thousand times: the table grows by one, not by a thousand.
    set intern_selftest_repeated to bytes.from_text("repeated")
    set intern_selftest_first to intern(intern_selftest_repeated)
    set intern_selftest_i to 0
    while intern_selftest_i < 1000
        intern(intern_selftest_repeated)
        set intern_selftest_i to intern_selftest_i + 1
    end
    say "repeat_growth " + to_text(G_INTERN_COUNT - intern_selftest_start)
    intern(bytes.from_text("other"))
    say "other_growth " + to_text(G_INTERN_COUNT - intern_selftest_start)

    // The empty name is a name, not a missing one.
    set intern_selftest_empty_start to G_INTERN_COUNT
    set intern_selftest_empty_one to intern([])
    set intern_selftest_empty_two to intern([])
    say "empty_same " + intern_selftest_yes(intern_selftest_empty_one is intern_selftest_empty_two)
    say "empty_growth " + to_text(G_INTERN_COUNT - intern_selftest_empty_start)

    // A name far longer than a bucket count, and a variant that differs only in
    // its last byte. A hash that truncated the name would give them one index.
    set intern_selftest_long_a to []
    set intern_selftest_long_b to []
    set intern_selftest_i to 0
    while intern_selftest_i < 10000
        append("intern_selftest_long_a", 120)
        append("intern_selftest_long_b", 120)
        set intern_selftest_i to intern_selftest_i + 1
    end
    append("intern_selftest_long_b", 121)
    set intern_selftest_long_start to G_INTERN_COUNT
    set intern_selftest_long_one to intern(intern_selftest_long_a)
    set intern_selftest_long_two to intern(intern_selftest_long_a)
    set intern_selftest_long_three to intern(intern_selftest_long_b)
    say "long_same " + intern_selftest_yes(intern_selftest_long_one is intern_selftest_long_two)
    say "long_distinct " + intern_selftest_yes(intern_selftest_long_one is not intern_selftest_long_three)
    say "long_growth " + to_text(G_INTERN_COUNT - intern_selftest_long_start)

    // Two distinct names engineered to select the same bucket: keep the first
    // candidate, then walk a sequence of distinct names until one hashes to its
    // bucket. Both then have to be in the bucket at once and each has to answer
    // with its own index.
    set intern_selftest_a to bytes.from_text("collision-0")
    set intern_selftest_a_bucket to intern_hash(intern_selftest_a) mod INTERN_BUCKETS
    set intern_selftest_b to []
    set intern_selftest_found to no
    set intern_selftest_i to 1
    while intern_selftest_i < 20000
        if intern_selftest_found is no then
            set intern_selftest_b to bytes.from_text("collision-" + to_text(intern_selftest_i))
            if (intern_hash(intern_selftest_b) mod INTERN_BUCKETS) is intern_selftest_a_bucket then
                set intern_selftest_found to yes
            end
        end
        set intern_selftest_i to intern_selftest_i + 1
    end
    set intern_selftest_a_index to intern(intern_selftest_a)
    set intern_selftest_b_index to intern(intern_selftest_b)
    say "collision_found " + intern_selftest_yes(intern_selftest_found)
    say "collision_distinct " + intern_selftest_yes(intern_selftest_a_index is not intern_selftest_b_index)
    say "collision_bucket " + to_text(intern_hash(intern_selftest_a) mod INTERN_BUCKETS)
    say "collision_a_index " + to_text(intern_selftest_a_index)
    say "collision_b_index " + to_text(intern_selftest_b_index)
    say "collision_a_lookup " + to_text(intern(intern_selftest_a))
    say "collision_b_lookup " + to_text(intern(intern_selftest_b))
