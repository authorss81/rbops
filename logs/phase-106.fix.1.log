+fn compensated_sum<I>(numbers: I) -> Option<f64>
+where
+    I: IntoIterator<Item = f64>,
+{
+    let mut sum = 0.0;
+    let mut correction = 0.0;
+    for number in numbers {
+        let next = sum + number;
+        if !next.is_finite() {
+            return None;
+        }
+        if sum.abs() >= number.abs() {
+            correction += (sum - next) + number;
+        } else {
+            correction += (number - next) + sum;
+        }
+        sum = next;
+    }
+    let total = sum + correction;
+    total.is_finite().then_some(total)
+}
+
+fn mean_of(array: &Array2<f64>) -> f64 {
+    let count = array.len() as f64;
+    if let Some(sum) = compensated_sum(array.iter().copied()) {
+        return sum / count;
+    }
+    let scale = array
+        .iter()
+        .fold(0.0_f64, |scale, number| scale.max(number.abs()));
+    if scale == 0.0 {
+        return 0.0;
+    }
+    let sum: f64 = array.iter().map(|number| number / scale).sum();
+    scale * (sum / count)
+}
+
