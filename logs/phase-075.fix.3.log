        .expect("a position inside the file is valid")
        .expect("the plain `abs` call is still the builtin");
    assert_eq!(
        (builtin.kind.as_str(), builtin.name.as_str()),
        ("builtin", "abs"),
        "the member guard must not hide a real use of the builtin"
    );
}

