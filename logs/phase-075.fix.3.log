        .lines()
        .next()
        .map(|line| line.chars().count() + 2)
        .unwrap();

    assert!(
        goto_definition(source, 1, past).is_err(),
        "a column past the line must be a clean error"
    );
    assert!(
        find_references(source, 1, past).is_err(),
