#[derive(Debug, Clone)]
struct Binding {
    name: String,
    location: Location,
    kind: DefinitionKind,
}

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
enum FrameKind {
    If,
    Unless,
    For,
    While,
    Repeat,
    To,
    Literal,
    Object,
    Module,
    Test,
    Try,
}

#[derive(Debug, Clone, Copy)]
struct Frame {
    kind: FrameKind,
    opens_scope: bool,
    catch_scope: bool,
    /// For a one-line function literal, the token index where the parsed body
    /// ends. The scope closes just before that token, so a trailing argument on
    /// the same line resolves outside the literal.
    closes_at_token: Option<usize>,
}

impl Frame {
    fn block(kind: FrameKind) -> Self {
        Self {
            kind,
            opens_scope: false,
            catch_scope: false,
            closes_at_token: None,
        }
    }

    fn scoped(kind: FrameKind) -> Self {
        Self {
            kind,
            opens_scope: true,
            catch_scope: false,
            closes_at_token: None,
        }
    }
}

