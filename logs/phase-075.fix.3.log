            TokenKind::Number(n) => {
                self.advance();
                Ok(Expr::Number(*n))
            }
            TokenKind::Text(s) => {
                self.advance();
                self.parse_text(s.clone(), token.span())
            }
            TokenKind::YesNo(b) => {
                self.advance();
                Ok(Expr::YesNo(*b))
            }
            TokenKind::Nothing => {
                self.advance();
                Ok(Expr::Nothing)
            }
