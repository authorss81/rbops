/// The mutable bookkeeping a declaration updates while scopes are walked.
struct DeclarationSink<'a> {
    token_binding: &'a mut [Option<usize>],
    declarations: &'a mut HashSet<usize>,
    type_names: &'a mut HashSet<usize>,
}

