fn to_json(&self) -> String {
        format!(
            concat!(
                "{{\"line\":{},\"column\":{},\"end_line\":{},\"end_column\":{},",
                "\"kind\":{},\"name\":{}}}"
            ),
            self.line,
            self.column,
            self.end_line,
