    fn parse_block_body(&mut self) -> Result<Vec<Stmt>> {
        self.skip_newlines();

        let mut body = Vec::new();
        while self.current().map(|t| &t.kind) != Some(&TokenKind::End)
            && self.current().map(|t| &t.kind) != Some(&TokenKind::Eof)
        {
            if let Some(stmt) = self.parse_statement()? {
                body.push(stmt);
            }
            self.skip_newlines();
        }

        Ok(body)
    }

