#[test]
fn edge_module_member_shadowed_by_set_does_not_resolve_to_the_stale_function() {
    let source = concat!(
        "module M\n",
        "    to f()\n",
        "        give back 1\n",
        "    end\n",
        "    set f to 2\n",
        "    export f\n",
        "end\n",
        "say M.f()\n",
    );

    assert_eq!(
        goto_definition(source, 8, 7).expect("a position inside the file is valid"),
        None,
        "a `set` replaces the module member's function value, so the old `to` is not its declaration"
    );
    assert!(
        find_references(source, 8, 7)
            .expect("a position inside the file is valid")
            .is_empty(),
        "the stale function binding must not own the member call"
    );
}

#[test]
fn edge_module_member_shadowed_by_constant_does_not_resolve_to_the_stale_function() {
    let source = concat!(
        "module M\n",
        "    to f()\n",
        "        give back 1\n",
        "    end\n",
        "    constant f to 2\n",
        "    export f\n",
        "end\n",
        "say M.f()\n",
    );

    assert_eq!(
        goto_definition(source, 8, 7).expect("a position inside the file is valid"),
        None,
        "a `constant` replaces the module member's function value, so the old `to` is not its declaration"
    );
}

#[test]
fn edge_module_member_shadowed_by_a_nested_block_replacement_does_not_resolve_to_the_stale_function(
) {
    let source = concat!(
        "module M\n",
        "    to f()\n",
        "        give back 1\n",
        "    end\n",
        "    to g()\n",
        "        give back 2\n",
        "    end\n",
        "    if yes then\n",
        "        set f to 3\n",
        "        constant g to 4\n",
        "    end\n",
        "    export all\n",
        "end\n",
        "say M.f()\n",
        "say M.g()\n",
    );

    for (line, name) in [(14, "f"), (15, "g")] {
        assert_eq!(
            goto_definition(source, line, 7).expect("a position inside the file is valid"),
            None,
            "a nested block's `set`/`constant` replaces the module member `{name}`, so the old `to` is not its declaration"
        );
        assert!(
            find_references(source, line, 7)
                .expect("a position inside the file is valid")
                .is_empty(),
            "the stale function binding must not own the member call for `{name}`"
        );
    }
}

#[test]
fn edge_module_member_write_replaces_the_published_function() {
    let source = concat!(
        "module M\n",
        "    to f()\n",
        "        give back 1\n",
        "    end\n",
        "    export f\n",
        "end\n",
        "say M.f\n",
        "set M.f to 2\n",
        "say M.f\n",
    );

    let before = goto_definition(source, 7, 7)
        .expect("a position inside the file is valid")
        .expect("a read before the write still names the published function");
    assert_eq!(
        (before.line, before.column),
        (2, 8),
        "the write only replaces the member for later uses"
    );

    for line in [8, 9] {
        assert_eq!(
            goto_definition(source, line, 7).expect("a position inside the file is valid"),
            None,
            "a member write replaces the module function, so line {line} must not resolve to the stale `to`"
        );
        assert!(
            find_references(source, line, 7)
                .expect("a position inside the file is valid")
                .is_empty(),
            "the stale function binding must not own the member on line {line}"
        );
    }
}

#[test]
fn edge_import_alias_member_write_replaces_the_published_function() {
    let source = concat!(
        "module M\n",
        "    to f()\n",
        "        give back 1\n",
        "    end\n",
        "    export f\n",
        "end\n",
        "import M as A\n",
        "say A.f\n",
        "set A.f to 2\n",
        "say A.f\n",
    );

    let before = goto_definition(source, 8, 7)
        .expect("a position inside the file is valid")
        .expect("a read through the alias before the write names the published function");
    assert_eq!(
        (before.line, before.column),
        (2, 8),
        "the aliased read before the write still resolves to the function"
    );

    for line in [9, 10] {
        assert_eq!(
            goto_definition(source, line, 7).expect("a position inside the file is valid"),
            None,
            "a member write through an import alias replaces the module function, so line {line} must not resolve to the stale `to`"
        );
    }
}

