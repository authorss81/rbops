fn close_due_frames(
    frames: &mut Vec<Frame>,
    scopes: &mut Vec<HashMap<String, usize>>,
    index: usize,
) {
    while matches!(
        frames.last(),
        Some(frame) if frame.closes_at_token == Some(index)
