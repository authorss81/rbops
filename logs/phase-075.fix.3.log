    printf '\033[33m║ PREFLIGHT NOTHING TO JUDGE — %s ║\033[0m\n' "$PHASE"
    printf '\033[33m╚══════════════════════════════════════╝\033[0m\n'
    exit 4
  fi
  bad "no changed files detected against $BASE_REF"
fi

