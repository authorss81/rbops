            _ => {}
        }

        if !matches!(token.kind, TokenKind::Newline | TokenKind::Eof) {
            last_significant_line = Some(token.line);
            last_significant = Some(index);
        }
        index += 1;
    }

    if visible.is_none() {
        visible = Some(visible_names(&scopes));
    }

    Ok(Analysis {
        tokens,
        bindings,
        token_binding,
        visible: visible.unwrap_or_default(),
    })
}

