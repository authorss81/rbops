fn mutations() {
    let root = std::path::Path::new(env!("CARGO_MANIFEST_DIR"));
    let mut files: Vec<std::path::PathBuf> = Vec::new();
    for dir in ["examples", "tests"] {
        for e in std::fs::read_dir(root.join(dir)).unwrap().flatten() {
            let p = e.path();
            if p.extension().and_then(|x| x.to_str()) == Some("rb") {
                files.push(p);
            }
        }
    }
    files.sort();
    let mut cases = 0usize;
    let mut nonidem = 0usize;
    let mut drift = 0usize;
    let mut errs = 0usize;
    for f in &files {
        let source = std::fs::read_to_string(f).unwrap();
        let lines: Vec<String> = source.lines().map(|s| s.to_string()).collect();
        let mut variants: Vec<String> = Vec::new();
        for i in 0..lines.len().max(1) {
            // delete
            let mut v = lines.clone();
            v.remove(i.min(v.len().saturating_sub(1)));
            variants.push(format!("{}\\n", v.join("\\n")));
            // duplicate
            let mut v = lines.clone();
            let l = v[i.min(v.len().saturating_sub(1))].clone();
            v.insert(i, l);
            variants.push(format!("{}\\n", v.join("\\n")));
            // blank line
            let mut v = lines.clone();
            v.insert(i, String::new());
            variants.push(format!("{}\\n", v.join("\\n")));
            // stray tab indent
            let mut v = lines.clone();
            let k = i.min(v.len().saturating_sub(1));
            v[k] = format!("\\t{}", v[k]);
            variants.push(format!("{}\\n", v.join("\\n")));
            // trailing whitespace
            let mut v = lines.clone();
            let k = i.min(v.len().saturating_sub(1));
            v[k] = format!("{}   ", v[k]);
            variants.push(format!("{}\\n", v.join("\\n")));
        }
        variants.push(source.replace('\\n', "\\r\\n"));
        variants.push(format!("{}   \\n", source));
        for m in variants {
            let once = match formatter::format(&m) {
                Ok(o) => o,
                Err(_) => { errs += 1; continue; }
            };
            cases += 1;
            match formatter::format(&once) {
                Ok(twice) if twice == once => {}
                Ok(twice) => { nonidem += 1; eprintln!("NONIDEM {} on {:?}", f.display(), &m[..m.len().min(60)]); }
                Err(e) => { nonidem += 1; eprintln!("SECOND-FAIL {} {:?} -> {}", f.display(), &m[..m.len().min(60)], e); }
            }
            let before = parser::parse(Lexer::tokenize(&m).unwrap()).unwrap();
            let after = parser::parse(Lexer::tokenize(&once).unwrap()).unwrap();
            if !same(&before, &after) {
                drift += 1;
                eprintln!("DRIFT {} on {:?}", f.display(), &m[..m.len().min(60)]);
            }
        }
    }
    eprintln!("MUT cases={} nonidem={} drift={} skipped_err={}", cases, nonidem, drift, errs);
    assert_eq!((nonidem, drift), (0, 0));
}

