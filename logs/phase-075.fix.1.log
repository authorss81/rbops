#[test]
fn edge_this_member_resolves_through_the_parent_chain() {
    let source = concat!(
        "object Person\n",
        "    has age default 1\n",
        "end\n",
        "object Employee extends Person\n",
        "    to can describe()\n",
        "        give back this.age\n",
        "    end\n",
        "end\n",
    );

    let found = goto_definition(source, 6, 24)
        .expect("a position inside the file is valid")
        .expect("`this.age` resolves the inherited field through the child");

    assert_eq!(
        (found.line, found.column),
        (2, 9),
        "the member read resolves to the ancestor that declared the field"
    );

    let references: Vec<(usize, usize)> = find_references(source, 6, 24)
        .expect("a position inside the file is valid")
        .into_iter()
        .map(|location| (location.line, location.column))
        .collect();
    assert_eq!(
        references,
        vec![(2, 9), (6, 24)],
        "`this.age` joins the field declaration it reads"
    );
}

#[test]
fn edge_extends_cycle_does_not_hang_member_navigation() {
    let source = concat!(
        "object A extends B\n",
        "end\n",
        "object B extends A\n",
        "end\n",
        "say A.thing\n",
    );

    assert_eq!(
        goto_definition(source, 5, 7).expect("a position inside the file is valid"),
        None,
        "a cyclic parent chain declares no member, and must stop rather than loop"
    );
    assert!(
        find_references(source, 5, 7)
            .expect("a position inside the file is valid")
            .is_empty(),
        "a cyclic parent chain has no binding to reference"
    );
}

