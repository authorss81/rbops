 #[test]
+fn edge_constant_in_an_inner_scope_shadows_the_enclosing_variable() {
+    let source = concat!(
+        "set x to 1\n",
+        "while x is less than 2\n",
+        "    constant x to 2\n",
+        "    say x\n",
+        "end\n",
+    );
+
+    let inside = goto_definition(source, 4, 9)
+        .expect("a position inside the file is valid")
+        .expect("the inner use resolves to the constant declared in the loop");
+    assert_eq!(
+        (inside.line, inside.column, inside.kind.as_str()),
+        (3, 14, "constant"),
+        "a `constant` declares in the current scope instead of reusing the outer `set`"
+    );
+
+    let references: Vec<(usize, usize)> = find_references(source, 4, 9)
+        .expect("a position inside the file is valid")
+        .into_iter()
+        .map(|location| (location.line, location.column))
+        .collect();
+    assert_eq!(
+        references,
+        vec![(3, 14), (4, 9)],
+        "the inner constant's references must not include the outer variable"
+    );
+}
