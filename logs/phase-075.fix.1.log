                self.analyze_body(then_branch);
                self.pop_scope();
                if self.stopped() {
                    return;
                }
                self.push_scope();
                self.analyze_body(else_branch);
                self.pop_scope();
            }
            Statement::Unless { condition, body } => {
                self.analyze_expr(condition, &span);
                self.push_scope();
                self.analyze_body(body);
                self.pop_scope();
            }
            Statement::ForEach {
                variable,
                iterable,
                body,
