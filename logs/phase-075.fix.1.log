            .find(|(listed, _)| *listed == module)
            .map(|(_, members)| *members)
            .unwrap_or(&[])
            .to_vec()
    } else if let Some(declared) = analysis.declared_module_members.get(module) {
        declared.iter().map(String::as_str).collect()
    } else {
        MODULE_MEMBERS
            .iter()
            .find(|(listed, _)| *listed == module)
            .map(|(_, members)| *members)
            .unwrap_or(&[])
            .to_vec()
    };
