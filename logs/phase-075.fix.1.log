///
/// The runtime keeps a function and a variable of the same spelling in one
/// slot, so a `set` after a `to` shadows the function for every later use. The
/// earlier function keeps its own references, which is why this is a fresh
/// binding rather than a reuse. `scope_position` is the innermost function,
/// module, test or program frame: block scopes are analyzer constructs, not
/// places where the VM's `set` creates a variable.
fn declare_replacing_binding(
    scopes: &mut [HashMap<String, usize>],
    bindings: &mut Vec<Binding>,
    binding_scopes: &mut Vec<usize>,
    scope_id: usize,
    scope_position: usize,
    name: &str,
    location: Location,
) -> usize {
    let id = bindings.len();
    bindings.push(Binding {
        name: name.to_string(),
        location,
        kind: DefinitionKind::Variable,
        lexical: true,
        call_only: false,
    });
    binding_scopes.push(scope_id);
    scopes[scope_position].insert(name.to_string(), id);
    id
}

