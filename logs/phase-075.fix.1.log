//! Editor/LSP tooling: the shipped TextMate grammar must cover the keyword set
//! the lexer actually recognises, and diagnostics must surface the spanned
//! lexer/parser/analyzer errors `run_source` reports.

use std::fs;
use std::path::PathBuf;

use redblue::lexer::Lexer;
use redblue::lsp::{
    completions, completions_json, diagnostics, diagnostics_json, find_references,
    find_references_json, goto_definition, goto_definition_json, keyword_pattern, textmate_grammar,
    Diagnostic, Severity, GRAMMAR_PATH, LANGUAGE_CONFIG_PATH,
};
use redblue::run_source;

fn manifest_path(relative: &str) -> PathBuf {
    PathBuf::from(env!("CARGO_MANIFEST_DIR")).join(relative)
}

/// The single error diagnostic, or a failure naming what came back instead.
fn error_diagnostic(source: &str) -> Diagnostic {
    let all = diagnostics(source);
    let diagnostic = all
        .iter()
        .find(|d| d.severity == Severity::Error)
        .unwrap_or_else(|| panic!("expected an error diagnostic, got {:?}", all));

    diagnostic.clone()
}

// ---------------------------------------------------------------------------
// The grammar covers the keyword set
// ---------------------------------------------------------------------------

#[test]
fn grammar_covers_the_lexer_keyword_set() {
    let keywords = Lexer::keywords();
    assert!(
        !keywords.is_empty(),
        "the lexer must publish a non-empty keyword set for tooling to use"
    );

    let pattern = keyword_pattern();
    let alternation = pattern
        .strip_prefix(r"\b(?:")
        .and_then(|rest| rest.strip_suffix(r")\b"))
        .unwrap_or_else(|| panic!("keyword pattern must be a bounded alternation: {}", pattern));

    let words: Vec<&str> = alternation.split('|').collect();

    for keyword in keywords {
        assert!(
            words.contains(keyword),
            "the grammar keyword pattern omits `{}`",
            keyword
        );
        assert!(
            textmate_grammar().contains(keyword),
            "the generated TextMate grammar omits `{}`",
            keyword
    assert!(
        completions(source, 0, 1).is_err(),
        "completion on line 0 must be a clean error"
    );
}

#[test]
fn edge_goto_definition_on_a_declared_module_value_resolves_to_its_declaration() {
    let source = concat!(
        "module Counter\n",
        "    set count to 1\n",
        "    constant label to \"n\"\n",
        "    export all\n",
        "end\n",
        "say Counter.count\n",
        "say Counter.label\n",
    );

    let count = goto_definition(source, 6, 13)
        .expect("a position inside the file is valid")
        .expect("a read of a declared module's exported value names its declaration");
    assert_eq!(
        (count.line, count.column, count.kind.as_str()),
        (2, 9, "variable"),
        "the member read must point at the module's `set` name"
    );
    assert_eq!(count.name, "count");

    let label = goto_definition(source, 7, 13)
        .expect("a position inside the file is valid")
        .expect("a read of a declared module's exported constant names its declaration");
    assert_eq!(
        (label.line, label.column, label.kind.as_str()),
        (3, 14, "constant"),
        "the member read must point at the module's `constant` name"
    );
}

#[test]
fn edge_find_references_on_a_declared_module_value_do_not_cross_a_same_named_variable() {
    let source = concat!(
        "module Counter\n",
        "    set count to 1\n",
        "    export all\n",
        "end\n",
        "set count to 99\n",
        "say count\n",
        "say Counter.count\n",
    );

    let module_value: Vec<(usize, usize)> = find_references(source, 2, 9)
        .expect("a position inside the file is valid")
        .into_iter()
        .map(|location| (location.line, location.column))
        .collect();
    assert_eq!(
        module_value,
        vec![(2, 9), (7, 13)],
        "the module value's references must exclude the same-named program variable"
    );

    let program_variable: Vec<(usize, usize)> = find_references(source, 5, 5)
        .expect("a position inside the file is valid")
        .into_iter()
        .map(|location| (location.line, location.column))
        .collect();
    assert_eq!(
        program_variable,
        vec![(5, 5), (6, 5)],
        "the program variable's references must exclude the module value"
    );
}

#[test]
fn edge_declared_module_value_navigation_respects_export() {
    let source = concat!(
        "module Counter\n",
        "    set hidden to 1\n",
        "    set shown to 2\n",
        "    export shown\n",
        "end\n",
        "say Counter.hidden\n",
        "say Counter.shown\n",
    );

    assert_eq!(
        goto_definition(source, 6, 13).expect("a position inside the file is valid"),
        None,
        "a value the export leaves out is not published, so it has no declaration to jump to"
    );
    assert!(
        find_references(source, 6, 13)
            .expect("a position inside the file is valid")
            .is_empty(),
        "an unexported value is not a reference target"
    );

    let published = goto_definition(source, 7, 13)
        .expect("a position inside the file is valid")
        .expect("the exported value still resolves");
    assert_eq!(
        (published.line, published.column, published.kind.as_str()),
        (3, 9, "variable"),
        "an explicit export publishes the value it names"
    );
}

#[test]
fn edge_a_module_function_after_a_value_replaces_the_published_binding() {
    let source = concat!(
        "module Counter\n",
        "    set read to 1\n",
        "    to read()\n",
        "        give back 2\n",
        "    end\n",
        "    export all\n",
        "end\n",
        "say Counter.read()\n",
    );

    let found = goto_definition(source, 8, 13)
        .expect("a position inside the file is valid")
        .expect("the later function replaces the module value of the same name");
    assert_eq!(
        (found.line, found.column, found.kind.as_str()),
        (3, 8, "function"),
        "the call must jump to the `to` declaration, not the replaced `set`"
    );
}

#[test]
fn edge_module_value_navigation_rejects_a_malformed_position() {
    let source = concat!(
        "module Counter\n",
        "    set count to 1\n",
        "    export all\n",
        "end\n",
        "say Counter.count\n",
    );

    for (line, column) in [(0, 1), (7, 1), (5, 99)] {
        assert!(
            goto_definition(source, line, column).is_err(),
            "goto_definition must reject {line}:{column} with an error"
        );
        assert!(
            find_references(source, line, column).is_err(),
            "find_references must reject {line}:{column} with an error"
        );
        assert!(
            completions(source, line, column).is_err(),
            "completions must reject {line}:{column} with an error"
        );
    }
}
