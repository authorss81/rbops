/// holds one alongside the plain name. A method and a field can share a
/// spelling; the scope's plain entry keeps the first declaration, so a call has
/// to look for the method explicitly, mirroring [`member_binding`].
///
/// Only a function declared after the scope's current entry can win. A later
/// `set` replaces an earlier function in the same runtime slot, so a call after
/// that `set` must not fall back to the shadowed function. A method declared
/// after a plain variable is still later, so `name()` keeps resolving to it.
fn scope_function_binding(
    name: &str,
    first: usize,
    scope_id: usize,
    bindings: &[Binding],
    binding_scopes: &[usize],
) -> Option<usize> {
    if bindings[first].lexical && bindings[first].kind == DefinitionKind::Function {
        return Some(first);
    }
    binding_scopes
        .iter()
        .enumerate()
        .find(|(id, scope)| {
            *id > first
                && **scope == scope_id
                && bindings[*id].lexical
                && bindings[*id].name == name
                && bindings[*id].kind == DefinitionKind::Function
        })
