/// binding in place, so the read still answers that variable.
fn scope_plain_binding(
    name: &str,
    first: usize,
    scope_id: usize,
    bindings: &[Binding],
    binding_scopes: &[usize],
) -> Option<usize> {
    if bindings[first].lexical {
        return Some(first);
    }
    binding_scopes
        .iter()
        .enumerate()
        .find(|(id, scope)| {
            **scope == scope_id && bindings[*id].lexical && bindings[*id].name == name
        })
        .map(|(id, _)| id)
}

