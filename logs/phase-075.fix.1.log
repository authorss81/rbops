+/// The source offset of the opening quote of the text literal holding `offset`.
+fn text_start_at(tokens: &[Token], map: &SourceMap, offset: usize) -> Option<usize> {
+    tokens.iter().find_map(|token| {
+        if !matches!(token.kind, TokenKind::Text(_)) {
+            return None;
+        }
+        let start = map.offset(token.line, token.column);
+        let mut cursor = start + 1;
+        while cursor < map.chars.len() {
+            match map.chars[cursor] {
+                '\\' => cursor += 2,
+                '"' => return (offset >= start && offset <= cursor).then_some(start),
+                _ => cursor += 1,
+            }
+        }
+        (offset >= start).then_some(start)
+    })
+}
+
+/// The offset just inside the innermost `{` whose pair is still open at
+/// `offset`, when `offset` sits inside a text interpolation.
+///
+/// A brace pair inside a text literal is code, not text, so the caret is
+/// naming an expression there. A `{` with no matching `}` is literal text to
+/// the parser, so it answers `None` just as it does to the parser. Escapes are
+/// skipped so an escaped quote cannot end the literal early.
+fn interpolation_inner_start(map: &SourceMap, text_start: usize, offset: usize) -> Option<usize> {
+    let chars = &map.chars;
+    let mut opens: Vec<usize> = Vec::new();
+    let mut cursor = text_start + 1;
+    while cursor < chars.len() && cursor <= offset {
+        match chars[cursor] {
+            '\\' => {
