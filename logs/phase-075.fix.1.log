fn visible_names(scopes: &[HashMap<String, usize>]) -> Vec<String> {
    scopes
        .iter()
        .rev()
        .flat_map(|scope| scope.keys().cloned())
        .collect()
}

fn declare(
    scopes: &mut [HashMap<String, usize>],
    bindings: &mut Vec<Binding>,
    binding_scopes: &mut Vec<usize>,
    scope_id: usize,
    name: &str,
    location: Location,
    kind: DefinitionKind,
) -> usize {
    let scope = scopes.last_mut().expect("the root scope always exists");
    if let Some(existing) = scope.get(name) {
        return *existing;
    }

    let id = bindings.len();
    bindings.push(Binding {
        name: name.to_string(),
        location,
        kind,
    });
    binding_scopes.push(scope_id);
    scope.insert(name.to_string(), id);
    id
}

/// Declare a name that must stay distinct from a same-named binding of another
/// kind in the same scope — an object's field and its method share a spelling
/// but not an entry, so `has name` and `to can name()` get separate bindings.
/// The scope keeps the first binding of the name for plain uses.
fn declare_fresh(
    scopes: &mut [HashMap<String, usize>],
    bindings: &mut Vec<Binding>,
    binding_scopes: &mut Vec<usize>,
    scope_id: usize,
    name: &str,
    location: Location,
    kind: DefinitionKind,
) -> usize {
    let id = bindings.len();
    bindings.push(Binding {
        name: name.to_string(),
        location,
        kind,
    });
    binding_scopes.push(scope_id);
    let scope = scopes.last_mut().expect("the root scope always exists");
    scope.entry(name.to_string()).or_insert(id);
    id
}

fn mark_declaration(
    token_binding: &mut [Option<usize>],
    declarations: &mut HashSet<usize>,
    index: usize,
    binding: usize,
) {
    declarations.insert(index);
    if let Some(slot) = token_binding.get_mut(index) {
        *slot = Some(binding);
    }
}

fn name_of(token: &Token) -> Option<&str> {
    match &token.kind {
        TokenKind::Identifier(name) => Some(name.as_str()),
        _ => None,
    }
}

fn skip_type_expression(
    tokens: &[Token],
    start: usize,
    stop_at_to: bool,
    type_names: &mut HashSet<usize>,
) -> usize {
    let mut cursor = start;
    let mut depth = 0usize;

    while cursor < tokens.len() {
        if matches!(tokens[cursor].kind, TokenKind::Identifier(_)) {
            type_names.insert(cursor);
        }
        match &tokens[cursor].kind {
            TokenKind::LeftParen | TokenKind::LeftBracket | TokenKind::LeftBrace => depth += 1,
            TokenKind::RightParen | TokenKind::RightBracket | TokenKind::RightBrace => {
                if depth == 0 {
            self.line, self.column, self.end_line, self.end_column,
        )
    }
}

/// What a goto-definition answer resolved to.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum DefinitionKind {
    Variable,
    Constant,
    Parameter,
    Function,
    Import,
    LoopVariable,
    Object,
    Module,
    Catch,
    Builtin,
}

impl DefinitionKind {
    /// The kind's name, as the JSON answer spells it.
    pub fn as_str(&self) -> &'static str {
        match self {
            DefinitionKind::Variable => "variable",
            DefinitionKind::Constant => "constant",
            DefinitionKind::Parameter => "parameter",
            DefinitionKind::Function => "function",
            DefinitionKind::Import => "import",
            DefinitionKind::LoopVariable => "loop",
            DefinitionKind::Object => "object",
            DefinitionKind::Module => "module",
            DefinitionKind::Catch => "catch",
            DefinitionKind::Builtin => "builtin",
        }
    }
