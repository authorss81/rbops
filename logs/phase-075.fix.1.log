+fn edge_test_body_declaration_is_offered_by_completion_after_end() {
+    let source = concat!(
+        "test \"scope\"\n",
+        "    for each item in values\n",
+        "        set inner to 1\n",
+        "    end\n",
+        "    set local to 2\n",
+        "end\n",
+    );
+
+    let offered = completions(source, 7, 1).expect("the blank line after the test is valid");
+
+    assert!(
+        offered.contains(&"local".to_string()),
+        "the interpreter keeps a test body's own declaration bound after `end`, got {offered:?}"
+    );
+    assert!(
+        !offered.contains(&"item".to_string()),
+        "a loop variable inside the test body still closes with its loop, got {offered:?}"
+    );
+    assert!(
+        !offered.contains(&"inner".to_string()),
+        "the loop body's declaration also closes with its loop, got {offered:?}"
+    );
+}
+
