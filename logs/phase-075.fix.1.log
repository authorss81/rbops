139:+/// The source positions of one file, in characters, for translating editor
140:+/// positions to token offsets and back.
141:+struct SourceMap {
142:+    chars: Vec<char>,
143:+    line_starts: Vec<usize>,
144:+}
145:+
146:+impl SourceMap {
147:+    fn new(source: &str) -> Self {
148:+        let chars: Vec<char> = source.chars().collect();
149:+        let mut line_starts = vec![0];
150:+        for (index, c) in chars.iter().enumerate() {
151:+            if *c == '\n' {
152:+                line_starts.push(index + 1);
153:+            }
154:+        }
155:+        Self { chars, line_starts }
156:+    }
157:+
158:+    fn offset(&self, line: usize, column: usize) -> usize {
159:+        let start = self
160:+            .line_starts
161:+            .get(line.saturating_sub(1))
162:+            .copied()
163:+            .unwrap_or(self.chars.len());
164:+        start.saturating_add(column.saturating_sub(1))
165:+    }
166:+
167:+    /// The source offset of a 1-based line and column, refusing positions no
168:+    /// editor could have sent: line or column zero, a line past the file, or a
169:+    /// column past the end of its line.
170:+    fn validate(&self, line: usize, column: usize) -> Result<usize, String> {
171:+        if line == 0 {
172:+            return Err("line 0 is not a source position: lines are 1-based".to_string());
173:+        }
174:+        if column == 0 {
175:+            return Err("column 0 is not a source position: columns are 1-based".to_string());
176:+        }
177:+        if line > self.line_starts.len() {
178:+            return Err(format!("line {line} is past the end of the file"));
179:+        }
180:+
181:+        let start = self.line_starts[line - 1];
182:+        let mut end = start;
183:+        while end < self.chars.len() && self.chars[end] != '\n' {
184:+            end += 1;
185:+        }
186:+        if column > end - start + 1 {
187:+            return Err(format!("column {column} is past the end of line {line}"));
188:+        }
189:+
190:+        Ok(start + column - 1)
191:+    }
192:+}
