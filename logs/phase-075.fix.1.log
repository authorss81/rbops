# line. A test fixture that embeds `#[ignore]` as data is not a skipped test.
SKIPDELTA="$(git diff -U0 "$BASE_REF" -- '*.rs' '*.rb' 2>/dev/null \
  | grep -cE '^\+[[:space:]]*(#\[ignore|//[[:space:]]*skip\b)')"
