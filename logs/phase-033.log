+/// The names this VM has bound that the standard library did not: what a
+/// `set`, a `to` or an `import` put here.
+///
+/// A completion has to offer those and nothing else — offering `abs` or
+/// `files` is noise, and it is the only way to tell a session's own names
+/// from the builtins, since both live in `globals`. Sorted, because
+/// `globals` is a `HashMap` and iteration order is not a result.
+pub fn user_names(&self) -> Vec<String> {
+    let builtins = stdlib::builtins();
+    let mut names: Vec<String> = self
+        .globals
+        .keys()
+        .filter(|name| !builtins.contains_key(*name))
+        .cloned()
+        .collect();
+    names.sort();
+    names
+}
