+    let ack = parse_ack_file(concat!(
+        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa|tolerated: real checkpoint\n",
+        "deadbeef|tolerated: typo, or a commit that was rewritten\n",
