+    /// writes, and `MathUtils_circle_area` is only how the VM reaches it.
+    fn session_names(&self) -> Vec<String> {
+        let mut names: Vec<String> = self.variables.keys().cloned().collect();
+        names.extend(self.vm.user_names());
