+    #[test]
+    fn edge_more_than_one_sigil_names_no_command() {
+        for (input, word) in [
+            ("::quit", ":quit"),
+            ("...quit", "..quit"),
+            ("::load some.rb", ":load"),
+            ("::vars", ":vars"),
+            (".:help", ":help"),
+            ("...help", "..help"),
+        ] {
+            assert_eq!(
+                ReplCommand::parse(input),
+                ReplCommand::Unknown(word.to_string()),
+                "{input:?} is a mistyped command word, and the word left over is \
+                 reported rather than run"
+            );
+        }
+    }
