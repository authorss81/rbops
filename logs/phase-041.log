        // `stdlib::resolve` (src/stdlib.rs:541), so it is ONE function reached
        // two ways, not two that look alike.
        let dotted = eval(&format!(
            "import {m}\\n{m}.{b}({a})\\n",
            m = row.module,
            b = row.builtin,
            a = row.args
        ));
