            .module
            .expect("every row in REACH names the module a reader reaches for");

        // The module name IS a module: `stdlib::is_module` is what lets the
        // analyzer accept `text` as a receiver at all.
        assert!(
            redblue::stdlib::is_module(module),
            "`{module}` should be a module name"
        );

        // Dotted: `files.read(path)` is `files_read`, and `text.split(..)` is
        // the bare `split` reached through the module. Both are dispatched by
        // `stdlib::resolve` in `src/stdlib.rs:541`, so both spellings of a row
        // are one builtin rather than two that look alike.
        match row.builtin {
            "files_read" => assert_eq!(
                eval("import files\\nfiles.read(\\"examples/hello.rb\\")\\n"),
                Value::Text(fs_read_hello()),
                "`files.read` is wrong dotted"
            ),
            "json_parse" => assert_eq!(
                eval("import json\\njson.parse(\\"{\\\\\\"a\\\\\\": 1}\\")\\n"),
                record(&[("a", Value::Number(1.0))]),
                "`json.parse` is wrong dotted"
            ),
            "csv_parse" => assert_eq!(
                eval("import csv\\ncsv.parse(\\"a,b\\\\n1,2\\")\\n"),
                Value::list(vec![cells(&["a", "b"]), cells(&["1", "2"])]),
                "`csv.parse` is wrong dotted"
            ),
            "length" => assert_eq!(
                eval("import list\\nlist.length(\\"abc\\")\\n"),
                Value::Number(3.0),
                "`list.length` is wrong dotted"
            ),
            "sqrt" => assert_eq!(
                eval("import math\\nmath.sqrt(9)\\n"),
                Value::Number(3.0),
                "`math.sqrt` is wrong dotted"
            ),
            name => assert_eq!(
                eval(&format!(
                    "import text\\ntext.{name}(\\"a,b\\", \\",\\")\\n"
                )),
                cells(&["a", "b"]),
                "`text.{name}` is wrong dotted"
            ),
        }

        // Flat: the same builtin under its own name, with no import at all.
        match row.builtin {
            "files_read" => assert_eq!(
                eval("files_read(\\"examples/hello.rb\\")\\n"),
                Value::Text(fs_read_hello()),
                "`files_read` is wrong flat"
            ),
            "json_parse" => assert_eq!(
                eval("json_parse(\\"{\\\\\\"a\\\\\\": 1}\\")\\n"),
                record(&[("a", Value::Number(1.0))]),
                "`json_parse` is wrong flat"
            ),
            "csv_parse" => assert_eq!(
                eval("csv_parse(\\"a,b\\\\n1,2\\")\\n"),
                Value::list(vec![cells(&["a", "b"]), cells(&["1", "2"])]),
                "`csv_parse` is wrong flat"
            ),
            "length" => assert_eq!(
                eval("length(\\"abc\\")\\n"),
                Value::Number(3.0),
                "`length` is wrong flat"
            ),
            "sqrt" => assert_eq!(eval("sqrt(9)\\n"), Value::Number(3.0), "`sqrt` is wrong flat"),
            name => assert_eq!(
                eval(&format!("{name}(\\"a,b\\", \\",\\")\\n")),
                cells(&["a", "b"]),
                "`{name}` is wrong flat"
            ),
        }
    }
}

/// The text of `examples/hello.rb`, read through the filesystem by the test
/// itself so the two spellings of `files.read` are compared against the file
/// rather than against each other.
fn fs_read_hello() -> String {
    std::fs::read_to_string(
        Path::new(env!("CARGO_MANIFEST_DIR")).join("examples/hello.rb"),
    )
    .expect("examples/hello.rb should be readable")
}

/// A record with the given fields, for comparing what `json.parse` produced.
fn cells_value(parts: &[&str]) -> Value {
    cells(parts)
}

fn record(fields: &[(&str, Value)]) -> Value {
    Value::Record(
        fields
            .iter()
            .map(|(k, v)| ((*k).to_string(), v.clone()))
            .collect(),
    )
}

#[test]
fn text_split_reaches_dotted_without_an_import_and_that_is_the_rule() {
    // `src/analyzer.rs:459-471` is what makes this true: the receiver of a
    // method call is an unknown variable only when it is neither in scope nor a
    // module. So `text.split(..)` is legal with no `import text` anywhere,
    // while a bare read of `text` — `say text`, or the property access
    // `text.length` used as a value — is not, and is refused by name.
    assert_eq!(
        eval("text.split(\\"a,b\\", \\",\\")\\n"),
        cells(&["a", "b"]),
        "`text.split` should work with no import"
    );
    assert_eq!(
        eval("text.join([\\"a\\", \\"b\\"], \\",\\")\\n"),
        Value::Text("a,b".to_string()),
        "`text.join` should work with no import"
    );

    // The same program with the import runs identically, so a reader who
    // writes it either way gets one answer.
    assert_eq!(
        eval("import text\\ntext.split(\\"a,b\\", \\",\\")\\n"),
        eval("text.split(\\"a,b\\", \\",\\")\\n"),
        "the import should not change the answer"
    );

    // A bare read of the module name is still refused, and by name.
    match eval_err("say text\\n") {
        Error::Analyzer(message, _) => assert!(
            message.contains("'text'"),
            "the refusal should name `text`, got {message}"
        ),
        other => panic!("a bare read of `text` should be refused, got {other:?}"),
    }
}

