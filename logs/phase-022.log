+/// a program may declare `to push`, and the builtin still answers the call.
+fn appended_item<'a>(value: &'a Expr, name: &str) -> Option<&'a Expr> {
+    let Expr::Call {
+        name: callee,
+        args,
+    } = value
+    else {
+        return None;
+    };
+    if callee != "push" || args.len() != 2 {
+        return None;
+    }
+    let Expr::Variable(target) = &args[0] else {
+        return None;
+    };
+    (target == name).then_some(&args[1])
