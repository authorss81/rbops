/// them in series is a gate nobody reads. Nothing is shared but the
/// already-written `stage1.rbc`, which no run writes, and each run has an output
/// file of its own — so what runs beside what cannot change a byte, which is
/// exactly the claim `edge_three_consecutive_self_compilations_are_byte_identical`
/// makes about them.
fn self_compilations() -> &'static [Stage2; 3] {
    static RUNS: std::sync::OnceLock<[Stage2; 3]> = std::sync::OnceLock::new();
    RUNS.get_or_init(|| {
        let started: Vec<std::process::Child> = (0..3)
            .map(|run| self_compile(run).expect("the rb binary starts"))
            .collect();
        let finished: Vec<Stage2> = started
            .into_iter()
            .zip(0..3)
            .map(|(mut child, run)| Stage2 {
                bytes: Vec::new(),
                stderr: String::new(),
                succeeded: child
                    .wait()
                    .map(|status| status.success())
                    .unwrap_or_else(|error| panic!("self-compilation {run} could not be waited on: {error}")),
            })
            .collect();
        // The output is read only after every run has exited, so a run cannot be
        // compared against a file another run is still writing.
        let _ = finished;
        let mut runs = Vec::new();
