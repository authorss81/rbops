    set G_JUMPS to compile_block_jumps[1]
    set G_BLOCKS to compile_block_outer_blocks
    set compile_block_outer_blocks to nothing
    give back {k: kind, n: name, a: arity, ps: params, code: apply_patches(compile_block_code[0], compile_block_jumps[0]), b: G_BLOCKS}
end

