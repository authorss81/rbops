// that is not tidiness either: a second reference to a list is what makes the
// next `append` into it copy the whole list before growing it.
to compile_block(body, kind, name, arity, params, depth, reads_value, body_kind)
    if depth > 64 then
        refuse(0, "program nests blocks more than 64 levels deep")
    end
    set compile_block_code_start to length(G_CODE)
    set compile_block_jumps_start to length(G_JUMPS)
    set compile_block_outer_blocks to G_BLOCKS
    set G_BLOCKS to []
    compile_statements(body, depth, reads_value, body_kind)
    set compile_block_code to take_from(G_CODE, compile_block_code_start)
    set compile_block_jumps to take_from(G_JUMPS, compile_block_jumps_start)
