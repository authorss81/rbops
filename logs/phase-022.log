        fields
            .iter()
            .map(|f| Value::Text((*f).to_string()))
            .collect(),
    )
}

/// Rows of cells, for comparing what `csv.parse` produced.
fn rows(expected: &[&[&str]]) -> Value {
    Value::List(expected.iter().map(|r| cells(r)).collect())
}

