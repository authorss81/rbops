/// The S3 fixed point itself: stage 1 compiling the compiler gives stage 2, and
/// the two must be one file.
///
/// Every other test here compares stage 2 against stage 1 for *corpus* programs,
/// which proves the two compilers agree about the language. This one asks the
/// question that decides whether the ladder can finish: does the compiler agree
/// about *itself*? A compiler that is byte-identical on 300 hand-written
/// programs and differs from stage 1 on its own 2 748 lines has a bug that only
/// shows up at its own size, and nothing else in this file would see it.
///
/// Byte-identical output is the only claim. Nothing here parses the file, runs
/// stage 2, or checks that it is "plausible".
#[test]
fn edge_the_self_hosted_compiler_compiles_itself_byte_identically() {
    let stage1_bytes = fs::read(stage1_of_the_compiler()).expect("stage 1 of the compiler exists");

    let stage2 = stage3("self", &compiler());

    assert!(
        stage2.succeeded,
        "stage 1 compiling bootstrap/compiler.rb must succeed, and said: {}",
        stage2.stderr
    );
    assert!(
        !stage2.bytes.is_empty(),
        "stage 1 wrote no .rbc for bootstrap/compiler.rb, so there are no \
         bytes to compare: {}",
        stage2.stderr
    );
    assert_eq!(
        stage1_bytes,
        stage2.bytes,
        "stage 1 and stage 2 disagree about bootstrap/compiler.rb: stage 1 is \
         {} bytes, stage 2 wrote {} bytes. The fixed point is the only proof \
         that stage 2 is stage 1.",
        stage1_bytes.len(),
        stage2.bytes.len()
    );
}
