+        answers.join("\n")
+    );
+    assert!(
+        answers
+            .iter()
+            .any(|line| line.contains("Unknown variable 'definitely_missing_phase062'")),
+        "it was run as code, and the code failed the way code fails; it \
+         answered:\n{}",
+        answers.join("\n")
+    );
+}
