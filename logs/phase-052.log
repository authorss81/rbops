    os.environ["HOME"]=HOME; os.environ["TERM"]="xterm"; os.execv(BIN,[BIN])
def drain(t):
    out=b""; end=time.time()+t
    while time.time()<end:
        r,_,_=select.select([fd],[],[],0.05)
        if r:
            try: c=os.read(fd,65536)
            except OSError: break
            if not c: break
            out+=c
    return out
drain(1.0)
os.write(fd, b":history\r")
print(repr(drain(1.0).decode('utf-8','replace')))
os.write(fd, b"\x04"); drain(0.5)
try: os.close(fd)
except OSError: pass
os.waitpid(pid,0)
