    fn load(&mut self, path: &Path) -> Result<()> {
        let file = File::open(path)?;
        file.lock_shared()?;
        let len = self.len();
        if self.load_from(&file)? {
            self.update_path(path, &file, self.len() - len)
        } else {
            // discard old version on next save
            self.path_info = None;
            Ok(())
        }
    }

    fn clear(&mut self) -> Result<()> {
        self.mem.clear()?;
        self.new_entries = 0;
        Ok(())
    }

