+/// The playground refuses the two things it has no platform for, and refusing
+/// them cleanly is the whole point — the alternative was a panic that killed the
+/// module instance rather than failing one run.
+#[test]
+fn edge_the_module_refuses_what_the_platform_cannot_do() {
+    // Each of these used to reach a `std` facility that is compiled out on
+    // `wasm32-unknown-unknown`: a thread for the blocking HTTP client, a thread
+    // to sleep, and a terminal to read. Each is a `Runtime` error there, and
+    // each prints nothing before refusing.
+    for (what, source) in [
+        ("network", "network.get(\"https://example.test\")"),
+        ("input", "input(\"what is your name? \")"),
+        ("time.sleep", "time.sleep(0)"),
+    ] {
+        let message = wasm::run_program(source)
+            .err()
+            .unwrap_or_else(|| panic!("{what} must be refused, not carried out"));
+        assert!(
+            message.to_lowercase().contains(&what.split('.').next().unwrap()),
+            "the refusal must name what was refused, got: {message}"
+        );
+    }
+}
