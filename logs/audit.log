   203	/// Calls the builtin `name`.
   204	///
   205	/// `None` means "wrong argument type or wrong argument count", and
   206	/// `Some(Value::Nothing)` means "the builtin ran and has no answer" — `sqrt` of
   207	/// a negative number is the last case. It has no real answer, and handing back
   208	/// `NaN` would put a value into `Value::Number` that no comparison and no
   209	/// display can be trusted on.
   210	pub fn builtin_function(name: &str, args: Vec<Value>) -> Option<Value> {
   211	    match name {
   212	        // Math functions
   213	        "abs" => Some(args.first()?.abs()),
   214	        "floor" => Some(args.first()?.floor()),
   215	        "ceil" => Some(args.first()?.ceil()),
   216	        "round" => Some(args.first()?.round()),
   217	        "sqrt" => Some(args.first()?.sqrt()),
   218	
   219	        // Text functions
   220	        "uppercase" => {
   221	            if let Value::Text(s) = args.first()? {
   222	                Some(Value::Text(s.to_uppercase()))
   223	            } else {
   224	                None
   225	            }
   226	        }
   227	        "lowercase" => {
   228	            if let Value::Text(s) = args.first()? {
   229	                Some(Value::Text(s.to_lowercase()))
   230	            } else {
   231	                None
   232	            }
   233	        }
   234	        "trim" => {
   235	            if let Value::Text(s) = args.first()? {
   236	                Some(Value::Text(s.trim().to_string()))
   237	            } else {
   238	                None
   239	            }
   240	        }
   241	        "length" => match args.first()? {
   242	            Value::Text(s) => Some(Value::Number(s.len() as f64)),
   243	            Value::List(items) => Some(Value::Number(items.len() as f64)),
   244	            _ => None,
