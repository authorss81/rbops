pub const MODULES: &[&str] = &[
    "bytes", "console", "csv", "files", "json", "list", "math", "network", "sys", "text", "time",
];

/// Whether `name` is one of the [`MODULES`].
pub fn is_module(name: &str) -> bool {
    MODULES.contains(&name)
}

