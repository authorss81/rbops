# sanity: ids continue, deps exist, acyclic
doc = json.loads(raw)
ids = [p["id"] for p in doc["phases"]]
assert ids == sorted(ids), ids
assert len(set(ids)) == len(ids)
for p in new:
    assert p["id"] not in ids, p["id"]
    for d in p["depends_on"]:
        assert d in ids or d in [q["id"] for q in new], (p["id"], d)
# acyclic over union
allp = doc["phases"] + new
known = {p["id"] for p in allp}
for p in allp:
    for d in p["depends_on"]:
        assert d in known, (p["id"], d)

# render new entries at the manifest's indentation (4 spaces per object)
body = json.dumps(new, indent=2, ensure_ascii=False)
lines = body.split("\n")
# drop the outer [ ] and de-indent by 2
