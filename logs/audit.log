  :
else
step "cargo fmt"
if cargo fmt --all -- --check >/tmp/fmt.log 2>&1; then ok "cargo fmt --check"
else bad "cargo fmt --check"; tail -20 /tmp/fmt.log; fi

step "cargo clippy"
if cargo clippy --all-targets -- -D warnings >/tmp/clippy.log 2>&1; then
  ok "cargo clippy -D warnings"
