time = {
  "id": "phase-035",
  "title": "Remove the reachable panics in the time builtins",
  "severity": "major",
  "depends_on": [],
  "risk": "low",
  "finding": "src/vm.rs:924, src/vm.rs:1089, src/vm.rs:1238, src/vm.rs:1250 and src/vm.rs:1263 each call `SystemTime::now().duration_since(UNIX_EPOCH).unwrap()`. `duration_since` returns `Err(SystemTimeError)` for any instant before 1970-01-01T00:00:00Z, and `.unwrap()` on it panics. All five are inside `time_now`, `time_format` and friends, reachable from a plain Redblue program through `time.now()` — no test, no flag and no unusual input is needed, only a host clock set before the epoch. Every other error path in these functions is a `RuntimeError`; these five are Rust panics that unwind through the interpreter thread and abort the process. This is exactly the reachable-`unwrap` class the reviewer contract (AGENTS.md section 5) lists as a hunt target, and it is the only place in src/ where `unwrap()` is used outside `#[cfg(test)]` code — the other 7 unwraps in src/ are all in test modules.",
  "goal": "Turn the five clock-`unwrap()`s into RuntimeErrors, so no Redblue program can panic the interpreter through a host clock that is set before the Unix epoch.",
  "must_touch": ["src/"],
  "accept": [
    "no `.unwrap()` remains in src/ outside a `#[cfg(test)]` or `mod tests` block — `grep -rn 'unwrap()' src/` matches only test code, and that is shown in REPORT.md",
    "the five call sites report a caught RuntimeError naming the clock rather than panicking, and a test asserts a Redblue `try`/`catch error` around a failing `time.now()` yields the error instead of aborting the process",
    "the failure is exercised without moving the machine clock: the time-formatting logic is extracted behind a function that takes the instant as an argument, so a test passes a pre-epoch instant directly and asserts the error — no test depends on wall-clock state, so it is deterministic",
    "edge tests named edge_* cover a pre-epoch instant, the exact epoch boundary, and `time.format` given an argument that is not a number or not a text",
    "`cargo test --all-targets` reports 0 failures and the 39 tests in tests/stdlib_modules_test.rs, including `network_timeouts_are_published_and_bounded`, still pass",
    "`cargo clippy --all-targets -- -D warnings` is clean with no `allow(` added"
  ],
  "timeout_min": 90
}

doc = json.load(open("/tmp/phases.json.bak", encoding="utf-8"))
old = json.load(open("rbops/phases.json", encoding="utf-8"))["phases"][24:]
assert len(old) == 10

# drop the most speculative phase (`when`/`case` needs pattern-matching
# semantics that no phase has been given) and renumber.
keep = {p["id"]: p for p in old}
del keep["phase-030"]                     # when/case — deferred, not a phase

order = [
    brk,
    keep["phase-025"],                    # lexer comparison symbols
    keep["phase-026"],                    # english comparison forms
    keep["phase-027"],                    # range loop
    keep["phase-028"],                    # mod + in
    keep["phase-029"],                    # unless
    keep["phase-031"],                    # module/export/import alias
    keep["phase-032"],                    # stdlib module reconciliation
    keep["phase-033"],                    # REPL
    keep["phase-034"],                    # function literal
    time,
]

remap = {p["id"]: f"phase-{n:03d}" for n, p in enumerate(order, start=25)}
for p in order:
    p["id"] = remap[p["id"]]
    p["depends_on"] = sorted({remap[d] for d in p["depends_on"]})
# ordering rationale: the range loop and the english comparison forms both need
# `<`/`>` to be testable, so both sit behind phase-026 (the symbol lexer).
for p in order:
    if p["title"].startswith("Implement the range loop"):
        p["depends_on"] = ["phase-026"]
# the stdlib-reconciliation phase has a legitimate documents-only outcome
for p in order:
    if "Reconcile the stdlib module list" in p["title"]:
        p["must_touch"] = ["src/", "docs/"]

ids = [p["id"] for p in order]
assert ids == [f"phase-{n:03d}" for n in range(25, 25 + len(order))], ids
known = {p["id"] for p in doc["phases"]} | set(ids)
for p in doc["phases"] + order:
    for d in p["depends_on"]:
        assert d in known, (p["id"], d)

doc["phases"] = doc["phases"] + order
out = json.dumps(doc, indent=2, ensure_ascii=False)
open("rbops/phases.json", "w", encoding="utf-8").write(out)
print("phases now:", len(doc["phases"]))
