AUDIT_MODELS="${RBOPS_AUDIT_MODELS:-opencode/deepseek-v4.1-flash-free,opencode/big-pickle,opencode/glm-5.3-flash-free,opencode/beam-free,opencode/nemotron-3-ultra-free}"

