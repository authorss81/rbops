inner = lines[1:-1]
inner = [l[2:] if l.startswith("  ") else l for l in inner]
inner[0] = inner[0].lstrip()          # first "{" already at col 0 after de-indent
entry = "\n".join(inner)

# locate the closing of the last existing phase object
tail = "\n    }\n  ]\n}"
assert raw.endswith(tail), repr(raw[-30:])
raw = raw[: -len(tail)] + "\n    },\n" + entry + "\n  ]\n}"
open(path, "w", encoding="utf-8").write(raw)
print("appended", len(new), "phases")
