    # deferral and must not consume the deferral budget either. The phase keeps
    # its state and the next tick re-dispatches it fresh.
    rm -f "$(marker "$phase" .failed)" "$(marker "$phase" .deferred)" \
          "$(marker "$phase" .deferred_attempts)"
    touch "$(marker "$phase" .watchdog)"
    return 1
  fi
  rm -f "$(marker "$phase" .watchdog)"
fi

# Harvest what the agent wrote. The agent's working directory is the PROJECT
# checkout, so anything it wrote to a relative path - REPORT.md, FINDINGS.md -
# lands in the project, not in the pipeline repo where the gate looks. Run 5
# produced a correct REPORT.md in redblue/phases/phase-001/ and the gate reported
# "a phase without a report cannot pass".
for artefact in REPORT.md FINDINGS.md; do
  if [ -f "$PROJECT_DIR/phases/$phase/$artefact" ]; then
    mkdir -p "$RBOPS_ROOT/phases/$phase"
    cp "$PROJECT_DIR/phases/$phase/$artefact" "$RBOPS_ROOT/phases/$phase/$artefact"
    log "harvested $artefact from the project"
  fi
done

  # --- classify -------------------------------------------------------------
  # A dead model chain (75) or an infra-shaped log is a RETRYABLE infra fault.
  # It must never be counted as a phase attempt: nothing was attempted, so
  # burning MAX_ATTEMPTS on it would block a phase that never even ran.
  if [ "$code" = "75" ] || { [ "$code" -ne 0 ] && infra_failure "$LOG_DIR/$phase.log"; }; then
    tail -6 "$LOG_DIR/$phase.log" | sed 's/^/    | /'
    defer_phase "$phase" "infra"
    return $?
  fi

  # --- THE GATE -------------------------------------------------------------
  normalize_tree
  log "running verify gate for $phase"
  # Capture the gate's own verdict to a file the NEXT attempt can read, while
  # still printing it. verify.sh writes both streams, and the diagnostic that
  # matters - the FAIL lines - is the part that gets lost: the next attempt
  # receives the previous REPORT.md (which claims success) plus a warning not to
  # trust it, and nothing about what actually failed. Phase-082 burned three
  # attempts and ~4.5 hours re-deriving a failure the gate had already named in
  # one line: "FAIL no test named edge_* - mandatory".
  #
  # tee, NOT `> file`. Redirecting alone captures the verdict but takes the
  # output off the console, and the run log IS how a human reads the gate -
  # smoke caught that immediately. Both consumers, one execution.
  set -o pipefail
  RBOPS_PROJECT_DIR="$PROJECT_DIR" RBOPS_PHASES="$PHASES" RBOPS_BASE_REF="$base" \
    "$VERIFY" "$phase" 2>&1 | tee "$LOG_DIR/$phase.gateout"
  code=${PIPESTATUS[0]}
  set +o pipefail
  if [ "$code" -ne 0 ]; then
    rm -f "$(marker "$phase" .done)" "$(marker "$phase" .checkpoint)"
    touch "$(marker "$phase" .failed)"
    # A phase resumed with UNRESOLVED CONFLICTS spent this attempt merging the
    # parked attempt onto a newer main, not on its own work: that work was
    # already done. A gate failure there is as likely to be a bad resolution as
    # a bad implementation, and neither should cost the phase one of its three
    # attempts - the phase would block on a merge technicality while its work
    # sat complete on a branch.
    #
    # It defers instead. That is the existing mechanism for "not now, and do not
    # count it": no attempt consumed, and bounded by MAX_DEFERRALS, so the
    # phase ends in a human rather than in a loop.
    if [ -f "$(marker "$phase" .conflict)" ]; then
      defer_phase "$phase" "the inherited work had to be merged onto a newer main and the gate refused the result"
      return $?
    fi
    local a; a="$(read_n "$phase" .attempts)"; bump "$phase" .attempts
    a="$(read_n "$phase" .attempts)"
    if [ "$a" -ge "$MAX_ATTEMPTS" ]; then
      touch "$(marker "$phase" .blocked)"
      log "$phase BLOCKED — gate failed $a/$MAX_ATTEMPTS times. A human must look."
