fn handle_command(&mut self, input: &str) -> bool {
        if !input.starts_with(':') && !input.starts_with('.') {
            return false;
        }

        let parts: Vec<&str> = input.split_whitespace().collect();
        let cmd = parts[0].trim_start_matches(':');

        match cmd {
            "quit" | "exit" | "q" => {
                self.running = false;
                true
            }
            "help" | "h" | "?" => {
                self.print_help();
                true
            }
