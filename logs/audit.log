- name: manifest is valid JSON and well-formed
        run: |
          set -uo pipefail
          jq empty rbops/phases.json
          n=$(jq '.phases | length' rbops/phases.json)
          echo "phases declared: $n"
          if [ "$n" -gt 0 ]; then echo "OK"; else echo "::error::manifest declares no phases"; exit 1; fi

      - name: phase ids are unique and well-formed
        run: |
          set -uo pipefail
          rc=0
          dup=$(jq -r '.phases[].id' rbops/phases.json | sort | uniq -d)
          if [ -n "$dup" ]; then echo "::error::duplicate phase ids: $dup"; rc=1; else echo "OK: ids unique"; fi
          # `grep -v` exits 1 when it filters out everything, which under `bash -e`
          # would abort the step even though the result is what we want.
          bad=$(jq -r '.phases[].id' rbops/phases.json | grep -vE '^phase-[0-9]{3}$' || true)
          if [ -n "$bad" ]; then echo "::error::malformed phase ids: $bad"; rc=1; else echo "OK: ids well-formed"; fi
          exit "$rc"

      - name: every depends_on resolves
        run: |
          set -uo pipefail
          rc=0
          ids=$(jq -r '.phases[].id' rbops/phases.json)
          while read -r dep; do
            if ! printf '%s\n' "$ids" | grep -qx -- "$dep"; then
              echo "::error::$dep is referenced but not declared"; rc=1
            fi
          done < <(jq -r '.phases[].depends_on[]?' rbops/phases.json)
          if [ "$rc" -eq 0 ]; then echo "OK: all dependencies declared"; fi
          exit "$rc"

      - name: the auditor contract still demands what it must
        run: |
          set -uo pipefail
          rc=0
          A=rbops/agents/auditor.md
          # These are requirements, not prose. Each one exists because the thing
          # it requires was missing and nothing noticed, so they are asserted
          # the same way verify.sh's checks are: if the contract loses a
          # requirement, CI says so instead of the auditor quietly doing less.
          for needle in \
            'bootstrap_requires' \
            'verify it at runtime' \
            'No checkpoint commits on redblue' \
            'No unreviewed work on' \
            'The gate really reads the manifest' \
            'Every manifest phase has a' \
            'Every agent has its permissions' \
            'bootstrap_reachable=' \
            'consecutive_unreachable_audits=' \
            're_scope_needed=' \
            'GENERATE THE PROMPTS' \
            'NOT resolve it by quietly widening' \
            ; do
            if ! grep -qF -- "$needle" "$A"; then
              echo "::error::auditor contract lost a requirement: $needle"; rc=1
            fi
          done
          # The readiness floor must be data, not prose, or it cannot be checked.
          jq -e 'any(.phases[]; has("bootstrap_requires"))' rbops/phases.json >/dev/null 2>&1 \
            || { echo "::error::no phase carries bootstrap_requires — readiness is unrecorded"; rc=1; }
          jq -e '[.phases[] | select(has("bootstrap_requires")) | .bootstrap_requires | length] | all(. > 0)' \
            rbops/phases.json >/dev/null 2>&1 \
            || { echo "::error::a bootstrap_requires list is empty"; rc=1; }
          if [ "$rc" -eq 0 ]; then echo "OK: auditor contract intact"; fi
          exit "$rc"

      - name: dependency graph is acyclic
        run: |
          set -uo pipefail
          remaining=$(jq -r '.phases[].id' rbops/phases.json)
          for _ in $(seq 1 64); do
            if [ -z "$remaining" ]; then break; fi
            progress=0
            for id in $remaining; do
              unmet=0
              while read -r d; do
                if printf '%s\n' "$remaining" | grep -qx -- "$d"; then unmet=1; fi
              done < <(jq -r --arg p "$id" '.phases[]|select(.id==$p)|.depends_on[]?' rbops/phases.json)
              if [ "$unmet" -eq 0 ]; then
                # `grep -vx` exits 1 when the line being removed is the last one.
                # Under `bash -e` that would abort the step mid-algorithm.
                remaining=$(printf '%s\n' "$remaining" | grep -vx -- "$id" || true)
                progress=1
              fi
            done
            if [ "$progress" -eq 0 ]; then break; fi
          done
          if [ -n "$remaining" ]; then
            echo "::error::dependency cycle among: $(echo $remaining)"
            exit 1
          fi
          echo "OK: graph is acyclic"

      - name: every declared phase has a committed PROMPT.md
        run: |
          set -uo pipefail
          rc=0
          while read -r id; do
            if [ ! -f "phases/$id/PROMPT.md" ]; then
              echo "::error::missing phases/$id/PROMPT.md"; rc=1
            fi
          done < <(jq -r '.phases[].id' rbops/phases.json)
          if [ "$rc" -eq 0 ]; then echo "OK: every phase has a prompt"; fi
          exit "$rc"

      - name: PROMPT.md files match the manifest
        run: ./rbops/gen-prompts.sh --check

      - name: baseline entries are real, and none is grandfathered
        run: |
          set -uo pipefail
          rc=0
