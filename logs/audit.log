    fn run_code(&mut self, code: &str) -> Result<Value, crate::error::Error> {
        let tokens = Lexer::tokenize(code)?;
        let mut parser = Parser::new(tokens);
        let program = parser.parse()?;
        analyzer::analyze(&program)?;
        self.vm.run(&program)
    }

