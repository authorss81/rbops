                        self.add_error(&format!("Unknown variable '{}'", name), *span);
                    }
                    Expr::Variable(_) => {}
                    other => self.analyze_expr(other, span),
                }
                for arg in args {
                    self.analyze_expr(arg, span);
                }
            }
            Expr::Index { object, index } => {
                self.analyze_expr(object, span);
                self.analyze_expr(index, span);
            }
