                        kind: TokenKind::Not,
                        ..
                    }) = self.current()
                    {
                        self.advance();
                        BinaryOp::NotEqual
                    } else {
                        BinaryOp::Equal // "is" alone means equality
                    }
                }
                Some(Token {
                    kind: TokenKind::Equal,
                    ..
                }) => {
                    self.advance();
                    BinaryOp::Equal
                }
                Some(Token {
                    kind: TokenKind::NotEqual,
                    ..
                }) => {
                    self.advance();
                    BinaryOp::NotEqual
                }
                Some(Token {
                    kind: TokenKind::Less,
                    ..
                }) => {
                    self.advance();
                    if let Some(Token {
                        kind: TokenKind::Equal,
                        ..
                    }) = self.current()
                    {
                        self.advance();
                        BinaryOp::LessEqual
                    } else {
