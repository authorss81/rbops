    fn parse_comparison(&mut self) -> Result<Expr> {
        let mut left = self.parse_addition()?;
        let mut chained = 0usize;

        loop {
            let op = match self.current() {
                Some(Token {
                    kind: TokenKind::Is,
                    ..
