#[test]
fn the_top_ten_are_ranked_by_blocked_programs() {
    let doc = survey();
    let entries = top_ten(&doc);
    assert!(
        entries.len() >= 10,
        "SURVEY.md names {} ranked gaps; the phase asks for a top ten.",
        entries.len()
    );
                .map(|c| c.trim().trim_matches('`'))
                .any(|c| {
                    !c.is_empty()
                        && c.chars()
                            .all(|ch| ch.is_ascii_alphanumeric() || ch == '-' || ch == '_')
                });
            assert!(
                named,
