use std::sync::{Arc, Mutex};

struct Node {
    value: Mutex<Option<Value>>,
    next: Mutex<Option<Arc<Node>>>,
}

fn build_cycle(values: Vec<redblue::Value>) -> Vec<Arc<Node>> {
    let head = Arc::new(Node { value: Mutex::new(values[0].clone()), next: Mutex::new(None) });
    let tail = Arc::new(Node { value: Mutex::new(values[1].clone()), next: Mutex::new(None) });
    *head.next.lock().unwrap() = Some(tail.clone());
    *tail.next.lock().unwrap() = Some(head.clone());
    vec![head, tail]
}

#[test]
fn cycle_probe() {
    let program = parse(BIG);
    let (_vm, result) = redblue::run_isolated(&program);
    let pair = result.unwrap();
    let Value::List(items) = pair.clone() else { panic!("want list") };
    let values: Vec<redblue::Value> = items.as_ref().clone();
    println!("payload elements = {}", values.len());

    let baseline = live();
    let handles = build_cycle(values.clone());
    drop(pair);
    drop(result);
    drop(_vm);
    let after_build = live();
    drop(values);
    let after_drop_values = live();
    drop(handles);
    let after_drop_handles = live();
    println!("after_build={} after_drop_values={} after_drop_handles={} baseline={baseline}", after_build - baseline, after_drop_values - baseline, after_drop_handles - baseline);
}
EOF
