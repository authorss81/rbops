    "    if n < 20 then\\n",
    "        pong(n + 1)\\n",
    "    end\\n",
    "end\\n",
    "to pong(n)\\n",
    "    ping(n + 1)\\n",
    "end\\n",
    "ping(0)\\n",
);

/// The limit the call-depth error names for an already-parsed `program`."""
assert old2 in s
s = s.replace(old2, new2, 1)
open(p,'w').write(s)
