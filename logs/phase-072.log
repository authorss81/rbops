old="""    fn run_program(
        &mut self,
        program: &Program,
        source: &str,
    ) -> Result<Value, crate::error::Error> {
        self.arm_debugger(source);
        self.vm.take_output();
        let result = self.vm.run(program);
        // What the program said, kept for the transcript `.export` writes. On the
        // error path these are the lines the program printed before it failed,
        // which are printed here rather than by [`Vm::run`] — the VM gives up
        // before its print loop — and on the success path `Vm::run` has already
        // printed them and left the buffer, so this is the same lines read once
        // more. Drained either way: an export that re-printed them would be the
        // bug this is here to prevent, one line later.
        self.last_output = self.vm.take_output();
        if result.is_err() {
            for line in &self.last_output {
                println!("{}", line);
            }
        }
        result
    }
"""
new="""    fn run_program(
        &mut self,
        program: &Program,
        source: &str,
    ) -> Result<Value, crate::error::Error> {
        // The marker is written before the run, so a compile failure still says
        // which engine was asked to run the line that failed.
        self.last_engine = self.engine;
        if self.engine == Engine::Bytecode {
            self.vm.take_output();
            let (result, output) = self.run_bytecode(program);
            if result.is_ok() {
                for line in &output {
                    println!("{}", line);
                }
            }
            self.last_output = output;
            if result.is_err() {
                for line in &self.last_output {
                    println!("{}", line);
                }
            }
            return result;
        }

        self.arm_debugger(source);
        self.vm.take_output();
        let result = self.vm.run(program);
        // What the program said, kept for the transcript `.export` writes. On the
        // error path these are the lines the program printed before it failed,
        // which are printed here rather than by [`Vm::run`] — the VM gives up
        // before its print loop — and on the success path `Vm::run` has already
        // printed them and left the buffer, so this is the same lines read once
        // more. Drained either way: an export that re-printed them would be the
        // bug this is here to prevent, one line later.
        self.last_output = self.vm.take_output();
        if result.is_err() {
            for line in &self.last_output {
                println!("{}", line);
            }
        }
        result
    }

    /// Runs `program` on the bytecode VM, with the session's bindings seeded in
    /// and whatever it bound copied back out.
    ///
    /// A fresh VM per run rather than one kept beside the tree-walker: a
    /// compiled chunk is tied to the program that produced it, and keeping a
    /// second VM's frames alive across REPL lines buys nothing a seed and an
    /// adopt do not. The bindings are the shared state, so they cross both ways
    /// and a switch back to the tree-walker reads what the bytecode side wrote.
    fn run_bytecode(
        &mut self,
        program: &Program,
    ) -> (Result<Value, crate::error::Error>, Vec<String>) {
        let chunk = match crate::bytecode::compile_program(program) {
            Ok(chunk) => chunk,
            Err(error) => return (Err(error), Vec::new()),
        };
        let mut compiled = BytecodeVm::new_in(self.vm.root());
        compiled.set_echo(false);
        for (name, value) in self.session_bindings() {
            compiled.seed_binding(&name, value);
        }
        let result = compiled.run(&chunk);
        let output = compiled.take_output();
        self.adopt_bytecode_bindings(&compiled);
        (result, output)
    }

    /// Copies the names the bytecode VM bound back into the session's VM.
    ///
    /// The tree-walker's own globals and scopes are kept, so its functions,
    /// modules and objects survive the round trip; only names the bytecode VM
    /// bound are overwritten. Language builtins are not copied, because every VM
    /// builds its own and a copied one would be a second answer to the same
    /// name. A function the bytecode VM declared carries a compiled body and
    /// cannot be called by the tree-walker; that is a known cross-engine limit,
    /// not a binding this method invents a value for.
    fn adopt_bytecode_bindings(&mut self, compiled: &BytecodeVm) {
        let bindings = compiled.user_bindings();
        if bindings.is_empty() {
            return;
        }
        let locals = self.vm.current_bindings().0.to_vec();
        let mut globals = self.vm.current_bindings().1.clone();
        for (name, value) in bindings {
            globals.insert(name, value);
        }
        self.vm.observe_bindings(&locals, &globals);
    }
"""
