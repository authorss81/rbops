                TokenKind::LeftParen => depth += 1,
                TokenKind::RightParen => {
                    depth -= 1;
                    if depth == 0 {
                        return matches!(self.current_at(offset + 1), Some(TokenKind::To));
                    }
                }
                _ => {}
            }
            offset += 1;
        }
        false
    }

