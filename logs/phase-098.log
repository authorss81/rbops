fn edge_take_and_skip_refuse_a_text_count() {
    for source in ["take([1, 2, 3], \"2\")", "skip([1, 2, 3], \"2\")"] {
        let walked = message(&fails(source));
        assert!(
            walked.contains("requires a list and a number"),
