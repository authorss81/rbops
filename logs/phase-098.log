    /// a declaration begins. A call such as `lru_cache(f, 2)` is followed by a
    /// newline rather than `to`, so it stays an ordinary call.
    fn lru_cache_declaration_ahead(&self) -> bool {
        if !self.is_word_ahead(0, "lru_cache") {
            return false;
