        match self.get_var(name) {
            Some(Value::Function(function)) => {
                self.call_function(name, &function, args, None)?;
                self.advance(frame);
                Ok(())
            }
            _ => Err(Error::Runtime(
                format!("Unknown function '{}'", name),
                self.span(),
