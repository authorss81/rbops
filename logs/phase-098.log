pub fn name(self) -> &'static str {
        match self {
            BlockKind::Main => "main",
            BlockKind::Function => "function",
            BlockKind::Method => "method",
            BlockKind::Object => "object",
            BlockKind::Test => "test",
            BlockKind::CatchBody => "catch body",
            BlockKind::FinallyBody => "finally body",
            BlockKind::Module => "module body",
        }
    }
