}

/// A statement together with the source position it was parsed from.
#[derive(Debug, Clone)]
pub struct Stmt {
    pub span: Span,
    pub statement: Statement,
}

#[derive(Debug, Clone)]
pub struct Program {
    pub statements: Vec<Stmt>,
