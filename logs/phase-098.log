addition='''/// The language compares two function values by name, parameters and captured
/// bindings, because two closures from one declaration over equal environments
/// are interchangeable. A cache key cannot use that equality: two declarations
/// can produce same-shaped functions with different bodies, so a function in an
/// argument is matched by identity. The structural equality is asserted first,
/// so this test fails if the cache ever falls back to it.
#[test]
fn edge_lru_cache_keys_function_arguments_by_identity() {
    use redblue::runtime::LruCache;
    use redblue::value::{Fields, FunctionBody, FunctionValue};
    use std::sync::Arc;

    let function = |name: &str| {
        Value::Function(FunctionValue::new(
            name.to_string(),
            vec!["x".to_string()],
            FunctionBody::Statements(Arc::new(Vec::new())),
            Arc::new(Vec::new()),
        ))
    };
    let first = function("f");
    let second = function("f");
    assert_eq!(
        first, second,
        "the language's `is` treats two same-shaped functions as equal"
    );

    let mut cache = LruCache::new(4);
    cache.insert(&[first.clone(), Value::Number(1.0)], Value::Number(2.0));
    assert_eq!(
        cache.get(&[second.clone(), Value::Number(1.0)]),
        None,
        "a distinct function value must not answer from another's entry"
    );

    // The rule reaches through a list argument, where the function is an item
    // rather than the argument itself.
    cache.insert(
        &[Value::list(vec![first.clone()]), Value::Number(1.0)],
        Value::Number(3.0),
    );
    assert_eq!(
        cache.get(&[Value::list(vec![second.clone()]), Value::Number(1.0)]),
        None,
        "a function nested in a list key is still matched by identity"
    );

    // And through a record field, which is the other shape a function can hide
    // in. Equal fields with an unequal function are different keys.
    let mut first_record = Fields::new();
    first_record.insert("fn".to_string(), first.clone());
    let mut second_record = Fields::new();
    second_record.insert("fn".to_string(), second.clone());
    cache.insert(
        &[Value::record(first_record), Value::Number(1.0)],
        Value::Number(4.0),
    );
    assert_eq!(
        cache.get(&[Value::record(second_record), Value::Number(1.0)]),
        None,
        "a function nested in a record key is still matched by identity"
    );
}

/// A capacity beyond `usize::MAX` cannot index a cache, so the parser refuses
/// it instead of saturating the cast to a size the declaration never stated.
/// This is the numeric boundary of the decorator's capacity.
#[test]
fn edge_lru_cache_refuses_a_capacity_beyond_a_count_it_can_hold() {
    let too_large = message(&fails(
        "lru_cache(1e300) to f(n)\n    give back n\nend\nf(1)\n",
    ));
    assert!(
        too_large.contains("at least 1") && too_large.contains("whole number"),
        "a capacity past usize::MAX should be refused, it said: {too_large}"
    );

    let negative = message(&fails(
        "lru_cache(-1) to f(n)\n    give back n\nend\nf(1)\n",
    ));
    assert!(
        negative.contains("at least 1"),
        "a negative capacity should be refused, it said: {negative}"
    );
}

/// SPEC.md must say what a function argument means as a cache key, because the
/// answer is deliberately different from the language's `is`.
#[test]
fn spec_says_a_cache_matches_function_arguments_by_identity() {
    let spec = include_str!("../SPEC.md");
    assert!(
        spec.contains("matched by identity"),
        "SPEC.md § Memoisation should say a function argument is matched by identity"
    );
}

