#[test]
fn edge_iteration_helpers_refuse_wrong_types() {
    for (source, name) in [
        ("chain([1], \"two\")", "chain"),
        ("zip([1], 2)", "zip"),
        ("enumerate(\"text\")", "enumerate"),
        ("product([1], {a: 1})", "product"),
        ("groupby(1)", "groupby"),
        ("take(\"text\", 1)", "take"),
        ("skip([1], \"one\")", "skip"),
    ] {
        let text = message(&fails(source));
        assert!(
            text.contains(name),
            "the refusal for `{source}` should name `{name}`, it said: {text}"
        );
    }
}

