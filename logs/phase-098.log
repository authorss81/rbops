                }
            };
            self.advance();
            self.expect(&TokenKind::RightParen)?;
            capacity
        } else {
            Self::DEFAULT_LRU_CAPACITY
        };

        self.expect(&TokenKind::To)?;
        self.enter_block()?;
        let parsed = self.parse_callable();
        self.leave_block();
        let (name, params, body) = parsed?;
        Ok(Some(Stmt {
            span,
            statement: Statement::Function {
                name,
                params,
                body,
                cache: Some(capacity),
            },
        }))
    }

