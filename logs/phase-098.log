            [Value::List(items), Value::Number(count)] => {
                let count = iteration_count("skip", *count, span)?;
                Ok(Some(Value::list(
                    items.iter().skip(count).cloned().collect(),
                )))
            }
            _ => Err(Error::Runtime(
                "skip requires a list and a number".to_string(),
                span,
