use redblue::bytecode::compile_source;
use redblue::bytecode::vm::BytecodeVm;
use redblue::{run_source_value, Value};

fn tree(source: &str) -> Value { run_source_value(source).unwrap() }
fn bc(source: &str) -> Value {
    let chunk = compile_source(source).unwrap();
    let mut vm = BytecodeVm::new();
    vm.run(&chunk).unwrap()
}

#[test]
fn probe() {
    let cases = [
        "chain([1], [2, 3])",
        "zip([1, 2], [3, 4])",
        "enumerate([1, 2])",
        "product([1, 2], [3])",
        "groupby([1, 2, 1])",
        "take([1,2,3], 2)",
        "skip([1,2,3], 2)",
        r#"to make(k)
    to f(n)
        give back k + n
    end
    give back f
end
set a to make(1)
set b to make(2)
groupby([a, b, a])"#,
        r#"to make(k)
    to f(n)
        give back k + n
    end
    give back f
end
set a to make(1)
set b to make(2)
chain([a], [b])"#,
        r#"to make(k)
    to f(n)
        give back k + n
    end
    give back f
end
set a to make(1)
set b to make(2)
zip([a], [b])"#,
    ];
    for source in cases {
        let t = tree(source);
        let c = bc(source);
        assert_eq!(t, c, "data mismatch for {source}: {t:?} vs {c:?}");
        println!("OK {source} => {t:?}");
    }
}
