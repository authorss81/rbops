import re, subprocess
from pathlib import Path
old = subprocess.check_output(['git','show','HEAD:src/stdlib.rs'], text=True).splitlines()
new = Path('src/stdlib.rs').read_text().splitlines()
survey = Path('SURVEY.md').read_text()
def repl(m):
    n=int(m.group(1))
    if not (1<=n<=len(old)):
        return m.group(0)
    text=old[n-1]
    matches=[i+1 for i,l in enumerate(new) if l==text]
    if len(matches)==1:
        return f'src/stdlib.rs:{matches[0]}'
    if matches:
        # choose closest to proportionally shifted position
        target=round(n*len(new)/len(old))
        best=min(matches,key=lambda x:abs(x-target))
        return f'src/stdlib.rs:{best}'
    return m.group(0)
new_survey=re.sub(r'src/stdlib\.rs:(\d+)',repl,survey)
Path('SURVEY.md').write_text(new_survey)
print('done')
