      if printf '%s\n' "$CHANGED" | grep -qxF -- "$ex"; then
        bad "example still fails AND this phase touched it (baseline revoked): $ex — $detail"
      else
        warn "pre-existing failure, baselined, not touched by this phase: $ex — $detail"
