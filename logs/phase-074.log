// A probe for the intern table, kept out of `bootstrap/compiler.rb` so the
// compiler that is compiled by itself does not carry test-only code.
//
// This is a fragment, not a program: `tests/bootstrap_selfhost_test.rs` reads
// `compiler.rb`, removes its final `main()` call, appends this file and calls
// `intern_selftest()` (or `intern_selftest_type_error()`) instead. The probe
// therefore runs the same `intern`, `intern_hash` and bucket array the compile
// path runs, without adding a hidden mode to the compiler's own `main`.

to intern_selftest()
    set intern_selftest_start to G_INTERN_COUNT

    // One name, a thousand times: the table grows by one, not by a thousand.
    set intern_selftest_repeated to bytes.from_text("repeated")
    set intern_selftest_first to intern(intern_selftest_repeated)
    set intern_selftest_i to 0
    while intern_selftest_i < 1000
        intern(intern_selftest_repeated)
        set intern_selftest_i to intern_selftest_i + 1
    end
    say "repeat_growth " + to_text(G_INTERN_COUNT - intern_selftest_start)
    intern(bytes.from_text("other"))
    say "other_growth " + to_text(G_INTERN_COUNT - intern_selftest_start)

    // The empty name is a name, not a missing one.
    set intern_selftest_empty_start to G_INTERN_COUNT
    set intern_selftest_empty_one to intern([])
    set intern_selftest_empty_two to intern([])
    say "empty_same " + intern_selftest_yes(intern_selftest_empty_one is intern_selftest_empty_two)
    say "empty_growth " + to_text(G_INTERN_COUNT - intern_selftest_empty_start)

    // A name far longer than a bucket count, and a variant that differs only in
    // its last byte. A hash that truncated the name would give them one index.
    set intern_selftest_long_a to []
    set intern_selftest_long_b to []
    set intern_selftest_i to 0
    while intern_selftest_i < 10000
        append("intern_selftest_long_a", 120)
        append("intern_selftest_long_b", 120)
        set intern_selftest_i to intern_selftest_i + 1
    end
    append("intern_selftest_long_b", 121)
    set intern_selftest_long_start to G_INTERN_COUNT
    set intern_selftest_long_one to intern(intern_selftest_long_a)
    set intern_selftest_long_two to intern(intern_selftest_long_a)
    set intern_selftest_long_three to intern(intern_selftest_long_b)
    say "long_same " + intern_selftest_yes(intern_selftest_long_one is intern_selftest_long_two)
    say "long_distinct " + intern_selftest_yes(intern_selftest_long_one is not intern_selftest_long_three)
    say "long_growth " + to_text(G_INTERN_COUNT - intern_selftest_long_start)

---
        assert_identical(name, source);
    }
}

// Phase 074: the compiler's intern table is internal to
// `bootstrap/compiler.rb`, so the direct tests build the compiler's own source
// with the fragment in `bootstrap/intern_selftest.rb` appended in place of its
// final `main()` call. The probe runs the same `intern` and `intern_hash` the
// normal compile path runs; it only gives a test a way to call them without a
// source file that happens to use every shape needed. The probe stays out of
// `bootstrap/compiler.rb` so the self-compilation fixed point does not include
// test-only code, and the compiler keeps its unmodified usage check.
//
// The byte-equality test is the real gate: a hash table that answers a name
// with the wrong index changes the constant pool, and the pool is part of the
// bytes. `edge_name_heavy_fixture_is_byte_identical_in_both_stages` compiles a
// program with many distinct names in both stages and requires the files to be
// one file.

struct InternOutput {
    stdout: String,
    stderr: String,
    succeeded: bool,
}

/// The compiler source with its `main()` call replaced by `entry`, after the
/// probe fragment. `compiler.rb` ends with `main()`, so cutting at the last one
/// leaves every declaration and no call.
fn intern_probe_source(entry: &str) -> String {
    let source = compiler_contents();
    let main_call = "\nmain()\n";
    let cut = source.rfind(main_call).unwrap_or_else(|| {
        panic!("bootstrap/compiler.rb no longer ends with a main() call:\n{source}")
    });

    let fixture = fs::read_to_string(
        Path::new(env!("CARGO_MANIFEST_DIR")).join("bootstrap/intern_selftest.rb"),
    )
    .expect("the intern probe fragment is readable");

    let mut combined = String::with_capacity(source.len() + fixture.len() + entry.len() + 16);
    combined.push_str(&source[..cut]);
    combined.push_str("\n\n");
    combined.push_str(&fixture);
    combined.push_str("\n\n");
    combined.push_str(entry);
    combined.push('\n');
    combined
}

fn run_intern_probe(entry: &str, name: &str) -> InternOutput {
    let path = scratch(name);
    fs::write(&path, intern_probe_source(entry)).expect("write the compiler and probe");

    let output = Command::new(env!("CARGO_BIN_EXE_rb"))
        .arg("run")
        .arg(&path)
        .output()
        .expect("the rb binary runs");
    InternOutput {
        stdout: String::from_utf8_lossy(&output.stdout).into_owned(),
        stderr: String::from_utf8_lossy(&output.stderr).into_owned(),
        succeeded: output.status.success(),
    }
}

/// The probe is minutes of loops, and the assertions below read overlapping
/// keys from it. It runs once per test process; the tests read the same output.
fn intern_selftest() -> &'static InternOutput {
    static RUN: std::sync::OnceLock<InternOutput> = std::sync::OnceLock::new();
    RUN.get_or_init(|| {
        let run = run_intern_probe("intern_selftest()", "intern_selftest.rb");
        assert!(
            run.succeeded,
            "the intern self-test failed:\n{}",
            run.stderr
        );
        run
    })
}
