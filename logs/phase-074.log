//! The benchmark harness's correctness face.
//!
//! `BENCH.md` is what makes a performance claim something a later phase can
//! check rather than a number in a paragraph. This test is deliberately about
//! coverage and answers, not about the timings: a timing assertion is a flake
//! wearing a gate's clothes, so the harness prints wall time and these tests
//! only require that a row exists and that the computed answer is right.
//!
//! The measuring runner is `cargo run --bin rb-bench`; this file shares its
//! workloads through `bench/mod.rs`. That is the one mechanism split across two
//! masters on purpose: the runner measures, the gate checks correctness.

#[path = "bench/mod.rs"]
mod bench;

use std::fs;
use std::thread;
use std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};

use bench::{BenchError, DEFAULT_BUDGET};
use redblue::Value;
use unicode_width::{UnicodeWidthChar, UnicodeWidthStr};

const WORKLOAD_NAMES: &[&str] = &["fibonacci", "primes", "concat", "lex"];

#[test]
fn bench_md_exists_and_names_all_workloads() {
    let path = bench::checked_in_baseline_path();
    let text = fs::read_to_string(&path)
        .unwrap_or_else(|error| panic!("{} should exist: {error}", path.display()));

    for workload in WORKLOAD_NAMES {
        assert!(
            text.contains(workload),
            "BENCH.md should record the `{workload}` workload:\n{text}"
        );
    }
    assert!(
        text.contains("## Hardware") && text.contains("CPU:"),
        "BENCH.md should have a Hardware section naming the CPU it was measured on:\n{text}"
    );
    assert!(
        text.to_lowercase().contains("workload") && text.contains("Answer"),
        "BENCH.md should be a table with a workload column and verified answers:\n{text}"
    );
    assert!(
        text.contains("Wall time"),
        "the checked-in baseline must record a measured wall time so a later phase can detect a regression:\n{text}"
    );

    let mut seen: Vec<&str> = Vec::new();
    for line in text.lines() {
        let line = line.trim();
        if !line.starts_with('|') {
            continue;
        }
        let cells: Vec<&str> = line.trim_matches('|').split('|').map(str::trim).collect();
        if cells.len() != 4 || !WORKLOAD_NAMES.contains(&cells[0]) {
            continue;
        }
        let name = cells[0];
        let size: i64 = cells[1].parse().unwrap_or_else(|_| {
            panic!(
                "BENCH.md size for `{name}` is not a whole number: {:?}",
                cells[1]
            )
        });
        let recorded = cells[2];
        let wall_time = bench::parse_wall_time_ms(cells[3]).unwrap_or_else(|error| {
            panic!("BENCH.md wall time for `{name}` is malformed: {error}")
        });
        assert!(
            wall_time >= 0.0 && wall_time.is_finite(),
            "BENCH.md wall time for `{name}` should be a real measurement, got {wall_time}"
        );
        assert!(
            !seen.contains(&name),
            "BENCH.md has more than one row for `{name}`:\n{text}"
        );
        assert_eq!(
            size,
            bench::default_size(name).expect("the row names a known workload"),
            "BENCH.md should record `{name}` at its default size:\n{text}"
        );
        let measured = bench::run_workload(name, size, DEFAULT_BUDGET).unwrap_or_else(|error| {
            panic!("BENCH.md row for `{name}` at size {size} should run: {error}")
        });
        assert_eq!(
            measured.answer.to_string(),
            recorded,
            "BENCH.md answer for `{name}` at size {size} disagrees with the workload:\n{text}"
        );
        seen.push(name);
    }

    let mut expected_names = WORKLOAD_NAMES.to_vec();
    expected_names.sort_unstable();
    seen.sort_unstable();
    assert_eq!(
        seen, expected_names,
        "BENCH.md should have exactly one answered row per workload:\n{text}"
    );
}

#[test]
fn bench_workloads_compute_the_documented_literals() {
    let fibonacci = bench::run_workload("fibonacci", 20, DEFAULT_BUDGET).expect("fib runs");
    assert_eq!(fibonacci.answer, Value::Number(6765.0), "fib(20)");

    let primes = bench::run_workload("primes", 1000, DEFAULT_BUDGET).expect("primes runs");
    assert_eq!(primes.answer, Value::Number(168.0), "primes below 1000");

    let concat = bench::run_workload("concat", 7, DEFAULT_BUDGET).expect("concat runs");
    assert_eq!(concat.answer, Value::Text("ababababababab".to_string()));

    let lex = bench::run_workload("lex", 100, DEFAULT_BUDGET).expect("lex runs");
    assert_eq!(
        lex.answer,
        Value::Number(100.0),
        "one statement per assignment"
    );
}

#[test]
fn bench_table_lists_four_workloads_and_wall_time() {
    let rows = bench::run_all(DEFAULT_BUDGET).expect("every workload runs at its default size");
    let table = bench::render_table(&rows);

    assert!(
        table.contains("workload") && table.contains("wall time"),
        "the harness should print a named table:\n{table}"
    );
    for name in WORKLOAD_NAMES {
        assert!(table.contains(name), "{name} should have a row:\n{table}");
        let row = table
            .lines()
            .find(|line| line.starts_with(name))
            .unwrap_or_else(|| panic!("{name} row should exist:\n{table}"));
        assert!(
            row.contains("ms"),
            "{name} should carry a wall time, not only an answer:\n{table}"
        );
    }
    assert_eq!(
        table.lines().count(),
        WORKLOAD_NAMES.len() + 1,
        "one header and one row per workload:\n{table}"
    );
}

#[test]
fn edge_zero_size_completes_with_trivial_answers() {
    let cases: &[(&str, Value)] = &[
        ("fibonacci", Value::Number(0.0)),
        ("primes", Value::Number(0.0)),
        ("concat", Value::Text(String::new())),
        ("lex", Value::Number(0.0)),
    ];
    for (name, expected) in cases {
        let row = bench::run_workload(name, 0, DEFAULT_BUDGET)
            .unwrap_or_else(|error| panic!("{name} at size 0 should run: {error}"));
        assert_eq!(&row.answer, expected, "{name} at size zero");
    }
}

#[test]
fn edge_singleton_sizes_are_exact() {
    assert_eq!(
        bench::run_workload("fibonacci", 1, DEFAULT_BUDGET)
            .expect("fib(1)")
            .answer,
        Value::Number(1.0)
    );
    assert_eq!(
        bench::run_workload("primes", 1, DEFAULT_BUDGET)
            .expect("primes below 1")
            .answer,
        Value::Number(0.0)
    );
    assert_eq!(
        bench::run_workload("primes", 2, DEFAULT_BUDGET)
            .expect("primes below 2")
            .answer,
        Value::Number(1.0)
    );
    assert_eq!(
        bench::run_workload("concat", 1, DEFAULT_BUDGET)
            .expect("concat once")
            .answer,
        Value::Text("ab".to_string())
    );
    assert_eq!(
        bench::run_workload("lex", 1, DEFAULT_BUDGET)
            .expect("one assignment")
            .answer,
        Value::Number(1.0)
    );
}

#[test]
fn edge_empty_workload_name_lists_the_four() {
    let refused = bench::run_workload("", 10, DEFAULT_BUDGET);
    assert!(
        refused.is_err(),
        "an empty workload name must produce an error"
    );
    let error = refused.expect_err("empty name must fail");
    let message = error.to_string();
    assert!(
        matches!(error, BenchError::Usage(_)),
        "an empty name is a usage error, got {error:?}"
    );
    for name in WORKLOAD_NAMES {
        assert!(
            message.contains(name),
            "the usage error should list `{name}`: {message}"
        );
    }
}

====
//! The benchmark workloads, shared by the `rb-bench` runner and the tests.
//!
//! A measurement harness is only useful if it knows the answer is right. Every
//! workload here returns a value that has a deterministic reference answer, and
//! [`run_workload`] refuses to report a timing for an answer that differs. Wall
//! time is recorded; it is never asserted. The runner in `tests/bench/runner.rs`
//! prints and writes the table, and `tests/bench_test.rs` pins the answers
//! inside the normal test gate.

use std::fmt;
use std::io::{BufReader, Read};
use std::path::{Path, PathBuf};
use std::process::{Command, Stdio};
use std::sync::mpsc::{self, RecvTimeoutError};
use std::thread;
use std::time::{Duration, Instant};

use redblue::analyzer;
use redblue::lexer::Lexer;
use redblue::parser;
use redblue::Value;
use unicode_width::{UnicodeWidthChar, UnicodeWidthStr};

/// The budget every harness workload runs under.
///
/// A benchmark that hangs must fail instead of waiting forever. Production
/// measurements run in a child process; when the budget expires the parent
/// kills and reaps that child, so a timed-out workload cannot outlive its
/// budget. The budget bounds the wait and the work. A single `run_workload`
/// spends this on one workload; `run_all` spends it once across all four, so
/// the no-argument runner is bounded by one budget rather than four.
pub const DEFAULT_BUDGET: Duration = Duration::from_secs(60);

/// How long the test-only start-marker handshake waits for a child to prove it
/// started before the measurement budget begins. Production never asks for a
/// start marker, so this never extends a real measurement.
const WORKER_START_TIMEOUT: Duration = Duration::from_secs(30);

/// The largest size each workload is allowed to run.
///
/// A larger size is refused before the reference answer or the workload's source
/// string is built, so the harness fails cleanly instead of allocating without
/// bound or burning the shared budget. The boundary test compares against these
/// maxima with [`check_size_supported`], which does not run the workload, so the
/// correctness gate never pays for a maximum-size measurement on an arbitrary
/// machine. The maxima are demonstrated by the measured baseline, not by a timed
/// assertion inside the gate.
///
/// Fibonacci is additionally capped where `f64` still represents every
/// intermediate value exactly (fib(78) < 2^53). Beyond that the expected answer
/// itself is rounded, and far enough out it becomes infinity, which would let
/// `inf == inf` pass as a verified measurement.
const MAX_FIBONACCI_SIZE: i64 = 78;
const MAX_PRIMES_SIZE: i64 = 10_000;
const MAX_CONCAT_SIZE: i64 = 100_000;
const MAX_LEX_SIZE: i64 = 250_000;

/// A workload's name, default size, largest checkable size, and the two
/// functions that make it a benchmark rather than a smoke test.
pub struct Workload {
    pub name: &'static str,
    pub default_size: i64,
    max_size: i64,
    run: fn(i64) -> Result<Value, String>,
    expected: fn(i64) -> Expected,
}

/// The deterministic answer a workload must produce for a given size.
#[derive(Debug, Clone, PartialEq)]
pub enum Expected {
    Number(f64),
    Text(String),
}

impl Expected {
    fn matches(&self, value: &Value) -> bool {
        match (self, value) {
            (Expected::Number(want), Value::Number(got)) => want == got,
            (Expected::Text(want), Value::Text(got)) => want == got,
            _ => false,
        }
    }

    fn render(&self) -> String {
        match self {
            Expected::Number(n) => n.to_string(),
            Expected::Text(text) => text.clone(),
        }
    }
}

/// What one run measured. `answer` is the checked value, not the elapsed time.
#[derive(Debug, Clone)]
pub struct Measurement {
    pub workload: &'static str,
    pub size: i64,
    pub answer: Value,
    pub elapsed: Duration,
}

/// Everything the harness can refuse to do.
#[derive(Debug, Clone, PartialEq)]
pub enum BenchError {
    Usage(String),
    Load(String),
    BudgetExceeded {
        workload: String,
        budget: Duration,
    },
    BudgetExhausted {
        workload: String,
        budget: Duration,
    },
    SizeTooLarge {
        workload: &'static str,
        size: i64,
        max: i64,
    },
    WrongAnswer {
        workload: &'static str,
        size: i64,
        expected: String,
        actual: String,
    },
}

impl fmt::Display for BenchError {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self {
            BenchError::Usage(message) => write!(f, "{message}"),
            BenchError::Load(message) => write!(f, "{message}"),
            BenchError::BudgetExceeded { workload, budget } => write!(
                f,
                "workload '{workload}' did not finish within its {:.3}s budget",
                budget.as_secs_f64()
            ),
            BenchError::BudgetExhausted { workload, budget } => write!(
                f,
                "the shared {:.3}s budget was exhausted before workload '{workload}' could start",
                budget.as_secs_f64()
            ),
            BenchError::SizeTooLarge {
                workload,
                size,
                max,
            } => write!(
                f,
                "workload '{workload}' size {size} exceeds the checkable maximum {max}"
            ),
            BenchError::WrongAnswer {
                workload,
                size,
                expected,
                actual,
            } => write!(
                f,
                "workload '{workload}' at size {size} computed {actual}, expected {expected}"
            ),
        }
    }
}

impl std::error::Error for BenchError {}

/// The four named workloads. Names are stable: `BENCH.md` and the tests use
/// them, and a runner invocation names one.
pub const WORKLOADS: &[Workload] = &[
    Workload {
        name: "fibonacci",
        default_size: 20,
        max_size: MAX_FIBONACCI_SIZE,
        run: run_fibonacci,
        expected: expected_fibonacci,
