    // A function literal is an expression in the grammar, and stage 1 refuses to
    // compile one rather than compiling it to something the bytecode VM would
    // read differently from the tree-walker. Stage 2 refuses it the same way
    // rather than inventing a third answer.
    if type_of(parse_primary_out) is "nothing" then
        if token_kind(tokens, pos) is "to" then
            refuse(token_line(tokens, pos), "'to (x) ... end' as an expression is not compiled yet; run programs that use one with 'rb run'")
        end
    end
    // `might fail <call>` is refused the same way, and for the same reason: the
    // guard needs a jump, a patched recovery and a constant, and stage 2 emits
    // none of those here, so a program that uses one is said to be refused rather
    // than compiled to something the bytecode VM would read differently. The
    // `mightfail` entry in `is_expression_start` is what makes this the arm that
    // catches it: without it the guard fell through to the arm below and the
    // refusal read `unexpected token mightfail`, which names the symptom and not
    // the gap. Either way stage 2 refuses, so the disagreement with stage 1 is
    // visible — which is the property `tests/bootstrap_selfhost_test.rs` pins.
    if type_of(parse_primary_out) is "nothing" then
        if token_kind(tokens, pos) is "mightfail" then
            refuse(token_line(tokens, pos), "'might fail <call>' is not compiled yet; run programs that use one with 'rb run'")
        end
    end
    if type_of(parse_primary_out) is "nothing" then
        refuse(token_line(tokens, pos), "unexpected token " + token_kind(tokens, pos))
    end
    give back parse_primary_out
end

// ---------------------------------------------------------------------------
// `{expr}` interpolation
//
// A `{...}` is a substitution only when it is well formed: a `{` with a
// matching `}` whose contents read as one whole expression. Everything else —
// an unmatched brace, an empty pair, a JSON document in a string — stays the
// characters it was written as, which is what `src/parser.rs` answers and what
// keeps a program that ran yesterday running today.
// ---------------------------------------------------------------------------

// The index of the `}` that closes the `{` at `open`, or -1 when the pair is
// never closed. Braces are counted, so a record written inside the expression
// closes its own pair rather than ending this one.
to interp_close(b, open)
    set interp_close_depth to 1
    set interp_close_i to open + 1
    set interp_close_j to -1
    while interp_close_i < length(b)
        if b[interp_close_i] is 123 then
            set interp_close_depth to interp_close_depth + 1
        end
        if b[interp_close_i] is 125 then
            set interp_close_depth to interp_close_depth - 1
            if interp_close_depth is 0 then
                set interp_close_j to interp_close_i
                set interp_close_i to length(b)
            end
        end
        if interp_close_i < length(b) then
            set interp_close_i to interp_close_i + 1
        end
    end
    give back interp_close_j
end

