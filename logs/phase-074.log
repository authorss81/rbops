//! The self-hosted compiler's intern table (phase-074).
//!
//! The intern table is internal to `bootstrap/compiler.rb`, so the tests drive
//! it through the compiler's hidden `--intern-selftest` mode. That mode runs
//! the same `intern` and `intern_hash` the normal compile path runs; it only
//! gives a test a way to call them without a source file that happens to use
//! every shape needed.
//!
//! The byte-equality test is the real gate: a hash table that answers a name
//! with the wrong index changes the constant pool, and the pool is part of the
//! bytes. `edge_name_heavy_fixture_is_byte_identical_in_both_stages` compiles a
//! program with a thousand distinct names in both stages and requires the files
//! to be one file.

use std::fs;
use std::path::{Path, PathBuf};
use std::process::Command;

fn compiler() -> PathBuf {
    Path::new(env!("CARGO_MANIFEST_DIR")).join("bootstrap/compiler.rb")
}

fn scratch(name: &str) -> PathBuf {
    let dir = Path::new(env!("CARGO_MANIFEST_DIR")).join("target/tmp/bootstrap-intern");
    fs::create_dir_all(&dir).expect("scratch directory");
    dir.join(name)
}

struct Output {
    stdout: String,
    stderr: String,
    succeeded: bool,
}

fn run_compiler(args: &[&str]) -> Output {
    let output = Command::new(env!("CARGO_BIN_EXE_rb"))
        .arg("run")
        .arg(compiler())
        .args(args)
        .output()
        .expect("the rb binary runs");
    Output {
        stdout: String::from_utf8_lossy(&output.stdout).into_owned(),
        stderr: String::from_utf8_lossy(&output.stderr).into_owned(),
        succeeded: output.status.success(),
    }
}

fn intern_selftest() -> Output {
    run_compiler(&["--intern-selftest"])
}

/// The value printed for `key`, which the self-test prints as `key value`.
fn report<'a>(stdout: &'a str, key: &str) -> &'a str {
    let prefix = format!("{key} ");
    stdout
        .lines()
        .find_map(|line| line.strip_prefix(&prefix))
        .unwrap_or_else(|| panic!("the self-test printed no '{key}' line:\n{stdout}"))
}

fn number(stdout: &str, key: &str) -> i64 {
    report(stdout, key)
        .parse::<i64>()
        .unwrap_or_else(|error| panic!("'{key}' is not an integer: {error}\n{stdout}"))
}

fn intern_selftest_type_error() -> Result<(), String> {
    let run = run_compiler(&["--intern-selftest-type-error"]);
    if run.succeeded {
        Ok(())
    } else {
        Err(run.stderr)
    }
}

#[test]
fn edge_interning_the_same_name_1000_times_grows_the_table_once() {
    let run = intern_selftest();
    assert!(
        run.succeeded,
        "the intern self-test failed:\n{}",
        run.stderr
    );
    assert_eq!(
        number(&run.stdout, "repeat_growth"),
        1,
        "1000 repetitions of one name grew the table by more than the one distinct name:\n{}",
        run.stdout
    );
    assert_eq!(
        number(&run.stdout, "other_growth"),
        2,
        "a second distinct name did not grow the table to exactly two entries:\n{}",
        run.stdout
    );
}

#[test]
fn edge_engineered_collision_resolves_each_name_to_its_own_index() {
    let run = intern_selftest();
    assert!(
        run.succeeded,
        "the intern self-test failed:\n{}",
        run.stderr
    );
    assert_eq!(
        report(&run.stdout, "collision_found"),
        "yes",
        "the self-test failed to construct a collision:\n{}",
        run.stdout
    );
    assert_eq!(
        report(&run.stdout, "collision_distinct"),
        "yes",
        "two colliding names were given the same index:\n{}",
        run.stdout
    );

    // Each colliding name must still resolve to the index it was given, after
    // the other one was added to the same bucket.
    for name in ["collision_a", "collision_b"] {
        let index = number(&run.stdout, &format!("{name}_index"));
        let lookup = number(&run.stdout, &format!("{name}_lookup"));
        assert_eq!(
            lookup, index,
            "{name} did not resolve to its own index after the collision:\n{}",
            run.stdout
        );
    }
}

#[test]
fn edge_empty_and_ten_kilobyte_names_are_interned_exactly() {
    let run = intern_selftest();
    assert!(
        run.succeeded,
        "the intern self-test failed:\n{}",
        run.stderr
    );
    assert_eq!(
        report(&run.stdout, "empty_same"),
        "yes",
        "the empty name was not interned to one index:\n{}",
        run.stdout
    );
    assert_eq!(
        number(&run.stdout, "empty_growth"),
        1,
        "the empty name grew the table by more than one:\n{}",
        run.stdout
    );
    assert_eq!(
        report(&run.stdout, "long_same"),
        "yes",
        "the same 10KB name did not intern to one index:\n{}",
        run.stdout
    );
    assert_eq!(
        report(&run.stdout, "long_distinct"),
        "yes",
        "a 10KB name that differs only in its last byte reused the first index, so the name was truncated:\n{}",
        run.stdout
    );
    assert_eq!(
        number(&run.stdout, "long_growth"),
        2,
        "the two 10KB names did not grow the table to exactly two entries:\n{}",
        run.stdout
    );
}

