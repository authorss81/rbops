+            !offered.is_empty(),
+            "`{module}.` offers nothing, so the module {} .doc lists {} \
+             cannot be reached from the keyboard",
+            documented.first().map(String::as_str).unwrap_or(""),
+            offered.len()
+        );
+        for member in &offered {
