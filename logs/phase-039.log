#[test]
fn edge_the_limit_itself_is_the_boundary() {
    assert_eq!(
        eval(&countdown(MAX_CALL_DEPTH - 1)),
        redblue::Value::Number(0.0),
        "{} active frames should be legal under a limit of {}",
