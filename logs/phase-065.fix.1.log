    /// so a recorded line may hold anything a line can hold. A malformed record
    /// is skipped rather than panicking on a file a user could have edited.
    fn parse_session_state(state: &str) -> (HashMap<String, String>, HashMap<String, Vec<String>>) {
        let mut aliases = HashMap::new();
        let mut macros = HashMap::new();
        let mut lines = state.lines();

        while let Some(line) = lines.next() {
            if let Some(rest) = line.strip_prefix("alias ") {
                if let Some((name, value)) = rest.split_once(char::is_whitespace) {
                    aliases.insert(name.to_string(), value.trim().to_string());
                }
            } else if let Some(rest) = line.strip_prefix("macro ") {
                let Some((name, count)) = rest.split_once(char::is_whitespace) else {
                    continue;
                };
                let Ok(count) = count.trim().parse::<usize>() else {
                    continue;
                };
                let mut body = Vec::with_capacity(count);
                for _ in 0..count {
                    let Some(recorded) = lines.next() else {
                        break;
                    };
                    body.push(recorded.to_string());
                }
                macros.insert(name.to_string(), body);
            }
        }

        (aliases, macros)
    }
