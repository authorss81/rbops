/// depth, and returns the value of its last statement.
#[track_caller]
fn eval(source: &str) -> redblue::Value {
    let ast = analyze(source);
    let (_vm, failure) = redblue::run_isolated(&ast);
    match failure {
        None => eval_last_statement_value(source),
        Some(error) => panic!("source should have run, failed with {:?}", error),
    }
}

/// Runs `source` and returns the runtime error it produced.
#[track_caller]
fn eval_err(source: &str) -> Error {
    let ast = analyze(source);
    let (_vm, failure) = redblue::run_isolated(&ast);
    failure.expect("source should have failed")
}

/// Lexes, parses and analyses `source`.
#[track_caller]
fn analyze(source: &str) -> redblue::parser::Program {
    let tokens = redblue::lexer::Lexer::tokenize(source).expect("source should lex");
    let ast = redblue::parser::parse(tokens).expect("source should parse");
    redblue::analyzer::analyze(&ast).expect("source should analyse");
    ast
}

/// The value of the last statement, from a second isolated run. `run_isolated`
/// reports failures rather than values, and a test that only needs the value of
/// a program already known to succeed does not care that it ran twice.
fn eval_last_statement_value(source: &str) -> redblue::Value {
    let ast = analyze(source);
    let mut vm = redblue::Vm::with_max_call_depth(1);
    vm.run(&ast).expect("source should run")
}''','''/// Lexes and parses `source`.
#[track_caller]
fn parse(source: &str) -> redblue::parser::Program {
    let tokens = redblue::lexer::Lexer::tokenize(source).expect("source should lex");
    redblue::parser::parse(tokens).expect("source should parse")
}

/// Runs `source` on a stack sized for the call depth and returns the value of
/// its last statement.
#[track_caller]
fn eval(source: &str) -> redblue::Value {
    let (_vm, result) = redblue::run_isolated(&parse(source));
    result.unwrap_or_else(|error| panic!("source should have run, failed with {:?}", error))
}

/// Runs `source` and returns the error it produced.
#[track_caller]
fn eval_err(source: &str) -> Error {
    let (_vm, result) = redblue::run_isolated(&parse(source));
    result.expect_err("source should have failed")
}''')
