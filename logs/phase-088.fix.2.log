                Some(minimal) => format!(
                    "{}:\n  tree-walking VM: {:?}\n  bytecode VM:    {:?}\n{}",
                    path.display(),
                    tree,
                    byte,
                    shrink::report(0, &source, &minimal),
                ),
                None => format!("{}:\n  {tree:?}\n  {byte:?}", path.display()),
        );
    }
}

