from pathlib import Path
for name in ["REPORT.md", "FINDINGS.md"]:
    text = Path("phases/phase-088")/name
    lines = text.read_text().split("\n")
    open_fence = None
    regions = []
    for i, line in enumerate(lines):
        s = line.lstrip()
        run = len(s) - len(s.lstrip("`"))
        if run < 3:
            continue
        info = s[run:].strip()
        if open_fence is None:
            open_fence = (i + 1, run, info)
        else:
            start, ticks, _ = open_fence
            if info == "" and run >= ticks:
                regions.append((start, i + 1))
                open_fence = None
            elif info != "" and run >= ticks:
                print(f"{name}: AMBIGUOUS fence with info {info!r} on line {i+1}")
    print(name, "regions:", len(regions), "unterminated:", open_fence)
