         );
     }
+
+    // The refusal is the builtin call's, not the statement's: a builtin that
+    // cannot answer refuses the same way inside an expression it is only one
+    // term of.
+    let result = redblue::run_source("set x to 1 + floor(\"x\")");
+    assert!(
+        result.is_err(),
