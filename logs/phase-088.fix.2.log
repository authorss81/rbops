import sys, re
sys.path.insert(0, "phases/phase-088")
import importlib.util
spec = importlib.util.spec_from_file_location("scan", "phases/phase-088/scan.py")
scan = importlib.util.module_from_spec(spec)
spec.loader.exec_module(scan)
from pathlib import Path

def rule_of(code):
    r = []
    if scan.READS_THE_PROGRAM.search(code): r.append("READS")
    if scan.COMPARES_A_VALUE.search(code): r.append("COMPARES")
    for m in re.finditer(r"\bassert!", code):
        op = code.find("(", m.end())
        if op == -1: continue
        arg = code[op+1:scan.match_paren(code, op)]
        r.append("ASSERT!" + ("(reach)" if scan.is_reachability_check(arg) else "(value)"))
    return r

for path in sorted(Path("tests").glob("*.rs")):
    raw = path.read_text(errors="replace")
    code = scan.mask(scan.mask(raw, mask_strings=True), mask_strings=False)
    words = scan.mask(raw, mask_strings=False)
    functions = scan.find_functions(code)
    bodies = {n:(b,e) for n,_l,b,e,_p in functions}
    def helper_reach(name, seen):
        if name in seen or name not in bodies: return "", ""
        seen.add(name)
        brace,end = bodies[name]
        body = code[brace:end]
        fixtures = words[brace:end]
        for callee in scan.called_names(body):
            sc, sf = helper_reach(callee, seen)
            body += sc; fixtures += sf
        return body, fixtures
    for name, line, brace, end, before in functions:
        attrs = before.rsplit("}",1)[-1]
        if "#[test]" not in attrs: continue
        body = code[brace:end]
        fixtures = words[brace:end]
        reached = body
        for callee in scan.called_names(body):
            sc, sf = helper_reach(callee, set())
            reached += sc; fixtures += sf
        if not any(t in reached for t in scan.RUNS_A_PROGRAM): continue
        rules = rule_of(reached)
        if not rules:
            print(f"VACUOUS {path.name}:{line} {name}")
        else:
            # figure out which rule is the "first" that fires
            print(f"{path.name}:{line}\t{name}\t{rules[:4]}")
