def add_span(src, expr):
    out = []
    idx = 0
    needle = "Error::Runtime("
    while True:
        j = src.find(needle, idx)
        if j == -1:
            out.append(src[idx:])
            return "".join(out)
        start = j + len(needle)
        depth = 1
        k = start
        while depth > 0:
            if src[k] == "(":
                depth += 1
            elif src[k] == ")":
                depth -= 1
                if depth == 0:
                    break
            k += 1
        inner = src[start:k]
        sep = ", " if inner.rstrip().endswith(",") is False else ", "
        out.append(src[idx:k])
        if inner.rstrip().endswith(","):
            out.append(expr + ",")
        else:
            out.append(", " + expr)
        idx = k
    return "".join(out)

