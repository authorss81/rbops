            assert!(!buffer.is_null(), "rb_alloc returned null");
            assert!(!cell.is_null(), "rb_alloc returned null");
        }

        std::ptr::write(out_cell.cast::<i32>(), out_cap);
        std::ptr::write(err_cell.cast::<i32>(), err_cap);
        let status = wasm::rb_run_into(
