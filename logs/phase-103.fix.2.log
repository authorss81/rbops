#[test]
fn edge_path_join_with_no_parts_is_a_clean_failure() {
    let error = run_source_value("path.join()").expect_err("a join needs at least one part");
    assert_eq!(error.label(), "RuntimeError", "{error}");
    assert!(
        error.to_string().contains("at least one path"),
        "the refusal must say what is missing, got: {error}"
    );
}

#[test]
fn edge_listing_a_file_is_an_io_error_not_a_list() {
    let dir = TempDir::new("path-list-file");
    dir.write_file("plain.txt", "x");
    let source = format!(
        r#"path.list("{}")"#,
        dir.file("plain.txt").to_string_lossy().replace('\\', "/")
    );
    let error = run_source_value(&source).expect_err("a file is not a directory");
    assert_eq!(error.label(), "IoError", "{error}");
}

mod logging_module {
    use std::fs;

    use super::*;

    #[derive(Debug)]
    struct Run {
        output: Vec<String>,
        result: Result<Value, Error>,
    }

    fn tree_walk(source: &str) -> Run {
        redblue::logging::reset();
        let tokens = redblue::lexer::Lexer::tokenize(source).expect("source tokenizes");
        let ast = redblue::parser::parse(tokens).expect("source parses");
        redblue::analyzer::analyze(&ast).expect("source analyzes");
        let mut vm = redblue::Vm::new();
        let result = vm.run_quietly(&ast);
        Run {
            output: vm.take_output(),
            result,
        }
    }

    fn bytecode(source: &str) -> Run {
        redblue::logging::reset();
        let chunk = compile_source(source).expect("source compiles");
        let mut vm = BytecodeVm::new();
        vm.set_echo(false);
        let result = vm.run(&chunk);
        Run {
            output: vm.take_output(),
            result,
        }
    }

    fn scratch(name: &str) -> PathBuf {
        let dir = Path::new(env!("CARGO_MANIFEST_DIR"))
            .join("target/tmp/logging-tests")
            .join(name);
        let _ = fs::remove_dir_all(&dir);
        fs::create_dir_all(&dir).expect("scratch dir");
        dir
    }

    fn quoted(path: &Path) -> String {
        path.to_string_lossy().replace('\\', "\\\\")
    }

    fn runtime_message(error: Error) -> String {
        match error {
            Error::Runtime(message, _) => message,
            other => panic!("expected a Runtime error, got {other:?}"),
        }
    }

