pub fn format_record(level: Level, message: &str, timestamp: Option<&str>) -> String {
    match timestamp {
        Some(timestamp) => format!("[{timestamp}] [{}] {message}\n", level.label()),
        None => format!("[{}] {message}\n", level.label()),
    }
}
