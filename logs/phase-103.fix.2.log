use std::cell::{Cell, RefCell};
use std::io::{self, Write};
use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
use std::sync::{Mutex, MutexGuard, OnceLock};

/// Whether program output is being collected instead of written to stdout.
static CAPTURING: AtomicBool = AtomicBool::new(false);

/// Set when a run tried to [`emit`] past [`MAX_OUTPUT_BYTES`]. A run that
/// overflows is reported as a failure rather than silently losing the tail,
/// because a playground showing the first 4 MiB of an endless loop and calling
/// it a success would be lying about what the program did.
static OVERFLOW: AtomicBool = AtomicBool::new(false);

/// The buffer a capture collects into. A [`Mutex`] rather than a `RefCell`
/// because `say` runs on the interpreter thread, not the thread that opened the
/// capture, and on wasm there is only one thread anyway.
static CAPTURED: Mutex<Vec<u8>> = Mutex::new(Vec::new());

thread_local! {
    /// Output that belongs to the current run but is written when the program
    /// finishes, not when the statement runs.
    ///
    /// A `say` line is buffered that way, and a `stdout` log record has to
    /// share the queue: writing the record straight to the capture would put it
    /// ahead of every `say` the program made earlier, because those lines only
    /// reach the capture in [`Vm::run`](crate::Vm::run)'s final flush. One
    /// queue preserves the order the program actually called them in.
    static DEFERRED: RefCell<Vec<u8>> = const { RefCell::new(Vec::new()) };
}

thread_local! {
    /// Whether this thread is part of the run that owns the open capture.
    ///
    /// The capture itself is process-global because the program runs on an
pub fn is_capturing() -> bool {
    capture_member() && CAPTURING.load(Ordering::Relaxed)
}

/// Whether this thread belongs to the run that has the capture open.
pub(crate) fn capture_member() -> bool {
    IN_CAPTURE.with(|member| member.get())
}

/// Carries [`capture_member`] into the interpreter thread a run spawns.
///
/// The program does not run on the thread that called [`begin_capture`], so
/// without this the interpreter thread would write its records and output to
/// the real stream instead of the capture.
pub(crate) fn join_capture(member: bool) {
    IN_CAPTURE.with(|flag| flag.set(member));
}

/// Writes a program's output and reports a failed write.
///
/// [`emit`] is this function with the failure discarded, which is what `say`
/// and `print` have always done. A caller that must not lose a record — the
/// logging module — uses this instead, so a closed or unwritable stream reaches
/// the program as a catchable error rather than as output that vanished.
pub fn try_emit(text: &str) -> io::Result<()> {
    if is_capturing() {
        let mut buffer = output_buffer();
        if buffer.len().saturating_add(text.len()) > MAX_OUTPUT_BYTES {
            OVERFLOW.store(true, Ordering::SeqCst);
            return Ok(());
        }
        buffer.extend_from_slice(text.as_bytes());
        return Ok(());
    }
    std::io::stdout().write_all(text.as_bytes())
}

/// Buffers output that the program's final flush will write, instead of
/// writing it now.
///
/// Used for a `say` line and for a `stdout` log record while a capture is open,
/// so the two interleave in call order. Outside a capture there is no final
/// flush to join, so the text goes to the stream immediately.
pub(crate) fn defer_capture(text: &str) -> io::Result<()> {
    if !is_capturing() {
        return try_emit(text);
    }
    DEFERRED.with(|deferred| {
        let mut deferred = deferred.borrow_mut();
        if deferred.len().saturating_add(text.len()) > MAX_OUTPUT_BYTES {
            OVERFLOW.store(true, Ordering::SeqCst);
            return Ok(());
        }
        deferred.extend_from_slice(text.as_bytes());
        Ok(())
    })
}

/// Writes everything [`defer_capture`] queued into the open capture.
///
/// Called at the end of a successful run, where the interpreter flushes its
/// buffered `say` lines. A failed run never reaches that point, so its queued
/// lines are cleared by the next [`begin_capture`] or by [`CaptureGuard`].
pub(crate) fn flush_deferred() {
    if !is_capturing() {
        DEFERRED.with(|deferred| deferred.borrow_mut().clear());
        return;
    }
    let queued = DEFERRED.with(|deferred| std::mem::take(&mut *deferred.borrow_mut()));
    if queued.is_empty() {
        return;
    }
    let text = String::from_utf8_lossy(&queued);
    let _ = try_emit(&text);
}

/// Serializes whole runs. There is one capture buffer and one program's output
/// goes in it, so two runs cannot overlap — on wasm there is one host thread
/// and the point is moot, but the module is also compiled natively where
/// `cargo test` runs its tests in parallel, and without this two of them would
/// divide one program's output between them. The lock is held across the run,
/// Starts a capture. The buffer is emptied first, so a capture never inherits
/// the previous one's bytes. Callers go through [`run_program`] or [`rb_run`],
/// which hold [`RUN_LOCK`]; reaching for these directly is only for a caller
/// that has serialised its own runs.
pub fn begin_capture() {
    output_buffer().clear();
    DEFERRED.with(|deferred| deferred.borrow_mut().clear());
    OVERFLOW.store(false, Ordering::SeqCst);
    CAPTURING.store(true, Ordering::SeqCst);
    IN_CAPTURE.with(|flag| flag.set(true));
}

/// Stops a capture and takes everything collected since [`begin_capture`].
fn take_capture() -> String {
    CAPTURING.store(false, Ordering::SeqCst);
    IN_CAPTURE.with(|flag| flag.set(false));
    let bytes = std::mem::take(&mut *output_buffer());
    String::from_utf8_lossy(&bytes).into_owned()
}

/// Puts the capture back the way it was found however this run ended — a clean
/// return, a failure, or a panic unwinding out of the interpreter.
///
/// Without it a panic leaves `CAPTURING` set, and every later run in the same
/// process would append to a capture nobody is reading, which is the one way a
/// panic can cost a host more than the run that caused it.
struct CaptureGuard;

impl Drop for CaptureGuard {
    fn drop(&mut self) {
        CAPTURING.store(false, Ordering::SeqCst);
        OVERFLOW.store(false, Ordering::SeqCst);
        IN_CAPTURE.with(|flag| flag.set(false));
        DEFERRED.with(|deferred| deferred.borrow_mut().clear());
    }
}

/// What one run produced: every byte it wrote, and the rendered failure if it
/// failed. They are independent. A program that printed three lines and then
/// divided by zero has three lines *and* a failure, and a host showing only the
/// message would look like a program that printed nothing at all.
struct RunOutcome {
    printed: String,
    failure: Option<String>,
}
