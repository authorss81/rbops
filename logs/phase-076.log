                    test_name: name.to_string(),
                    file: "inline".to_string(),
                    line: Some(line),
                    message: e.to_string(),
                    expected: None,
                    actual: None,
                });
                print!("F");
            }
        }
    }

    fn run_benchmark(&mut self, lines: &[&str], i: &mut usize, bench_name: &str) -> Result<()> {
