while read -r f; do
  [ -n "$f" ] || continue
  case "$f" in
    .github/workflows/*|rbops/*|.opencode/agent/*)
      bad "forbidden path touched: $f" ;;
  esac
done <<< "$CHANGED"
ok "forbidden-path scan done"

