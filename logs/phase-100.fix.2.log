        "resolve must remove dot segments on this platform, got {resolved}"
    );
    assert_eq!(
        Path::new(&resolved)
            .file_name()
    assert_eq!(filename("data//records/"), Some("records".to_string()));
    assert_eq!(stem("data//records/"), Some("records".to_string()));
    assert_eq!(
        join_with_separator(&["data/", "records/"], '/'),
