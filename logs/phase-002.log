+#[cfg(test)]
+mod discovery_tests {
+    use super::*;
+    use std::fs;
+    use std::path::{Path, PathBuf};
+
+    /// Scratch directory for the fixtures below. `CARGO_TARGET_TMPDIR` points
+    /// inside the build tree so the fixtures never touch the repository or the
+    /// user's filesystem.
+    fn scratch(name: &str) -> PathBuf {
+        let root = std::env::var("CARGO_TARGET_TMPDIR").unwrap_or_else(|_| "target/tmp".to_string());
+        let dir = Path::new(&root).join("phase-002").join(name);
+        let _ = fs::remove_dir_all(&dir);
+        fs::create_dir_all(&dir).expect("scratch directory must be creatable");
+        dir
+    }
+
+    fn write(dir: &Path, name: &str, contents: &str) {
+        let path = dir.join(name);
+        if let Some(parent) = path.parent() {
+            fs::create_dir_all(parent).expect("parent directory must be creatable");
+        }
+        fs::write(&path, contents).expect("fixture file must be writable");
+    }
+
+    /// A Rust test source that would be *reported as a failure* if the Redblue
+    /// harness parsed it: the marker line is honoured, the body fails.
+    const FAILING_RUST_SOURCE: &str = "#[test]\nfn t() {}\n// test \"not redblue\"\nexpect 1 to be 2\n// end\n";
+
+    #[test]
+    fn discovers_only_rb_files() {
+        let found = find_test_files("tests/").expect("discovery must not fail");
+        let rust: Vec<&String> = found.iter().filter(|p| p.ends_with(".rs")).collect();
+        assert!(
+            rust.is_empty(),
+            "the Redblue harness must never collect Rust sources, got {:?}",
+            rust
+        );
+        assert!(
+            !found.is_empty(),
+            "discovery must still find the .rb suite, got an empty list"
+        );
+    }
+
+    #[test]
+    fn run_all_tests_reports_no_errors_from_rust_sources() {
+        let results = run_all_tests().expect("suite must run");
+        assert!(
+            results.total > 0,
+            "the .rb suite must contribute tests, got 0"
+        );
+        for error in &results.errors {
+            assert!(
+                !error.file.ends_with(".rs") && !error.message.contains(".rs"),
+                "a Rust source reached the Redblue harness: {:?}",
+                error
+            );
+        }
+    }
+
+    #[test]
+    fn run_file_rejects_a_rust_source() {
+        let dir = scratch("run-file-rejects");
+        let path = dir.join("probe_test.rs");
+        write(&dir, "probe_test.rs", FAILING_RUST_SOURCE);
+
+        let mut harness = TestHarness::new();
+        let err = harness
+            .run_file(&path.to_string_lossy())
+            .expect_err("a .rs path must be refused, not parsed as Redblue");
+        assert!(
+            err.to_string().contains(".rb"),
+            "the error must name the expected extension, got: {}",
+            err
+        );
+        assert_eq!(
+            harness.results().total,
+            0,
+            "a refused file must not record a test"
+        );
+    }
+
+    #[test]
+    fn edge_rs_file_with_failing_marker_is_never_collected() {
+        let dir = scratch("failing-rs-not-collected");
+        write(&dir, "probe_test.rs", FAILING_RUST_SOURCE);
+
+        let found = find_test_files(&dir.to_string_lossy()).expect("discovery must not fail");
+        assert!(
+            found.is_empty(),
+            "a Rust source with a `// test` marker must not be collected, got {:?}",
+            found
+        );
+    }
+
+    #[test]
+    fn edge_extension_match_is_exact() {
+        let dir = scratch("extension-match");
+        for name in [
+            "suite.rb",
+            "suite.rb.bak",
+            "suite.RB",
+            "suite_test.rs",
+            "suite.rsx",
+            "notes.txt",
+        ] {
+            write(&dir, name, "");
+        }
+
+        let mut found = find_test_files(&dir.to_string_lossy()).expect("discovery must not fail");
+        found.sort();
+        let names: Vec<String> = found
+            .iter()
+            .map(|p| {
+                Path::new(p)
+                    .file_name()
+                    .expect("collected path must have a name")
+                    .to_string_lossy()
+                    .to_string()
+            })
+            .collect();
+        assert_eq!(names, vec!["suite.rb".to_string()]);
+    }
+
+    #[test]
+    fn edge_nested_directories_ignore_rust_sources() {
+        let dir = scratch("nested");
+        write(&dir, "top.rb", "");
+        write(&dir, "nested/deep/inner.rb", "");
+        write(&dir, "nested/deep/inner_test.rs", FAILING_RUST_SOURCE);
+        write(&dir, "nested/deep/deeper/leaf_test.rs", FAILING_RUST_SOURCE);
+
+        let mut found = find_test_files(&dir.to_string_lossy()).expect("discovery must not fail");
+        found.sort();
+        let names: Vec<String> = found
+            .iter()
+            .map(|p| {
+                Path::new(p)
+                    .file_name()
+                    .expect("collected path must have a name")
+                    .to_string_lossy()
+                    .to_string()
+            })
+            .collect();
+        assert_eq!(names, vec!["inner.rb".to_string(), "top.rb".to_string()]);
+    }
+
+    #[test]
+    fn edge_missing_directory_is_not_an_error() {
+        let found = find_test_files("tests/no-such-directory-here")
+            .expect("a missing directory is not a discovery failure");
+        assert!(found.is_empty(), "got {:?}", found);
+    }
+
+    #[test]
+    fn edge_empty_suite_directory_yields_no_tests() {
+        let dir = scratch("empty");
+        let mut harness = TestHarness::new();
+        let found = find_test_files(&dir.to_string_lossy()).expect("discovery must not fail");
+        assert!(found.is_empty(), "an empty directory must collect nothing");
+        assert_eq!(harness.results().total, 0);
+    }
+
+    #[test]
+    fn a_failing_expect_is_still_reported_as_a_failure() {
+        let mut harness = TestHarness::new();
+        harness
+            .run_source("// test \"deliberately fails\"\nexpect 1 to be 2\n// end\n")
+            .expect("a failing assertion is a test result, not a harness error");
+
+        let results = harness.results();
+        assert_eq!(results.total, 1);
+        assert_eq!(results.failed, 1, "the failure must be recorded: {:?}", results.errors);
+        let error = &results.errors[0];
+        assert_eq!(error.test_name, "deliberately fails");
+        assert!(
+            error.expected.is_some() && error.actual.is_some(),
+            "a failing `expect` must name both sides, got {:?}",
+            error
+        );
+    }
+}

