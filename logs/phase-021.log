    assert_eq!(
        tree.output,
        vec!["[kept, 6]".to_string()],
        "the loop's own answer is the sum of the list"
    );
    assert_eq!(
        byte.output, tree.output,
        "the bytecode VM must keep the caller's first operand across the loop"
    );
}

