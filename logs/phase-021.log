old = '''    fn set_var(&mut self, name: &str, value: Value) {
        for scope in self.locals.iter_mut().rev() {
            if scope.contains_key(name) {
                scope.insert(name.to_string(), value);
                return;
            }
        }
        if self.module_depth > 0 {
            if let Some(scope) = self.locals.last_mut() {
                scope.insert(name.to_string(), value);
            }
            return;
        }
        self.globals.insert(name.to_string(), value);
    }'''
new = '''    fn set_var(&mut self, name: &str, value: Value) {
        // Only the scopes of the call this `set` is running in: a caller's frame
        // is somebody else's binding, and writing to it is what made recursion
        // impossible on the tree-walking VM, which is the specification. See
        // `Vm::set_var` there for the whole of it.
        let base = self.frames.last().map_or(0, |frame| frame.locals_base);
        for scope in self.locals[base..].iter_mut().rev() {
            if scope.contains_key(name) {
                scope.insert(name.to_string(), value);
                return;
            }
        }
        if self.module_depth > 0 {
            if let Some(scope) = self.locals.last_mut() {
                scope.insert(name.to_string(), value);
            }
            return;
        }
        // A name the call introduced goes in the scope the call pushed for its
        // own names — `locals_base` plus whatever `this` and the captured scopes
        // sit above it — so that it outlives a `catch` body or a loop body it was
        // assigned in, and dies with the call.
        if let Some(own) = self
            .frames
            .last()
            .map(|frame| self.own_scope_of(frame.locals_base))
        {
            if let Some(scope) = self.locals.get_mut(own) {
                scope.insert(name.to_string(), value);
                return;
            }
        }
        self.globals.insert(name.to_string(), value);
    }

    /// The scope a call pushed for its own names: the one holding the
    /// parameters, which is the last scope pushed before the body runs.
    ///
    /// `locals_base` counts the caller's scopes, and the call pushes `this`
    /// first when it has a receiver, then every captured scope, then the
    /// parameters — so the parameters' scope is the last one standing when
    /// [`BytecodeVm::set_var`] reaches this.
    fn own_scope_of(&self, locals_base: usize) -> Option<usize> {
        let own = self.locals.len().checked_sub(1)?;
        if own < locals_base { None } else { Some(own) }
    }'''
assert old in s
s=s.replace(old,new,1)
open(p,'w').write(s)
print("bytecode vm patched")
