to number_bytes(n)
    if n is not n then
        refuse(0, "a NaN cannot be a bytecode constant")
    end
    set raw to []
    set sign to 0
    set mag to n
    if n < 0 then
        set sign to 1
        set mag to 0 - n
    end

    // Zero. The lexer never puts a `-` in a numeric literal, so a constant can
    // only be `+0.0`, and `+0.0` is eight zero bytes.
    if mag is 0 then
        set raw to [0, 0, 0, 0, 0, 0, 0, 0]
    else
        set e to exponent_of(mag)
        set biased to 0
        set fraction to 0
        if mag < inv_pow2(1022) then
            // Subnormal: the exponent field is zero and the whole mantissa is
            // the fraction, at a scale of 2^-1074. `mag / 2^-1074` is an exact
            // integer below 2^52, so the division rounds to exactly it.
            set fraction to mag / inv_pow2(1074)
        else
            set biased to e + 1023
            if e <= 52 then
                set fraction to mag * pow2(52 - e) - pow2(52)
            else
                set fraction to mag / pow2(e - 52) - pow2(52)
            end
        end

        // The fraction's high half and its low half. The low half is below 2^32
        // and the high half is `sign | biased exponent | high half`, below 2^32
        // too, so both are exact here and both are `% 256` away from bytes.
        set mant_high to fraction / pow2(32)
        set low to fraction - mant_high * pow2(32)
        set high to biased * pow2(20) + mant_high
        if sign is 1 then
            set high to high + pow2(31)
        end
        set raw to cat(u32_le(low), u32_le(high))
    end
    give back raw
end
