p='bootstrap/compiler.rb'
s=open(p).read()
anchor = '// Whether the whole `or equal to` tail of a compound comparison is there.'
assert anchor in s
fn = '''// The comparison that follows an `is`, in either its word form
// (`is greater than or equal to`) or its symbolic one (`is =`, `is not`). A
// word counts as an operator only when the whole phrase is there, so a variable
// named `greater` still compares for equality.
//
// The width is how many tokens the whole comparison consumes, `is` included,
// which is what the caller adds to the position it found the operator at.
to read_is_operator(tokens, pos)
    set p to pos + 1
    set first to word_at(tokens, p)
    set second to word_at(tokens, p + 1)
    set result to ""
    set width to 0

    if first is "equal" then
        if token_kind(tokens, p + 1) is "to" then
            set result to "eq"
            set width to 3
        end
    end
    if first is "greater" then
        if second is "than" then
            set result to "gt"
            set width to 3
            if or_equal_to_ahead(tokens, p + 2) then
                set result to "ge"
                set width to 6
            end
        end
    end
    if first is "less" then
        if second is "than" then
            set result to "lt"
            set width to 3
            if or_equal_to_ahead(tokens, p + 2) then
                set result to "le"
                set width to 6
            end
        end
    end
    if result is "" then
        set k to token_kind(tokens, p)
        if k is "eq" then
            set result to "eq"
            set width to 2
        end
        if k is "not" then
            set result to "ne"
            set width to 2
        end
        if k is "in" then
            set result to "in"
            set width to 2
        end
    end
    // A bare `is` is equality, and is the only token it consumes.
    if result is "" then
        set result to "eq"
        set width to 1
    end
    give back [result, width]
end

'''
s = s.replace(anchor, fn + anchor, 1)

# the fraction split: `fraction / 2^32` is not an integer unless the fraction is
# a multiple of 2^32, so the low half is taken first and the rest divided.
old = '''        set mant_high to fraction / pow2(32)
        set low to fraction - mant_high * pow2(32)
        set high to biased * pow2(20) + mant_high'''
new = '''        set low to fraction mod pow2(32)
        set mant_high to (fraction - low) / pow2(32)
        set high to biased * pow2(20) + mant_high'''
assert old in s
s = s.replace(old, new, 1)
open(p,'w').write(s)
