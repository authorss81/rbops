            set parse_record_fields_out to parse_record_fields(tokens, parse_record_fields_p + 1, depth, parse_record_fields_next)
        end
        if type_of(parse_record_fields_out) is "nothing" then
            set parse_record_fields_out to [parse_record_fields_next, parse_record_fields_p]
        end
    end
    give back parse_record_fields_out
end

