            // the file wrote a loop shape for. The body runs once, which is all a
            // file that says this can mean.
            self.advance(frame);
            return;
        };
        let stack_base = self.stack.len().saturating_sub(1);
        self.loops.push(Loop {
            kind: site.kind,
            iterator: sequence,
            top: site.top,
            back_edge: site.back_edge,
            exit: site.exit,
            iterations: 0,
            frame,
            stack_base,
            variable: None,
        });
        self.advance(frame);
    }

