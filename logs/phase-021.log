import re
p='bootstrap/compiler.rb'
lines=open(p).read().split('\n')
out=[]; i=0; n=len(lines); undone=0
while i < n:
    line=lines[i]
    m=re.match(r'^to ([a-z_0-9]+)\((.*)\)\s*$', line)
    if not m:
        out.append(line); i+=1; continue
    fname=m.group(1)
    j=i+1
    while j < n and lines[j].rstrip() != 'end':
        j+=1
    body=lines[i+1:j]
    pat = re.compile(r'\b'+re.escape(fname)+r'_([a-z_0-9]+)\b')
    newbody=[]
    for b in body:
        nb,k = pat.subn(lambda mm: mm.group(1), b)
        undone += k
        newbody.append(nb)
    out.append(line); out.extend(newbody); out.append(lines[j]); i=j+1
open(p,'w').write('\n'.join(out))
print('undone', undone)
