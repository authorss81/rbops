import re
p='bootstrap/compiler.rb'
lines=open(p).read().split('\n')
out=[]; i=0; n=len(lines); changed=0
while i < n:
    line=lines[i]
    m=re.match(r'^to ([a-z_0-9]+)\((.*)\)\s*$', line)
    if not m:
        out.append(line); i+=1; continue
    fname=m.group(1)
    params=[x.strip() for x in m.group(2).split(',') if x.strip()]
    j=i+1
    while j < n and lines[j].rstrip() != 'end':
        j+=1
    body=lines[i+1:j]
    assigned=[]
    for b in body:
        mb=re.match(r'^\s*set ([a-z_0-9]+) to ', b)
        if mb and mb.group(1) not in params and mb.group(1) not in assigned:
            assigned.append(mb.group(1))
    canon={}
    for a in assigned:
        target = a if a.startswith(fname+'_') else fname+'_'+a
        canon[a]=target
        canon[fname+'_'+a]=target
    if canon:
        pat=re.compile(r'\b('+'|'.join(sorted(canon, key=len, reverse=True))+r')\b')
        nb=[]
        for b in body:
            s=pat.sub(lambda mm: canon[mm.group(1)], b)
            if s!=b: changed+=1
            nb.append(s)
        body=nb
    out.append(line); out.extend(body); out.append(lines[j]); i=j+1
open(p,'w').write('\n'.join(out))
print('lines changed', changed)
