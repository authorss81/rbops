import re
p='bootstrap/compiler.rb'
lines=open(p).read().split('\n')
out=[]
i=0
n=len(lines)
renamed=0
while i < n:
    line=lines[i]
    m=re.match(r'^to ([a-z_0-9]+)\((.*)\)\s*$', line)
    if not m:
        out.append(line); i+=1; continue
    fname=m.group(1)
    params=[x.strip() for x in m.group(2).split(',') if x.strip()]
    # find the `end` at column 0
    j=i+1
    while j < n and lines[j].rstrip() != 'end':
        j+=1
    body=lines[i+1:j]
    assigned=[]
    for b in body:
        mb=re.match(r'^\s*set ([a-z_0-9]+) to ', b)
        if mb and mb.group(1) not in params and mb.group(1) not in assigned:
            assigned.append(mb.group(1))
    mapping={}
    for a in assigned:
        new = '%s_%s' % (fname, a)
        if new != a and new not in assigned:
            mapping[a]=new
    if mapping:
        renamed+=len(mapping)
        pat = re.compile(r'\b(' + '|'.join(sorted(mapping, key=len, reverse=True)) + r')\b')
        body=[pat.sub(lambda mm: mapping[mm.group(1)], b) for b in body]
    out.append(line)
    out.extend(body)
    out.append(lines[j])
    i=j+1
open(p,'w').write('\n'.join(out))
print('renamed', renamed)
