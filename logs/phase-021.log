p='bootstrap/compiler.rb'
s=open(p).read()

# 1. a list concatenation helper, placed before the encoding section
anchor = '''// ---------------------------------------------------------------------------
// The encoding
// ---------------------------------------------------------------------------
'''
helper = '''// ---------------------------------------------------------------------------
// The encoding
// ---------------------------------------------------------------------------

// Two byte lists joined. Redblue's `+` adds numbers and joins texts — it does
// not concatenate lists — so the one operation the encoder cannot do without is
// written here, once, in terms of `push`.
to cat(first, second)
    set out to first
    for each byte in second do
        set out to push(out, byte)
    end
    give back out
end
'''
s = s.replace(anchor, helper, 1)

# 2. the encoding itself
old_encode = s[s.index('to encode(chunk)'):s.index('// ---------------------------------------------------------------------------\n// Lexer')]
new_encode = '''to encode(chunk)
    set out to [82, 69, 68, 26]
    set out to cat(out, [5, 0])
    set out to cat(out, u32_le(length(chunk.p)))
    for each entry in chunk.p
        set out to cat(out, [entry.t])
        set out to cat(out, entry.b)
    end
    give back encode_block(out, chunk.main)
end

// One block record, then its children: preorder, which is what
// `write_block_tree` writes — it pops `main` first and pushes each block's
// children in reverse, so they come out first-to-last.
to encode_block(out, block)
    set out to cat(out, [block.k])
    set out to cat(out, u32_le(block.a))
    set out to cat(out, u32_le(length(block.ps)))
    for each param in block.ps
        set out to cat(out, u32_le(length(param)))
        set out to cat(out, param)
    end
    set out to cat(out, u32_le(length(block.n)))
    set out to cat(out, block.n)
    set out to cat(out, u32_le(length(block.code)))
    for each instruction in block.code
        set out to cat(out, [instruction.o])
        set out to cat(out, u32_le(instruction.a))
        set out to cat(out, u32_le(instruction.x))
        set out to cat(out, u32_le(instruction.l))
    end
    set out to cat(out, u32_le(length(block.b)))
    for each child in block.b
        set out to encode_block(out, child)
    end
    give back out
end

'''
s = s.replace(old_encode, new_encode, 1)

s = s.replace('set raw to u32_le(low) + u32_le(high)', 'set raw to cat(u32_le(low), u32_le(high))')
