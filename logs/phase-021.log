    set c to 0
    set result to 0
    set c to src[pos]
    set result to nothing
    if is_space(c) then
        set result to ["skip", pos + 1, 0]
    end
    if type_of(result) is "nothing" then
        if c is 10 or c is 13 then
            set p to pos + 1
            if c is 13 and byte_at(src, pos + 1) is 10 then
                set p to p + 2
            end
            set result to [{k: "nl", l: line}, p, 1]
        end
    end
    if type_of(result) is "nothing" then
        if c is 47 and byte_at(src, pos + 1) is 47 then
            set p to pos
            set at_end to no
            while at_end is no
                if p >= length(src) then
                    set at_end to yes
                else
                    if src[p] is 10 then
                        set at_end to yes
                    else
                        if src[p] is 13 then
                            set at_end to yes
                        else
                            set p to p + 1
                        end
                    end
                end
            end
            set result to ["skip", p, 0]
        end
    end
    if type_of(result) is "nothing" then
        if is_digit(c) or (c is 46 and is_digit(byte_at(src, pos + 1))) then
            set result to lex_number(src, pos, line)
        end
