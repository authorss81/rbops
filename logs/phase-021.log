            TokenKind::LeftParen => {
                self.advance();
                self.enter_nesting()?;
                let expr = self.parse_expression()?;
                self.leave_nesting(1);
                self.expect(&TokenKind::RightParen)?;
                Ok(expr)
            }
            TokenKind::LeftBracket => {
                self.advance();
                let mut items = Vec::new();

                self.enter_nesting()?;
