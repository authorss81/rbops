    if type_of(result) is "nothing" then
        if c is 34 then
            set result to lex_text(src, pos, line)
        end
    end
    if type_of(result) is "nothing" then
        if is_alpha(c) then
            set result to lex_word(src, pos, line)
        end
    end
    if type_of(result) is "nothing" then
        set result to lex_operator(src, pos, line)
    end
