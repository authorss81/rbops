if c == '\n' || c == '\r' {
                let carriage_return = c == '\r';
                lexer.advance();
                if carriage_return && lexer.current() == Some('\n') {
                    lexer.advance();
                }
                tokens.push(Token::new(TokenKind::Newline, line, column));
