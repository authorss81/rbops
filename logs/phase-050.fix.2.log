+// `stdlib::MODULE_MEMBERS` is the whole of a stdlib module's
+// surface, and it is asked first: a `<module>_<member>` entry in
+// the registry is only reachable through the spelling the table
+// holds, so `files_read` being registered is not on its own a
+// reason `files.read` answers. Without this, a builtin added to
+// the registry under a stdlib module's prefix would answer a
+// dotted call no document gives and no gate walks.
+//
+// A module the program declared is a different thing and keeps
+// the rule below: its members are the ones `module … end`
+// published, and `stdlib::is_module` says nothing about those.
+if stdlib::is_module(&module) && !stdlib::module_has_member(&module, method) {
+    return Err(Error::Runtime(
+        format!("Module '{module}' has no function '{method}'"),
+        self.span(),
+    ));
+}
