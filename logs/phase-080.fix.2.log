+                | TokenKind::YesNo(_)
+                | TokenKind::Nothing
+                | TokenKind::Identifier(_)
+                | TokenKind::LeftParen
+                | TokenKind::LeftBracket
+                | TokenKind::LeftBrace
+                | TokenKind::Not
+                | TokenKind::Minus
+                | TokenKind::To
