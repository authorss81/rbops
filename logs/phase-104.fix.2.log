/// Decodes strict hexadecimal, naming the first character that is not a digit
/// and the position of an unpaired final digit.
///
/// The `hex` crate would silently stop at a bad character if asked to decode a
/// slice it considered short enough; validating first is what keeps a decoder
/// from turning corrupt input into a shorter byte list.
fn decode_hex(span: Span, text: &str) -> Result<Vec<u8>> {
    let mut digits = 0usize;
    for (position, character) in text.chars().enumerate() {
        if !character.is_ascii_hexdigit() {
            return Err(Error::Runtime(
                format!("hex.decode: invalid hex digit '{character}' at position {position}"),
                span,
            ));
        }
        digits += 1;
    }
    if !digits.is_multiple_of(2) {
        return Err(Error::Runtime(
            format!(
                "hex.decode: odd number of hex digits ({digits}); the last digit at \
                 position {} has no pair, so the input ends at position {digits}",
                digits - 1
            ),
            span,
        ));
    }
    hex::decode(text).map_err(|error| Error::Runtime(format!("hex.decode: {error}"), span))
}

/// The character the original text holds at the byte position a decoder
/// reported, falling back to the raw byte only if that position is not a
/// character boundary. A non-ASCII character must be named as the program wrote
/// it, not as the first byte read through Latin-1.
fn offending_char(text: &str, position: usize, byte: u8) -> char {
    text.get(position..)
        .and_then(|rest| rest.chars().next())
        .unwrap_or(char::from(byte))
}

/// Decodes strict base64 in every padding form a transport sends, naming the
/// position of the byte that made it refuse.
fn decode_base64(span: Span, text: &str) -> Result<Vec<u8>> {
    BASE64_ANY_PADDING.decode(text).map_err(|error| {
        use base64::DecodeError::{InvalidByte, InvalidLastSymbol, InvalidLength, InvalidPadding};
        let message = match error {
            InvalidByte(position, byte) => format!(
                "base64.decode: invalid byte '{}' at position {position}",
                offending_char(text, position, byte)
            ),
            InvalidLastSymbol(position, byte) => format!(
                "base64.decode: invalid final symbol '{}' at position {position}",
                offending_char(text, position, byte)
            ),
            InvalidLength => format!(
                "base64.decode: incomplete base64 group ending at position {}",
                text.len()
            ),
            InvalidPadding => format!(
                "base64.decode: invalid padding at position {}",
                text.rfind('=').unwrap_or(text.len())
            ),
        };
        Error::Runtime(message, span)
    })
}

/// Every function that is not a user-defined one, in the one place both VMs
/// reach for.
///
/// `Ok(None)` says the name is not a builtin, which is how the caller knows to
/// look for a user declaration. This lives here rather than in either VM so
/// that a bytecode `CALL` and a tree-walked call cannot drift apart: there is
/// one implementation and both answer from it.
pub fn builtin(span: Span, name: &str, args: &[Value]) -> Result<Option<Value>> {
    match name {
        "say" => {
            if let Some(arg) = args.first() {
                // Through the one boundary every program's bytes leave by, as
                // `say` the statement does. A `println!` here would put
                // `say("hi")` on stdout while `say "hi"` went to the playground's
                // capture, and the byte-identical promise is exactly that the two
                // spellings of the same thing print the same thing.
                crate::wasm::emit(&format!("{}\n", arg));
                Ok(Some(Value::Nothing))
            } else {
                Err(Error::Runtime("say requires an argument".to_string(), span))
            }
        }
        "length" | "len" => {
            if let Some(Value::List(items)) = args.first().cloned() {
                Ok(Some(Value::Number(items.len() as f64)))
            } else if let Some(Value::Text(s)) = args.first().cloned() {
                // Characters, not bytes. `s.len()` is the length of the
                // `String` as UTF-8, so every text outside ASCII answered two,
                // three or four times its real length: `length("日本")` said 6
                // for two characters and `length("é")` said 2 for one. README
                // promises "Text is fully Unicode", so the one measurement a
                // program can make about its own text was wrong for every
                // non-ASCII string and carried a plausible-looking number.
                //
                // A character here is one Unicode scalar value — what Rust's
                // `char` is — not one user-perceived glyph. `e` + U+0301 is two
                // characters and one glyph, and answering 1 would mean
                // segmenting grapheme clusters, which is a different
                // measurement under a different name. A program that wants the
                // bytes writes `length(bytes.from_text(s))`, which answers 6
                // for `"héllo"` because a byte is a byte.
                //
