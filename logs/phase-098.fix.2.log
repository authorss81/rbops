    /// Carries the finished callee's `value` on to the `map` `frame` started.
    fn advance_map(&mut self, frame: usize, value: Value) -> Result<()> {
        let Some(map) = self.frames[frame].pending_map.as_mut() else {
            return Ok(());
        };
