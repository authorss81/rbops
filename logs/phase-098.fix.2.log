+    // two lists equal to ["a"] share a group instead of making separate ones.
+    yields(
+        "groupby([2, 1, 2, 1, 3])",
+        "[{key: 2, items: [2, 2]}, {key: 1, items: [1, 1]}, {key: 3, items: [3]}]",
+    );
+    yields(
+        "groupby([[\"a\"], [\"b\"], [\"a\"]])",
+        "[{key: [a], items: [[a], [a]]}, {key: [b], items: [[b]]}]",
+    );
+}
