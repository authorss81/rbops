#[test]
fn edge_lru_cache_does_not_survive_a_bytecode_run() {
    let mut vm = BytecodeVm::new();
    let first = compile_source(
        "set calls to 0\n\
         lru_cache(10) to f(n)\n\
             set calls to calls + 1\n\
             give back n\n\
         end\n\
         f(1)\n\
         calls",
    )
    .expect("the first program should compile");
    assert_eq!(
        vm.run(&first)
            .expect("the first run should work")
            .to_string(),
        "1"
    );

    let second = compile_source("f(1)\ncalls").expect("the second program should compile");
    assert_eq!(
        vm.run(&second)
            .expect("the second run should work")
            .to_string(),
        "2",
        "a cache from the previous run must not answer this run's call"
    );
}

