                //
                // An ordinary declaration calls the internal clear instead, so a
                // name that was decorated earlier does not keep answering from
                // the old declaration's memory. Both calls carry a NUL, so a
                // program cannot spell either name.
                match cache {
                    Some(capacity) => {
                        let declared = self.text(name);
                        let capacity = self.constant(Constant::Number(*capacity as f64));
                        emit(code, Opcode::PushConst, declared, 0, line);
                        emit(code, Opcode::PushConst, capacity, 0, line);
                        let declare = self.text(crate::stdlib::LRU_CACHE_DECLARE);
