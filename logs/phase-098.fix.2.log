#[test]
fn iteration_helpers_agree_across_both_engines() {
    for source in [
        "chain([1, 2], [3])",
        "zip([1, 2, 3], [4, 5])",
        "enumerate([\"a\", \"b\", \"c\"])",
        "product([1, 2], [3, 4])",
        "groupby([3, 1, 3, 2, 1])",
        "take([1, 2, 3], 2)",
        "skip([1, 2, 3], 1)",
    ] {
        both(source);
    }
}
