            }
            _ => (None, Vec::new()),
        };
'''
new2='''        let value = self.value_answer(code, ".dir", introspect::Wording::Shown)?;

        // An object declaration binds the object's fields as a record, so the
        // name is what says the value is an object: the type table, not the
        // value's own kind, holds its methods. A `Value::Object` is recognised
        // the same way, because the bytecode side can produce one.
        let object_type = match &value {
            Value::Object(name, _) => Some(name.clone()),
            Value::Record(_) => {
                let name = code.trim();
                self.vm
                    .object_type_members(name)
                    .map(|_| name.to_string())
            }
            _ => None,
        };

        let mut lines = vec![format!(
            "kind: {}",
            if object_type.is_some() {
                "object"
            } else {
                value.type_name()
            }
        )];
        if let Some(name) = &object_type {
            lines.push(format!("type: {}", name));
        }
        lines.push(format!("value: {}", value));

        let (fields, methods) = match &value {
            Value::Record(fields) => (
                Some(fields.clone()),
                object_type
                    .as_deref()
                    .and_then(|name| self.vm.object_type_members(name))
                    .map(|(_, methods)| methods)
                    .unwrap_or_default(),
            ),
            Value::Object(name, fields) => {
                let methods = self
                    .vm
                    .object_type_members(name)
                    .map(|(_, methods)| methods)
                    .unwrap_or_default();
                (Some(fields.clone()), methods)
            }
            _ => (None, Vec::new()),
        };
'''
assert old2 in s
s=s.replace(old2,new2,1)
p.write_text(s)
