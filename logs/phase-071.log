///
/// [`expression_of`] with the command's own name in the refusal, so a user who
/// typed `.pretty` is not told about `:type` — the same rule, told to the
/// person who has to read it.
pub fn expression_of_for<'a>(
    program: &'a Program,
    command: &str,
    wording: Wording,
) -> Result<&'a Expr, String> {
    match program.statements.as_slice() {
        [Stmt {
            statement: Statement::Expr(expr),
            ..
        }] => Ok(expr),
        [Stmt { statement, .. }] => Err(format!(
            "Error: {command} is a question about a value, and `{}` is a statement. \
             Type the expression you want {}, or run the statement as a line.",
            statement_keyword(statement),
            wording.participle(),
        )),
        [] => Err(format!(
            "Error: {command} was given nothing to {}. Type the expression you want {}.",
            wording.infinitive(),
            wording.participle(),
        )),
        statements => Err(format!(
            "Error: {command} is a question about one value, and this is {} statement(s). \
             Type the expression you want {}, or run the lines as a program.",
            statements.len(),
            wording.participle(),
        )),
    }
}

/// The keyword a statement is written with, for a refusal that names it.
///
/// `:type` never runs a statement, so the refusal is the only time the user
/// hears what they handed over; "not an expression" without the word they typed
/// is a worse answer than "that is a `set`".
fn statement_keyword(statement: &Statement) -> &'static str {
    match statement {
        Statement::Say(_) => "say",
        Statement::Expr(_) => "an expression",
        Statement::Print(_) => "print",
        Statement::Set { .. } => "set",
        Statement::Constant { .. } => "constant",
        Statement::SetProperty { .. } => "set",
        Statement::If { .. } => "if",
        Statement::Unless { .. } => "unless",
        Statement::ForEach { .. } | Statement::ForRange { .. } => "for each",
        Statement::Repeat { .. } | Statement::RepeatUntil { .. } => "repeat",
        Statement::While { .. } => "while",
        Statement::Break => "break",
        Statement::Skip => "skip",
        Statement::Return(_) => "return",
        Statement::GiveBack(_) => "give back",
        Statement::Function { .. } => "to",
        Statement::Method { .. } => "to",
        Statement::Has { .. } => "has",
        Statement::Object { .. } => "object",
        Statement::Try { .. } => "try",
        Statement::Test { .. } => "test",
        Statement::Import(_) => "import",
        Statement::Module { .. } => "module",
        Statement::Export { .. } => "export",
    }
}

