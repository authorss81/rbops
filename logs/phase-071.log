        }
        lines.push(format!("value: {}", value));

        let (fields, methods) = match &value {
            Value::Record(fields) => (Some(fields.clone()), Vec::new()),
            Value::Object(name, fields) => {
                let methods = self
                    .vm
                    .object_type_members(name)
