    /// One line of a macro, dispatched exactly as a typed line would be.
    fn replay_macro_line(&mut self, line: &str) {
        let input = line.trim();
        if input.is_empty() {
            return;
        }
        // The trimmed form answers "is there a line" and "is it an alias"; the
        // dispatched command keeps the trailing whitespace the recording kept,
        // for the one command whose argument is display text (`:prompt rb> `).
        let typed = line.trim_start();
        let alias_target = match self.expand_alias_line(typed) {
            Ok(target) => target,
            Err(message) => {
                println!("{}", self.style.paint(Paint::Error, &message));
                return;
            }
        };
        let command_line = alias_target.as_deref().unwrap_or(typed);
        if self.handle_command(command_line) {
            return;
        }
        self.execute_line(line);
    }

    /// Runs one command line, returning whether `input` was a command rather
    /// than Redblue source.
    ///
    /// The command table lives in [`ReplCommand::parse`]; this only dispatches
    /// what it produced. Two copies of the table meant an alias added to one was
    /// invisible to the other.
    fn handle_command(&mut self, input: &str) -> bool {
        match ReplCommand::parse(input) {
            ReplCommand::Quit => {
                self.running = false;
                true
            }
            ReplCommand::Help => {
                self.print_help();
                true
            }
            ReplCommand::Clear => {
                print!("\x1B[2J\x1B[H");
                let _ = io::stdout().flush();
                true
            }
            ReplCommand::History => {
                for i in 0..self.history.len() {
                    if let Some(entry) = self.history.get(i) {
                        println!("  {:4}  {}", i + 1, entry);
                    }
                }
                true
            }
            ReplCommand::Vars => {
                self.print_variables();
                true
            }
            ReplCommand::Functions => {
                self.print_functions();
                true
            }
            ReplCommand::Shell(command) => {
                self.run_shell(&command);
                true
            }
            ReplCommand::Pipe(command) => {
                match self.pipe_last(&command) {
                    Ok(outcome) => self.print_shell_outcome(&outcome),
                    Err(message) => println!("{}", self.style.paint(Paint::Error, &message)),
                }
                true
            }
            ReplCommand::ChangeDir(path) => {
                match self.change_directory(&path) {
                    Ok(()) => println!("{}", self.session_directory().display()),
                    Err(message) => println!("{}", self.style.paint(Paint::Error, &message)),
                }
                true
            }
            ReplCommand::PrintWorkingDirectory => {
                println!("{}", self.session_directory().display());
                true
            }
            ReplCommand::ListDirectory => {
                self.print_session_listing();
                true
            }
            ReplCommand::Load(path) => {
                self.load_file(&path);
                true
            }
            ReplCommand::Save(path) => {
                self.save_session(&path);
                true
            }
            ReplCommand::Restore(path) => {
                // The one word with two destinations: the dot spelling is the
                // in-memory checkpoint, the colon spelling is the saved file.
                // The help text states that split once, and dispatch is the
                // only place that has to know it.
                if input.trim_start().starts_with(commands::ALT_SIGIL) {
                    match self.restore_checkpoint(&path) {
                        Ok(()) => println!("Restored checkpoint '{}'.", path.trim()),
                        Err(message) => {
                            println!("{}", self.style.paint(Paint::Error, &message))
                        }
                    }
                } else {
                    self.restore_session(&path);
                }
                true
            }
            ReplCommand::Checkpoint(name) => {
                match self.create_checkpoint(&name) {
                    Ok(()) => println!("Checkpoint '{}' saved.", name.trim()),
                    Err(message) => println!("{}", self.style.paint(Paint::Error, &message)),
                }
                true
            }
            ReplCommand::Sessions => {
                println!("{}", self.checkpoint_listing());
                true
            }
            ReplCommand::Undo => {
                match self.undo_binding() {
                    Ok(()) => println!("Undid one change."),
                    Err(message) => println!("{}", self.style.paint(Paint::Error, &message)),
                }
                true
            }
            ReplCommand::Redo => {
                match self.redo_binding() {
                    Ok(()) => println!("Redid one change."),
                    Err(message) => println!("{}", self.style.paint(Paint::Error, &message)),
                }
                true
            }
            ReplCommand::Export(path) => {
                self.export_session(path.as_deref());
                true
            }
            ReplCommand::Reset => {
                self.reset_session();
                true
            }
            ReplCommand::Run(path) => {
                self.run_file(&path);
                true
            }
            ReplCommand::Reload => {
                self.reload_file();
                true
            }
            ReplCommand::Format(argument) => {
                self.format_command(argument.as_deref());
                true
