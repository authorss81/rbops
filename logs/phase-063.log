                else { 1 }
            }).sum();
            println!(
                "{name:14} chars={:2} per_char={:2} unicode_width={:2} char_width={:?}",
                text.chars().count(),
                per_char,
                unicode_width::UnicodeWidthStr::width(text),
                text.chars().map(unicode_width::UnicodeWidthChar::width).collect::<Vec<_>>()
            );
        }
    }
}
