  printf '\033[31m║ PREFLIGHT FAIL   — %-19s ║\033[0m\n' "$PHASE"
  printf '\033[31m║ %d diff-based check(s) failed         ║\033[0m\n' "$FAIL"
  printf '\033[31m╚══════════════════════════════════════╝\033[0m\n'
  exit 3
fi
