    fn probe_widths() {
        for (name, text) in [
            ("star", "\u{2b50}"),
            ("sparkles", "\u{2728}"),
            ("check", "\u{2705}"),
            ("mahjong", "\u{1f004}"),
            ("joker", "\u{1f0cf}"),
            ("heart", "\u{2764}"),
            ("heart-vs16", "\u{2764}\u{fe0f}"),
            ("watch", "\u{231a}"),
            ("flag", "\u{1f1ef}\u{1f15f}"),
            ("family", "\u{1f468}\u{200d}\u{1f469}\u{200d}\u{1f467}"),
            ("thumbs", "\u{1f44d}"),
            ("thumbs-tone", "\u{1f44d}\u{1f3fb}"),
            ("party", "\u{1f389}"),
            ("cjk", "\u{65e5}\u{672c}"),
            ("combining", "a\u{301}"),
            ("ascii", "ada"),
        ] {
            let per_char: usize = text.chars().map(|c| {
                if c.is_control() { 0 } else if matches!(c as u32, 0x1100..=0x115F | 0x2E80..=0x303E | 0x3041..=0x33FF | 0x3400..=0x4DBF | 0x4E00..=0x9FFF | 0xA000..=0xA4CF | 0xA960..=0xA97F | 0xAC00..=0xD7A3 | 0xF900..=0xFAFF | 0xFE10..=0xFE19 | 0xFE30..=0xFE6F | 0xFF00..=0xFF60 | 0xFFE0..=0xFFE6 | 0x1F300..=0x1F64F | 0x1F680..=0x1F6FF | 0x1F900..=0x1F9FF | 0x20000..=0x2FFFD | 0x30000..=0x3FFFD) { 2 }
