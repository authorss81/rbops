use redblue::repl::Transcript;

fn main() {
    // 1. leading blank line in a block
    let doc = "# Redblue session\n\n```redblue\n\nsay \"one\"\nsay \"two\"\n```\none\ntwo\n\n";
    println!("1) {:?}", Transcript::read_markdown(doc));

    // 2. output fenced, then next exchange
    let mut t = Transcript::new();
    t.record("say \"```redblue\"".into(), vec!["```redblue".into()]);
    t.record("say \"x\"".into(), vec!["x".into()]);
    let d = t.markdown();
    println!("2 doc:\n{}\n2) {:?}", d, Transcript::read_markdown(&d));

    // 3. output line that is only whitespace-indented fence
    let mut t = Transcript::new();
    t.record("say \"a\"".into(), vec!["   ```redblue".into()]);
    t.record("say \"b\"".into(), vec!["b".into()]);
    let d = t.markdown();
    println!("3 doc:\n{}\n3) {:?}", d, Transcript::read_markdown(&d));

    // 4. output line ending with the closing fence width? try weird
    let mut t = Transcript::new();
    t.record("set q to \"````\"".into(), vec!["x".into()]);
    let d = t.markdown();
    println!("4 doc:\n{}\n4) {:?}", d, Transcript::read_markdown(&d));

    // 5. output with a fence AND trailing content
    let mut t = Transcript::new();
    t.record("say 1".into(), vec!["ok".into(), "```text".into(), "body".into()]);
    t.record("say 2".into(), vec!["2".into()]);
    let d = t.markdown();
    println!("5 doc:\n{}\n5) {:?}", d, Transcript::read_markdown(&d));
}
