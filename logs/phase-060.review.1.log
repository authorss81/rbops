+    let inputs = redblue::repl::Transcript::read_markdown(&document);
+    assert_eq!(
+        inputs,
+        vec![
+            "set q to \"```redblue\"".to_string(),
+            "say q".to_string(),
+            "say \"after\"".to_string(),
