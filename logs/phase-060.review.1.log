+    fn a_path_is_offered_only_in_the_argument_of_a_command_that_takes_one() {
+        for (line, pos, expected) in [
+            (":load s", 7, Some(6)),
+            (".save sr", 7, Some(6)),
+            (":run s", 6, Some(5)),
+            (":restore s", 10, Some(9)),
+            (":l s", 4, Some(3)),
+            (":load", 5, None),
+            (":loadx s", 8, None),
+            ("::load s", 8, None),
+            ("load s", 6, None),
+            ("say s", 5, None),
+            ("say \"s", 6, None),
+            ("", 0, None),
+        ] {
+            assert_eq!(
+                path_argument(line, pos).map(|(start, _)| start),
+                expected,
+                "{line:?} at {pos} is {} a path argument",
