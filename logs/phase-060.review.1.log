    // now walk into the quoted directory, as the completer itself writes it
    println!("offer for '\"my dir/': {:?}", complete_path_in(dir, "\"my dir/"));
    // and what the line looks like after accepting
    let line = ":load \"my dir/";
    let (start, frag) = path_argument(line, line.len()).unwrap();
    println!("line {line:?} -> start={start} fragment={frag:?}");
    println!("walk-in candidates: {:?}", complete_path_in(dir, frag));
    // unquoted, typed by hand
    println!("offer for 'my dir/': {:?}", complete_path_in(dir, "my dir/"));
}
