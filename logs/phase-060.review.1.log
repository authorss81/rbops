+    fn stripping_a_painted_string_gives_the_text_back() {
+        for role in [
+            Paint::Prompt,
+            Paint::Heading,
+            Paint::Result,
+            Paint::Error,
+            Paint::Dim,
+            Paint::BrandRed,
+            Paint::BrandBlue,
+            Paint::BrandMid,
+            Paint::Keyword,
+            Paint::Str,
+            Paint::Number,
+            Paint::Comment,
+            Paint::Builtin,
+            Paint::Operator,
+        ] {
+            assert_eq!(
+                strip_escapes(&painted(role, "hello")),
