use redblue::repl::Transcript;

fn rt(inputs: &[&str]) -> bool {
    let mut t = Transcript::new();
    for i in inputs {
        t.record((*i).to_string(), vec![format!("out for {i}")]);
    }
    let d = t.markdown();
    let back = Transcript::read_markdown(&d);
    let want: Vec<String> = inputs.iter().map(|s| s.to_string()).collect();
    if back != want {
        println!("MISMATCH inputs={inputs:?}\n--- doc ---\n{d}\n--- back ---\n{back:?}\n");
        false
    } else { true }
}

fn rt_out(inputs: &[(&str, &[&str])]) -> bool {
    let mut t = Transcript::new();
    for (i, o) in inputs {
        t.record((*i).to_string(), o.iter().map(|s| s.to_string()).collect());
    }
    let d = t.markdown();
    let back = Transcript::read_markdown(&d);
    let want: Vec<String> = inputs.iter().map(|(i, _)| (*i).to_string()).collect();
    if back != want {
        println!("MISMATCH inputs={inputs:?}\n--- doc ---\n{d}\n--- back ---\n{back:?}\n");
        false
    } else { true }
}

fn main() {
    let ticks = ["", "`", "``", "```", "````", "`````", "redblue", "text", "  ", "x"];
    // build inputs from every combination of a tick-run and a suffix
    let mut cases: Vec<String> = Vec::new();
    for t in ticks {
        for suf in ["", "redblue", "text", "x", " x"] {
            cases.push(format!("say \"{t}{suf}\""));
        }
    }
    cases.push("\nsay \"leading blank\"".into());
    cases.push("say 1\n\nsay 2".into());
    cases.push("".into());
    cases.push("\n".into());
    let mut bad = 0;
    for c in &cases {
        if !rt(&[c.as_str()]) { bad += 1; }
    }
    // pairs
    for a in &cases {
        for b in &cases {
            if !rt(&[a.as_str(), b.as_str()]) { bad += 1; }
        }
    }
    println!("input round trip mismatches: {bad}");

    // output-driven: output line that opens a fence
    let outs: Vec<Vec<&str>> = vec![
        vec!["```redblue"], vec!["````"], vec!["```"], vec!["```text"], vec!["```rust"],
        vec!["  ```redblue"], vec!["ok", "```", "fine"], vec!["`````text"],
        vec!["```redblue"], vec!["```rust"], vec!["```"], vec!["`````"],
        vec![], vec![""], vec!["a\n```b"], vec!["\n```redblue"],
    ];
    let mut bad2 = 0;
    for o in &outs {
        let inp: Vec<(&str, &[&str])> = vec![("say 1", &o[..]), ("say 2", &[]), ("say 3", &["z"])];
        if !rt_out(&inp) { bad2 += 1; }
    }
    println!("output round trip mismatches: {bad2}");
}
EOF
