+    second.assert_exited_ok();
+    assert_eq!(
+        second.count_stdout("after"),
+        1,
+        "the line written after the fence runs once in a fresh session, as it did \
+         before it was exported\n--- actual ---\n{}",
+        second.stdout
+    );
