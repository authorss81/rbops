        let name = read_u16(central, at + 28).unwrap_or(0) as usize;
        let extra = read_u16(central, at + 30).unwrap_or(0) as usize;
        let comment = read_u16(central, at + 32).unwrap_or(0) as usize;
        at += 46 + name + extra + comment;
        count += 1;
    }
    count
}

