use redblue::lexer::Lexer;
use redblue::parser::parse;

fn try_depth(d: usize) -> bool {
    let src = format!("set x to {}1{}\n", "[".repeat(d), "]".repeat(d));
    let tokens = match Lexer::tokenize(&src) { Ok(t) => t, Err(_) => return false };
    match parse(tokens) { Ok(p) => { std::mem::forget(p); true }, Err(_) => true }
}

#[test]
fn probe() {
    let h = std::thread::spawn(|| {
        let mut ok = 0;
        for d in 1..=400 { if try_depth(d) { ok = d } else { break } }
        ok
    });
    println!("MAX SAFE DEPTH = {}", h.join().unwrap());
}
EOF
