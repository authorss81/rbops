+    assert_eq!(cli_field(&parsed, "help"), &Value::YesNo(false));
+    let usage = cli_field(&parsed, "usage").to_string();
+    assert!(
+        usage.contains("Options:") && usage.contains("--help, -h"),
+        "usage should still describe help, got {usage:?}"
+    );
+}
