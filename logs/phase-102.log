// Cli - declared command-line flags for a Redblue program.
//
//   import Cli
//
//   set options to [{name: "output", type: "text", default: "out.txt"}, {name: "count", type: "number", required: yes}, {name: "verbose", type: "yes/no"}]
//
//   Cli.run(options) with parsed
//       say parsed.output
//   end
//
// `--help` (or `-h`) prints the usage text generated from the declaration and
// does not call the body. `run_with` takes the argument list explicitly, which
// is what tests use and what a caller with arguments from somewhere other than
// `sys.argv()` needs.

module Cli
    to run(declaration, body)
        set parsed to sys.parse(declaration)
        if parsed.help is yes then
            say parsed.usage
        else
            body(parsed)
        end
        give back nothing
    end

    to run_with(declaration, body, arguments)
        set parsed to sys.parse(declaration, arguments)
        if parsed.help is yes then
            say parsed.usage
        else
            body(parsed)
        end
        give back nothing
    end

    export all
end
            // Not every byte list is text, and the failure names the byte
            // rather than reporting a replacement character three files later.
            match String::from_utf8(out) {
                Ok(text) => Ok(Some(Value::Text(text))),
                Err(e) => Err(Error::Runtime(
                    format!("bytes.text was given bytes that are not text: {e}"),
                    span,
                )),
            }
        }
        "sys_argv" => Ok(Some(Value::list(
            program_args()
                .iter()
                .map(|argument| Value::Text(argument.clone()))
                .collect(),
        ))),
        "sys_parse" => {
            let Some(declaration) = args.first() else {
                return Err(Error::Runtime(
                    "sys.parse requires a list of flag declarations".to_string(),
                    span,
                ));
            };
            let arguments = match args.get(1) {
                None => program_args(),
                Some(Value::List(items)) => {
                    let mut arguments = Vec::with_capacity(items.len());
                    for (index, item) in items.iter().enumerate() {
                        match item {
                            Value::Text(text) => arguments.push(text.clone()),
                            other => {
                                return Err(Error::Runtime(
                                    format!(
                                    "sys.parse expects a list of text arguments, but item {} is {}",
                                    index + 1,
                                    other.type_name()
                                ),
                                    span,
                                ))
                            }
                        }
                    }
                    arguments
                }
                Some(other) => {
                    return Err(Error::Runtime(
                        format!(
                            "sys.parse expects its arguments as a list of text, but was given {}",
                            other.type_name()
                        ),
                        span,
                    ))
                }
            };
            Ok(Some(crate::cli::parse(declaration, &arguments, span)?))
        }
        _ => Ok(None),
    }
}

/// The arguments after the program path, for `sys.argv()`.
///
/// The CLI sets them when it runs a file and nothing else does, so a program run
/// from the REPL or from a test sees an empty list rather than the arguments of
/// whatever process happens to be running.
fn program_args() -> Vec<String> {
    PROGRAM_ARGS
        .lock()
        .map(|args| args.clone())
        .unwrap_or_default()
}
        ))
    }
}

/// Whether `name` is a builtin this crate can answer, used to tell a missing
/// builtin from a missing user function.
pub fn is_builtin(name: &str) -> bool {
    BUILTIN_NAMES.contains(&name)
}

/// Whether `name` is an internal builtin whose only spelling is as a member of a
/// module.
///
/// The phase-101 text utilities and `sys.parse` are stored under
/// `<module>_<member>` because that is the name a dotted call resolves to, but
/// they are not part of the flat builtin surface: `text.wrap` and `sys.parse`
/// answer and a bare `text_wrap` or `sys_parse` does not. They are deliberately
/// absent from [`BUILTIN_NAMES`] and [`builtins`], so `is_builtin` does not
/// advertise them and the analyzer, REPL completer, highlighter and
/// introspection never offer a name a program cannot call. A program that wants
/// a flat text helper keeps writing `wrap`, which remains an ordinary name it
/// may declare. Both engines refuse the bare spelling unless the program has
/// declared that name itself, so this cannot depend on which one ran the
/// program.
pub fn is_module_only_builtin(name: &str) -> bool {
    matches!(
        name,
        "text_wrap"
            | "text_diff"
            | "text_dedent"
            | "text_template"
            | "text_pad"
            | "text_align"
            | "sys_parse"
    )
}

/// Resolves `module.member` to the builtin name behind it.
///
/// The internal encoding of a module function is `module_member` — that is what
/// `qualified_member` builds and what the global table registers, which is why
/// `json.parse` is stored as `json_parse`. The *documented* modules are spelled
/// differently from the ones this table was grown from: `text.uppercase` is
/// stored as nothing, so the dotted spelling reached the VM and found nothing.
///
/// This only unwraps a name the table does **not** already hold. That
/// qualification is load-bearing: `files.append` is registered as
/// `files_append`, and unwrapping it to the bare `append` sent a working
/// two-argument call to a builtin that needs a binding to write through, so
/// `files.append(path, "a")` was refused as arguments it cannot use. A name
/// the table holds is already the right name.
