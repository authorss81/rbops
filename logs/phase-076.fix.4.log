    )
    .expect("fixture file");

    let ran = run_in(&root, &["test", "broken.rb"]);
    assert!(
        !ran.status.success(),
        "a file that does not parse must fail: {}{}",
        stdout(&ran),
        stderr(&ran)
    );
    let output = format!("{}{}", stdout(&ran), stderr(&ran));
    assert!(
        output.contains("broken.rb:2"),
