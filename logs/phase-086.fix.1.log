/// No parameters at all — written both ways the grammar allows, `to ()` and a
/// bare `to`, and each called through its own name.
#[test]
fn edge_a_literal_needs_no_parameters() {
    assert_yields(
        "
        set answer to to ()
            give back 42
        end
        set bare to to give back 7
        give back answer() + bare()
        ",
        "49",
    );
}

