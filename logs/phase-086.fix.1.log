/// One fenced `redblue` block, with the position a reader would jump to.
#[derive(Clone, Debug, PartialEq, Eq)]
struct Block {
    doc: String,
    /// 1-based line of the opening fence.
    line: usize,
    body: String,
    /// False when the document ends before the closing fence.
