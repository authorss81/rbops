/// The items a deque holds, from left to right.
///
/// `front` pops from the left and `back` pops from the right, so the logical
/// order is the front's pop order followed by the reverse of the back's. Both
/// walks validate the trees they touch, which means a malformed value answers
/// `None` rather than an order it does not have. Equality and the key hash both
/// use this one definition, so a deque cannot compare equal to another with a
/// different hash.
pub(crate) fn deque_logical_items(value: &Value) -> Option<Vec<Value>> {
    let span = Span::new(1, 1);
    let (front, back) = deque_parts(span, value).ok()?;
    let mut items = stack_pop_order(span, &front).ok()?;
    let mut back_items = stack_pop_order(span, &back).ok()?;
    back_items.reverse();
    items.extend(back_items);
    Some(items)
}

/// Whether two well-formed deques hold the same items in the same order.
///
/// `None` means at least one side is not a well-formed deque, which lets the
/// caller keep the ordinary structural comparison for a value that only looks
/// like a deque.
pub(crate) fn deques_equal(left: &Value, right: &Value) -> Option<bool> {
    Some(deque_logical_items(left)? == deque_logical_items(right)?)
}

