    /// `5 % 0` and `1e308 * 1e308` are `Runtime` errors rather than values
    /// that print as `not a number` and compare false against everything.
    pub fn number(n: f64, span: Span) -> Result<Value> {
        finite_number(n, span).map(Value::Number)
    }

