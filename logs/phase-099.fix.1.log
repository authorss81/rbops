        "value made by collections.deque",
    );
    both_refuse(
        "say collections.pop_left(collections.namedtuple([\"kind\", \"front\"], [\"deque\", []]))",
        "value made by collections.deque",
    );
    both_refuse(
        "say collections.pop_left(collections.namedtuple([\"kind\", \"front\", \"back\"], [\"deque\", 1, []]))",
        "value made by collections.deque",
    );
    both_refuse(
