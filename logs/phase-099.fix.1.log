SSHKEY="$HOME/.ssh/rbops_redblue"

          if [ -n "${REDBLUE_DEPLOY_KEY:-}" ]; then
            mkdir -p "$HOME/.ssh"; chmod 700 "$HOME/.ssh"
            # The secret holds base64 (single line, newline-immune); older
            # rotations stored raw PEM, which is still accepted.
            if printf '%s' "$REDBLUE_DEPLOY_KEY" | grep -q 'BEGIN OPENSSH PRIVATE KEY'; then
              printf '%s' "$REDBLUE_DEPLOY_KEY" > "$SSHKEY"
            else
              printf '%s' "$REDBLUE_DEPLOY_KEY" | base64 -d > "$SSHKEY" \
                || { echo "::error::REDBLUE_DEPLOY_KEY is neither PEM nor base64"; exit 1; }
            fi
            chmod 600 "$SSHKEY"
            # Safe diagnostics, always printed: byte count and the PUBLIC
            # fingerprint. Neither leaks the key, and together they settle any
            # "server rejected the key" question in one glance — compare with
            # the fingerprint printed by rbops/setup-deploy-key.ps1.
            echo "key bytes: $(wc -c < "$SSHKEY")"
            ssh-keygen -lf "$SSHKEY" 2>&1 || echo "::error::key file is not a valid private key"
            ssh-keyscan -t ed25519 github.com > "$HOME/.ssh/known_hosts_rbops" 2>/dev/null
            if ! grep -q 'github.com ssh-ed25519' "$HOME/.ssh/known_hosts_rbops"; then
              echo "::error::ssh-keyscan returned no host key — cannot trust github.com"
              exit 1
            fi
            SSHOPTS="ssh -i $SSHKEY -o IdentitiesOnly=yes -o UserKnownHostsFile=$HOME/.ssh/known_hosts_rbops -o StrictHostKeyChecking=yes"
            echo "GIT_SSH_COMMAND=$SSHOPTS" >> "$GITHUB_ENV"
            export GIT_SSH_COMMAND="$SSHOPTS"
            git clone --depth 50 "git@github.com:${OWNER}/redblue.git" redblue
            echo "::notice::cloned over SSH (deploy key)"
          elif [ -n "${REDBLUE_TOKEN:-}" ]; then
            git clone --depth 50 "https://github.com/${OWNER}/redblue.git" redblue
            git -C redblue remote set-url origin \
              "https://x-access-token:${REDBLUE_TOKEN}@github.com/${OWNER}/redblue.git"
            echo "::notice::cloned over HTTPS (PAT)"
          else
            git clone --depth 50 "https://github.com/${OWNER}/redblue.git" redblue
            echo "::warning::no REDBLUE_DEPLOY_KEY or REDBLUE_TOKEN — the clone can read but NOT push."
            echo "::warning::phase work will be captured as work-<phase>.patch but not pushed."
          fi
          git -C redblue config user.name  "rbops-bot"
          git -C redblue config user.email "rbops-bot@users.noreply.github.com"

          # THE CRITICAL PATH SETTING. dispatch.sh keeps its state in the rbops
          # repo but the agent must edit redblue. Without this the agent runs in
          # the rbops checkout, cannot find src/testing/harness.rs, burns its
          # whole budget searching, and its output is discarded.
          echo "RBOPS_PROJECT_DIR=$PWD/redblue" >> "$GITHUB_ENV"

          # Prove write access now, and SHOW git's actual stderr.
          #
          # `probe="$(cmd)"` inherits cmd's exit status, so under `bash -e` a
          # failed push aborts the step on the assignment and the stderr never
          # reaches the log. Hence `|| prc=$?`: capture the code first, then the
          # output, and never let a failed probe kill the run.
          prc=0
          probe="$(git -C redblue push --dry-run origin HEAD:main 2>&1)" || prc=$?
          printf '%s\n' "$probe" | sed 's/^/    /'
          if [ "$prc" -eq 0 ]; then
            echo "::notice::redblue push access verified"
          else
            echo "::warning::redblue push NOT available (exit $prc) — work is captured as an artifact, not pushed"
          fi
          exit 0

      - name: Fetch resume branches (WIP checkpoints + recovery)
        continue-on-error: true
        run: |
          git -C redblue fetch origin "+refs/heads/rbops-wip/*:refs/remotes/origin/rbops-wip/*" \
            || echo "::notice::no WIP checkpoints to resume"
          # Gate-failed attempts park their tree on rbops-recovery/<phase> so a
          # retry builds on prior work instead of re-rolling from zero.
          git -C redblue fetch origin "+refs/heads/rbops-recovery/*:refs/remotes/origin/rbops-recovery/*" \
            || echo "::notice::no recovery branches to resume"

      # Warm the build so the phase's own gate is fast.
      - name: Warm cargo cache
        working-directory: redblue
        run: cargo build --all-targets

      - name: Dispatch
        id: d
          # still working, so lengthening the budget buys completed phases rather
          # than burning hours on dead ones. The genuinely-dead case is already
          # bounded twice - the model chain advances without consuming a phase
          # attempt, and the progress watchdog ends an attempt that has written
          # nothing at 70% of this budget.
          #
          # The job timeout is 300 minutes and is the real outer cap, so this
          # cannot run unbounded: one 180m call plus gate and review fits inside
          # 300m with room for one more short call.
          RBOPS_MODEL_TIMEOUT: 10800
          # A model killed before it could have started fixing did no work, and
          # the next model in the chain is dispatched instead. 45 minutes is the
          # floor: long enough to read the finding and start editing, short
          # enough that a model which is going to die has usually died first.
          # Two models in a row doing this blocks the phase for a human.
          RBOPS_NO_WORK_SECONDS: 2700
          # 4 review rounds, not 3. The evidence: 015, 020 and 033 each burned
          # all 3 rounds on genuine, *different* blockers per round — never the
          # same finding twice. Cutting at 3 blocked converging work, not loops.
          # Cost of the 4th round when it fires: one more fix pass (~40 min
          # worst case). Non-convergence is still caught by the fix-pass
          # verification (a pass that touches nothing blocks immediately).
          RBOPS_MAX_REVIEW_ROUNDS: 4
        run: |
          set -uo pipefail
          PHASE="${RBOPS_PHASE}"
          # Promote to GITHUB_ENV: the commit, state-push and report steps all
          # reference RBOPS_PHASE, and under `set -u` an unset variable aborts
          # the step. It was step-scoped to this one and killed Report status.
          echo "RBOPS_PHASE=$PHASE" >> "$GITHUB_ENV"
          # Refuse to run rather than silently point the agent at the wrong tree.
          if [ ! -d "${RBOPS_PROJECT_DIR:-.}/.git" ] && [ ! -f "${RBOPS_PROJECT_DIR:-.}/Cargo.toml" ]; then
            echo "::error::RBOPS_PROJECT_DIR='${RBOPS_PROJECT_DIR:-unset}' is not the redblue checkout"
            echo "progress=false" >> "$GITHUB_OUTPUT"
            echo "rc=2" >> "$GITHUB_OUTPUT"
            exit 0
          fi
          if [ "${{ needs.select.outputs.action }}" = "audit" ]; then
            bash rbops/dispatch.sh audit; rc=$?
          else
            bash rbops/dispatch.sh run "$PHASE" || rc=$?
            rc=${rc:-0}
            if [ "$rc" = "0" ]; then
              bash rbops/dispatch.sh review "$PHASE" || rc=$?
            fi
          fi
          echo "rc=$rc" >> "$GITHUB_OUTPUT"
          # Only a clean run counts as progress. A deferred phase is retried by
          # the cron safety net instead, so a dead model chain cannot spawn an
          # unbounded queue of runs that all hit the same wall.
          if [ "$rc" = "0" ]; then
            echo "progress=true" >> "$GITHUB_OUTPUT"
          else
            echo "progress=false" >> "$GITHUB_OUTPUT"
            echo "::warning::rc=$rc — not chaining; the cron safety net will retry"
          fi

      - name: Preserve and push phase work
        if: always()
        env:
          GIT_NAME: rbops-bot
          GIT_EMAIL: rbops-bot@users.noreply.github.com
          RBOPS_PHASE: ${{ env.RBOPS_PHASE }}
          PROGRESS: ${{ steps.d.outputs.progress }}
        run: |
          set -uo pipefail
          PHASE="${RBOPS_PHASE:-none}"
          cd redblue
          git config user.name "$GIT_NAME"
          git config user.email "$GIT_EMAIL"
