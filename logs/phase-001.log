          git fetch origin "+refs/heads/rbops-wip/*:refs/remotes/origin/rbops-wip/*" || true

      # Warm the build so the phase's own gate is fast.
      - name: Warm cargo cache
        working-directory: redblue
        run: cargo build --all-targets

      - name: Dispatch
        id: d
        env:
          OPENCODE_API_KEY: ${{ secrets.OPENCODE_API_KEY }}
          # Optional. Only needed if you add openrouter/* models to the chains
          # below; the default chains are opencode/* only so a single key is
          # sufficient.
          OPENROUTER_API_KEY: ${{ secrets.OPENROUTER_API_KEY }}
          GITHUB_TOKEN: ${{ github.token }}
          GITHUB_REPOSITORY: ${{ github.repository }}
          RBOPS_PHASE: ${{ needs.select.outputs.phase }}
          RBOPS_RETRIGGER: ${{ inputs.no_retrigger && '0' || '1' }}
          # opencode/* only by default: these are served by the OpenCode Zen key.
          # A dead model advances the chain without consuming a phase attempt,
          # so a generous list is safe. Benchmark-ranked by Terminal-Bench /
          # SWE-bench among live free models as of 2026-09; treat as a hint.
          RBOPS_IMPL_MODELS: opencode/big-pickle,opencode/muse-spark-1.3-contributor-free,opencode/nemotron-3-ultra-free,opencode/nemotron-3.5-lightning-free,opencode/mimo-v2.5-free
          RBOPS_REVIEW_MODELS: opencode/muse-spark-1.3-contributor-free,opencode/nemotron-3-ultra-free,opencode/big-pickle
          RBOPS_AUDIT_MODELS: opencode/muse-spark-1.3-contributor-free,opencode/big-pickle,opencode/nemotron-3-ultra-free
          RBOPS_MODEL_TIMEOUT: 3000
          RBOPS_MAX_REVIEW_ROUNDS: 3
        run: |
          set -uo pipefail
          PHASE="${RBOPS_PHASE}"
          # Promote to GITHUB_ENV: the commit, state-push and report steps all
          # reference RBOPS_PHASE, and under `set -u` an unset variable aborts
          # the step. It was step-scoped to this one and killed Report status.
          echo "RBOPS_PHASE=$PHASE" >> "$GITHUB_ENV"
          if [ "${{ needs.select.outputs.action }}" = "audit" ]; then
            bash rbops/dispatch.sh audit; rc=$?
          else
            bash rbops/dispatch.sh run "$PHASE" || rc=$?
            rc=${rc:-0}
            if [ "$rc" = "0" ]; then
              bash rbops/dispatch.sh review "$PHASE" || rc=$?
            fi
          fi
          echo "rc=$rc" >> "$GITHUB_OUTPUT"

      - name: Push phase work
        if: always()
        env:
          GIT_NAME: rbops-bot
          GIT_EMAIL: rbops-bot@users.noreply.github.com
          RBOPS_PHASE: ${{ env.RBOPS_PHASE }}
        run: |
          set -uo pipefail
          cd redblue
          git config user.name "$GIT_NAME"
          git config user.email "$GIT_EMAIL"
          if [ -z "$(git status --porcelain)" ]; then
            echo "::notice::clean tree — nothing to push"; exit 0
          fi
          git add -A
          git commit -m "rbops: ${RBOPS_PHASE} ($(date -u +%Y-%m-%dT%H:%M:%SZ))" || exit 0
          for i in 1 2 3 4 5; do
            git push origin HEAD:main && { echo "pushed"; exit 0; }
            git pull --rebase origin main || true
            sleep 3
          done
          git branch -f "rbops-recovery/${RBOPS_PHASE}" HEAD
          git format-patch -1 --stdout > "../recovery-${RBOPS_PHASE}.patch" || true
          echo "::error::push failed after 5 attempts — recovery branch + patch saved"

      - name: Push RBOPS state
        if: always()
        run: |
          set -uo pipefail
          git config user.name rbops-bot
          git config user.email rbops-bot@users.noreply.github.com
          mkdir -p phases logs
          cp -r redblue/phases/. phases/ 2>/dev/null || true
          cp -r redblue/logs/. logs/ 2>/dev/null || true
          [ -n "$(git status --porcelain phases logs)" ] || { echo "no state change"; exit 0; }
          git add phases logs
          git commit -m "rbops: state after ${RBOPS_PHASE}" || exit 0
          for i in 1 2 3 4 5; do
            git push origin HEAD:main && exit 0
            git pull --rebase origin main || true; sleep 3
          done

      - name: Upload recovery artifacts
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: rbops-${{ needs.select.outputs.phase || 'audit' }}
          path: |
            recovery-*.patch
            logs/*.log
          retention-days: 14

      - name: Report status
        if: always()
        env:
          GH_TOKEN: ${{ github.token }}
          RBOPS_PHASE: ${{ env.RBOPS_PHASE }}
        run: |
          set -uo pipefail
          PHASE="${RBOPS_PHASE:-none}"
          rc="${{ steps.d.outputs.rc }}"
          echo "phase=${PHASE} rc=${rc:-unknown}"
          if [ ! -d "redblue/phases/${PHASE}" ]; then
            echo "::notice::no phase directory for '${PHASE}' — nothing to report"
            exit 0
          fi
          if [ -f "redblue/phases/${PHASE}/.blocked" ]; then
            TITLE="RBOPS blocked: ${PHASE}"
            if gh issue list --state open --search "$TITLE in:title" --json number \
               2>/dev/null | grep -q '"number"'; then
              echo "::notice::issue already open for $PHASE"
            else
              gh issue create --title "$TITLE" \
                --body "$(tail -60 "logs/${PHASE}.log" 2>/dev/null || echo 'see run logs')" || true
            fi
          fi

