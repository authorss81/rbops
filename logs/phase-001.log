+/// How `expect` compares the value under test against the expected value.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub enum ExpectMatcher {
+    /// `expect x to be y` — the two values must be equal.
+    Equal,
+    /// `expect x to contain y` — the first value must contain the second.
+    Contain,
+}
+
+impl ExpectMatcher {
+    /// The comparison word as it is written in source.
+    pub fn keyword(self) -> &'static str {
+        match self {
+            ExpectMatcher::Equal => "be",
+            ExpectMatcher::Contain => "contain",
+        }
+    }
+}
