  # ---------------------------------------------------------------------------
  # work: clone redblue, run the dispatcher. contents:write is required to
  # push phase work; it is NOT granted any workflow scope, so the bot cannot
  # rewrite its own gate.
  # ---------------------------------------------------------------------------
  work:
    needs: select
    if: needs.select.outputs.exists == 'true' && needs.select.outputs.action != 'status'
    runs-on: ubuntu-latest
    permissions:
      contents: write          # push phase work. NO `workflows` scope.
    steps:
      - uses: actions/checkout@v4
        with: { fetch-depth: 0 }

      - uses: actions-rust-lang/setup-rust-toolchain@v1
        with:
          toolchain: stable
          components: rustfmt, clippy

      - name: Install jq and ripgrep
        run: sudo apt-get update -qq && sudo apt-get install -y -qq jq ripgrep

      - name: Install opencode (pinned)
        run: |
          # 1.15.12 is what llops-android pins, but the free tier now requires
          # >=1.18.0 and every opencode/* model fails with "OpenCode 1.18.0 or
          # newer is required to use the free tier".
          curl -fsSL https://opencode.ai/install | bash -s -- --version 1.18.34
          # $GITHUB_PATH only affects LATER steps, so the binary must be called
          # by absolute path here or this step dies with exit 127.
          "$HOME/.opencode/bin/opencode" --version
          echo "$HOME/.opencode/bin" >> "$GITHUB_PATH"

      - name: Cache cargo
        uses: actions/cache@v4
        with:
          path: |
            ~/.cargo/registry
            ~/.cargo/git
            target
          key: rbops-${{ runner.os }}-${{ hashFiles('rbops/phases.json') }}
          restore-keys: rbops-${{ runner.os }}-

      - name: Clone redblue
        run: |
          git clone --depth 50 https://github.com/authorss81/redblue.git redblue
          echo "RBOPS_REPO=$PWD/redblue" >> "$GITHUB_ENV"

      - name: Fetch WIP checkpoint
        continue-on-error: true
        run: |
          cd redblue
          git fetch origin "+refs/heads/rbops-wip/*:refs/remotes/origin/rbops-wip/*" || true

      # Warm the build so the phase's own gate is fast.
      - name: Warm cargo cache
        working-directory: redblue
        run: cargo build --all-targets

      - name: Dispatch
        id: d
        env:
          OPENCODE_API_KEY: ${{ secrets.OPENCODE_API_KEY }}
          # Optional. Only needed if you add openrouter/* models to the chains
          # below; the default chains are opencode/* only so a single key is
          # sufficient.
          OPENROUTER_API_KEY: ${{ secrets.OPENROUTER_API_KEY }}
          GITHUB_TOKEN: ${{ github.token }}
          GITHUB_REPOSITORY: ${{ github.repository }}
          RBOPS_PHASE: ${{ needs.select.outputs.phase }}
          RBOPS_RETRIGGER: ${{ inputs.no_retrigger && '0' || '1' }}
          # opencode/* only by default: these are served by the OpenCode Zen key.
          # A dead model advances the chain without consuming a phase attempt,
          # so a generous list is safe. Benchmark-ranked by Terminal-Bench /
          # SWE-bench among live free models as of 2026-09; treat as a hint.
          RBOPS_IMPL_MODELS: opencode/big-pickle,opencode/muse-spark-1.3-contributor-free,opencode/nemotron-3-ultra-free,opencode/nemotron-3.5-lightning-free,opencode/mimo-v2.5-free
          RBOPS_REVIEW_MODELS: opencode/muse-spark-1.3-contributor-free,opencode/nemotron-3-ultra-free,opencode/big-pickle
          RBOPS_AUDIT_MODELS: opencode/muse-spark-1.3-contributor-free,opencode/big-pickle,opencode/nemotron-3-ultra-free
          RBOPS_MODEL_TIMEOUT: 3000
          RBOPS_MAX_REVIEW_ROUNDS: 3
        run: |
          set -uo pipefail
          PHASE="${RBOPS_PHASE}"
          # Promote to GITHUB_ENV: the commit, state-push and report steps all
          # reference RBOPS_PHASE, and under `set -u` an unset variable aborts
          # the step. It was step-scoped to this one and killed Report status.
          echo "RBOPS_PHASE=$PHASE" >> "$GITHUB_ENV"
          if [ "${{ needs.select.outputs.action }}" = "audit" ]; then
            bash rbops/dispatch.sh audit; rc=$?
          else
            bash rbops/dispatch.sh run "$PHASE" || rc=$?
            rc=${rc:-0}
            if [ "$rc" = "0" ]; then
              bash rbops/dispatch.sh review "$PHASE" || rc=$?
            fi
          fi
