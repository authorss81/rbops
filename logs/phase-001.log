+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Run `source` and hand back the results.
+    fn run(source: &str) -> TestResults {
+        let mut harness = TestHarness::new();
+        harness.run_source(source).expect("source should parse");
+        harness.results()
+    }
+
+    fn only_error(results: &TestResults) -> &TestError {
+        assert_eq!(results.errors.len(), 1, "expected exactly one failure");
+        &results.errors[0]
+    }
+
+    #[test]
+    fn test_correct_expectation_passes() {
+        let results = run("test \"adds\"\n    set result to 2 + 3\n    expect result to be 5\nend\n");
+
+        assert_eq!(results.passed, 1);
+        assert_eq!(results.failed, 0);
+        assert!(results.errors.is_empty());
+    }
+
+    #[test]
+    fn test_wrong_expectation_fails_the_test() {
+        let results = run("test \"wrong\"\n    expect 1 to be 2\nend\n");
+
+        assert_eq!(results.passed, 0, "a wrong expectation must not pass");
+        assert_eq!(results.failed, 1);
+
+        let error = only_error(&results);
+        assert_eq!(error.test_name, "wrong");
+        assert_eq!(error.expected.as_deref(), Some("Number(2.0)"));
+        assert_eq!(error.actual.as_deref(), Some("Number(1.0)"));
+    }
+
+    #[test]
+    fn test_each_block_is_a_separate_test() {
+        let results = run(
+            "test \"holds\"\n    expect 1 to be 1\nend\ntest \"does not\"\n    expect 1 to be 2\nend\n",
+        );
+
+        assert_eq!(results.total, 2);
+        assert_eq!(results.passed, 1);
+        assert_eq!(results.failed, 1);
+    }
+
+    #[test]
+    fn edge_failing_assertion_stops_the_rest_of_the_body() {
+        // The second statement would fail differently. If the harness kept
+        // going after a failed assertion it would run an unbounded remainder,
+        // so a failure has to end the test where it happens.
+        let results = run("test \"short circuits\"\n    expect 1 to be 2\n    set n to 1 / 0\nend\n");
+
+        let error = only_error(&results);
+        assert!(
+            error.message.contains("Values not equal"),
+            "expected the assertion failure, got: {}",
+            error.message
+        );
+    }
+
+    #[test]
+    fn edge_empty_values_are_compared_not_skipped() {
+        let results = run(
+            "test \"empty text\"\n    expect \"\" to be \"\"\nend\ntest \"empty list\"\n    expect [] to be []\nend\n",
+        );
+
+        assert_eq!(results.passed, 2, "empty values must be asserted, not ignored");
+        assert_eq!(results.failed, 0);
+    }
+
+    #[test]
+    fn edge_empty_against_non_empty_fails() {
+        let results = run("test \"empty text\"\n    expect \"\" to be \"x\"\nend\n");
+
+        assert_eq!(results.failed, 1);
+        assert_eq!(only_error(&results).expected.as_deref(), Some("Text(\"x\")"));
+    }
+
+    #[test]
+    fn edge_singleton_list_membership() {
