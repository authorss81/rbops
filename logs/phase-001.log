+
+    /// The single `expect` in `source`, or a failure if it is not one.
+    fn expect_expr(source: &str) -> Expr {
+        let tokens = Lexer::tokenize(source).unwrap();
+        let program = parse(tokens).unwrap();
+        match program.statements.as_slice() {
+            [Statement::Expr(expr @ Expr::Expect { .. })] => expr.clone(),
+            other => panic!("expected one expect expression, got {:?}", other),
+        }
+    }
+
+    #[test]
+    fn test_parse_expect_to_be() {
+        let expr = expect_expr("expect 2 + 3 to be 5");
+
+        assert!(matches!(
+            expr,
+            Expr::Expect {
+                matcher: ExpectMatcher::Equal,
+                ..
+            }
+        ));
+    }
+
+    #[test]
+    fn test_parse_expect_to_contain() {
+        let expr = expect_expr("expect [1, 2] to contain 1");
+
+        assert!(matches!(
+            expr,
+            Expr::Expect {
+                matcher: ExpectMatcher::Contain,
+                ..
+            }
+        ));
+    }
+
+    #[test]
+    fn test_parse_expect_keeps_both_operands() {
+        let expr = expect_expr("expect total to be nothing");
+
+        match expr {
+            Expr::Expect {
+                actual,
+                expected,
+                matcher,
+            } => {
+                assert!(matches!(*actual, Expr::Variable(ref name) if name == "total"));
+                assert!(matches!(*expected, Expr::Nothing));
+                assert_eq!(matcher, ExpectMatcher::Equal);
+            }
+            other => panic!("expected an expect expression, got {:?}", other),
+        }
+    }
+
+    #[test]
+    fn edge_expect_without_a_comparison_word_is_rejected() {
+        let tokens = Lexer::tokenize("expect 1 to 2").unwrap();
+        let error = parse(tokens).unwrap_err();
+
+        assert!(error.to_string().contains("Expected 'be' or 'contain'"));
+    }
+
+    #[test]
+    fn test_be_and_contain_stay_usable_as_variable_names() {
+        // Neither comparison word is reserved, so nothing outside an `expect`
+        // changes meaning.
+        let tokens = Lexer::tokenize("set be to 1\nset contain to 2\nsay contain").unwrap();
+        let program = parse(tokens).unwrap();
+
+        assert_eq!(program.statements.len(), 3);
+    }
 }

