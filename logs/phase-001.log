+/// Run every top-level `test "name" … end` block in `source`.
+///
+/// This is the form the language documents for tests, and the only place
+/// assertions are evaluated: the body is walked statement by statement and
+/// each `expect` is compared by `testing::assertions`, so a mismatch is
+/// reported as an assertion failure carrying the expected and the actual
+/// value rather than as a bare runtime error.
+fn run_test_blocks(&mut self, source: &str) -> Result<()> {
+    let program = self.parse(source)?;
+
+    for statement in &program.statements {
+        if let Statement::Test { name, body } = statement {
+            let mut vm = Vm::new();
+            let outcome = self.run_test_body(&mut vm, body);
+            vm.flush_output();
+            self.record(name, None, outcome);
+        }
+    }
+
     Ok(())
 }
 
+/// Execute a test body, checking every `expect` it contains.
+///
+/// Statements run in order and an `expect` is checked at the point it is
+/// reached, so the values it compares are the values the statements before
+/// it produced, and a failure stops the rest of the body.
+fn run_test_body(
+    &self,
+    vm: &mut Vm,
+    body: &[Statement],
+) -> Result<(), TestAssertionError> {
+    for statement in body {
+        match statement {
+            Statement::Expr(Expr::Expect {
+                actual,
+                expected,
+                matcher,
+            }) => check_expectation(vm, actual, expected, *matcher)?,
+            other => vm
+                .execute_statements(std::slice::from_ref(other))
+                .map(|_| ())
+                .map_err(|e| runtime_failure(e.to_string()))?,
+        }
+    }
+
+    Ok(())
+}
+
+/// Record one test outcome. A test that cannot fail is not a test, so both
+/// arms have to move `results.total`; the failing arm additionally carries
+/// the assertion detail.
+fn record(&mut self, name: &str, line: Option<usize>, outcome: Result<(), TestAssertionError>) {
+    match outcome {
+        Ok(()) => {
+            self.results.add_pass();
+            print!(".");
+        }
+        Err(e) => {
+            self.results.add_fail(TestError {
+                test_name: name.to_string(),
+                file: "inline".to_string(),
+                line,
+                message: e.message,
+                expected: e.expected,
+                actual: e.actual,
+            });
+            print!("F");
+        }
+    }
+}
+
+fn parse(&self, source: &str) -> Result<Program> {
+    let tokens = Lexer::tokenize(source)?;
+    let mut parser = Parser::new(tokens);
+    let program = parser.parse()?;
+    analyzer::analyze(&program)?;
+
+    Ok(program)
+}
