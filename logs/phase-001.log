+            "test \"present\"\n    expect [7] to contain 7\nend\ntest \"absent\"\n    expect [7] to contain 8\nend\n",
+        );
+
+        assert_eq!(results.passed, 1);
+        assert_eq!(results.failed, 1);
+        assert!(only_error(&results)
+            .message
+            .contains("does not contain"));
+    }
