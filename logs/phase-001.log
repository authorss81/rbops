    /// `expect <expr> to be <expr>` and `expect <expr> to contain <expr>`.
    ///
    /// `be` and `contain` are compared as identifiers rather than tokens, so
    /// neither word is reserved and both remain usable as variable names
    /// everywhere outside an `expect`.
    fn parse_expect(&mut self) -> Result<Expr> {
        self.advance(); // consume 'expect'

        let actual = self.parse_expression()?;
        self.expect(&TokenKind::To)?;

        let matcher = match self.current() {
            Some(Token {
                kind: TokenKind::Identifier(word),
                ..
            }) if word == ExpectMatcher::Equal.keyword() || word == ExpectMatcher::Contain.keyword() =>
            {
                let matcher = if word == ExpectMatcher::Equal.keyword() {
                    ExpectMatcher::Equal
                } else {
                    ExpectMatcher::Contain
                };
                self.advance();
                matcher
            }
            _ => {
                return Err(Error::Parser(format!(
                    "Expected '{}' or '{}' after 'to' in expect",
                    ExpectMatcher::Equal.keyword(),
                    ExpectMatcher::Contain.keyword()
                )))
            }
        };

        let expected = self.parse_expression()?;

        Ok(Expr::Expect {
            actual: Box::new(actual),
            expected: Box::new(expected),
            matcher,
        })
    }
