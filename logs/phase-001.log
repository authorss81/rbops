+/// Evaluate the two operands of an `expect` and compare them with the
+/// assertion library.
+fn check_expectation(
+    vm: &mut Vm,
+    actual: &Expr,
+    expected: &Expr,
+    matcher: ExpectMatcher,
+) -> Result<(), TestAssertionError> {
+    let actual_value = vm
+        .evaluate_expression(actual)
+        .map_err(|e| runtime_failure(e.to_string()))?;
+    let expected_value = vm
+        .evaluate_expression(expected)
+        .map_err(|e| runtime_failure(e.to_string()))?;
+
+    match matcher {
+        ExpectMatcher::Equal => assert_values_equal(&expected_value, &actual_value),
+        ExpectMatcher::Contain => assert_value_contains(&actual_value, &expected_value),
+    }
+}
+
+/// Turn an error raised while running a test into an assertion failure that
+/// names the problem.
+fn runtime_failure(message: String) -> TestAssertionError {
+    TestAssertionError {
+        message,
+        expected: None,
+        actual: None,
+    }
+}

