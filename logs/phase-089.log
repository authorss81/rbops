+
+#[test]
+fn edge_a_typed_catch_changes_no_operand_shape_in_the_bytecode() {
+    // The kind travels in the catch block's parameter list, which is a field
+    // every block header already had. So: the same opcodes, the same operands,
+    // the same block tree, the same format version — and a `.rbc` written by a
+    // build that never heard of a typed catch still decodes.
+    let untyped = "try\n    set sum to 1 + \"a\"\ncatch error problem\n    say problem\nend\n";
+    let typed = "try\n    set sum to 1 + \"a\"\ncatch error of Runtime problem\n    say problem.kind\nend\n";
+
+    let plain = compile_source(untyped).expect("the untyped program compiles");
+    let typed_chunk = compile_source(typed).expect("the typed program compiles");
+
+    // The instruction stream is the same shape, instruction for instruction:
+    // same opcodes, same operand values, in the same blocks.
+    let shape = |chunk: &redblue::bytecode::Chunk| {
+        let main = &chunk.main;
+        let code: Vec<(redblue::bytecode::Opcode, u32, u32)> = main
+            .code
+            .iter()
+            .map(|instruction| (instruction.opcode, instruction.arg, instruction.aux))
+            .collect();
+        let catch: Vec<(redblue::bytecode::Opcode, u32, u32)> = main.blocks[0]
+            .code
+            .iter()
+            .map(|instruction| (instruction.opcode, instruction.arg, instruction.aux))
+            .collect();
+        (
+            chunk.constants.iter().map(|c| format!("{c:?}")).collect::<Vec<_>>(),
+            code,
+            catch,
+            main.blocks.len(),
+            main.blocks[0].blocks.len(),
+            main.blocks[0].arity,
+        )
+    };
+    let (plain_constants, plain_code, plain_catch, plain_blocks, plain_nested, plain_arity) =
+        shape(&plain);
+    let (typed_constants, typed_code, typed_catch, typed_blocks, typed_nested, typed_arity) =
+        shape(&typed_chunk);
+    assert_eq!(
+        typed_code, plain_code,
+        "the main block's instructions must not change shape"
+    );
+    assert_eq!(
+        typed_catch, plain_catch,
+        "the catch body's instructions must not change shape"
+    );
+    assert_eq!((typed_blocks, typed_nested, typed_arity), (plain_blocks, plain_nested, plain_arity));
+    assert_ne!(
+        typed_constants, plain_constants,
+        "the kind does travel — as a constant the catch block names"
+    );
+
+    // `rb dis` says so in the block header, and the `TRY` line is byte for byte
+    // the line an untyped handler's is: no new operand, no new column.
+    let listing = redblue::bytecode::disassemble(&typed_chunk);
+    assert!(
+        listing.contains("main.blocks[0] (catch-body, arity 0) (Runtime)"),
+        "the kind must be readable in the listing, got:\n{listing}"
+    );
+    let try_line = |listing: &str| {
+        listing
+            .lines()
+            .find(|line| line.contains(" TRY "))
+            .unwrap_or_else(|| panic!("no TRY instruction in:\n{listing}"))
+            .to_string()
+    };
+    assert_eq!(
+        try_line(&redblue::bytecode::disassemble(&plain)),
+        try_line(&listing),
+        "a typed handler must not change how TRY is written"
+    );
+
+    // The format did not move, so a `.rbc` written today decodes and still names
+    // the kind the handler matches.
+    assert_eq!(redblue::bytecode::FORMAT_VERSION, 6, "the format version is unchanged");
+    let round_tripped = redblue::bytecode::decode(&typed_chunk.encode()).expect("a .rbc decodes");
+    assert_eq!(
+        round_tripped.main.blocks[0].params,
+        vec!["Runtime".to_string()],
+        "the kind must survive the encoding"
+    );
+    let mut vm = BytecodeVm::new();
+    vm.set_echo(false);
+    let value = vm
+        .run(&round_tripped)
+        .expect("the decoded chunk runs");
+    assert_eq!(vm.take_output(), vec!["Runtime"]);
+    assert_eq!(value, Value::Nothing, "the program says its piece and stops");
 }
