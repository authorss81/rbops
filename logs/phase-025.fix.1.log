        let lines = vm.take_output();
        assert_eq!(
            lines.last().map(String::as_str),
            Some(expected),
            "count {count} should have taken {expected} turns, the loop printed {lines:?}"
        );
    }

    // A count too large to count is refused by name, and before the body runs,
    // so the loop that cannot finish never prints from the turn it never takes.
    for count in ["1e300", "-1e300"] {
        let source = format!("repeat {count} times\\n    say \\"never\\"\\nend\\n");
        let tokens = redblue::lexer::Lexer::tokenize(&source).expect("source should lex");
        let ast = redblue::parser::parse(tokens).expect("source should parse");
        let mut vm = redblue::Vm::new();
        match vm.run(&ast) {
            Err(Error::Runtime(message, span)) => {
                assert_eq!(
                    message,
                    "A 'repeat' count must be no more than 9223372036854775807 turns",
                    "count {count} was refused wrongly"
                );
                assert!(span.is_known(), "count {count} reported no position");
            }
            Err(other) => panic!("count {count} should be a Runtime error, got {other:?}"),
            Ok(value) => panic!("count {count} should not return a value, got {value}"),
        }
        assert_eq!(
            vm.take_output(),
            Vec::<String>::new(),
            "count {count} must be refused before the first turn"
        );
    }
}
'''
open(path, "w").write(head + new)
