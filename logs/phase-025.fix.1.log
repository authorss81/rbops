import itertools, os, subprocess
os.makedirs("target/tmp/matrix2", exist_ok=True)

def indent(text, n):
    pad = " " * n
    return "".join(pad + line + "\n" for line in text.split("\n") if line.strip() != "")

blocks = {
    "test": 'test "a block"\nset reached to "yes"\n{sig}set reached to "leaked"\nend',
    "module": 'module M\n    export v\n    set reached to "yes"\n    {sig}    set reached to "leaked"\nend',
    "object": 'object O\n    has v default 1\n    set reached to "yes"\n    {sig}    set reached to "leaked"\nend',
    "catch": 'try\n        set bad to 1 + "one"\n    catch error\n        set reached to "yes"\n        {sig}        set reached to "leaked"\n    end',
    "finally": 'try\n    finally\n        set reached to "yes"\n        {sig}        set reached to "leaked"\n    end',
}
sigs = {"break": "break\n", "skip": "skip\n"}

def build(bname, sname, wrapper):
    src = blocks[bname].replace("{sig}", sigs[sname])
    if wrapper:
        # a try with a finally, then the block, all inside one loop turn
        return ('set reached to "no"\nset log to ""\nrepeat 2 times\n'
                + indent('set log to log + "t"', 4)
                + indent('try\n    set bad to 1 + "one"\ncatch error\n    set log to log + "c"\nend', 4)
                + indent(src, 4)
                + indent('set log to log + "."', 4)
                + 'end\nsay log\nsay reached\n')
    return ('set reached to "no"\nset log to ""\nfor each i in [1, 2, 3]\n'
            + indent('set log to log + "t"', 4)
            + indent(src, 4)
            + indent('set log to log + "."', 4)
            + 'end\nsay log\nsay reached\n')

def norm(out, code):
    lines = [l for l in out.splitlines()
             if not l.strip().startswith("-->") and not l.strip().startswith("|")
             and not l.strip()[:1].isdigit() and l.strip()]
    return (code, tuple(lines))

bad = total = 0
for bname, sname, wrapper in itertools.product(blocks, sigs, [False, True]):
    total += 1
    name = f"{'w' if wrapper else 'p'}-{bname}-{sname}"
    path = f"target/tmp/matrix2/{name}.rb"
    open(path, "w").write(build(bname, sname, wrapper))
    t = subprocess.run(["./target/debug/rb", "run", path], capture_output=True, text=True)
    subprocess.run(["./target/debug/rb", "compile", path, "-o", path + ".rbc"], capture_output=True)
    b = subprocess.run(["./target/debug/rb", "vm", path + ".rbc"], capture_output=True, text=True)
    if norm(t.stdout + t.stderr, t.returncode) != norm(b.stdout + b.stderr, b.returncode):
        bad += 1
        print("DIVERGE", name)
        print(open(path).read())
        print("tree:", t.returncode, repr((t.stdout+t.stderr)[:200]))
        print("byte:", b.returncode, repr((b.stdout+b.stderr)[:200]))
print(f"checked {total}, {bad} diverge")
