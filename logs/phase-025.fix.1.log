#!/bin/bash
# usage: compare.sh file.rb
cd /home/runner/work/rbops/rbops/redblue
f="$1"
./target/debug/rb run "$f" > /tmp/opencode/.t 2>&1; te=$?
./target/debug/rb compile "$f" -o /tmp/opencode/.t.rbc >/dev/null 2>&1 && ./target/debug/rb vm /tmp/opencode/.t.rbc > /tmp/opencode/.b 2>&1; be=$?
sed -i -E 's/^( *)(-+> )[0-9]+:[0-9]+/\1\2LINE/' /tmp/opencode/.t /tmp/opencode/.b
sed -i -E 's/^(.*\.rb):[0-9]+:[0-9]+$/\1:LINE/' /tmp/opencode/.t /tmp/opencode/.b
if [ "$te" = "$be" ] && diff -q /tmp/opencode/.t /tmp/opencode/.b >/dev/null; then
  echo "AGREE (exit $te)"; cat /tmp/opencode/.t
else
  echo "DIVERGE tree=$te byte=$be"; diff /tmp/opencode/.t /tmp/opencode/.b
fi
EOF
