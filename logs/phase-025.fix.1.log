// ---------------------------------------------------------------------------
// edge: the count of a `repeat`, read as turns
// ---------------------------------------------------------------------------

/// Edge: a count too large to count is refused *before* the first turn.
///
/// The count used to be narrowed with `as i64`, which saturates, so
/// `repeat 1e300 times` became `i64::MAX` turns and ran until the iteration cap
/// stopped it. The program was bounded, but the failure arrived after a million
/// turns of a loop the reader can see cannot finish, and it named the cap rather
/// than the count. Both halves are wrong for a count this shape: the loop never
/// had that many turns in it.
#[test]
fn edge_a_count_too_large_to_count_is_refused_before_the_first_turn() {
    for count in ["99999999999999999999", "1e300"] {
        let source = format!(
            "set n to 0\nrepeat {} times\n    set n to n + 1\n    say n\nend\n",
            count
        );

        let error = run_capped(&source, 100)
            .expect_err("a count too large to count must be refused, not run");
        assert!(
            matches!(error, Error::Runtime(..)),
            "count {} produced {:?}, which is not a RuntimeError",
            count,
            error
        );
        let message = runtime_message(&error);
        assert!(
            message.contains("9223372036854775807"),
            "the refusal must name the largest countable count, got {:?}",
            message
        );
        assert!(
            !message.contains("Maximum of"),
            "the cap is no longer what stops this loop, so it must not be what \
             the message says, got {:?}",
            message
        );
    }
}

/// Edge: the count is the number of *whole* turns before the fraction, and a
/// `break` in that body leaves it there. `repeat 2.5 times` is two turns, so the
/// body runs once and prints one value; the third turn the fraction asks about
/// does not exist.
#[test]
fn edge_a_fractional_count_is_its_whole_turns_and_a_break_leaves_one_of_them() {
    let printed = {
        let source = concat!(
            "repeat 2.5 times\n",
            "    say \"turn\"\n",
            "    break\n",
            "end\n",
        );
        let mut vm = Vm::new();
        vm.run(&parse(source)).expect("a fractional count must not fail");
        vm.take_output()
    };

    assert_eq!(
        printed,
        vec!["turn".to_string()],
        "2.5 turns is two whole turns, and the break leaves the first"
    );
}

/// Edge: a negative count runs no turns at all, and a `break` written in that
/// body is never raised — a loop whose body cannot run cannot report that a
/// `break` was found outside a loop.
#[test]
fn edge_a_negative_count_runs_no_turns_and_raises_no_break() {
    for count in ["-5", "-0.5"] {
        let source = format!(
            "set n to 0\nrepeat {} times\n    set n to n + 1\n    say n\n    break\nend\nsay n\n",
            count
        );

        let mut vm = Vm::new();
        vm.run(&parse(&source)).unwrap_or_else(|error| {
            panic!("count {} must run no turns without failing: {:?}", count, error)
        });
        assert_eq!(
            vm.take_output(),
            vec!["0".to_string()],
            "count {} must leave the statement after the loop as the only thing printed",
            count
        );
    }
}
