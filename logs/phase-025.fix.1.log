+/// The number of turns a `repeat <count> times` loop takes.
+///
+/// A loop needs a whole number of turns, so the count — which is written as a
+/// number, and is an `f64` like every number — is turned into one here rather
+/// than by the `as i64` cast each VM used, so that the two VMs cannot read one
+/// count two ways. The three shapes that are not a turn count are answered
+/// rather than narrowed:
+///
+/// - A count that is not a number is not a loop at all, and runs no times. That
+///   is the behaviour `for each x in 5` already has, and `repeat "five" times`
+///   is pinned to it.
+/// - A finite count is the number of *whole* turns before the fraction, so
+///   `repeat 2.5 times` runs twice and `repeat -5 times` runs no times: there is
+///   no turn before the first one for a negative count to be counted back from.
+/// - A count that is not finite, or one too large to count, is refused with a
+///   spanned [`Error::Runtime`] instead of being narrowed. The cast saturated
+///   both, so `repeat 1e300 times` became `i64::MAX` turns and ran until the
+///   iteration cap stopped it — a refusal with a precise cause arriving after a
+///   million turns of a loop the reader can see cannot finish.
+pub fn expect_repeat_count(value: &Value, span: Span) -> Result<i64> {
+    let count = match value {
+        Value::Number(n) => *n,
+        _ => return Ok(0),
+    };
+    if !count.is_finite() {
+        return Err(Error::Runtime(
+            format!(
+                "A 'repeat' count of {} is not a whole number of turns",
+                non_finite_name(count)
+            ),
+            span,
+        ));
+    }
+    // `trunc` towards zero is what leaves `-5` at zero rather than at a
+    // negative turn count, which a loop cannot have.
+    let turns = count.trunc();
+    if turns >= i64::MAX as f64 {
+        return Err(Error::Runtime(
+            format!("A 'repeat' count must be no more than {} turns", i64::MAX),
+            span,
+        ));
+    }
+    Ok(if turns < 0.0 { 0 } else { turns as i64 })
