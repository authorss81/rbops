/// A `repeat` count is the one place a Redblue program cannot write a non-finite
/// number, because nothing can put one into `Value::Number` — but `Expr::Number`
/// holds an `f64` and is public API, so a Rust caller can hand a loop a count
/// that is not a number at all. Both engines refuse it, and they refuse it the
/// same way: the number is refused at the door it came through, before either
/// reads it as a count.
#[test]
fn edge_a_non_finite_number_given_as_a_repeat_count_is_refused_by_both_engines() {
    use redblue::bytecode::compile_program;
    use redblue::bytecode::vm::BytecodeVm;
    use redblue::parser::{Expr, Program, Statement, Stmt};

    let cases = [
        (f64::NAN, "NaN is not a finite number"),
        (f64::INFINITY, "infinity is not a finite number"),
        (f64::NEG_INFINITY, "-infinity is not a finite number"),
    ];

    for (count, expected) in cases {
        let program = Program {
            statements: vec![Stmt {
                span: redblue::Span::new(1, 1),
                statement: Statement::Repeat {
                    count: Expr::Number(count),
                    body: vec![],
                },
            }],
        };

        let mut walking = redblue::Vm::new();
        match walking.run(&program) {
            Err(Error::Runtime(message, span)) => {
                assert_eq!(message, expected, "count {count} was refused wrongly");
                assert!(span.is_known(), "count {count} reported no position");
            }
            Err(other) => panic!("count {count} should be a Runtime error, got {other:?}"),
            Ok(value) => panic!("count {count} should not return a value, got {value}"),
        }

        let chunk = compile_program(&program).expect("the program should compile");
        let mut bytecode = BytecodeVm::new();
        match bytecode.run(&chunk) {
            Err(Error::Runtime(message, _)) => {
                assert_eq!(
                    message, expected,
                    "the bytecode engine refused count {count} differently"
                );
            }
            Err(other) => panic!(
                "count {count} should be a Runtime error on the bytecode engine, got {other:?}"
            ),
            Ok(value) => panic!(
                "count {count} should not return a value on the bytecode engine, got {value}"
            ),
        }
    }
}

/// The helper both engines read a `repeat` count through is public API, so it is
/// held to the same total behaviour here: every double it can be given has an
/// answer, and the ones with no whole number of turns in them are refused rather
/// than narrowed. `NaN as i64` is 0 and `f64::INFINITY as i64` is `i64::MAX`,
/// so before this the same `as i64` cast meant "run no turns" for one and "run
/// until something stops it" for the other.
#[test]
fn edge_the_repeat_count_helper_is_total_for_every_double() {
    use redblue::value::expect_repeat_count;

    let span = redblue::Span::new(1, 1);
    let turns = |n: f64| expect_repeat_count(&Value::Number(n), span).map_err(|e| e.message().to_string());

    assert_eq!(turns(0.0), Ok(0), "zero is no turns");
    assert_eq!(turns(1.0), Ok(1), "one is one turn");
    assert_eq!(turns(2.5), Ok(2), "a fraction is its whole turns");
    assert_eq!(turns(-5.0), Ok(0), "a negative count has no turn to start from");
    assert_eq!(turns(-0.5), Ok(0), "a negative fraction has none either");
    assert_eq!(
        turns(i64::MAX as f64),
        Ok(i64::MAX),
        "the largest countable count is countable"
    );
    assert_eq!(
        expect_repeat_count(&Value::Text("five".to_string()), span)
            .map_err(|e| e.message().to_string()),
        Ok(0),
        "a count that is not a number is not a loop, which is what `for each x in 5` does"
    );

    for (count, expected) in [
        (
            f64::NAN,
            "A 'repeat' count of NaN is not a whole number of turns",
        ),
        (
            f64::INFINITY,
            "A 'repeat' count of infinity is not a whole number of turns",
        ),
        (
            f64::NEG_INFINITY,
            "A 'repeat' count of -infinity is not a whole number of turns",
        ),
    ] {
        assert_eq!(
            expect_repeat_count(&Value::Number(count), span)
                .map_err(|e| e.message().to_string()),
            Err(expected.to_string()),
            "count {count} must be refused, not narrowed"
        );
    }

    assert_eq!(
        turns(1e300).unwrap_err(),
        "A 'repeat' count must be no more than 9223372036854775807 turns",
        "a count too large to count is refused rather than saturated into a loop"
    );
}
