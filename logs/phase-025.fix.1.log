/// Edge: a count past `i64` saturates into the largest countable count, and what
/// stops such a loop is the iteration cap — named as the limit that stopped it —
/// or a `break` on its first turn, never a panic and never a hang. The
/// narrowing is what decides *which* of those two happens, so it is pinned on
/// both engines at once: a count read two ways is a count read one way on a
/// Tuesday.
#[test]
fn edge_a_count_beyond_i64_is_the_same_saturation_on_both_engines() {
    for count in ["99999999999999999999", "1e300"] {
        let source = format!(
            "set n to 0\\nrepeat {count} times\\n    set n to n + 1\\nend\\n"
        );

        let error = run_capped(&source, 100)
