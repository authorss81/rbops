+/// The turn count of a `repeat` is read by two different instructions on two
+/// different engines — `0..(n as i64)` in the tree-walker and
+/// `Sequence::Repeat { remaining }` in the bytecode VM — and each used its own
+/// narrowing cast with its own answer for everything a cast cannot answer. Both
+/// now read the count through one helper, and this is the test that says so:
+/// every shape of count, with a `break` and a `skip` in the body, is the same
+/// program with the same outcome on both engines.
+#[test]
+fn edge_both_vms_read_a_repeat_count_the_same_way() {
+    let counts = [
+        // A count of turns, unchanged by the round trip.
+        "3",
+        // Whole turns before the fraction.
+        "2.5",
+        "0.5",
+        // No turn to start from.
+        "-5",
+        "-0.5",
+        // Not a count of anything.
+        "\"five\"",
+        "nothing",
+        // Not countable.
+        "1e300",
+        "99999999999999999999",
+    ];
+    let bodies = ["break", "skip", "set n to n + 1"];
+
+    for count in counts {
+        for body in bodies {
+            let source = format!(
+                "set n to 0\nrepeat {count} times\n    say \"turn\"\n    {body}\n    say \"after\"\nend\nsay n\n"
+            );
+            assert_agrees(&source);
+        }
+    }
+}
+
+/// A count too large to count is refused the same way on both engines, and it
+/// is refused before the body runs — a `break` in the first turn cannot rescue a
+/// loop that was never a loop. Both engines built the count before either ran a
+/// turn, so neither prints anything at all here.
+#[test]
+fn edge_a_count_too_large_to_count_is_the_same_refusal_on_both_vms() {
+    let source = concat!(
+        "set n to 0\n",
+        "repeat 1e300 times\n",
+        "    say \"turn\"\n",
+        "    break\n",
+        "end\n",
+    );
+
+    let (tree, byte) = assert_agrees(source);
+
+    assert!(
+        tree.output.is_empty(),
+        "no turn of a refused count may run, but the tree-walking VM printed {:?}",
+        tree.output
+    );
+    assert!(
+        byte.output.is_empty(),
+        "no turn of a refused count may run, but the bytecode VM printed {:?}",
+        byte.output
+    );
+    let message = tree
+        .result
+        .as_ref()
+        .expect_err("a count too large to count must be refused");
+    assert!(
+        message.contains("9223372036854775807"),
+        "the refusal must name the largest countable count, got {message}"
+    );
+}
+
+/// A fractional count is its whole turns, and a `break` in that body leaves the
+/// loop after the first of them: the fraction does not buy a turn, and the two
+/// engines must not disagree about either half of that.
+#[test]
+fn edge_both_vms_truncate_a_fractional_count_the_same_way() {
+    let source = concat!(
+        "set n to 0\n",
+        "repeat 2.5 times\n",
+        "    set n to n + 1\n",
+        "    break\n",
+        "end\n",
+        "say n\n",
+    );
+
+    let (tree, byte) = assert_agrees(source);
+
+    let expected = vec!["1".to_string()];
+    assert_eq!(tree.output, expected, "one whole turn, then the break");
+    assert_eq!(byte.output, expected, "one whole turn, then the break");
+}
