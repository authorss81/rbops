#[test]
fn edge_a_fractional_count_is_its_whole_turns_and_a_break_leaves_one_of_them() {
    let source = concat!(
        "repeat 2.5 times\\n",
        "    say \\"turn\\"\\n",
        "    break\\n",
        "end\\n",
    );

    let mut vm = Vm::new();
    vm.run(&parse(source)).expect("a fractional count must not fail the program");

    assert_eq!(
        vm.take_output(),
        vec!["turn".to_string()],
        "2.5 turns is two whole turns, and the break leaves the first"
    );
}

