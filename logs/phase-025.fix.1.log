import itertools, os, subprocess

os.makedirs("target/tmp/matrix", exist_ok=True)

# (label, block-open, block-close, inside-signal)
blocks = {
    "test": ('test "a block"\n', 'end\n'),
    "module": ('module M\n    export v\n', 'end\n'),
    "object": ('object O\n    has v default 1\n', 'end\n'),
    "catch": ('try\n        set bad to 1 + "one"\n    catch error\n', 'end\n'),
    "finally": ('try\n    finally\n', 'end\n'),
}
sigs = {"break": "break\n", "skip": "skip\n"}

programs = []
for (bname, (open_s, close_s)), (sname, sig) in itertools.product(blocks.items(), sigs.items()):
    for loop in ["for each i in [1, 2, 3]\n", "repeat 3 times\n", "set k to 0\nwhile k is not 3\n    set k to k + 1\n"]:
        indent = "    "
        body = open_s + indent + "    set reached to \"yes\"\n" + indent + "    " + sig + indent + "    set reached to \"leaked\"\n" + close_s
        src = (
            'set reached to "no"\n'
            'set log to ""\n'
            + loop
            + indent + 'set log to log + "t"\n'
            + indent + body
            + indent + 'set log to log + "."\n'
            + "end\n"
            + 'say log\n'
            + 'say reached\n'
        )
        programs.append((f"{bname}-{sname}-{abs(hash(loop)) % 97}", src))

# also: a try wrapping the block, and a loop inside the block
extra = []
for bname, (open_s, close_s) in blocks.items():
    for sname, sig in sigs.items():
        src = (
            'set reached to "no"\n'
            'set log to ""\n'
            'repeat 2 times\n'
            '    set log to log + "t"\n'
            '    try\n'
            '        set bad to 1 + "one"\n'
            '    finally\n'
            '        set log to log + "f"\n'
            '    end\n'
            '    module Guard\n'
            '        export v\n'
            '        set v to 1\n'
            + open_s.replace("\n", "\n    ").replace("        ", "        ") + "    "
            + sig + "        set reached to \"leaked\"\n"
            + close_s + '    set log to log + "."\n'
            'end\n'
            'say log\n'
            'say reached\n'
        )
        extra.append((f"wrapped-{bname}-{sname}", src))

allp = programs + extra
bad = 0
for name, src in allp:
    path = f"target/tmp/matrix/{name}.rb"
    open(path, "w").write(src)
    t = subprocess.run(["./target/debug/rb", "run", path], capture_output=True, text=True)
    subprocess.run(["./target/debug/rb", "compile", path, "-o", path + ".rbc"], capture_output=True)
    b = subprocess.run(["./target/debug/rb", "vm", path + ".rbc"], capture_output=True, text=True)
    def norm(out, code):
        lines = [l for l in out.splitlines() if not l.strip().startswith("-->") and not l.strip().startswith("|") and not l.strip()[0:1].isdigit()]
        return (code, tuple(lines))
    if norm(t.stdout + t.stderr, t.returncode) != norm(b.stdout + b.stderr, b.returncode):
        bad += 1
        print("DIVERGE", name)
        print(open(path).read())
        print("tree:", t.returncode, repr((t.stdout + t.stderr)[:300]))
        print("byte:", b.returncode, repr((b.stdout + b.stderr)[:300]))
print(f"checked {len(allp)} programs, {bad} diverge")
