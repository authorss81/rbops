        assert!(
            tree.result.is_ok(),
            "count {count} must not be a failure, got {:?}",
            tree.result
        );
        assert_eq!(
            tree.output,
            vec!["0".to_string()],
            "count {count} runs no turns, so the break in it is never raised"
        );
        assert_eq!(byte.output, tree.output, "and both engines agree");
    }
}

