            "count {} produced {:?}, which is not a RuntimeError",
            count,
            error
        );
        let message = runtime_message(&error);
        assert!(
            message.contains("100"),
            "the cap is what stops a saturated count, so it must be what the \\
             message says, got {:?}",
            message
        );
        assert!(
            !message.contains("i64"),
            "the narrowing is not what the reader is shown, so it must not be \\
             in the message either, got {:?}",
            message
        );
    }
}

/// Edge: the count is the number of *whole* turns before the fraction, and a
