    elif l.startswith('test result'):
        m=re.search(r'(\d+) passed; (\d+) failed; (\d+) ignored',l)
        total+=int(m.group(1)); n+=1
        print(f"{m.group(1):>5} passed {m.group(2)} failed {m.group(3)} ignored   {cur}")
print("LINES",n,"TOTAL",total)
