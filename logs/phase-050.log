import re
def section(txt):
    out=[];inside=False
    for line in txt.split('\n'):
        if line.startswith('## '): inside = line.strip()=='## Standard Library'
        if inside: out.append(line)
    return out
def names(path):
    lines=section(open(path,encoding='utf-8').read())
    found=set();in_code=False
    for line in lines:
        if line.lstrip().startswith('```'): in_code = not in_code; continue
        if line.startswith('### '):
            for w in line.lstrip('#').split():
                w=w.strip('.,()')
                if w and w!='and': found.add(w.lower())
            continue
        if not in_code: continue
        # strip strings and comments
        s=re.sub(r'"[^"]*"|\'[^\']*\'','',line)
        s=s.split('//')[0]
        for m in re.finditer(r'([A-Za-z_][A-Za-z0-9_]*)\s*\.\s*[A-Za-z_]',s):
            found.add(m.group(1).lower())
    return sorted(found)
for p in ['SPEC.md','README.md']:
    print(p, names(p))
