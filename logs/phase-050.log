+/// The `### ` headings inside a `## Standard Library` section.
+fn subheadings(section: &str) -> Vec<String> {
+    section
+        .lines()
+        .filter(|line| line.starts_with("### "))
+        .map(|line| line.trim_end().to_string())
+        .collect()
