+    "Unused variable: 'zeta'",
     "Unused variable: 'alpha'",
-    "Unused variable: 'beta'",
     "Unused variable: 'mid'",
-    "Unused variable: 'zeta'",
+    "Unused variable: 'beta'",
 ];
 
 let messages =
     |found: &[Diagnostic]| -> Vec<String> { found.iter().map(|d| d.message.clone()).collect() };

