+        "one name is one finding however often it is assigned: {:?}",
+        found
+    );
+    assert_eq!(found[0].message, "Unused variable: 'x'");
+    assert_eq!(
+        found[0].line, 2,
+        "the finding must point at the first `set x`, the line that introduced it"
+    );
+}
