+                  try\n    set x to 1e400\ncatch error\n    say \"caught\"\nend\n\
+                  say \"done\"\n";
+
+    let (lint_errors, found) = split(source);
+    assert!(
+        lint_errors.is_empty(),
+        "the fixture must be valid Redblue: {:?}",
+        lint_errors
+    );
+    assert_eq!(
+        found.len(),
