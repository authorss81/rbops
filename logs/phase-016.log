fn parse_unary(&mut self) -> Result<Expr> {
        if let Some(token) = self.current() {
            match &token.kind {
                TokenKind::Not => {
                    self.advance();
                    self.enter_nesting()?;
                    let expr = self.parse_unary()?;
                    self.leave_nesting(1);
                    return Ok(Expr::Unary {
                        op: UnaryOp::Not,
                        expr: Box::new(expr),
                    });
                }
                TokenKind::Minus => {
                    self.advance();
                    self.enter_nesting()?;
                    let expr = self.parse_unary()?;
                    self.leave_nesting(1);
                    return Ok(Expr::Unary {
                        op: UnaryOp::Neg,
                        expr: Box::new(expr),
                    });
                }
                _ => {}
            }
        }

        self.parse_postfix()
    }

