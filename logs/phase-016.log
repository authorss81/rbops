test "objects: the nearest declaration of a method answers"
    object Person
        to can role()
            give back "person"
        end
    end
    object Employee extends Person
        to can role()
            give back "employee"
        end
    end
    expect Employee.role() to be "employee"
    expect Person.role() to be "person"
end

