# `cdylib` is what makes the WebAssembly playground module: it is the crate type
# that emits a `.wasm` and exports every `#[no_mangle]` symbol the library
# defines, which is what `wasm/redblue.js` calls. Built with:
#
#   rustup target add wasm32-unknown-unknown
#   cargo build --release --target wasm32-unknown-unknown --lib
#
# writing `target/wasm32-unknown-unknown/release/redblue.wasm`. `rlib` is kept
# so the native `rb` binary and the test suite link exactly as they did.
[lib]
name = "redblue"
path = "src/lib.rs"
crate-type = ["rlib", "cdylib"]

