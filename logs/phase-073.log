pub struct Workload {
    pub name: &'static str,
    pub default_size: i64,
    max_size: i64,
    run: fn(i64) -> Result<Value, String>,
    expected: fn(i64) -> Expected,
}

/// The deterministic answer a workload must produce for a given size.
#[derive(Debug, Clone, PartialEq)]
pub enum Expected {
    Number(f64),
    Text(String),
}

impl Expected {
    fn matches(&self, value: &Value) -> bool {
        match (self, value) {
            (Expected::Number(want), Value::Number(got)) => want == got,
            (Expected::Text(want), Value::Text(got)) => want == got,
            _ => false,
        }
    }

    fn render(&self) -> String {
        match self {
            Expected::Number(n) => n.to_string(),
            Expected::Text(text) => text.clone(),
        }
    }
}

/// What one run measured. `answer` is the checked value, not the elapsed time.
#[derive(Debug, Clone)]
pub struct Measurement {
    pub workload: &'static str,
    pub size: i64,
    pub answer: Value,
    pub elapsed: Duration,
}

/// Everything the harness can refuse to do.
#[derive(Debug, Clone, PartialEq)]
pub enum BenchError {
    Usage(String),
    Load(String),
    BudgetExceeded {
        workload: String,
        budget: Duration,
    },
    BudgetExhausted {
        workload: String,
        budget: Duration,
    },
    SizeTooLarge {
        workload: &'static str,
        size: i64,
        max: i64,
    },
    WrongAnswer {
        workload: &'static str,
        size: i64,
        expected: String,
        actual: String,
    },
}

