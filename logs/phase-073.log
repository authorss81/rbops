        ("concat", Value::Text(String::new())),
        ("lex", Value::Number(0.0)),
    ];
    for (name, expected) in cases {
        let row = bench::run_workload(name, 0, DEFAULT_BUDGET)
            .unwrap_or_else(|error| panic!("{name} at size 0 should run: {error}"));
