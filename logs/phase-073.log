            eprintln!("could not write {}: {error}", bench_md_path().display());
            return 1;
        }
        println!("wrote {}", bench_md_path().display());
        return 0;
    }

    let selected: (&str, i64) = match arguments {
        [name] if name == "--help" || name == "-h" => {
            println!("{}", usage());
            return 0;
        }
        [name] => match default_size(name) {
            Ok(size) => (name.as_str(), size),
            Err(error) => {
                eprintln!("{error}");
                eprintln!("{}", usage());
