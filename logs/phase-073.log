}

#[test]
fn edge_timings_path_stays_beside_a_file_or_inside_a_directory() {
    let dir = unique_temp_dir("timings-path");
    let file_output = dir.join("BASELINE.md");

    assert_eq!(
        bench::timings_path(&file_output),
        dir.join("BENCH_TIMINGS.md"),
