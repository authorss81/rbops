                eprintln!("{}", usage());
                return 2;
            }
        },
        _ => {
            eprintln!("{}", usage());
            return 2;
        }
    };

    match run_workload(selected.0, selected.1, DEFAULT_BUDGET) {
        Ok(row) => {
            print!("{}", render_table(&[row]));
            0
        }
        Err(error) => {
            eprintln!("{error}");
            1
        }
    }
}
