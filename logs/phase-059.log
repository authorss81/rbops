//! Colour for the REPL.
//!
//! The property that matters most is negative: **with colour off, output is
//! byte-identical to the plain output.** Everything else here is in service of
//! proving that, because a colour feature that leaked escape bytes into a
//! plain transcript would corrupt golden files and any transcript a user saved.

use std::sync::Mutex;

use redblue::repl::style::{Paint, Style};

/// Serialises the two tests that pin `COLUMNS`.
///
/// The banner reads the terminal width out of the process environment, and
/// cargo runs the tests in one binary on parallel threads sharing it. Whichever
/// of the two ran `remove_var` in between the other's calls decided what the
/// other saw: `edge_banner_is_stable_across_calls` compared a banner centred at
/// 80 columns with one centred at none, and failed under the full suite while
/// passing every time it was run alone. Taking this lock is the fix — the
/// environment is still what the production code reads, and no assertion is
/// weakened by not letting two tests write to it at once.
static COLUMNS_LOCK: Mutex<()> = Mutex::new(());

/// The lock, taken even if a test that held it panicked, so one failure does not
/// cascade into every later COLUMNS test.
fn pin_columns() -> std::sync::MutexGuard<'static, ()> {
    COLUMNS_LOCK
        .lock()
        .unwrap_or_else(|poisoned| poisoned.into_inner())
}

// --- the byte-identical guarantee -------------------------------------------

#[test]
fn edge_disabled_paint_returns_the_text_unchanged() {
    let off = Style::forced(false);
    for role in [
        Paint::Prompt,
        Paint::Heading,
        Paint::Result,
        Paint::Error,
        Paint::Dim,
    ] {
        assert_eq!(
            off.paint(role, "plain text"),
            "plain text",
            "a disabled style must return its input verbatim, not a decorated copy"
        );
    }
}

#[test]
fn a_disabled_style_emits_no_escape_sequences_anywhere() {
    let off = Style::forced(false);
    let text = "say \"hello\" — ünïcode ✓";
    for role in [
        Paint::Prompt,
        Paint::Heading,
        Paint::Result,
        Paint::Error,
        Paint::Dim,
    ] {
        let painted = off.paint(role, text);
        assert!(
            !painted.contains('\u{1b}'),
            "disabled paint leaked an escape: {painted:?}"
        );
        assert_eq!(painted.as_bytes(), text.as_bytes());
    }
}

#[test]
fn empty_text_stays_empty_in_both_modes() {
    assert_eq!(Style::forced(false).paint(Paint::Result, ""), "");
    // On, an empty string still wraps and unwraps, so the sequence is balanced
    // rather than unbalanced by the empty payload.
    let on = Style::forced(true).paint(Paint::Result, "");
    assert_eq!(on.matches('\u{1b}').count(), 2);
}

