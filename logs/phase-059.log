+        /// Strips every escape sequence, so a test asserts on the text and
+        /// cannot fail because the palette changed.
+        fn plain(rendered: &str) -> String {
+            let mut out = String::new();
+            let mut chars = rendered.chars();
+            while let Some(c) = chars.next() {
+                if c == '\u{1b}' {
+                    for skip in chars.by_ref() {
+                        if skip == 'm' {
+                            break;
+                        }
+                    }
+                } else {
+                    out.push(c);
+                }
+            }
+            out
+        }
+
+        /// The `--> file:line:column` line, with the file dropped.
+        ///
+        /// The file is the one half that must differ: a session's failure is in
+        /// `<session>` and the same program run from disk is in its own path.
+        /// Everything after the last `:` is what both must agree on.
+        fn position(rendered: &str) -> String {
+            rendered
+                .lines()
+                .find(|line| line.trim_start().starts_with("-->"))
+                .unwrap_or_else(|| panic!("no location in:\n{}", rendered))
+                .rsplit_once(':')
+                .map(|(_, rest)| rest.to_string())
+                .unwrap_or_else(|| panic!("no line:column in:\n{}", rendered))
+        }
+
+        /// The `N | text` source line for buffer line `n`.
+        fn source_line<'a>(rendered: &'a str, n: usize) -> &'a str {
+            rendered
+                .lines()
+                .find(|line| line.starts_with(&format!("{} | ", n)))
+                .unwrap_or_else(|| {
+                    panic!(
+                        "line {} of the buffer is not drawn in:\n{}",
+                        n, rendered
+                    )
+                })
+        }
+
+        /// The caret line: the one drawn with no line number in its gutter.
+        fn caret(rendered: &str) -> &str {
+            rendered
+                .lines()
+                .find(|line| {
+                    line.starts_with("  | ") || line.split(" | ").next() == Some("")
+                })
+                .unwrap_or_else(|| panic!("no caret in:\n{}", rendered))
+        }
+
+        /// Runs `code` in a session and returns the failure the session was
+        /// handed, rather than the text it printed.
+        fn failure_of(code: &str) -> Error {
+            let mut repl = Repl::new();
+            repl.run_code(code)
+                .expect_err("the program under test is meant to fail")
+        }
+
+        fn session_render(code: &str) -> String {
+            plain(&render_error(
+                &Style::forced(false),
+                code,
+                SESSION_FILE,
+                &failure_of(code),
+            ))
+        }
