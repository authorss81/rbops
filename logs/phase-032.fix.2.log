+                        format!("Cannot read the clock to draw a random number: {e}"),
+                        span,
+                    )
+                })?
+                .as_nanos() as u64;
+            generator.seeded = true;
+        }
+        let drawn = draw(&mut generator);
+        cell.set(generator);
+        Ok(drawn)
+    })
