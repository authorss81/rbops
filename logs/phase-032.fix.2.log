#[cfg(test)]
mod tests {
    use super::{low_bits, Random};

    /// The mask `Random::below` builds has to keep every value of the range and
    /// not one more, or a draw is refused forever or the low residues come out
    /// twice as often as the high ones.
    #[test]
    fn edge_the_mask_below_builds_covers_the_whole_range_and_no_more() {
        for bound in [
            1u64,
            2,
            3,
            4,
            5,
            7,
            8,
            9,
            255,
            256,
            257,
            1 << 32,
            (1 << 63) - 1,
            1 << 63,
            u64::MAX,
        ] {
            let mask = low_bits(u64::BITS - (bound - 1).leading_zeros());
            assert_eq!(
                mask.count_ones(),
                u64::BITS - (bound - 1).leading_zeros(),
                "the mask for {bound} should keep the fewest bits that reach it"
            );
            let reach = mask as u128 + 1;
            assert!(
                reach >= bound as u128,
                "the mask for {bound} reaches only {reach} values"
            );
            // Half the range, or less, is refused and drawn again — so the loop
            // in `below` settles rather than spinning.
            assert!(
                reach - bound as u128 <= bound as u128,
                "{reach} values for a range of {bound} refuses at least half of them"
            );
        }
        assert_eq!(low_bits(0), 0, "no bits is no values");
        assert_eq!(low_bits(64), u64::MAX, "64 bits is every value");
    }

    /// `below` answers a value of the range and does not get stuck, at every
    /// boundary — a bound of one and of two in particular, where a generator
    /// that mixed the low bits badly would show.
    #[test]
    fn edge_below_answers_a_value_of_the_range_at_every_boundary() {
        let mut generator = Random::seeded(1);
        assert_eq!(generator.below(0), 0, "nothing to draw from nothing");
        for bound in [1u64, 2, 3, 4, 5, 8, 17, 1 << 40] {
            for seed in [0u64, 1, 2, u64::MAX] {
                let mut generator = Random::seeded(seed);
                for _ in 0..1000 {
                    assert!(
                        generator.below(bound) < bound,
                        "seed {seed} drew outside 0..{bound}"
                    );
                }
            }
        }
        // And the two halves of a range of two are both reachable from one seed:
        // a generator that only ever set the low bit would answer `1` here.
        let mut generator = Random::seeded(1);
        let first = (0..100).any(|_| generator.below(2) == 0);
        let second = (0..100).any(|_| generator.below(2) == 1);
        assert!(first && second, "a range of two must be reachable on both sides");
    }

    /// The sequence advances on every draw and does not depend on the seed being
    /// non-zero — a `xorshift` seeded with `0` is stuck forever, which is exactly
    /// the value `math.seed(0)` gives.
    #[test]
    fn edge_the_sequence_advances_from_every_seed() {
        for seed in [0u64, 1, 2, 42, u64::MAX] {
            let mut generator = Random::seeded(seed);
            let mut seen = Vec::new();
            for _ in 0..1000 {
                seen.push(generator.next_u64());
            }
            assert!(
                seen.windows(2).all(|pair| pair[0] != pair[1]),
                "seed {seed} drew the same word twice in a row"
            );
            assert!(
                seen.iter().collect::<std::collections::HashSet<_>>().len() > 990,
                "seed {seed} repeated within a thousand words"
            );
        }
        // Two seeds give two sequences.
        assert_ne!(
            Random::seeded(1).next_u64(),
            Random::seeded(2).next_u64(),
            "one word should not be a function of nothing"
        );
    }
}
EOF
