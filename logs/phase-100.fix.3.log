+#[test]
+fn edge_the_in_memory_filesystem_treats_a_backslash_as_a_filename_character() {
+    use redblue::vfs::memory;
+
+    let _serialised = memory_filesystem();
+    memory::clear();
+
+    let dir = "/wasm-backslash";
