json.dump(out, open("target/tmp/classified.json","w"), indent=1)
print("mapped", len(out), "of", sum(len(blocks(d)) for d in DOCS))
for d in DOCS:
    miss = [ln for ln, _ in blocks(d) if "%s:%d" % (d, ln) not in out]
    print(d, "missing:", miss)
