            doc=r.split()[2]
            j=i+1
            while j<len(lines) and not lines[j].startswith("# --- "):
                j+=1
            block=lines[i+1:j]
            rows=[x for x in block if x.strip() and not x.startswith("#")]
            other=[x for x in block if not (x.strip() and not x.startswith("#"))]
            rows.sort(key=lambda x:int(x.split(":")[1]))
            # keep blank-line spacing: rebuild as header, blank, rows, blanks
            while rows and rows[-1].strip()=="":
                rows.pop()
            newblock=[x for x in other if x.strip()!=x.strip().rstrip()][:1] + ([""] if rows else []) + rows + [""]
            out.append(r); out.extend(newblock)
            i=j
            continue
        out.append(r); i+=1
    open(p,'w').write("\n".join(out))
print("ok")
