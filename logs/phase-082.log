#[derive(Clone, Debug, PartialEq, Eq)]
struct Block {
    doc: String,
    /// 1-based line of the opening fence.
    line: usize,
    body: String,
    /// False when the document ends before the closing fence.
    closed: bool,
}

impl Block {
    /// The `doc:line` key both data files are matched on.
    fn key(&self) -> String {
        format!("{}:{}", self.doc, self.line)
