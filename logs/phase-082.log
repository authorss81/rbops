import difflib, json, os, subprocess
DOCS = ["SPEC.md", "README.md", "PHILOSOPHY.md", "HANDOUT.md", "docs/GRAMMAR.md"]
def blocks(path):
    lines = open(path, encoding="utf-8").read().split("\n")
    out, i = [], 0
    while i < len(lines):
        t = lines[i].strip()
        if t.startswith("```"):
            info = t[3:].strip()
            first = info.split()[0] if info.split() else ""
            if first == "redblue":
                j = i + 1; body = []
                while j < len(lines) and not lines[j].strip().startswith("```"):
                    body.append(lines[j]); j += 1
                out.append((i + 1, "\n".join(body))); i = j + 1; continue
        i += 1
    return out
def align(oldp, newp):
    old, new = blocks(oldp), blocks(newp)
    sm = difflib.SequenceMatcher(None, [b for _, b in old], [b for _, b in new], autojunk=False)
    m = {}
    for tag, i1, i2, j1, j2 in sm.get_opcodes():
        if tag == "equal" or (tag == "replace" and (i2-i1) == (j2-j1)):
            for k in range(i2-i1): m[new[j1+k][0]] = old[i1+k][0]
    return m
def rows(p):
    out = {}
    for line in open(p, encoding="utf-8").read().split("\n"):
        if not line.strip() or line.startswith("#"): continue
        k, _, v = line.partition("\t")
        k = k.rstrip(); doc, ln = k.rsplit(":", 1)
        out[(doc, int(ln))] = v.strip()
    return out
# reasons from the pre-089 buckets
pre = {}
for b, p in [("RUNS","target/tmp/pre089_runs.txt"),("FRAG","target/tmp/pre089_frag.txt"),("KF","target/tmp/pre089_kf.txt")]:
    for k, v in rows(p).items(): pre[k] = (b, v)
