def section(doc):
    header="# --- "+doc+" "
    start=next(i for i,r in enumerate(lines) if r.startswith(header))
    later=[i for i,r in enumerate(lines) if r.startswith("# --- ") and i>start]
    return (later[0] if later else len(lines))

