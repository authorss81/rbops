import re, sys, os
DOCS = ["SPEC.md", "README.md", "PHILOSOPHY.md", "HANDOUT.md", "docs/GRAMMAR.md"]

def blocks(path):
    lines = open(path, encoding="utf-8").read().split("\n")
    out = []
    i = 0
    while i < len(lines):
        t = lines[i].strip()
        if t.startswith("```"):
            info = t[3:].strip()
            first = info.split()[0] if info.split() else ""
            if first == "redblue":
                start = i
                j = i + 1
                body = []
                while j < len(lines) and not lines[j].strip().startswith("```"):
                    body.append(lines[j]); j += 1
                out.append((start + 1, "\n".join(body)))
                i = j + 1
                continue
        i += 1
    return out

def entries(path):
    out = []
    for ln in open(path, encoding="utf-8"):
        ln = ln.rstrip("\n")
        if not ln or ln.startswith("#"):
            continue
        out.append(ln)
    return out

