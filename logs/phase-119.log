+/// A session name is text, and text is not ASCII. A name of emoji, CJK or a
+/// right-to-left script comes back out of the listing as it went in, and a
+/// combining mark is part of the name rather than a decoration on it.
+#[test]
+fn edge_a_unicode_session_name_is_listed_as_it_was_written() {
+    let (mut repl, path) = session_with_label_file("labels-unicode");
+    let now = labels::now_epoch();
+
+    for name in [" debugging \u{1F41B}", "\u{8FFD}\u{8E64}", "\u{627}\u{644}\u{639}\u{628}"] {
+        repl.label_session(Some(name))
+            .expect("a name in any script is a name");
+    }
+    let mut expected = vec![
+        "\u{1F41B}".to_string(),
+        "\u{8FFD}\u{8E64}".to_string(),
+        "\u{644}\u{639}\u{628}\u{627}".to_string(),
+    ];
+    expected.sort();
+
+    assert_eq!(
+        labels::used(&path, now).expect("the listing should be readable"),
+        expected,
+        "each name survives the round trip, trimmed and in order"
+    );
+}
+
+/// The record file grows by a line per named session and nothing ever
+/// removes one, so there is a cap on what it holds. Asserted on both
+/// sides of it: a file past the cap is refused rather than read into
+/// memory to answer a question about the last week, and it is not
+/// appended to either — a listing that grows without stopping is the
+/// unbounded resource use.
+#[test]
+fn edge_a_label_file_past_its_cap_is_refused_rather_than_read() {
+    let (mut repl, path) = session_with_label_file("labels-cap");
+    let filler = "n".repeat(1023);
+    let mut oversized = String::new();
+    while oversized.len() < labels::MAX_FILE_BYTES + 1 {
+        oversized.push_str(&format!("1\t{filler}\n"));
+    }
+    std::fs::write(&path, &oversized).expect("the file should be writable");
+
+    let before = std::fs::metadata(&path).expect("the file should be readable").len();
+    assert!(
+        labels::used(&path, NOW).is_err(),
+        "a file past the cap is refused, not read"
+    );
+    assert!(
+        repl.label_session(Some("refused")).is_err(),
+        "and naming a session does not append to it either"
+    );
+    assert_eq!(
+        std::fs::metadata(&path).expect("the file should be readable").len(),
+        before,
+        "the file is exactly as long as it was"
+    );
+}
+
 /// The listing is a listing of *this week*. A record from eight days ago
 /// is not what the user asked for, and a record dated in the future is
 /// not a record at all — a clock that disagrees with itself does not get
 /// to invent a session.

