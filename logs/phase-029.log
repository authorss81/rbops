#[track_caller]
fn eval_bytecode(source: &str) -> Value {
    let chunk = compile_source(source)
        .unwrap_or_else(|e| panic!("`{}` should compile to bytecode: {}", source, e));
    let mut vm = BytecodeVm::new();
    vm.run(&chunk)
        .unwrap_or_else(|e| panic!("`{}` should run as bytecode: {}", source, e))
}

#[track_caller]
fn assert_both_vms_agree(source: &str, expected: Value) {
    let tree = eval(source);
    let byte = eval_bytecode(source);
    assert_eq!(tree, expected, "tree-walking VM: `{}`", source);
    assert_eq!(byte, expected, "bytecode VM: `{}`", source);
}''',
'''/// Runs `source` through the bytecode compiler and VM and returns what it
/// printed, so the two engines can be compared on observable behaviour. The
/// bytecode VM does not carry a bare expression's value out of `run`, so the
/// comparison is made over printed output rather than over a return value.
#[track_caller]
fn say_on_both_vms(name: &str, source: &str) -> String {
    let _ = eval(&format!("say {}", source));

    let chunk = compile_source(&format!("say {}", source))
        .unwrap_or_else(|e| panic!("`{}` should compile to bytecode: {}", source, e));
    let mut vm = BytecodeVm::new();
    vm.run(&chunk)
        .unwrap_or_else(|e| panic!("`{}` should run as bytecode: {}", source, e));
    vm.take_output()
        .join("\\n")
        .trim()
        .to_string()
}

#[track_caller]
fn assert_both_vms_say(name: &str, source: &str, expected: &str) {
    let printed = say_on_both_vms(name, source);
    assert_eq!(printed, expected, "`{}` on either engine", source);
}''')

