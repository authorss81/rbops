+/// The formatter has to write `in` back the way the parser reads it, or
+/// `rb format` turns a valid program into one that no longer parses. `mod` has
+/// a symbol, so it may legitimately normalise to `%`.
+#[test]
+fn edge_the_formatter_round_trips_the_word_forms() {
+    for (name, program) in [
+        (
+            "is-in",
+            "if \"a\" is in [\"a\", \"b\"] then\n    say \"yes\"\nend\n",
+        ),
+        ("mod", "set m to 10 mod 3\nsay m\n"),
+    ] {
+        let (ok, _, stderr) = rb_run(
+            &format!("fmt-{}-check", name),
+            &format!("// {}\n", program),
+        );
+        assert!(ok, "the {} program should run: {}", name, stderr);
+
+        let (ok, stdout, stderr) = rb_run(
+            &format!("fmt-{}-run", name),
+            &format!("{}{}", "", program),
+        );
+        assert!(ok, "`rb run` on the {} program failed: {}", name, stderr);
+        assert!(!stdout.is_empty(), "`{}` printed nothing", name);
+    }
+
+    // The formatted source must still parse, and must still mean the same thing.
+    let formatted = redblue::formatter::format("if \"a\" is in [\"a\"] then\nsay 1\nend\n")
+        .expect("source should format");
+    let formatted = formatted.expect("format should produce output");
+    assert!(
+        formatted.contains("is in"),
+        "the formatter must write membership back as `is in`, got {:?}",
+        formatted
+    );
+    let ast = parse(tokens(&formatted))
+        .unwrap_or_else(|e| panic!("formatted source should parse: {}", e));
+    let mut vm = redblue::Vm::new();
+    vm.run(&ast).expect("formatted source should run");
+    assert_eq!(vm.take_output(), vec!["1".to_string()]);
+}
+
