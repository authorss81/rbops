name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

env:
  CARGO_TERM_COLOR: always

jobs:
  # The fast tier. Everything here is cheap and catches the mistakes that
  # happen most often: a lint, a type error, a doc example that no longer runs,
  # a claim in README.md that has drifted from the corpus.
  fast:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          # Full history is REQUIRED, not an optimisation.
          # unreviewed_work_ack_test audits every commit in git log HEAD, and
          # actions/checkout defaults to a depth-1 clone. A truncated log reads
          # as a clean one, so that test refuses to read it rather than pass.
          fetch-depth: 0
      - uses: actions-rust-lang/setup-rust-toolchain@v1
      - uses: actions/cache@v4
        with:
          path: target
          key: cargo-target-${{ hashFiles('Cargo.lock') }}-${{ github.sha }}
          restore-keys: |
            cargo-target-${{ hashFiles('Cargo.lock') }}-
      - run: cargo build --verbose
      # Formatting is cheap and it is gate #1 in AGENTS.md, so it belongs in the
      # fast tier: a misformatted line should fail in seconds rather than after
      # the slowest shard. This used to be omitted on the claim that the tree was
      # not fmt-clean. That claim was wrong - the check had never run - and the
      # tree passes today.
      - run: cargo fmt --all -- --check
      - run: cargo clippy -- -D warnings
      # Unit tests only. The integration targets are sharded below because they
      # hold the 361-program corpus differential harness, which dominates.
      - run: cargo test --lib
      # Docs that can't go stale: every ```redblue block in README.md is a real
      # program and must exit 0. Reference-style fences (no language tag) are
      # illustrative API listings and are not executed. Each block runs in its
      # own temp dir so file-writing examples can't dirty the tree.
