    std::fs::create_dir_all(&empty).expect("scratch directory");
    std::fs::write(dir.join("z.txt"), "z").unwrap();
    std::fs::write(dir.join("a.txt"), "a").unwrap();

    let source = format!(
        r#"say path.list("{dir}")
say path.list("{empty}")"#,
