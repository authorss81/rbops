/// A named record made through the same builtin a program uses.
#[track_caller]
fn named_record(names: &[&str], values: Vec<Value>) -> Value {
    builtin_value(
        "collections_namedtuple",
        &[
            Value::list(
                names
                    .iter()
                    .map(|name| Value::Text((*name).to_string()))
                    .collect(),
            ),
            Value::list(values),
        ],
    )
}

