 for (const [what, source] of [
   ["network", 'say network.get("https://example.test")'],
   ["time.sleep", 'time.sleep(0.01)\nsay "unreachable"'],
   ["input", 'say input("what is your name? ")'],
+  ["path.resolve", 'say path.resolve("data")'],
 ]) {
