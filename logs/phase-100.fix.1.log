#[test]
fn edge_an_object_named_deque_still_needs_the_kind_marker() {
    for (how, fields) in [
        (
            "without a kind",
            named_record(
                &["front", "back"],
                vec![Value::list(Vec::new()), Value::list(Vec::new())],
            ),
        ),
        (
            "with the wrong kind",
            named_record(
                &["kind", "front", "back"],
                vec![
                    Value::Text("not a deque".to_string()),
                    Value::list(Vec::new()),
                    Value::list(Vec::new()),
                ],
            ),
        ),
    ] {
        let Value::Record(fields) = fields else {
            panic!("named_record builds a record")
        };
        let forged = Value::object("deque".to_string(), (*fields).clone());
        let error = redblue::stdlib::builtin(Span::new(1, 1), "collections_pop_left", &[forged])
            .expect_err("an object named deque must still carry the kind marker");
        assert!(
            error
                .to_string()
                .contains("value made by collections.deque"),
            "an object named deque {how} must not be trusted: {error}"
        );
    }
}

#[test]
fn edge_a_source_declared_object_named_deque_cannot_pose_as_a_trusted_deque() {
    // `back` is a reserved word, so an `object deque` declaration cannot even
    // spell one of the three fields. The declaration binds a record, not the
    // private `Object` a module deque is, and taking the untrusted record path
    // refuses it rather than trusting the name.
    let source = "object deque\n\
                  has kind default \"deque\"\n\
                  has front default []\n\
                  end\n\
                  say collections.pop_left(deque)";
    both_refuse(source, "value made by collections.deque");
}

