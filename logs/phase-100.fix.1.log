/// The one path argument `name` takes, as text.
fn one_path(span: Span, name: &str, args: &[Value]) -> Result<String> {
    match args {
        [arg] => text_of(arg)
            .map(str::to_string)
            .ok_or_else(|| Error::Runtime(format!("{name} requires a text path"), span)),
        _ => Err(Error::Runtime(
            format!("{name} requires one text path"),
            span,
        )),
    }
}

