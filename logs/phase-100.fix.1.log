fn lock() -> MutexGuard<'static, Store> {
        store()
            .lock()
            .unwrap_or_else(|poisoned| poisoned.into_inner())
    }

    pub fn read_to_string(path: &str) -> io::Result<String> {
        let key = file_key(path)?;
