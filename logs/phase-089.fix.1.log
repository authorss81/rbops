import re, subprocess

DOCS = ["SPEC.md", "docs/GRAMMAR.md", "PHILOSOPHY.md", "HANDOUT.md", "README.md"]
FILES = ["tests/doc_blocks_runs.txt", "tests/doc_blocks_fragments.txt", "tests/doc_blocks_known_fail.txt"]

def block_lines(text):
    return [i for i, line in enumerate(text.split("\n"), start=1) if line.strip() == "```redblue"]

for doc in DOCS:
    old = block_lines(subprocess.run(["git", "show", f"HEAD:{doc}"], capture_output=True, text=True).stdout)
    new = block_lines(open(doc).read())
    if len(old) != len(new):
        print(f"{doc}: BLOCK COUNT CHANGED {len(old)} -> {len(new)}")
        continue
    moved = sum(1 for a, b in zip(old, new) if a != b)
    print(f"{doc}: {len(new)} blocks, {moved} moved")
    if not moved:
        continue
    mapping = dict(zip(old, new))
    for path in FILES:
        out = []
        for line in open(path).read().split("\n"):
            m = re.match(rf"^({re.escape(doc)}):(\d+)(.*)$", line)
            if m and int(m.group(2)) in mapping:
                line = f"{doc}:{mapping[int(m.group(2))]}{m.group(3)}"
            out.append(line)
        open(path, "w").write("\n".join(out))
