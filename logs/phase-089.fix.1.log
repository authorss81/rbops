import re

DOCS = ["SPEC.md", "docs/GRAMMAR.md", "PHILOSOPHY.md", "HANDOUT.md", "README.md"]
FILES = ["tests/doc_blocks_runs.txt", "tests/doc_blocks_fragments.txt", "tests/doc_blocks_known_fail.txt"]

def block_lines(path):
    return [i for i, line in enumerate(open(path).read().split("\n"), start=1) if line.strip() == "```redblue"]

blocks = {doc: block_lines(doc) for doc in DOCS}
contents = {path: open(path).read().split("\n") for path in FILES}

for doc in DOCS:
    entries = []  # (path, index, old key)
    for path in FILES:
        for idx, line in enumerate(contents[path]):
            m = re.match(r"^%s:(\d+)(.*)$" % re.escape(doc), line)
            if m:
                entries.append((path, idx, int(m.group(1))))
    keys = sorted(k for _, _, k in entries)
    want = blocks[doc]
    assert len(keys) == len(want), f"{doc}: {len(keys)} keys but {len(want)} blocks"
    assert len(set(keys)) == len(keys), f"{doc}: duplicate keys"
    mapping = dict(zip(keys, want))
    changed = 0
    for path, idx, old in entries:
        new = mapping[old]
        if old != new:
            contents[path][idx] = re.sub(r"^%s:\d+" % re.escape(doc), f"{doc}:{new}", contents[path][idx])
            changed += 1
    print(f"{doc}: {len(want)} blocks, {changed} keys moved")

for path in FILES:
    open(path, "w").write("\n".join(contents[path]))
