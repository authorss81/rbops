import re

DOCS = ["SPEC.md", "docs/GRAMMAR.md", "PHILOSOPHY.md", "HANDOUT.md", "README.md"]
FILES = ["tests/doc_blocks_runs.txt", "tests/doc_blocks_fragments.txt", "tests/doc_blocks_known_fail.txt"]

def block_lines(path):
    return [i for i, line in enumerate(open(path).read().split("\n"), start=1) if line.strip() == "```redblue"]

blocks = {doc: block_lines(doc) for doc in DOCS}

for path in FILES:
    lines = open(path).read().split("\n")
    # collect, per doc, the (index in file, key line) pairs in file order
    per_doc = {doc: [] for doc in DOCS}
    for idx, line in enumerate(lines):
        m = re.match(r"^([\w./-]+\.md):(\d+)(.*)$", line)
        if m and m.group(1) in per_doc:
            per_doc[m.group(1)].append((idx, int(m.group(2))))
    for doc, entries in per_doc.items():
        want = blocks[doc]
        got = [k for _, k in entries]
        assert len(got) == len(want), f"{doc}: {len(got)} keys but {len(want)} blocks"
        assert got == sorted(got), f"{doc}: keys are not in document order"
        for (idx, old), new in zip(entries, want):
            if old != new:
                lines[idx] = re.sub(r"^%s:\d+" % re.escape(doc), f"{doc}:{new}", lines[idx])
    open(path, "w").write("\n".join(lines))
    print("rekeyed", path)
