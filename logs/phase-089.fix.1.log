import re
lines = open('bootstrap/compiler.rb').read().split('\n')
depth = 0
stack = []
found = []
for i, l in enumerate(lines):
    s = l.strip()
    if s.startswith('to '):
        stack.append((i+1, depth))
    # track then-blocks
    if re.search(r'\bthen$', s) or s.endswith('do') :
        stack.append(('blk', i+1, depth))
    if s == 'end' or s.endswith(' end'):
        if stack: stack.pop()
    if s.startswith('give back'):
        # find enclosing if blocks
        enclosing = [x for x in stack if x[0]=='blk' if isinstance(x[0], str)]
        if enclosing:
            found.append((i+1, enclosing[-1][1]))
print(len(found))
for f in found[:15]:
    print(f)
EOF
