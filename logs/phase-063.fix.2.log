    // for it would step the caret over a column that is on the line.
    if c == '\t' {
        return 1;
    }
    let code = c as u32;
    if c.is_control() || in_ranges(code, ZERO_WIDTH) {
        0
    } else if in_ranges(code, WIDE) {
        2
    } else {
        1
    }
}

