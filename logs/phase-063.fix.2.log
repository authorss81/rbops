/// changing what is around them.
///
/// The ranges are the ones a terminal draws in no cell — the zero-width marks
/// — plus the bidi isolates: a mark that is drawn in no cell is still drawn,
/// and a row it reorders is a row the reader cannot read.
fn mangles_the_terminal(c: char) -> bool {
    c.is_control()
        || matches!(
            c,
            '\\u{200B}'..='\\u{200F}'
                | '\\u{2028}'..='\\u{202E}'
