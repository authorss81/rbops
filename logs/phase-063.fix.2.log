/// `.json` is a document first and a terminal rendering second.
///
/// The characters a terminal acts on are written as the value holds them,
/// because the document `.json` prints is the document `json.stringify`
/// writes — and a document that differed from the language's own writer would
/// be a document no program could produce. `.pretty` is the rendering that
/// spells them out, in JSON's own escape, so what it writes is still a
/// document.
#[test]
fn edge_the_json_document_writes_the_marks_a_terminal_would_act_on_as_they_are() {
    let out = session(concat!(
        ".json \"\\u202e\"\n",
        ".pretty \"\\u202e\"\n",
        ":quit\n"
    ));

    let document = after_prompt(&out, 0);
    assert!(
        document.contains('\u{202e}'),
        "the document holds the mark as the value holds it\n--- actual ---\n{:?}",
        document.escape_debug()
    );

    let rendering = after_prompt(&out, 1);
    assert!(
        !rendering.contains('\u{202e}'),
        "and the rendering spells it out\n--- actual ---\n{:?}",
        rendering.escape_debug()
    );
    assert!(
        rendering.contains("\\u202e"),
        "in JSON's own escape, so what it writes is still a document\n--- actual ---\n{:?}",
        rendering.escape_debug()
    );
}

