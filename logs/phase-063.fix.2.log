    #[test]
    fn edge_the_json_document_is_the_language_s_own_writer_s_document() {
        let value = record(vec![
            ("name", Value::Text("ada".to_string())),
            ("count", Value::Number(3.0)),
            ("flag", Value::YesNo(true)),
            ("missing", Value::Nothing),
