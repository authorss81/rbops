old=s[s.index('fn regenerating_the_corpus_writes_exactly_what_the_generator_produces() {'):s.index('// -- 2. the two engines agree')]
new = '''fn edge_regenerating_the_corpus_reproduces_the_checked_in_one_byte_for_byte() {
    // Regeneration is run into a scratch directory and compared against what is
    // checked in, so the claim "the corpus on disk is what the generator
    // produces" is asserted by an ordinary `cargo test` rather than by a command
    // somebody has to remember to run. `RB_WRITE_CORPUS=1` still refreshes
    // `corpus/` in place, for when the generator has deliberately changed.
    let scratch = std::path::Path::new(env!("CARGO_MANIFEST_DIR"))
        .join("target/tmp/corpus-regenerated");
    let _ = std::fs::remove_dir_all(&scratch);
    std::fs::create_dir_all(&scratch).expect("scratch dir should be creatable");

    if writing_corpus() {
        regenerate(&corpus_dir());
    }
    regenerate(&scratch);

    let mut differences: Vec<String> = Vec::new();
    let mut checked = 0usize;
    for entry in std::fs::read_dir(&scratch).expect("the scratch corpus should be readable") {
        let path = entry.expect("a readable directory entry").path();
        let name = path
            .file_name()
            .and_then(|n| n.to_str())
            .expect("a named file")
            .to_string();
        let original = corpus_dir().join(&name);
        match std::fs::read(&original) {
            Ok(bytes) if bytes == std::fs::read(&path).expect("the regenerated file should be readable") => {}
            _ => differences.push(name),
        }
        checked += 1;
    }
    assert!(
        differences.is_empty(),
        "regenerating did not reproduce: {differences:?}"
    );
    assert_eq!(
        checked,
        generated().len() * 2,
        "regeneration wrote {} files for {} programs, so one of them is missing",
        checked,
        generated().len()
    );
}

/// Writes the whole corpus — programs and their golden files — into `dir`.
///
/// Everything in `dir` that is not a generated program or its golden file is
/// removed first, so a renamed or orphaned file cannot survive a regeneration.
/// A program is only recorded once the two engines agree on it, so the golden
/// files are never a record of one engine's opinion.
fn regenerate(dir: &Path) {
    let mut keep: Vec<String> = Vec::new();
    for stem in generated().keys() {
        keep.push(format!("{stem}.rb"));
        keep.push(format!("{stem}.expected"));
    }
    for entry in std::fs::read_dir(dir).expect("corpus directory should be readable") {
        let path = entry.expect("a readable directory entry").path();
        let name = path
            .file_name()
            .and_then(|n| n.to_str())
            .unwrap_or_default()
            .to_string();
        if !keep.contains(&name) {
            std::fs::remove_file(&path)
                .unwrap_or_else(|e| panic!("{} should be removable: {e}", path.display()));
        }
    }

    let mut written = 0usize;
    for (name, source) in generated() {
        let program = dir.join(&name);
        std::fs::write(&program, &source)
            .unwrap_or_else(|e| panic!("{} should be writable: {e}", program.display()));
        let tree = tree_walk(&source);
        let byte = bytecode(&source);
        assert_eq!(
            tree, byte,
            "{name}: a corpus program is only recorded once the two engines agree \\
             on it, so the goldens are not a record of one engine's opinion"
        );
        write_expected(&program, &tree);
        written += 1;
    }
    assert!(
        written >= MINIMUM_CORPUS,
        "only {written} programs were written, not {MINIMUM_CORPUS}"
    );
}

'''
