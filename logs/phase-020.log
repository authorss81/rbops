[0m$ [0mpython3 - <<'PY'
p = "tests/common/vm.rs"
s = open(p).read()
s = s.replace('''/// Runs `source` on the tree-walking VM.
///
/// A program that does not lex, parse or analyze has *failed*, and that failure
/// is the outcome rather than a panic: the corpus deliberately contains
/// malformed programs, and how each is reported is part of what is compared.
pub fn tree_walk(source: &str) -> Outcome {
    let tokens = match redblue::lexer::Lexer::tokenize(source) {
        Ok(tokens) => tokens,
        Err(error) => return failed(failure_of(&error)),
    };
    let ast = match redblue::parser::parse(tokens) {
        Ok(ast) => ast,
        Err(error) => return failed(failure_of(&error)),
    };
    if let Err(error) = redblue::analyzer::analyze(&ast) {
        return failed(failure_of(&error));
    }
    let (mut vm, result) = run_isolated(&ast);
    Outcome {
        output: vm.take_output(),
        result: result
            .map(|value| value.to_string())
            .map_err(|error| failure_of(&error)),
    }
}''','''/// The failure `source` produced on the tree-walking VM, with its position.
///
/// `None` when it ran to completion. This is the one place the frontend pipeline
/// is spelled out: a second copy in a test that wanted the `Span` would be a
/// second pipeline, and two pipelines drift — the first version of this helper
/// returned `None` for a lexer and a parser error, because it only kept the
/// analyzer's and the VM's, and reported as a corpus defect a program the
/// corpus had recorded correctly.
pub fn tree_walk_failure(source: &str) -> Option<Error> {
    let tokens = match redblue::lexer::Lexer::tokenize(source) {
        Ok(tokens) => tokens,
        Err(error) => return Some(error),
    };
    let ast = match redblue::parser::parse(tokens) {
        Ok(ast) => ast,
        Err(error) => return Some(error),
    };
    if let Err(error) = redblue::analyzer::analyze(&ast) {
        return Some(error);
    }
    let (_vm, result) = run_isolated(&ast);
    result.err()
}

/// Runs `source` on the tree-walking VM.
///
/// A program that does not lex, parse or analyze has *failed*, and that failure
/// is the outcome rather than a panic: the corpus deliberately contains
/// malformed programs, and how each is reported is part of what is compared.
pub fn tree_walk(source: &str) -> Outcome {
    if let Some(error) = tree_walk_failure(source) {
        return failed(failure_of(&error));
    }
    let tokens = redblue::lexer::Lexer::tokenize(source).expect("the lexer succeeded");
    let ast = redblue::parser::parse(tokens).expect("the parser succeeded");
    let (mut vm, result) = run_isolated(&ast);
    Outcome {
        output: vm.take_output(),
        result: result
            .map(|value| value.to_string())
            .map_err(|error| failure_of(&error)),
    }
}''')
