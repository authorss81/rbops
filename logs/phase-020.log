        assert!(
            shrinks_to("aa", "aaa", &mut |_| true),
            "a shorter candidate the predicate accepts must be taken"
        );
        assert!(
            !shrinks_to("aaa", "aaa", &mut |_| true),
            "an equal-length candidate is not progress; accepting one is an \\
