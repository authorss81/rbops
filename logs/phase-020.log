new = '''/// A random program.
///
/// The grammar is typed rather than arbitrary: an expression is generated for a
/// requested type and only combined with operands of that type, so a generated
/// program runs rather than falling over on a type error three lines in. Faults
/// are injected deliberately and rarely, which keeps the mix — some programs
/// complete, some fail — meaningful instead of every program failing.
///
/// What the grammar cannot guarantee is that nothing panics, and that is one of
/// the properties asserted below rather than an assumption made here.
fn random_program(rng: &mut Rng) -> String {
    let mut source = format!(
        "set n to {}\\nset t to {}\\nset b to {}\\n\\
         say n\\nsay t\\nsay b\\nsay type_of(n)\\nsay length(t)\\n",
        typed_expression(rng, 2, Kind::Number),
        typed_expression(rng, 2, Kind::Text),
        typed_expression(rng, 1, Kind::YesNo)
    );
    source.push_str(&random_statement(rng, 0));
    if rng.chance(8) {
        source.push_str(&random_fault(rng));
    }
    source
}

/// What an expression is generated to produce.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
enum Kind {
    Number,
    Text,
    YesNo,
}

/// A random expression of the requested kind.
fn typed_expression(rng: &mut Rng, depth: usize, kind: Kind) -> String {
    if depth == 0 || rng.chance(4) {
        return literal(rng, kind);
    }
    match kind {
        Kind::Number => {
            let left = typed_expression(rng, depth - 1, Kind::Number);
            match rng.below(5) {
                0 => format!("({left} + {})", rng.between(-9, 9)),
                1 => format!("({left} - {})", rng.between(-9, 9)),
                2 => format!("({left} * {})", rng.between(0, 9)),
                3 => format!("abs({left})"),
                _ => format!("floor({left})"),
            }
        }
        Kind::Text => {
            let left = typed_expression(rng, depth - 1, Kind::Text);
            match rng.below(4) {
                0 => format!("uppercase({left})"),
                1 => format!("trim({left})"),
                2 => format!("length({left}) as text"),
                _ => format!("({left} + \\"-\\" + {left})"),
            }
        }
        Kind::YesNo => format!(
            "({} is {})",
            typed_expression(rng, depth - 1, Kind::Number),
            typed_expression(rng, depth - 1, Kind::Number)
        ),
    }
}

/// A literal of the requested kind.
fn literal(rng: &mut Rng, kind: Kind) -> String {
    match kind {
        Kind::Number => match rng.below(3) {
            0 => format!("{}.5", rng.between(0, 9)),
            1 => format!("-{}", rng.between(0, 9)),
            _ => rng.between(-9, 9).to_string(),
        },
        Kind::Text => {
            format!("\\"{}\\"", rng.pick(&["", "x", "hello", "é", "🎉", "a b c"]))
        }
        Kind::YesNo => (*rng.pick(&["yes", "no"])).to_string(),
    }
}

/// A random statement over the three names `random_program` binds.
///
/// The names keep their types — `n` a number, `t` text, `b` a yes/no — so the
/// program stays well-typed from its first statement to its last.
fn random_statement(rng: &mut Rng, depth: usize) -> String {
    match (depth, rng.below(6)) {
        (0, 0) => format!("set n to {}\\n", typed_expression(rng, 2, Kind::Number)),
        (0, 1) => format!("set t to {}\\n", typed_expression(rng, 2, Kind::Text)),
        (_, 2) => "say (b is yes)\\n".to_string(),
        (_, 3) => "say length(t)\\n".to_string(),
        (0, _) => format!("say t\\nsay {}\\n", typed_expression(rng, 1, Kind::Number)),
        (_, 4) => {
            "if b is yes\\n    say \\"yes branch\\"\\nelse\\n    say \\"no branch\\"\\nend\\n"
                .to_string()
        }
        (_, _) => format!(
            "repeat {} times\\n    say n\\nend\\n{}",
            rng.between(0, 3),
            random_statement(rng, depth - 1)
        ),
    }
}

/// A statement that must fault at runtime.
///
/// Injected rather than generated, because a fault that falls out of the
/// grammar by accident proves nothing: these are the programs whose failure is
/// the point.
fn random_fault(rng: &mut Rng) -> String {
    let faults: &[&str] = &[
        "set xs to [n]\\nsay xs[9]",
        "set xs to [n]\\nsay xs[-9]",
        "set r to {a: n}\\nsay r[0]",
        "set bad to 1 / 0",
        "set bad to 0 / 0",
        "set bad to n + t",
        "say nothing.missing",
        "set bad to [n] + n",
    ];
    format!("{}\\n", rng.pick(faults))
}

/// Runs a program on the tree-walking VM.
///
/// A panic anywhere in the frontend or the VM fails the test here, at the
/// property, with the program that caused it — rather than aborting the whole
/// test binary with no indication of which of hundreds of programs did it.
fn tree_walk_or_panic(source: &str, context: &str) -> Outcome {
    assert!(
        !source.trim().is_empty(),
        "{context}: the generator produced an empty program"
    );
    tree_walk(source)
}

