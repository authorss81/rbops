/// A failure and where it happened.
///
/// `Error` is not `Copy` and the position has to be read out of it before it is
/// moved anywhere, so the two travel together in one type rather than as a
/// tuple that would have to copy the position out first.
#[derive(Debug, Clone)]
pub struct Failure {
    pub error: Error,
    pub span: Option<Span>,
}

impl Failure {
