    // Each word is a *value*; the escaping is this function's job, because a
    // word is free to hold a quote or a backslash and the source literal has to
    // survive that. Splicing a raw word into quotes produced
    // `("a b" + "a"b")` — a `LexerError` from a program the grammar meant to be
    // well-typed, which is exactly the failure `text_literal` existing as a
    // separate function was supposed to prevent.
    let words = ["a", "bb", "ccc", "", "a b", "日本", "🎉", "x\\y", "#value 1", "a\\"b"];
    let word = rng.pick(&words);
    let mut out = String::with_capacity(word.len() + 2);
    out.push('"');
