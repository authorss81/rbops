    let message = reported
        .err()
        .map(|payload| *payload.downcast::<String>().expect("the loader panics with a String"))
        .unwrap_or_default();
    assert!(
        message.contains("orphan.expected"),
        "a corpus program with no .expected file was loaded without a failure; the \\
         panic said {message:?}"
    );
}''')

s=s.replace('''/// A failure reported as `unknown` exists and is rare.
///
/// Recorded as a count rather than a prohibition: `Error::span()` already
/// documents `unknown` as legal before a token exists, so the assertion is that
/// it is not what most failures are.
#[test]
fn edge_only_a_few_failures_are_reported_at_an_unknown_position() {
    let mut failures = 0usize;
    let mut unknown = 0usize;
    for (_, source, text) in loaded_corpus() {
        if !parse_expected(&text).is_failure() {
            continue;
        }
        failures += 1;
        if tree_walk_span(&source).1.is_none() {
            unknown += 1;
        }
    }
    assert!(failures >= 20, "only {failures} failures to look at");
    assert!(
        unknown * 2 <= failures,
        "{unknown} of {failures} failures report no position; most failures happen \\
         after a token exists and can say where"
    );
}''','''/// Nearly every recorded failure says where it happened.
///
/// `Error::span()` documents `unknown` as legal before a token exists — an `Io`
/// failure has none — so this is a proportion and not a prohibition. What it does
/// assert is that the corpus's failures are not *mostly* positionless, and that a
/// handful of named cases do carry a position, so the ratio cannot be satisfied
/// by every failure reporting `unknown`.
#[test]
fn edge_nearly_every_recorded_failure_says_where_it_happened() {
    let mut failures = 0usize;
    let mut unknown = 0usize;
    for (_, source, text) in loaded_corpus() {
        if !parse_expected(&text).is_failure() {
            continue;
        }
        failures += 1;
        if tree_walk_span(&source).1.is_none() {
            unknown += 1;
        }
    }
    assert!(failures >= 20, "only {failures} failures to look at");
    assert!(
        unknown * 2 <= failures,
        "{unknown} of {failures} failures report no position; most failures happen \\
         after a token exists and can say where"
    );

    // One named case per stage, so the ratio above cannot be satisfied by a
    // corpus in which nothing carries a position.
    for (label, source) in [
        ("LexerError", "say \\"unterminated\\n"),
        ("ParserError", "say 1\\nend\\n"),
        ("AnalyzerError", "say nosuchvariable\\n"),
        ("RuntimeError", "say [1][9]\\n"),
    ] {
        let (outcome, span) = tree_walk_span(source);
        assert_eq!(
            split_failure(outcome.result.as_ref().err().expect("must fail"))
                .map(|(label, _)| label),
            Some(label),
            "the fixture for {label} does not fail that way: {outcome:?}"
        );
        let span = span.expect("a failure after a token exists names a position");
        assert!(
            span.is_known(),
            "{label} reported {span}, which is the unknown position"
        );
    }
}''')

