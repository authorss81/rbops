        "set n to 0\nwhile n is less than 3 do\nset n to n + 1\nend\n",
        "set n to 0\nwhile n is less than 3\nset n to n + 1\nend\nsay n\n",
        "set i to 0\nwhile i is less than 3\nset i to i + 1\nend\nsay i\n",
        "for i from 1 to 3\nsay i\nend\n",
        "repeat 3 times\nsay \"x\"\nend\n",
        "to f(x)\ngive back x * 2\nend\nsay f(3)\n",
        "to f(x)\ngive back x * 2\nend\nset g to f\nsay g(3)\n",
        "set f to to(x)\ngive back x\nend\n",
        "constant K to 5\nsay K\n",
        "set K to 5\nsay K\n",
        "say 1 is 1 and 2 is 2\n",
        "say (1 + 2) * 3\n",
        "say 10 % 3\n",
        "say [1, 2] + [3]\n",
        "say \"a\" * 2\n",
        "set r to {a: 1}\nset r.b to 2\nsay r.b\n",
        "set xs to [1, 2, 3]\nset xs[0] to 9\nsay xs[0]\n",
