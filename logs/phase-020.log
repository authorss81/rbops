s=s.replace('''/// Renders a failure for a report or a golden file.''','''/// Whether two engines place the same failure in the same place.
///
/// The **line** is always comparable. The **column** is comparable only for a
/// frontend failure: a `.rbc` carries no source positions at all, so a runtime
/// failure is reported by the bytecode VM at the start of the line the
/// instruction is on, while the tree-walking VM reports the column of the
/// statement. Both answers are the one their own format can give, so the
/// difference is a property of the formats rather than a divergence in what the
/// program did — and the golden file records both halves for the tree-walking VM
/// so a change to *its* placement is still caught.
pub fn same_place(a: &Failure, b: &Failure) -> bool {
    let frontend = |failure: &Failure| matches!(failure, Failure::Label { label, .. } if label != "RuntimeError");
    match (a.position(), b.position()) {
        (Some((line_a, column_a)), Some((line_b, column_b))) => {
            line_a == line_b && (!frontend(a) || column_a == column_b)
        }
        (None, None) => true,
        _ => false,
    }
}

/// Renders a failure for a report or a golden file.''')
