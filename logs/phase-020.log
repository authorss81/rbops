+/// Whether the program's last statement is a bare expression.
+///
+/// The words that open a statement, plus `end`, which closes one. A line that
+/// starts with none of them is an expression on its own, and its value is the
+/// program's value.
+fn last_statement_is_a_bare_expression(source: &str) -> bool {
+    let last = source
+        .lines()
+        .map(str::trim)
+        .filter(|line| !line.is_empty() && !line.starts_with("//"))
+        .next_back();
+    let Some(last) = last else {
+        return false;
+    };
+    const STATEMENT_STARTS: [&str; 7] = ["set ", "say ", "if ", "repeat ", "for ", "try ", "give "];
+    !last.starts_with("end") && !STATEMENT_STARTS.iter().any(|open| last.starts_with(open))
+}
+
