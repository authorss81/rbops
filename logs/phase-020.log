/// message ended.
pub fn format_expected(outcome: &Outcome) -> String {
    let mut text = match &outcome.result {
        Ok(_) => "#label none\n".to_string(),
        Err(failure) => {
            let (label, message) = failure
                .split_once(": ")
                .unwrap_or(("RuntimeError", &**failure));
            format!("#label {label}\n#message {}\n", escape(&message))
        }
    };
    for line in &outcome.output {
        text.push_str(&escape(line));
        text.push('\n');
    }
    text
}

/// Reads a `.expected` file.
///
/// The first line names the outcome and every line after it is output, so a
/// program that prints nothing has a two-line expected file rather than an
/// empty one — an empty file and a missing file must not look alike.
pub fn parse_expected(text: &str) -> Expected {
    let mut lines = text.lines();
    let header = lines
        .next()
        .expect("an .expected file always carries a #label header line");
    let label = header
        .strip_prefix("#label ")
        .expect("an .expected file starts with '#label <label>'")
