new = '''/// One sweep of deletions over the current best, replacing it in place.
///
/// Returns whether anything was removed. Each call takes the **first** deletion
/// the predicate accepts and returns, and the caller restarts: taking a line
/// away can unblock a line that was previously load-bearing, so a single sweep
/// over a stale program would miss it.
///
/// A candidate is accepted only when it is **strictly shorter** than what is
/// already in hand. That is not a micro-optimisation — without it a predicate
/// that accepts an empty reduction never terminates: `without_line` on a
/// one-line source returns `"\\n"`, `without_line` on `"\\n"` returns `"\\n"`
/// again, and a shrinker that reads "no progress" as progress loops for ever.
/// Strictly shorter is also the only reading under which "minimal" means
/// anything.
fn pass<F>(best: &mut String, reproduces: &mut F) -> bool
where
    F: FnMut(&str) -> bool,
{
    let current = best.clone();

    let lines: Vec<&str> = current.lines().collect();
    for index in 0..lines.len() {
        let mut candidate = lines.clone();
        candidate.remove(index);
        let joined = join_lines(&candidate);
        if joined.len() < current.len() && reproduces(&joined) {
            *best = joined;
            return true;
        }
    }

    let characters: Vec<char> = current.chars().collect();
    for index in 0..characters.len() {
        let mut candidate = characters.clone();
        candidate.remove(index);
        let text: String = candidate.into_iter().collect();
        if text.len() < current.len() && reproduces(&text) {
            *best = text;
            return true;
        }
    }

    false
}

/// Joins lines back into a source, keeping a trailing newline.
///
/// `lines.join("\\n")` plus one newline, so a source that ended with a newline
/// still does. Used by both [`without_line`] and [`pass`], so the shrinker and
/// the thing its minimality is asserted against cannot drift apart.
fn join_lines(lines: &[impl AsRef<str>]) -> String {
    let mut out: String = lines
        .iter()
        .map(|line| line.as_ref().to_string())
        .collect::<Vec<String>>()
        .join("\\n");
    out.push('\\n');
    out
}

