/// The expression the arm at `index` of `kind`'s table builds.
///
/// Built by index rather than by drawing, so a test can ask about *that* arm.
/// A test that recomputed the draw instead would be a second implementation, and
/// a second implementation agrees with a bug.
pub fn arm_at(rng: &mut Rng, kind: Kind, index: usize, depth: usize) -> String {
    let table = arms(kind);
    let (_, build) = &table[index % table.len()];
    build(rng, depth + 1)
