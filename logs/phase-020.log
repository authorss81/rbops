    /// Compiles a nested declaration, adds it to `blocks` and returns its
    /// index.
    ///
    /// The index is what the parent instruction carries, so `blocks` is in the
    /// order the compiler emitted the bodies in.
    fn nested(&mut self, decl: Decl<'_>, depth: usize, blocks: &mut Vec<Block>) -> Result<u32> {
        let block = self.block(decl, depth + 1)?;
        let index = blocks.len() as u32;
        blocks.push(block);
        Ok(index)
    }

/// Whether a block of this kind is worth the value of its last statement.
///
/// Three kinds are: `main`, because `run` answers the whole program's value with
/// it; a `Function` and a `Method`, because a call's answer is the value its
/// body ends with. Every other kind is entered for its effect, so its last
/// statement is a statement and leaves nothing behind — that is the tree-walking
/// VM's rule, and `docs/BYTECODE.md`'s stack discipline ("an expression leaves
/// its value on top, and a statement leaves nothing behind") is about the
/// program, not about each block in it. A block that kept its last expression
/// would leave a stray value on the operand stack of the block that entered it,
/// which the frame would then hand to *its* caller.
fn carries_its_last_expression(kind: BlockKind) -> bool {
    matches!(
        kind,
        BlockKind::Main | BlockKind::Function | BlockKind::Method
    )
}

