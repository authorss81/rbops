/// Prints a handful of generated programs and what each is worth.
///
/// A failure in a property test names a seed, and a seed is only actionable if
/// the program behind it can be seen. The generated programs are not checked in,
/// so without this there is no way to look at one.
#[test]
fn edge_a_generated_program_can_be_seen() {
    let seed = property_seed();
    for offset in 0..4 {
        let program = generate(seed.wrapping_add(offset as u64));
        let tree = tree_walk(&program.source);
        println!(
            "=== seed {} fault {:?}\\n{}--- tree {tree:?}\\n--- bytecode {:?}",
            offset,
            program.fault,
            program.source,
            bytecode(&program.source).result
        );
    }
    assert!(
        generate(seed).source.contains('\\n'),
        "a generated program is several lines, so the report shows one"
    );
}''')
open(p,'w').write(s)
