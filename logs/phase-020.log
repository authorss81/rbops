impl Kind {
    /// Every kind, so a test can ask that each is reachable.
    pub const ALL: [Kind; 5] = [
        Kind::Number,
        Kind::Text,
        Kind::YesNo,
        Kind::List,
        Kind::Record,
    ];

    /// The name `type_of` prints for the kind's values.
    pub fn type_name(self) -> &'static str {
        match self {
            Kind::Number => "number",
            Kind::Text => "text",
            Kind::YesNo => "yes/no",
            Kind::List => "list",
            Kind::Record => "record",
        }
    }

    /// The indices of `rng` that are bound and readable under this name.
    fn bound_index(self, index: usize) -> Option<usize> {
        match (self, index) {
            (Kind::Number, 0) => Some(0),
            (Kind::Text, 0) | (Kind::Text, 1) => Some(0),
            (Kind::YesNo, 0) => Some(0),
            (Kind::List, 0) => Some(0),
            (Kind::Record, 0) | (Kind::Record, 1) => Some(0),
            _ => None,
        }
    }
}

/// Every number the number arms can draw from.
