            "{name}: .expected says {} but the generator says the program {}",
            if expected.is_failure() { "it fails" } else { "completes" },
            if *must_fail { "must fail" } else { "must complete" },
        );
    }
}

/// The corpus is at least two hundred programs, and each has an expectation.
#[test]
fn corpus_holds_at_least_two_hundred_programs() {
    let programs = corpus::corpus();
    assert!(
        programs.len() >= 200,
        "the corpus is what makes a fixed point provable; it holds {} programs, not 200",
        programs.len()
    );
}
