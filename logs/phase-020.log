fn arms(kind: Kind) -> Vec<(&'static str, Box<dyn Fn(&mut Rng) -> String>)> {
    let num = || "n".to_string();
    let txt = || "s".to_string();
    match kind {
        Kind::Number => vec![
            ("literal", Box::new(|_: &mut Rng| NUMBERS.split(',').next().unwrap_or("0").to_string())),
            ("bound", Box::new(move |_: &mut Rng| num())),
            ("add", Box::new(|rng: &mut Rng| format!("({} + {})", expression(Kind::Number, rng), expression(Kind::Number, rng)))),
            ("sub", Box::new(|rng: &mut Rng| format!("({} - {})", expression(Kind::Number, rng), expression(Kind::Number, rng)))),
            ("mul", Box::new(|rng: &mut Rng| format!("({} * {})", expression(Kind::Number, rng), expression(Kind::Number, rng)))),
            ("mod", Box::new(|rng: &mut Rng| format!("({} mod {})", expression(Kind::Number, rng), expression(Kind::Number, rng)))),
            ("length", Box::new(|rng: &mut Rng| format!("length({})", expression(Kind::Text, rng)))),
            ("negate", Box::new(|rng: &mut Rng| format!("0 - ({})", expression(Kind::Number, rng)))),
