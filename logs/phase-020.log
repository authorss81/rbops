# Rewrite expression() with verified forms only.
old_expr = s[s.index("/// An expression known to be of kind `kind`."):s.index("#[cfg(test)]\nmod tests {")]
new_expr = '''/// An expression known to be of kind `kind`.
///
/// Every arm must produce the kind it is given. That is the whole invariant, and
/// `edge_a_generated_program_only_faults_on_a_fault_that_was_injected` is what
/// holds it up from the outside.
fn expression(rng: &mut Rng, kind: Kind) -> String {
    match kind {
        Kind::Number => match rng.below(5) {
            0 => number_literal(rng),
            1 => format!("({} + {})", number_literal(rng), number_literal(rng)),
            2 => format!("({} - {})", number_literal(rng), number_literal(rng)),
            3 => format!("({} * {})", number_literal(rng), number_literal(rng)),
            _ => format!("length({})", text_literal(rng)),
        },
        // `length` is a *number* and cannot be folded into a text expression:
        // text plus number is a runtime error, so it is deliberately absent.
        Kind::Text => match rng.below(3) {
            0 => text_literal(rng),
            1 => format!("({} + {})", text_literal(rng), text_literal(rng)),
            _ => format!("type_of({})", expression(rng, Kind::Number)),
        },
        Kind::YesNo => match rng.below(3) {
            0 => "yes".to_string(),
            1 => "no".to_string(),
            _ => format!("({} is {})", number_literal(rng), number_literal(rng)),
        },
        Kind::List => match rng.below(3) {
            0 => "[]".to_string(),
            1 => format!("[{}]", number_literal(rng)),
            _ => format!("[{}, {}]", number_literal(rng), number_literal(rng)),
        },
        Kind::Record => match rng.below(2) {
            0 => "{}".to_string(),
            _ => format!("{{a: {}}}", number_literal(rng)),
        },
        Kind::Nothing => match rng.below(2) {
            0 => "nothing".to_string(),
            _ => format!("({}).missing", expression(rng, Kind::Record)),
        },
    }
}

