70 of 73 point strictly inside; the 3 exceptions are all `Expected End but got Eof` at line N+1 — a legitimate "the file ended here" convention. Let me make the assertion say exactly that:
[0m$ [0mpython3 - <<'PY'
p = "tests/differential_test.rs"
s = open(p).read()
start = s.index("/// Every recorded failure has to point at a real line and column of its own")
end = s.index("/// A mismatch between what the corpus records and what the VM does has to name")
new = '''/// Every recorded failure has to point at a real line and column of its own
/// program, or the position is decoration.
///
/// One exemption, stated rather than assumed: a program that ends before its
/// blocks do is reported at line *N+1* for an N-line file, which is how "the
/// file ended here" is spelled. That is a convention, not a defect, so the
/// exemption is available **only** to a `ParserError` whose message says it ran
/// out of input; every other failure must name a line and a column that exist.
/// The strict count is asserted as well, so the exemption cannot become the norm
/// and quietly turn the check into nothing.
#[test]
fn edge_every_recorded_failure_points_at_a_line_of_its_own_program() {
    let mut strictly_inside = 0usize;
    let mut at_end_of_file = 0usize;

    for path in corpus::corpus() {
        let recorded = corpus::read_recorded(&path);
        if recorded.label == "none" {
            continue;
        }
        let name = path.display();
        let source = corpus::read_source(&path);
        let lines: Vec<&str> = source.lines().collect();
        let error = vm::tree_walk_failure(&source).unwrap_or_else(|| {
            panic!(
                "{name}: recorded as {} but the program ran to completion",
                recorded.label
            )
        });
        assert_eq!(
            error.label(),
            recorded.label,
            "{name}: recorded {} but the pipeline said {}",
            recorded.label,
            error.label()
        );

        let span = error
            .span()
            .cloned()
            .unwrap_or_else(|| panic!("{name}: {} carries no position", recorded.label));

        if (span.line as usize) > lines.len() {
            assert!(
                recorded.label == "ParserError" && error.message().contains("Eof"),
                "{name}: failure at line {} but the program has {} line(s): {:?}",
                span.line,
                lines.len(),
                error.message()
            );
            at_end_of_file += 1;
            continue;
        }

        assert!(
            span.line >= 1,
            "{name}: failure at line {}, which is not a line",
            span.line
        );
        let line = lines[span.line as usize - 1];
        assert!(
            (span.column as usize) <= line.chars().count() + 1,
            "{name}: failure at column {} but line {} holds {} character(s): {line:?}",
            span.column,
            span.line,
            line.chars().count()
        );
        strictly_inside += 1;
    }

    assert!(
        strictly_inside >= 60,
        "only {strictly_inside} recorded failures point strictly inside their own program"
    );
    assert!(
        at_end_of_file <= 5,
        "{at_end_of_file} failures point past the end of their file; the end-of-file \
         exemption has become the norm"
    );
}

'''
