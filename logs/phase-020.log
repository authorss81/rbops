/// The line half is comparable on every failure; the column half only where the
/// bytecode format carries one.
#[test]
fn edge_a_frontend_failure_carries_a_column_and_a_runtime_failure_carries_a_line() {
    let frontend = vm::tree_walk("say \\"unterminated\\n");
    assert_eq!(
        frontend.result.as_ref().err().and_then(vm::Failure::position),
        Some((1, 1)),
        "a lexer failure names the offending token",
    );

    for source in [
        "set xs to [1, 2]\\nsay xs[9]\\n",
        "say \\"before\\"\\n    say 1 / 0\\n",
        "to f(n)\\n    give back f(n + 1)\\nend\\nsay f(0)\\n",
    ] {
        let tree = vm::tree_walk(source);
        let byte = vm::bytecode(source);
        assert!(
            tree.agrees_ignoring_columns(&byte),
            "{source:?}: the line must agree even where the column cannot: {tree:?} vs {byte:?}",
        );
        let (Err(a), Err(b)) = (&tree.result, &byte.result) else {
            panic!("{source:?} must fail on both engines");
        };
        assert_eq!(
            a.position().map(|(line, _)| line),
            b.position().map(|(line, _)| line),
            "the line half is comparable on every failure",
        );
    }
}''')
