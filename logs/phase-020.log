import re
p='tests/common/generator.rs'
s=open(p).read()

# Introduce a depth-bounded expression build.
s=s.replace('''/// An expression of `kind`, built by the grammar's own draw.
///
/// [`expression`] is a thin wrapper on this, so there is exactly one place that
/// chooses an arm. A test that recomputed the draw instead of calling this
/// would be a second implementation, and a second implementation agrees with a
/// bug.
pub fn expression_with_arm(rng: &mut Rng, kind: Kind) -> (String, &'static str) {
    let table = arms(kind);
    let index = rng.below(table.len());
    let (name, build) = &table[index];
    (build(rng), name)
}

/// An expression of `kind`.
pub fn expression(rng: &mut Rng, kind: Kind) -> String {
    expression_with_arm(rng, kind).0
}''','''/// How deep an expression may nest before the grammar stops descending.
///
/// Without a bound the grammar is not a generator but an infinite regress: an
/// `add` arm draws two more numbers, each of which may be an `add`, so the
/// source a seed can produce has no size bound at all — and the first run of
/// this file overflowed the interpreter thread's stack proving it.
pub const MAX_DEPTH: usize = 3;

/// An expression of `kind`, built by the grammar's own draw.
///
/// [`expression`] is a thin wrapper on this, so there is exactly one place that
/// chooses an arm. A test that recomputed the draw instead of calling this
/// would be a second implementation, and a second implementation agrees with a
/// bug.
///
/// `depth` counts how far down the grammar already is. At [`MAX_DEPTH`] the draw
/// is restricted to the arms that do not descend, so every program the generator
/// produces has a bounded size.
pub fn expression_with_arm(rng: &mut Rng, kind: Kind) -> (String, &'static str) {
    expression_bounded(rng, kind, 0).0
}

/// [`expression_with_arm`], with the remaining depth in the open.
pub fn expression_bounded(rng: &mut Rng, kind: Kind, depth: usize) -> (String, &'static str) {
    let table = arms(kind);
    let candidates: Vec<usize> = if depth >= MAX_DEPTH {
        (0..table.len())
            .filter(|index| !descends(table[*index].0))
            .collect()
    } else {
        (0..table.len()).collect()
    };
    if candidates.is_empty() {
        // A kind whose every arm descends would have no leaf. None does today —
        // every kind has a literal arm — and this is the assertion that says so
        // rather than a fallback that hides it.
        panic!("kind {kind:?} has no arm that stops descending, so the grammar cannot be bounded");
    }
    let pick = candidates[rng.below(candidates.len())];
    let (name, build) = &table[pick];
    (build(rng, depth + 1), name)
}

/// Whether the arm called `name` draws further expressions of its own.
fn descends(name: &str) -> bool {
    !matches!(
        name,
        "literal" | "bound" | "yes" | "no" | "empty" | "singleton" | "pair"
            | "trailing-comma" | "one-field" | "two-fields" | "repeated-key" | "spaced"
    )
}

/// An expression of `kind`.
pub fn expression(rng: &mut Rng, kind: Kind) -> String {
    expression_with_arm(rng, kind).0
}''')
