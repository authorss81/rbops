    let cases: &[(&str, &str)] = &[
        ("{n} / 0", "integer division by zero is refused, not infinity"),
        ("0 / {n}", "zero over zero is refused, not NaN"),
        ("{n} % 0", "a modulo by zero is refused"),
        ("{n} + \\"x\\"", "a number plus text is a type error"),
        ("-0.0", "negative zero"),
        ("9007199254740993", "an integer past 2^53 loses its last bit"),
        ("9007199254740992", "2^53 exactly"),
        ("0.1 + 0.2", "decimal addition is not exact"),
        ("{n} / 3", "a repeating decimal is deterministic"),
        ("-2147483648", "the low 32-bit boundary"),
        ("1000000 * {n}", "a large but exact product"),
        ("9223372036854775807", "the largest i64 as a literal"),
        ("-{n} / -3", "sign handling across a division"),
        ("{n} / -0.0", "a division by negative zero"),
    ];
    let (template, why) = cases[index % cases.len()];
    let n = rng.between(1, 99);
    program(
        "numeric_boundary",
        index,
        &format!(
            "// {why}\\n\\
             set caught to no\\n\\
             set value to 0\\n\\
             try\\n    \\
               set value to {}\\n\\
             catch error\\n    \\
               set caught to yes\\n\\
             end\\n\\
             say value\\n\\
             say caught\\n\\
             say (caught is yes)\\n",
            template.replace("{n}", &n.to_string())
        ),
    )
}

