//! The corpus on disk: what is in `tests/corpus`, what it recorded, and the
//! comparison the runner makes against it.

use std::fs;
use std::path::{Path, PathBuf};

use crate::vm::{failure_of, Outcome};

/// The corpus directory: every `.rb` file directly under `tests/corpus`.
pub fn corpus_dir() -> PathBuf {
    Path::new(env!("CARGO_MANIFEST_DIR")).join("tests/corpus")
}

/// The corpus programs, in a stable order.
///
/// Sorted by file name, so a failure names the same program first on every
/// machine and in every run.
pub fn corpus() -> Vec<PathBuf> {
    let dir = corpus_dir();
    let mut files: Vec<PathBuf> = match fs::read_dir(&dir) {
        Ok(entries) => entries
            .filter_map(|entry| entry.ok())
            .map(|entry| entry.path())
            .filter(|path| path.extension().and_then(|e| e.to_str()) == Some("rb"))
            .collect(),
        Err(error) => panic!(
            "corpus directory {} should be readable: {error}",
            dir.display()
        ),
    };
