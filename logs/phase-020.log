# Replace the FAULTS list + statement/expression generator with verified syntax.
old_faults = s[s.index("pub const FAULTS"):s.index("/// A program from the seeded grammar.")]
new_faults = '''pub const FAULTS: [&str; 6] = [
    "index past the end",
    "index before the start",
    "division by zero",
    "text minus a number",
    "index on a number",
    "property on nothing",
];

'''
s = s.replace(old_faults, new_faults)

old_gen = s[s.index("/// A program from the seeded grammar."):s.index("/// Every kind the generator can produce a value of.")]
new_gen = '''/// A program from the seeded grammar.
///
/// `seed` is the whole input. The same seed produces the same bytes on every
/// machine, which is what makes a reported failure reproducible by anyone.
pub fn generate(seed: u64) -> Generated {
    let mut rng = Rng::new(seed);
    let fault = if rng.chance(2, 5) {
        Some(FAULTS[rng.below(FAULTS.len())].to_string())
    } else {
        None
    };

    let statements = rng.below(3) + 2;
    let mut body = String::new();
    for _ in 0..statements {
        body.push_str(&statement(&mut rng));
    }

    let tail = match &fault {
        Some("index past the end") => "set xs to [1, 2]\\nsay xs[9]\\n".to_string(),
        Some("index before the start") => "set xs to [1, 2]\\nsay xs[-9]\\n".to_string(),
        Some("division by zero") => "set n to 0\\nsay 1 / n\\n".to_string(),
        Some("text minus a number") => "say \\"a\\" - 1\\n".to_string(),
        Some("index on a number") => "say 5[0]\\n".to_string(),
        Some("property on nothing") => "say nothing.a\\n".to_string(),
        _ => expression(&mut rng, *rng.pick(ALL_KINDS)),
    };

    Generated {
        source: format!("{body}{tail}\\n"),
        fault,
    }
}

/// One generated statement, from the forms the generator lists.
///
/// Every form here has been run: `if` needs its `then`, `for each` takes no
/// `do` and no `from … to` range, and there is no comparison operator that
/// lexes, so a condition is built from `is` and the logical words only.
///
/// `edge_the_generator_emits_every_statement_form_it_lists` counts which of
/// these appeared over a run of seeds, so an arm that became unreachable — a
/// grammar that no longer says what it says — fails rather than quietly
/// shrinking the coverage.
fn statement(rng: &mut Rng) -> String {
    match rng.below(7) {
        0 => {
            let kind = *[Kind::Number, Kind::Text, Kind::YesNo][rng.below(3)];
            format!("set v{} to {}\\n", rng.below(3), expression(rng, kind))
        }
        1 => format!("say {}\\n", expression(rng, ALL_KINDS[rng.below(ALL_KINDS.len())])),
        2 => {
            let name = format!("v{}", rng.below(3));
            format!("set {name} to 1\\nif {name} is {name} then\\nsay 1\\nend\\n")
        }
        3 => {
            "set i to 0\\nrepeat 3 times\\nset i to i + 1\\nend\\n".to_string()
        }
        4 => "for each x in [1, 2]\\nsay x\\nend\\n".to_string(),
        5 => format!("set xs to [{}]\\n", number_literal(rng)),
        _ => format!(
            "set r to {{a: {}}}\\nsay r.a\\n",
            expression(rng, Kind::Number)
        ),
    }
}

'''
