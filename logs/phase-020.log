p = "tests/common/shrink.rs"
s = open(p).read()

# Extract the acceptance rule into a named helper so it can be pinned directly.
s = s.replace('''/// One sweep of deletions over the current best, replacing it in place.''','''/// Whether a candidate may replace what the shrinker already holds.
///
/// Two conditions, and the first is the one that is easy to leave out:
///
/// 1. The candidate must be **strictly shorter**. Without it a predicate that
///    accepts an empty reduction never terminates — `without_line` on a one-line
///    source returns `"\\n"`, `without_line` on `"\\n"` returns `"\\n"` again, and
///    a shrinker that reads "no progress" as progress loops for ever. Strictly
///    shorter is also the only reading under which "minimal" means anything.
/// 2. The predicate must still hold, or the counterexample has been replaced by
///    a different one.
fn shrinks_to<F>(candidate: &str, current: &str, reproduces: &mut F) -> bool
where
    F: FnMut(&str) -> bool,
{
    candidate.len() < current.len() && reproduces(candidate)
}

/// One sweep of deletions over the current best, replacing it in place.''')

