import os,collections
d='corpus'
labels=collections.Counter(); valued=0; distinct=set(); printed=0; offcol=0; fails=0; endof=0; fam=collections.Counter()
for f in sorted(os.listdir(d)):
    if not f.endswith('.rb'): continue
    fam[f.rsplit('-',1)[0]]+=1
    t=open(os.path.join(d,f.replace('.rb','.expected'))).read().split('\n')
    label=t[0][len('#label '):]; pos=t[1][len('#position '):]; val=t[2][len('#value '):]
    out=[x for x in (t[4:] if label!='none' else t[3:]) if x!='']
    labels[label]+=1
    if label!='none':
        fails+=1
        if out: printed+=1
        if pos!='none' and int(pos.split(':')[1])!=1: offcol+=1
        src=open(os.path.join(d,f)).read(); n=len(src.split('\n'))-1
        if pos!='none' and int(pos.split(':')[0])==n+1: endof+=1
    elif val!='nothing':
        valued+=1; distinct.add(val)
print('total',sum(fam.values()),'families',len(fam))
print('labels',dict(labels))
print('failures',fails,'printed',printed,'offcol',offcol,'endof',endof,'valued',valued,'distinct',len(distinct))
print(dict(collections.Counter(v.split(':')[0].replace('#value ','') for v in distinct)))
print({k:v for k,v in sorted(fam.items())})
