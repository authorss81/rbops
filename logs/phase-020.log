fn control_flow(rng: &mut Rng, index: usize) -> String {
    let limit = rng.between(1, 9);
    let depth = 1 + rng.below(3);
    let mut body = String::new();
    let mut indent = "    ";
    for level in 0..depth {
        let threshold = rng.between(-5, 5);
        body.push_str(&format!(
            "{indent}if n is greater than {threshold}\n\
             {indent}    say \"n is greater than {threshold}\"\n",
        ));
        indent = &format!("{indent}    ");
        let _ = level;
    }
    body.push_str(&format!(
        "{indent}say \"deepest branch, n = \" + n as text\n"
    ));
    for _ in 0..depth {
        indent = &indent[..indent.len().saturating_sub(4)];
        body.push_str(&format!(
            "{indent}else\n{indent}    say \"not greater than\"\n{indent}end\n"
        ));
    }
    program(
        "control_flow",
        index,
        &format!(
