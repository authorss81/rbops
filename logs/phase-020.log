        &mut self,
        body: &[Stmt],
        code: &mut Vec<Instruction>,
        blocks: &mut Vec<Block>,
        depth: usize,
        reads_value: bool,
    ) -> Result<()> {
        for stmt in body {
            self.statement(stmt, code, blocks, depth, reads_value)?;
        }
