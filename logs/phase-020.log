fn run(src: &str) -> String {
    match redblue::lexer::Lexer::tokenize(src) { Err(e) => return format!("LEXER {}", e.message()),
      Ok(tk) => match redblue::parser::parse(tk) { Err(e) => return format!("PARSER {}", e.message()),
        Ok(a) => match redblue::analyzer::analyze(&a) { Err(e) => return format!("ANALYZER {}", e.message()),
          Ok(_) => { let (mut vm, r) = redblue::run_isolated(&a); format!("out={:?} val={:?}", vm.take_output(), r.map(|v| v.to_string()).map_err(|e| format!("{}: {}", e.label(), e.message()))) } } } }
}
