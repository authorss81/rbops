new = '''pub fn shrink<F>(source: &str, mut reproduces: F) -> String
where
    F: FnMut(&str) -> bool,
{
    let mut best = source.to_string();
    let mut lines: Vec<String> = Vec::new();
    let mut chars: Vec<char> = Vec::new();

    loop {
        let reduced = pass(&mut best, &mut lines, &mut chars, &mut reproduces);
        if !reduced {
            break;
        }
    }

    best
}

/// One sweep of deletions over the current best, replacing it in place.
///
/// `lines` and `chars` are scratch that is rebuilt only when `best` actually
/// changed, because rebuilding them is the expensive half and a sweep that
/// reduces nothing should not pay for it twice.
fn pass<F>(
    best: &mut String,
    lines: &mut Vec<String>,
    chars: &mut Vec<char>,
    reproduces: &mut F,
) -> bool
where
    F: FnMut(&str) -> bool,
{
    let before = best.len();
    let current = best.clone();

    lines.clear();
    lines.extend(current.lines().map(|l| l.to_string()));
    for index in 0..lines.len() {
        let mut candidate = lines.clone();
        candidate.remove(index);
        let joined = join_lines(&candidate);
        if joined.len() < joined.len().max(0) && joined.len() < current.len() && reproduces(&joined) {
            *best = joined;
            return true;
        }
    }

    chars.clear();
    chars.extend(current.chars());
    for index in 0..chars.len() {
        let mut candidate = chars.clone();
        candidate.remove(index);
        let text: String = candidate.into_iter().collect();
        if text.len() < current.len() && reproduces(&text) {
            *best = text;
            return true;
        }
    }

    *best != before.to_string() || best.len() < before
}

/// Joins lines back into a source, keeping a trailing newline.
///
/// Separate from [`join`] so a multi-line candidate carries its newline too.
fn join_lines(lines: &[String]) -> String {
    lines.join("\\n") + "\\n"
}

