header = '''//! Corpus-driven differential and property tests (phase-020).
//!
//! The bootstrap ladder is proved by a fixed point: stage 2 must produce
//! byte-identical output to stage 1 for a corpus. A corpus that is not checked
//! cannot be the thing that proves anything, so this file supplies one —
//! `corpus/NNNN-*.rb`, each paired with a `.expected` file recording what the
//! tree-walking VM made of it.
//!
//! Every program is run twice: once on the tree-walking VM, which is the
//! specification of what a Redblue program *does*, and once through the bytecode
//! compiler and the bytecode VM. A program whose two outcomes disagree is a
//! divergence, and the runner names the file rather than an exit code, because
//! both VMs are called as a library.
//!
//! The `.expected` files are the recorded output of the tree-walking VM and they
//! are checked in: this runner only ever reads them, so a behaviour change shows
//! up as a failure rather than as a golden file quietly re-written under the
//! test. `common/corpus.rs` owns the format and `common/generator.rs` owns what
//! is in the corpus; `common/vm.rs`, `common/rng.rs` and `common/shrink.rs` are
//! the two VMs, the seeded generator and the delta-debugging shrinker.

mod common;

use std::fs;

use common::corpus::{
    self, assert_outcome_matches, corpus_dir, format_expected, loaded_corpus, parse_expected,
};
use common::generator::{self, STATEMENT_FORMS};
use common::rng::{Rng, SEEDS};
use common::shrink;
use common::vm::{bytecode, split_failure, tree_walk, tree_walk_span, Outcome, LABELS};

/// Whether the corpus may be re-recorded.
///
/// Off unless `RB_WRITE_CORPUS` is set, so that a CI job re-running these tests
/// reports a regression rather than rewriting the golden files and passing.
fn writing_corpus() -> bool {
    std::env::var("RB_WRITE_CORPUS").as_deref() == Ok("1")
}

/// Writes the corpus from the generator.
///
/// The only place the `.rb` files are produced. Behind an environment variable
/// so that regeneration is a deliberate act, and it *refuses* to record a
/// program the two VMs disagree about — a corpus that recorded a divergence as
/// its specification would be a corpus that made the divergence invisible.
#[test]
fn regenerating_the_corpus_writes_exactly_what_the_generator_produces() {
    let dir = corpus_dir();
    let programs = generator::corpus();
    assert!(
        programs.len() >= 200,
        "the generator produces {} programs; the corpus is what makes a fixed \\
         point provable and it holds at least 200",
        programs.len()
    );

    let writing = writing_corpus();
    let mut failures = Vec::new();
    for (name, source, must_fail) in &programs {
        let tree = tree_walk(source);
        let byte = bytecode(source);
        if *must_fail {
            if !tree.failed() {
                failures.push(format!(
                    "{name}: the must-fail generator produced a program that ran to \\
                     completion:\\n{source}"
                ));
                continue;
            }
        } else if tree.failed() {
            failures.push(format!(
                "{name}: the generator produced a program that failed without a fault \\
                 being injected: {:?}\\n{source}",
                tree.result.as_ref().err()
            ));
            continue;
        }
        if tree != byte {
            failures.push(format!(
                "{name}: the VMs disagree\\n--- tree\\n{tree:?}\\n--- bytecode\\n{byte:?}\\n--- source\\n{source}"
            ));
            continue;
        }
        if writing {
            corpus::write_program(&dir, name, source, &tree);
        }
    }

    assert!(
        failures.is_empty(),
        "{} of the {} generated corpus programs are wrong:\\n\\n{}",
        failures.len(),
        programs.len(),
