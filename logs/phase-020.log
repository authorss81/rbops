    pub fn agrees_with(&self, other: &Outcome) -> bool {
        self == other
    }''','''    /// Whether the two engines said the same thing, printed and valued.
    pub fn agrees_with(&self, other: &Outcome) -> bool {
        self == other
    }

    /// The same verdict, with the position compared only as far as the two
    /// formats can carry it; see [`same_place`].
    pub fn agrees_ignoring_columns(&self, other: &Outcome) -> bool {
        self.output == other.output
            && match (&self.result, &other.result) {
                (Ok(a), Ok(b)) => a == b,
                (Err(a), Err(b)) => same_place(a, b) && a.message() == b.message(),
                _ => false,
            }
    }''')
