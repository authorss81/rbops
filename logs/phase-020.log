/// The property the shrinker is exercised against: an unterminated text
/// literal.
///
/// Chosen because it is a real counterexample of a property the language
/// promises — an unclosed literal is not a program, and a frontend that
/// accepted one would be lenient where SPEC.md says it is not. It is also
/// *specific*: "the frontend rejects this" would be satisfied by any stray
/// token, so a shrinker given it would reduce to the first character it could
/// find, which is not a reduction of anything.
fn unterminated_string(source: &str) -> bool {
    match redblue::lexer::Lexer::tokenize(source) {
        Err(error) => error.label() == "LexerError" && error.message().contains("Unterminated"),
        Ok(_) => false,
    }
}

#[test]
fn the_shrinker_reduces_a_counterexample_to_a_minimal_program() {
    // Padding around the defect is what makes a generated counterexample hard
    // to read, and it is exactly what the shrinker removes.
    let mut rng = Rng::new(0x1234_5678_9abc_def0);
    let padding: String = (0..12)
        .map(|_| format!("set pad{} to {}\\nsay pad{}\\n", rng.between(0, 9), rng.between(0, 9)))
        .collect();
    let counterexample = format!("{padding}say \\"unterminated\\n{padding}");

    assert!(
        unterminated_string(&counterexample),
        "the starting point must reproduce the property being shrunk"
    );
    assert!(
        counterexample.lines().count() > 20,
        "the fixture must carry enough padding for the reduction to mean something"
    );

    let minimal = shrink(&counterexample, &unterminated_string);
    assert_eq!(
        minimal, "\\"",
        "the smallest program that is still not a program is one open quote"
    );
    assert!(
        minimal.len() * 4 < counterexample.len(),
        "the shrinker barely shrank {} bytes to {}",
        counterexample.len(),
        minimal.len()
    );
    assert!(
        unterminated_string(&minimal),
        "the shrunken program must still reproduce the property"
    );
    println!(
        "{}",
        report(
            "the shrinker",
            &minimal,
            "the frontend accepts a program that is not a program"
        )
    );
}

#[test]
fn edge_the_shrinker_stops_only_when_nothing_can_be_removed() {
    // Minimality is a claim, so it is asserted rather than assumed: no further
    // deletion may keep the property. A shrinker that stops early reports a
    // program that still has the defect buried in it.
    let source = "say 1\\nsay 2\\nsay 3\\nsay 4\\nsay \\"unterminated\\n";
    let minimal = shrink(source, &unterminated_string);

    assert!(
        minimal.len() < source.len(),
        "nothing was removed from {source:?}"
    );

    let lines: Vec<&str> = minimal.lines().collect();
    for index in 0..lines.len() {
        let mut kept = lines.clone();
        let removed = kept.remove(index);
        let candidate = kept.join("\\n");
        assert!(
            !unterminated_string(&candidate),
            "removing {removed:?} from the minimal program still reproduces the \\
             property, so it was not minimal:\\n{minimal}"
        );
    }

    for index in 0..minimal.len() {
        let mut candidate = minimal.clone();
        candidate.remove(index);
        assert!(
            !unterminated_string(&candidate),
            "removing one character from the minimal program still reproduces the \\
             property, so it was not minimal: {minimal:?}"
        );
    }
}

#[test]
fn edge_the_shrinker_never_invents_a_counterexample() {
    // Given a program that does not reproduce, the shrinker has nothing to say.
    // Returning something smaller would be a lie about which input is the
    // failing one.
    let source = "say 1\\n";
    assert!(
        !unterminated_string(source),
        "the fixture must be a program the frontend accepts"
    );
    assert_eq!(
        shrink(source, &unterminated_string),
        source,
        "the shrinker must not reduce a program that does not reproduce"
    );
    assert_eq!(
        shrink("say 1", &|_| false),
        "say 1",
        "a predicate nothing satisfies must leave the program alone"
    );
}

#[test]
fn edge_the_shrinker_reduces_character_by_character_when_no_line_can_go() {
    // A defect on one line leaves no line to lose, so the character pass is the
    // only thing that can reduce it — and it must still leave a program that
    // reproduces rather than an empty one that trivially does not.
    let source = "set unused to 1 set other to 2 say \\"unterminated";
    assert!(
        unterminated_string(source),
        "the fixture must reproduce the property"
    );

    let minimal = shrink(source, &unterminated_string);
    assert!(
        minimal.len() < source.len(),
        "the character pass should have shortened {} bytes, got {minimal:?}",
        source.len()
    );
    assert_eq!(
        minimal, "\\"",
        "the open quote is all that survives; reducing it away would be reducing \\
         the reproduction rather than the program"
    );
}
