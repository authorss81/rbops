where
    F: FnMut(&str) -> bool,
{
    let mut current = source.to_string();
    let mut steps: Vec<Step> = Vec::new();
    let mut rounds = 0usize;

    loop {
        rounds += 1;
        assert!(
            rounds <= 10_000,
            "the shrinker made {rounds} rounds on a {} character program without \\
             finishing; the reduction is not making progress",
            source.len()
        );
        if let Some(step) = line_step(&current, &mut reproduces) {
            let line = step.removed.line().expect("a line removal");
            current = without_line(&current, line).expect("the line it just found");
            steps.push(step);
            continue;
        }
        if let Some(step) = char_step(&current, &mut reproduces) {
            let index = step.removed.index().expect("a character removal");
            current = without_char(&current, index).expect("the char it just found");
            steps.push(step);
            continue;
        }
        return (current, steps);
    }
}

/// The first line whose removal still reproduces, if there is one.
fn line_step<F>(source: &str, reproduces: &mut F) -> Option<Step>
where
    F: FnMut(&str) -> bool,
{
    let lines = source.split('\\n').count();
    (1..=lines)
        .find(|&line| {
            without_line(source, line)
                .map(|candidate| reproduces(&candidate))
                .unwrap_or(false)
        })
        .map(|line| Step {
            removed: Removal::Line(line),
        })
}

/// The first character whose removal still reproduces, if there is one.
fn char_step<F>(source: &str, reproduces: &mut F) -> Option<Step>
where
    F: FnMut(&str) -> bool,
{
    (0..char_count(source))
        .find(|&index| {
            without_char(source, index)
                .map(|candidate| reproduces(&candidate))
                .unwrap_or(false)
        })
        .map(|index| Step {
            removed: Removal::Char(index, source.chars().nth(index).unwrap_or(' ')),
        })
}
'''
