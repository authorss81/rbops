+/// process environment, which is shared with every test running in parallel.
+#[track_caller]
+fn resolve_limit(env_var: &str, from_env: Result<String, std::env::VarError>, default: usize) -> usize {
+    match from_env {
+        Ok(raw) => match raw.trim().parse::<usize>() {
+            Ok(limit) if limit > 0 => limit,
+            _ => default,
+        },
+        Err(_) => default,
+    }
