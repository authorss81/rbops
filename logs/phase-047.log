+/// The test this phase corrected. It is named here so that deleting or renaming
+/// it fails this phase rather than passing quietly.
+const CORRECTED: &str = "text: a well formed brace pair substitutes";
+
+#[test]
+fn edge_the_corrected_redblue_test_still_exists_and_still_passes() {
+    let path = concat!(env!("CARGO_MANIFEST_DIR"), "/tests/test_text.rb");
+    let source = std::fs::read_to_string(path).expect("the Redblue text tests are readable");
+    assert!(
+        source.contains(&format!("test \"{CORRECTED}\"")),
+        "tests/test_text.rb must still carry the test named `{CORRECTED}`"
+    );
+
+    let results = redblue::testing::run_test_file(path).expect("the file runs");
+    assert_eq!(
+        results.failed,
+        0,
+        "every test in tests/test_text.rb must pass, including `{CORRECTED}`: {:?}",
+        results.errors
+    );
+    assert_eq!(results.passed, results.total, "no test may be skipped");
+}

