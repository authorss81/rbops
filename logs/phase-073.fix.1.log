+fn measure_in_child(
+    binary: &Path,
+    workload: &'static Workload,
+    size: i64,
+    budget: Duration,
+) -> Result<(Value, Duration), BenchError> {
+    let mut child = Command::new(binary)
+        .arg("--worker")
+        .arg(workload.name)
+        .arg(size.to_string())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .spawn()
+        .map_err(|error| {
+            BenchError::Load(format!(
+                "could not start the '{}' worker: {error}",
+                workload.name
+            ))
+        })?;
+    let stdout = child.stdout.take().ok_or_else(|| {
+        BenchError::Load(format!("the '{}' worker has no stdout", workload.name))
     })?;
+    let (sender, receiver) = mpsc::channel();
+    let reader = thread::spawn(move || {
+        let mut reader = BufReader::new(stdout);
+        let mut output = String::new();
+        let result = reader.read_to_string(&mut output).map(|_| output);
+        let _ = sender.send(result);
+    });
+
+    match receiver.recv_timeout(budget) {
+        Ok(Ok(output)) => {
+            let status = child.wait().map_err(|error| {
+                BenchError::Load(format!(
+                    "could not reap the '{}' worker: {error}",
+                    workload.name
+                ))
+            })?;
+            let _ = reader.join();
+            if !status.success() {
+                return Err(BenchError::Load(format!(
+                    "workload '{}' worker exited with {status}: {}",
+                    workload.name,
+                    output.trim()
+                )));
+            }
+            parse_worker_output(workload.name, &output)
+        }
+        Ok(Err(error)) => {
+            let _ = child.wait();
+            let _ = reader.join();
+            Err(BenchError::Load(format!(
+                "could not read the '{}' worker output: {error}",
+                workload.name
+            )))
+        }
+        Err(RecvTimeoutError::Timeout) => {
+            let _ = child.kill();
+            let _ = child.wait();
+            let _ = reader.join();
+            Err(BenchError::BudgetExceeded {
+                workload: workload.name.to_string(),
+                budget,
+            })
+        }
+        Err(RecvTimeoutError::Disconnected) => {
+            let _ = child.kill();
+            let _ = child.wait();
+            let _ = reader.join();
+            Err(BenchError::Load(format!(
+                "workload '{}' stopped without producing an answer",
+                workload.name
+            )))
+        }
+    }
+}
