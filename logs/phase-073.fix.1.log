fn encode_worker_error(error: &BenchError) -> String {
    match error {
        BenchError::WrongAnswer { expected, actual, .. } => format!(
            "WRONG {} {}",
            encode_hex(expected.as_bytes()),
            encode_hex(actual.as_bytes())
        ),
        other => format!("ERR {other}"),
    }
}

