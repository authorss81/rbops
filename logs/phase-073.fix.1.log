# Strict classifiers. The bare word "retry" must NOT match, or normal agent
# prose about retrying a build would falsely defer a phase.
infra_failure() {
  grep -qiE 'HTTP[ /]?(429|5[0-9][0-9])|too many requests|rate[ _-]?limit|insufficient[ _-]?quota|quota exceeded|model not found|unknown model|invalid model|no such model|overloaded|upstream error|ECONNRESET|ETIMEDOUT|stream.*(closed|failed)|UnknownError|unexpected server error' "$1"
}

# A fingerprint of the project's working tree: what is changed, what is
# staged, what is committed, and what is untracked. Two fingerprints that differ
# mean the tree is not what it was.
#
# HEAD is part of it because an agent is allowed to commit its own work, and a
# committed fix leaves every file byte-identical - only the commit is new. A
# check that watched file contents alone would call that "nothing happened".
tree_fingerprint() {
  in_project bash -c '
    git rev-parse HEAD 2>/dev/null
    git status --porcelain 2>/dev/null
    git diff HEAD 2>/dev/null
    git ls-files --others --exclude-standard 2>/dev/null | while read -r f; do
      if [ -f "$f" ]; then printf "%s " "$f"; cksum < "$f" 2>/dev/null; fi
    done
  ' 2>/dev/null | cksum
}

# Push work-in-progress every CHECKPOINT_SECS so a timeout or cancellation
# never loses a partial phase.
#
# stdout/stderr MUST be redirected away from the caller. A background job that
# inherits the pipe keeps it open for as long as it sleeps, so `$(dispatch.sh
# ...)` and `dispatch.sh ... | tee` block until the 300s sleep expires — the
# phase appears to hang even though the work finished in seconds.
checkpoint_loop() {
  local phase="$1"
  while sleep "$CHECKPOINT_SECS"; do
    # Everything here is git inside the PROJECT, so the checkpoint captures the
    # agent's work rather than the untouched pipeline repo.
    in_project bash -c '
      tree=$(git add -A >/dev/null 2>&1; git write-tree 2>/dev/null) || exit 0
      commit=$(git commit-tree "$tree" -p HEAD -m "rbops: '"$phase"' checkpoint $(date -u +%s)" 2>/dev/null) || exit 0
      git push -f origin "$commit:refs/heads/rbops-wip/'"$phase"'" >/dev/null 2>&1 || true
      git reset --mixed HEAD >/dev/null 2>&1 || true
    ' || true
  done
}

# A phase with "manual": true cannot be landed by an agent: it needs an
# edit under rbops/, and AGENTS.md hard rule 1 forbids an agent to make
# one. Such a phase is applied by a human and marked .done. Without this
# check the pipeline dispatches it anyway, the agent works in the redblue
# checkout where there is no rbops/ directory to edit, must_touch can never
# be satisfied, and the phase defers forever.
#
# Phase-111 spun on exactly this: 4 attempts, zero work, every one doomed
# before it started. Dispatch had no notion of `manual` at all - the flag
# was only ever read by humans reading the manifest.
is_manual() {
  [ "$("$JQ" -r --arg p "$1" '.phases[]|select(.id==$p)|.manual // false' "$PHASES" 2>/dev/null)" = "true" ]
}

start_checkpoint_loop() {
  local phase="$1"
  checkpoint_loop "$phase" >>"${LOG_DIR}/${phase}.checkpoint.log" 2>&1 &
  CHECK_PID=$!
}

stop_checkpoint_loop() {
  [ -n "${CHECK_PID:-}" ] || return 0
  kill "$CHECK_PID" 2>/dev/null || true
  wait "$CHECK_PID" 2>/dev/null || true
  CHECK_PID=""
}

