/// Whether `code` falls in one of the inclusive ranges of `table`.
fn in_ranges(code: u32, table: &[(u32, u32)]) -> bool {
    table
        .iter()
        .any(|(first, last)| code >= *first && code <= *last)
}

/// How many terminal cells `c` is drawn in.
