+      log "$phase REVIEW REFUSED — agent.reviewer.permission.$key is '$val' in $cfg: it must deny"
+      rc=1
+    fi
+  done
+  [ "$rc" -eq 0 ] && log "$phase reviewer resolves read-only out of $cfg"
+  return "$rc"
+}
