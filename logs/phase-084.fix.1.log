#!/usr/bin/env bash
# Measure the audit against a clone whose history is completed by a fetch that
# is IN FLIGHT while the audit runs: .git/shallow.lock is held the way a fetch
# holds it, and the fetch that completes the clone lands later.
set -u
cd /tmp/opencode/measure
echo "== depth before: shallow=$(git rev-parse --is-shallow-repository), commits in HEAD=$(git rev-list --count HEAD)"
# A fetch in flight holds .git/shallow.lock; every fetch made while it is held
# loses. It lands 6 seconds from now -- longer than the two-second window the
# attempt-counting repair had.
: > .git/shallow.lock
(
  sleep 6
  rm -f .git/shallow.lock
  git fetch --unshallow --quiet origin '+refs/heads/*:refs/remotes/origin/*' >/dev/null 2>&1
  echo "[the contending fetch landed: shallow=$(git rev-parse --is-shallow-repository), commits in HEAD=$(git rev-list --count HEAD)]"
) &
HOLDER=$!
START=$(date +%s)
CARGO_TARGET_DIR=/tmp/opencode/measure-target cargo test --test unreviewed_work_ack_test 2>&1 | grep -v "^stack backtrace\|^   [0-9]\|^note:" | tail -30
echo "[the test binary finished after $(( $(date +%s) - START ))s]"
wait $HOLDER
echo "== depth after: shallow=$(git rev-parse --is-shallow-repository), commits in HEAD=$(git rev-list --count HEAD)"
EOF
