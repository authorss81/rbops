          PHASE="${RBOPS_PHASE:-none}"
          cd redblue
          git config user.name "$GIT_NAME"
          git config user.email "$GIT_EMAIL"

          # DIAGNOSE FIRST. A phase once produced 788 changed lines and the old
          # version of this step cheerfully reported "clean tree — nothing to
          # push". Nothing is lost now that this runs first and is unconditional.
          echo "::group::work inventory for ${PHASE}"
          echo "  HEAD          : $(git rev-parse --short HEAD) $(git log -1 --pretty=%s)"
          echo "  local commits : $(git log --oneline origin/main..HEAD 2>/dev/null | wc -l)"
          echo "  status lines  : $(git status --porcelain | wc -l)"
          echo "  diff vs HEAD  : $(git diff HEAD --shortstat)"
          echo "  staged        : $(git diff --cached --shortstat)"
          # NEVER `| head` a pipe under `set -o pipefail`: head exits after N
          # lines, the writer gets SIGPIPE (141), and pipefail fails the whole
          # step. phase-020 staged 694 corpus files and this purely diagnostic
          # line killed the run. `sed -n '1,20p'` consumes the whole stream.
          # `-uall`: without it git collapses a wholly-untracked directory to a
          # single `?? dir/` line, so 700 new files would show as one line.
          git status --porcelain -uall | sed -n '1,20p' | sed 's/^/    /'
          echo "::endgroup::"

          # ALWAYS capture a patch, before any commit, push or reset. If every
          # later step fails the work is still recoverable from the artifact.
          git add -A
          git diff --cached --binary > "../work-${PHASE}.patch" || true
          echo "patch bytes: $(wc -c < "../work-${PHASE}.patch")"

          has_local_commits() { [ -n "$(git log --oneline origin/main..HEAD 2>/dev/null)" ]; }
          has_staged()        { ! git diff --cached --quiet; }

          # The agent may have committed its own work. `git status --porcelain`
          # is EMPTY in that case, which is how a whole phase was once discarded.
          if ! has_staged && ! has_local_commits; then
            echo "::notice::genuinely nothing to push for ${PHASE}"
            exit 0
          fi

          if has_staged; then
            git commit -m "rbops: ${PHASE} ($(date -u +%Y-%m-%dT%H:%M:%SZ))" || true
          fi

          # Park unproven work where a retry can find it. Before overwriting,
          # archive whatever was parked there before: a worse attempt must not
          # be able to destroy a better one. Phase-003's first attempt (187
          # tests) was overwritten by a retry that inherited a broken tree and
          # managed 1; the only reason that was recoverable is that the run
          # happened to upload a patch artifact. This makes it unconditional.
          archive_and_park() {
            local prev
            prev="$(git ls-remote origin "refs/heads/rbops-recovery/${PHASE}" 2>/dev/null | awk '{print $1}')"
            if [ -n "${prev:-}" ] && [ "${prev}" != "$(git rev-parse HEAD)" ]; then
              if git push -q origin "${prev}:refs/heads/rbops-archive/${PHASE}/${prev:0:7}" 2>/dev/null; then
                echo "::notice::archived the previous recovery head ${prev:0:7} to rbops-archive/${PHASE}"
              fi
            fi
            git branch -f "rbops-recovery/${PHASE}" HEAD 2>/dev/null || true
            git push -f origin "HEAD:refs/heads/rbops-recovery/${PHASE}" 2>/dev/null \
              || echo "::warning::recovery-branch push failed; work-${PHASE}.patch artifact still holds the work"
          }

          # POLICY: only gate-green, reviewed work lands on main. A failed gate
          # means the code is unproven — possibly correct, possibly not — and
          # unproven code does not belong on the language's main branch. It goes
          # to a recovery branch instead, where the next attempt (or a human)
          # can inspect it, and to the patch artifact either way.
          if [ "${PROGRESS:-false}" != "true" ]; then
            echo "::warning::gate did not pass for ${PHASE} — keeping main clean, parking work on rbops-recovery/${PHASE}"
            archive_and_park
            exit 0
          fi

          for i in 1 2 3 4 5; do
            if git push origin HEAD:main; then echo "::notice::pushed ${PHASE}"; exit 0; fi
            git pull --rebase origin main || true
            sleep 3
          done

          archive_and_park
          echo "::error::push failed after 5 attempts — recovery branch and work-${PHASE}.patch artifact saved"

      - name: Push RBOPS state
        if: always()
        run: |
          set -uo pipefail
          git config user.name rbops-bot
          git config user.email rbops-bot@users.noreply.github.com
          mkdir -p phases logs
          cp -r redblue/phases/. phases/ 2>/dev/null || true
          cp -r redblue/logs/. logs/ 2>/dev/null || true
          # rbops/phases.json must be staged too, or an audit that appends real
          # phases generates them into a file nobody commits and the work is lost.
          [ -n "$(git status --porcelain phases logs rbops/phases.json rbops/agents)" ] || { echo "no state change"; exit 0; }
          git add phases logs rbops/phases.json rbops/agents
          git commit -m "rbops: state after ${RBOPS_PHASE}" || exit 0
          for i in 1 2 3 4 5; do
            git push origin HEAD:main && exit 0
            git pull --rebase origin main || true; sleep 3
          done
