name: rbops

# =============================================================================
# RBOPS — self-dispatching, self-auditing pipeline for the redblue language.
#
# Unlike the llops design, this one cannot be fooled by an agent that merely
# claims success. `rbops/verify.sh` is a real gate whose non-zero exit blocks
# `.done`, and it runs the four gates itself.
#
# The bot token deliberately has NO `workflows` permission, so a push that
# touches .github/ is refused by GitHub. That is the lock that makes the gate
# trustworthy: the implementer cannot edit its own gate.
# =============================================================================

on:
  workflow_dispatch:
    inputs:
      phase:
        description: "Force a phase (e.g. phase-001). Empty = auto-select."
        required: false
        default: ""
      action:
        description: "tick | run | review | audit | status"
        required: false
        default: "tick"
      no_retrigger:
        description: "Do not chain to the next tick"
        required: false
        type: boolean
        default: false
  push:
    branches: [main]
    paths-ignore:
      - 'logs/**'
      - 'docs/audits/**'
  repository_dispatch:
    types: [rbops_tick]

permissions:
  contents: read
=== tick ===
name: rbops-tick

# Safety net. The primary path is rbops.yml's `retrigger` job, which chains to
# the next phase in ~10-30s. This cron exists so a lost dispatch, a runner
# eviction, or a failed re-dispatch does not stall the pipeline for more than
# one interval.
#
# NOTE: this job must have `contents: write`. repository_dispatch is a write
# operation; with `contents: read` GitHub returns 403 and this safety net is
# silently useless. That bug is present in the design this borrows from.

on:
  schedule:
    - cron: '17,47 * * * *'
  workflow_dispatch:

# MUST be the same group as rbops.yml. These are two workflows driving one
# pipeline, and separate groups do not exclude each other: a cron tick fired at
# :17 or :47 while the retrigger chain was mid-phase, and both runs worked
# phase-015 concurrently on separate runners. The result was phase-015's work
# committed to redblue TWICE (329e83d at 12:30 and 58d9644 at 12:38) while its
# `.done` marker was clobbered back to `.failed`, so the phase was re-attempted.
#
# The in-run guard below (count in-progress/queued runs) is best-effort and has a
# TOCTOU window: it checks, sleeps 5s, then dispatches, and a retrigger from a
# phase finishing inside that window also dispatches. The advisory lock in
# dispatch.sh cannot close it either — that is a `mkdir` under /tmp, and every CI
# run gets its own fresh runner with its own /tmp, so a filesystem lock
# coordinates nothing across runs.
#
