import random, itertools

def old_pairs(s):
    n=len(s); i=0; out=[]
    while i<n:
        if s[i]!='{':
            i+=1; continue
        depth=1; scan=i+1
        while scan<n and depth>0:
            if s[scan]=='{': depth+=1
            elif s[scan]=='}': depth-=1
            if depth>0: scan+=1
        if depth!=0:
            i+=1; continue
        out.append((i,scan)); i=scan+1
    return out

def unmatched(s):
    n=len(s); u=[False]*n; d=0
    for i in range(n-1,-1,-1):
        if s[i]=='}': d+=1
        elif s[i]=='{':
            if d>0: d-=1
            else: u[i]=True
    return u

def new_pairs(s):
    n=len(s); u=unmatched(s); i=0; out=[]
    while i<n:
        if s[i]!='{' or u[i]:
            i+=1; continue
        depth=1; scan=i+1
        while scan<n and depth>0:
            if s[scan]=='{': depth+=1
            elif s[scan]=='}': depth-=1
            if depth>0: scan+=1
        assert depth==0, (s,i,scan)
        out.append((i,scan)); i=scan+1
    return out

