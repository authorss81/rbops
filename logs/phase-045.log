    pub fn new_in(root: &std::path::Path) -> Self {
        let globals = stdlib::builtins();
        Self {
            globals,
            constants: HashSet::new(),
            locals: vec![CapturedScope::new()],
            output: Vec::new(),
            output_bytes: 0,
