if "\n## Tests added\n" not in cur:
    s = next(i for i,l in enumerate(orig_lines) if l.startswith("## Tests added"))
    e = next(i for i,l in enumerate(orig_lines) if l.startswith("## Invariants touched"))
    missing = "\n".join(orig_lines[s:e]) + "\n"
    cur = cur.replace("\n## Invariants touched\n", "\n" + missing + "\n## Invariants touched\n", 1)
    print("restored the missing region")
open(REPORT,"w").write(cur)

# ---------- 2. the gate paste into the Gates section ----------
gate = open("target/tmp/gate.log").read()
out=[]; i=0
while i < len(gate):
    if gate[i] == "\x1b":
        j=i+1
        while j < len(gate) and gate[j] not in "mK": j+=1
        i=j+1; continue
    out.append(gate[i]); i+=1
gate_lines = [l for l in "".join(out).splitlines() if not l.startswith("EXIT=")]
cmd = ['$ RBOPS_ROOT="$PWD" RBOPS_PROJECT_DIR="$PWD" RBOPS_PHASES="$PWD/../rbops/phases.json" \\',
       '    RBOPS_BASELINE="$PWD/../rbops/baseline.json" \\',
       '    RBOPS_BASE_REF=1d73e8c \\',
       '    ../rbops/verify.sh phase-084']

lines = open(REPORT).read().splitlines()
# the Gates-section block: the fence containing RBOPS_BASE_REF=d425e2b...
i = next((i for i,l in enumerate(lines) if "RBOPS_BASE_REF=d425e2b322bd3be245ecbedc0be4636bd1141114" in l), None)
if i is not None:
    start = i-1
    while lines[start].strip() != "```": start -= 1
    end = i
    while lines[end].strip() != "```": end += 1
    lines[start:end+1] = ["```"] + cmd + [""] + gate_lines + ["```"]
    print("gate pasted into the Gates section")
cur = "\n".join(lines) + "\n"

# ---------- 3. the Gates table's count ----------
cur = cur.replace("| `cargo test --all-targets` | 1963 passed, 0 failed, 0 ignored |",
                  "| `cargo test --all-targets` | 1967 passed, 0 failed, 0 ignored |", 1)

# ---------- 4. the four new test rows ----------
lines = cur.splitlines()
new_rows = [
 "| `edge_a_config_opencode_would_read_but_the_suite_cannot_is_rejected` | malformed input — the two readers of this phase's file are not the same parser. opencode reads the project config as JSON(C), so a line comment, a block comment and a trailing comma are legal to it — all three were measured to be accepted by `opencode debug config` on this build — while `serde_json` refuses them. The suite is the stricter of the two on purpose: a file it cannot read is a file it cannot vouch for. |",
 "| `edge_a_duplicate_key_resolves_to_the_last_value` | duplicate / missing keys — the other place the two readers could disagree. `serde_json` resolves a repeated key to the LAST value and so does opencode (measured: a config that declared `edit` twice resolved to the second one). The second `agent` block is the one that is read, in both directions. |",
 "| `edge_the_refusal_names_the_last_attempts_failure_and_not_a_stale_one` (in `tests/unreviewed_work_ack_test.rs`) | error message — the refusal names the failure of the LAST attempt. Before this round it named the first attempt's, kept across the whole loop, so a reader could be sent after a lock that was already free. |",
 "| `edge_the_refusal_names_the_last_attempts_failure_and_not_a_stale_one` (in `tests/checkpoint_ancestry_test.rs`) | error message — the same refusal, in the sibling audit file, which carried the identical stale-failure pattern. |",
]
if not any("edge_a_config_opencode_would_read_but_the_suite_cannot_is_rejected" in l for l in lines):
    idx = next(i for i,l in enumerate(lines) if l.startswith("| `edge_a_repair_that_lands_after_the_attempts_are_spent_is_accepted` (in `tests/checkpoint_ancestry_test.rs`)"))
    lines[idx+1:idx+1] = new_rows
    print("the four new test rows inserted")
cur = "\n".join(lines) + "\n"

# ---------- 5. the edge-case matrix rows ----------
old_dup = "(a repeated key resolves last-wins, so a trailing `\"allow\"` is the one that counts),"
if "edge_a_duplicate_key_resolves_to_the_last_value` (the same rule at the top level" not in cur:
    cur = cur.replace(old_dup, old_dup + " `edge_a_duplicate_key_resolves_to_the_last_value` (the same rule at the top level, where a repeated `agent` block means the **second** block is the one that is read — in both directions),", 1)
old_mal = "(empty file, truncated JSON, trailing comma, byte order mark, a non-object document, a bare string),"
if "edge_a_config_opencode_would_read_but_the_suite_cannot_is_rejected` (a line comment" not in cur:
