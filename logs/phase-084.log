import re,sys
def ambiguous(lines):
    open_=None
    for i,l in enumerate(lines,1):
        t=l.strip()
        if not t.startswith('```'): continue
        run=len(t)-len(t.lstrip('`'))
        info=t[run:].strip()
        if open_ is None: open_=(i,run)
        else:
            if info: return (i,info)
            if run>=open_[1]: open_=None
    return None
def regions(lines, cm):
    out=[];open_=None
    for i,l in enumerate(lines,1):
        t=l.strip()
        if not t.startswith('```'): continue
        run=len(t)-len(t.lstrip('`'))
        info=t[run:].strip()
        if open_ is None: open_=(i,run)
        else:
            closes = (not cm) or (not info and run>=open_[1])
            if closes:
                out.append((open_[0],i)); open_=None
    return out, open_
for p in ['target/tmp/report_as_inherited.md','target/tmp/findings_as_inherited.md','phases/phase-084/REPORT.md','phases/phase-084/FINDINGS.md']:
    lines=open(p,encoding='utf-8').read().split('\n')
    a=ambiguous(lines); r1,o1=regions(lines,True); r2,o2=regions(lines,False)
    print(p)
    print("   ambiguous:", a, "| regions agree:", r1==r2, "| cm unterminated:", o1, "| naive unterminated:", o2)
