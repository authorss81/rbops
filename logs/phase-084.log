+/// The refusal names the failure of the LAST attempt, not a stale one.
+///
+/// The repair attempts the fetch more than once, and the attempts can fail
+/// for different reasons — or one can fail and the next one can succeed
+/// without the clone becoming complete, because a fetch that succeeds is not
+/// the same thing as a fetch that completes the history. The refusal has to
+/// say what the LAST attempt did, because that is the attempt a reader has to
+/// reproduce. An earlier attempt's error is a problem that has already gone
+/// away, and a reader holding it is sent looking for a lock that is free.
+#[test]
+fn edge_the_refusal_names_the_last_attempts_failure_and_not_a_stale_one() {
+    // The first attempt fails for one reason, every attempt after it for
+    // another. The refusal must name the second reason.
+    let attempts = Cell::new(0);
+    let err = ensure_history_with(
+        &|| Ok(true),
+        &|| {
+            attempts.set(attempts.get() + 1);
+            if attempts.get() == 1 {
+                Err("the FIRST attempt's error".into())
+            } else {
+                Err("the LAST attempt's error".into())
+            }
+        },
