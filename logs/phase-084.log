import re
lines=open('phases/phase-084/REPORT.md',encoding='utf-8').read().split('\n')

def naive_regions(lines):
    infence=False; regions=[]; start=None
    for i,l in enumerate(lines,1):
        if l.startswith('```'):
            if infence: regions.append((start,i-1)); infence=False
            else: infence=True; start=i
    if infence: regions.append((start,len(lines)))
    return regions

def cm_regions(lines):
    # CommonMark: closing fence must have no info string; open fence of >=N backticks
    infence=False; n=0; regions=[]; start=None
    for i,l in enumerate(lines,1):
        m=re.match(r'^(`{3,})(.*)$', l)
        if m:
            ticks=m.group(1); info=m.group(2).strip()
            if not infence:
                infence=True; n=len(ticks); start=i
            elif not info and len(ticks)>=n:
                infence=False; regions.append((start,i-1))
    if infence: regions.append((start,len(lines)))
    return regions

nr=naive_regions(lines); cr=cm_regions(lines)
print("naive regions:", nr)
print("cm regions == naive?", nr==cr)
for name in ["## What changed","## Tests added","## Gates","## Invariants touched","## Known gaps / follow-ups","## Result"]:
    idx=[i for i,l in enumerate(lines,1) if l.startswith(name)]
    for i in idx:
        hidden_naive = any(a<=i<=b for a,b in nr)
        hidden_cm = any(a<=i<=b for a,b in cr)
        print(f"{name!r} at line {i}: hidden_naive={hidden_naive} hidden_cm={hidden_cm}")
