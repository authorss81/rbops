/// watches registered against it, and the block the sub-REPL is buffering.
pub struct DebugRepl {
    vm: Vm,
    state: Arc<Mutex<State>>,
    buffer: Vec<String>,
    style: Style,
    /// The sub-REPL's own `_`, kept here so the parent's last result is never
