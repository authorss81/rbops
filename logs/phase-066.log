    /// `CALL`: a builtin, or a function the program declared.
    fn call(&mut self, instruction: Instruction, frame: usize) -> Result<()> {
        let name = self.constant_text(instruction.arg)?;
        let args = self.pop_n(instruction.aux)?;
        self.call_named(&name, &args, frame)
    }

    /// Calls `name`, which is either a builtin or a declared function.
    fn call_named(&mut self, name: &str, args: &[Value], frame: usize) -> Result<()> {
        // `append` writes through a binding, so it is answered here where the
        // frame is and not by the free `runtime::builtin`, which has none. The
        // write is the one a `STORE` would do, so a name that is a constant is
        // refused the same way and in the same place.
        if name == "append" {
            let span = self.span();
            let target = runtime::append_target(span, args)?;
            if self.module_depth == 0 {
                self.refuse_constant_rebind(target)?;
            }
            runtime::append_through(span, target, self.get_var_mut(target), args[1].clone())?;
            self.push(Value::Nothing);
            self.advance(frame);
            return Ok(());
        }
        // `map` has to *call* a Redblue function, which the shared resolver
        // cannot do, so it is answered here and started on the frame — asked for
        // before the resolver, which would otherwise claim the name and refuse it
        // as one it cannot use, turning a working higher-order call into an
        // error. The tree-walking VM excludes the same two names before its own
        // call into `stdlib::builtin`; see [`crate::interpreter::Vm::call`].
        if matches!(name, "map" | "list_map") {
            let [Value::List(items), rest @ ..] = args else {
                return Err(Error::Runtime(
                    "map requires a list and a function".to_string(),
                    self.span(),
                ));
            };
            let function = crate::stdlib::map_function(rest)
                .map_err(|message| Error::Runtime(message, self.span()))?
                .clone();
            self.start_map(frame, items.clone(), function)?;
            self.advance(frame);
            return Ok(());
        }
        // The same single resolver the tree-walker uses, so the two engines
        // cannot disagree about which names exist. See `stdlib::builtin`.
        if let Some(value) = crate::stdlib::builtin(self.span(), name, args)? {
            self.push(value);
            self.advance(frame);
            return Ok(());
        }
        match self.get_var(name) {
            Some(Value::Function(function)) => {
                self.call_function(name, &function, args, None)?;
                self.advance(frame);
                Ok(())
            }
            _ => Err(Error::Runtime(
                format!("Unknown function '{}'", name),
                self.span(),
            )),
        }
    }

    /// `receiver.method(args)`.
    ///
    /// Resolved against the receiver's *name*, as the tree-walking VM resolves
    /// it: a name that is a declared `object` is a method on that type, and
    /// anything else is the `receiver_method` spelling a module function is
    /// written with.
    fn call_method(&mut self, instruction: Instruction, frame: usize) -> Result<()> {
        let dotted = self.constant_text(instruction.arg)?;
        let args = self.pop_n(instruction.aux)?;

        let Some((object_name, method)) = split_dotted(&dotted) else {
            // A receiver that was an expression rather than a name pushed its
            // value, and the file says so by carrying the bare method name.
            // `[1, 2, 3].map(f)` is the one such call the language answers: a
            // list is not an object and is not a module, but the higher-order
            // builtin has a spelling that takes its receiver literally. It is
            // the same answer the tree-walking VM gives its own expression
            // receiver; see [`crate::interpreter::Vm::call_method`].
            let receiver = self.pop()?;
            return match dotted.as_str() {
                "map" => {
                    let Value::List(items) = receiver else {
                        return Err(Error::Runtime(
                            format!(
                                "Cannot call method '{dotted}' on {receiver}, which is not an object"
                            ),
                            self.span(),
                        ));
                    };
                    let function = crate::stdlib::map_function(&args)
                        .map_err(|message| Error::Runtime(message, self.span()))?;
                    self.start_map(frame, items.clone(), function.clone())?;
                    self.advance(frame);
                    Ok(())
                }
                _ => Err(Error::Runtime(
                    format!(
                        "Cannot call method '{}' on {}, which is not an object",
                        dotted, receiver
                    ),
                    self.span(),
                )),
            };
        };
        // A receiver that was a name pushed nothing: the name is the whole of
        // what a call resolves against. An object method still needs a `this`,
        // which is the *binding* the name holds rather than the type's declared
        // fields — `set Greeter.name to "Ada"` writes that binding, and the
        // method has to see it, which is why the tree-walking VM evaluates its
        // receiver as a variable.
        let receiver = if self.objects.contains_key(object_name) {
            Some(self.get_var(object_name).unwrap_or(Value::Nothing))
        } else {
            None
        };

        let Some(object) = self.objects.get(object_name).cloned() else {
            // A module function, which a builtin namespace member is too. An
            // alias is resolved to the module it names first, so `import json
            // as J` then `J.stringify(..)` reaches the same function
            // `json.stringify(..)` does — the tree-walking VM resolves the same
            // way; see [`crate::interpreter::Vm::call_method`].
            let module = self
                .module_aliases
                .get(object_name)
                .cloned()
                .unwrap_or_else(|| object_name.to_string());
            let qualified = qualified_member(&module, method);
            // The whole rule for a receiver that is not an object lives in
            // `stdlib::dotted_call_reaches`, which the tree-walking VM asks
            // through the same function; see
            // [`crate::interpreter::Vm::call_method`].
            //
            // Three things it decides, and each of them was a way for a dotted
            // call to answer something the language does not have: the receiver
            // has to name a module at all (`random.seed(1)` used to answer
            // through `random_seed`), a module the program declared or imported
            // owns the name rather than `stdlib::MODULE_MEMBERS`, and a stdlib
            // module answers only for a pair that table holds.
            if !crate::stdlib::dotted_call_reaches(
                &module,
                method,
                self.is_declared_module(&module),
                self.get_var(&qualified).is_some(),
                crate::stdlib::module_member_name(&qualified).is_some(),
            ) {
                // Nothing the module path can reach answers this, and `map` is
                // the one member that is also a method on a list, so a name
                // holding a list is asked here rather than refused. `xs.map(f)`
                // is the program SPEC.md's "First-Class Functions" section uses
                // to introduce function values, and before this it died as
                // `xs_map`, a name nothing registers.
                //
                // It is asked *after* the module path, never before it, so a
                // module function of the same spelling still wins: `list` bound
                // to a list and called as `list.map(f)` is `list_map` with one
                // argument, and stays the refusal that says so. The tree-walking
                // VM asks it in the same place; see
                // [`crate::interpreter::Vm::call_method`].
                if method == "map" {
                    if let Some(Value::List(items)) = self.get_var(object_name) {
                        let function = crate::stdlib::map_function(&args)
                            .map_err(|message| Error::Runtime(message, self.span()))?;
                        self.start_map(frame, items, function.clone())?;
                        self.advance(frame);
                        return Ok(());
                    }
                }
                return Err(Error::Runtime(
                    format!("Module '{module}' has no function '{method}'"),
                    self.span(),
                ));
            }
            return self.call_named(&qualified, &args, frame);
        };
