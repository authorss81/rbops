                assert_eq!(
                    crate::repl::style::strip_escapes(&painted[0]),
                    hint_lines(step, &off)[0],
                    "and what it says survives the painting (step {step:?}): {:?}",
                    painted[0].escape_debug()
                );
            }
        }
