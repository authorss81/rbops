+/// Reads a `#position` directive's payload.
+///
+/// `none`, or `line:column` with both numbers at least 1. Anything else is
+/// refused: a golden file that quietly means something else is worse than one
+/// that does not parse.
+fn parse_position(rest: &str) -> Result<Option<Span>, String> {
+    if rest == NO_POSITION {
+        return Ok(None);
+    }
+    let (line, column) = rest
+        .split_once(':')
+        .ok_or(format!("{rest:?} is not a position; write line:column, or 'none'"))?;
+    let read = |raw: &str, what: &str| -> Result<usize, String> {
+        raw.parse::<usize>()
+            .ok()
+            .filter(|number| *number > 0)
+            .ok_or_else(|| format!("{raw:?} is not a {what}; positions count from 1"))
+    };
+    Ok(Some(Span::new(
+        read(line, "line")?,
+        read(column, "column")?,
+    )))
+}
