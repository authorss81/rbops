+/// Builds a VM with all three limits set explicitly, ignoring the
+/// environment.
+///
+/// The three `with_max_*` constructors each replace one limit and leave the
+/// other two to `REDBLUE_MAX_CALL_DEPTH`, `REDBLUE_MAX_STEPS` and
+/// `REDBLUE_MAX_ITERATIONS`, so a caller that wants a run to be reproducible
+/// — a test harness, most of all — has no way to ask for one without this.
+/// A zero is ignored for each limit separately, by the same policy
+/// [`Vm::with_max_iterations`] applies to its own argument.
+pub fn with_limits(max_call_depth: usize, max_steps: usize, max_iterations: usize) -> Self {
+    let mut vm = Self::new();
+    if max_call_depth > 0 {
+        vm.max_call_depth = max_call_depth;
+    }
+    vm.max_steps = resolve_max_steps_from(Some(max_steps));
+    vm.max_iterations = resolve_max_iterations_from(Some(max_iterations));
+    vm
