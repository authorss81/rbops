/// Compiles `body` into `code`.
///
/// `tailing` says whether `body` is the whole of the block it goes in and that
/// block's value is read. When it is, the block's last statement is a bare
/// expression and the value it produced is the block's value — which is what a
/// call returns, and what a program is worth. When it is not, no statement in
/// `body` leaves anything behind, because a block statement is worth nothing
/// whatever its body produced: `set n to 1 / if n is 1 then / 7 / end` is worth
/// `nothing`, and leaving `7` on the operand stack for whoever ran the block
/// would make the two VMs disagree about it.
fn statements(
        &mut self,
        body: &[Stmt],
        code: &mut Vec<Instruction>,
        blocks: &mut Vec<Block>,
        depth: usize,
        tailing: bool,
    ) -> Result<()> {
        let last = tailing.then(|| body.len().saturating_sub(1));
        for (index, stmt) in body.iter().enumerate() {
            self.statement(stmt, code, blocks, depth, last == Some(index))?;
        }
        Ok(())
    }

