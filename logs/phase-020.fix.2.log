/// positions there were to disagree about, so a corpus that stopped failing
/// cannot quietly turn the comparison into a no-op.
#[test]
fn edge_both_vms_place_every_failure_at_the_same_line_and_column() {
    let mut failures = 0usize;
    let mut with_a_position = 0usize;

    for path in corpus::corpus() {
        let source = corpus::read_source(&path);
        let tree = vm::tree_walk(&source);
        let byte = vm::bytecode(&source);
        let (Some(tree_failure), Some(byte_failure)) = (&tree.result, &byte.result) else {
            continue;
        };
        failures += 1;
        if tree_failure.position.is_some() {
            with_a_position += 1;
        }
        assert_eq!(
            tree_failure.position, byte_failure.position,
            "{}: the two VMs reported {} at two different places",
            path.display(),
            tree_failure
        );
