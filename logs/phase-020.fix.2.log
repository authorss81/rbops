    pub fn message(&self) -> &str {
        match self {
            Error::Lexer(msg, _)
            | Error::Parser(msg, _)
            | Error::Analyzer(msg, _)
            | Error::Runtime(msg, _)
            | Error::Io(msg) => msg,
        }
    }

