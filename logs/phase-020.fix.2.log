+#[test]
+fn zz_tmp_probe_span_agreement() {
+    let _ = vm::tree_walk_failure("");
+    let _ = corpus::writing_enabled();
+    let mut span_diff = 0;
+    let mut neither = 0;
+    let mut diffs: Vec<String> = Vec::new();
+    for path in corpus::corpus() {
+        let source = corpus::read_source(&path);
+        let (out1, r1) = vm::tree_walk_verbose(&source);
+        let _ = out1;
+        let name = path.file_name().unwrap().to_string_lossy().to_string();
+        let chunk = match redblue::bytecode::compile_source(&source) {
+            Ok(c) => c,
+            Err(e) => {
+                diffs.push(format!("{name}: compile_source failed: {e}"));
+                continue;
+            }
+        };
+        let mut bvm = redblue::bytecode::vm::BytecodeVm::new();
+        let out2 = bvm.run(&chunk);
+        let (l1, m1, s1) = match &r1 {
+            Ok(_) => ("ok", String::new(), None),
+            Err(e) => (e.label(), e.message().to_string(), e.span().copied()),
+        };
+        let (l2, m2, s2) = match &out2 {
+            Ok(_) => ("ok", String::new(), None),
+            Err(e) => (e.label(), e.message().to_string(), e.span().copied()),
+        };
+        if l1 != l2 || m1 != m2 {
+            diffs.push(format!("{name}: label/message differ {l1}:{m1} vs {l2}:{m2}"));
+            continue;
+        }
+        if s1.is_none() && s2.is_none() {
+            neither += 1;
+        }
+        if s1 != s2 {
+            span_diff += 1;
+            diffs.push(format!("{name}: span {s1:?} vs {s2:?}  msg={m1:?}"));
+        }
+    }
+    println!("span_diff={span_diff} neither={neither}");
+    for d in diffs.iter().take(80) {
+        println!("{d}");
+    }
+}
