    #[test]
    fn edge_every_kind_is_reachable_and_its_arms_produce_it() {
        // Spot-check that each arm of `expression` produces a *parseable* value
        // for its kind by running it as a program: the typed-grammar invariant
        // is asserted from the outside in the differential test, and this is the
