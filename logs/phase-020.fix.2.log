+        "the fixture must reproduce the property"
+    );
+    assert!(
+        source.len() > source.chars().count(),
+        "the fixture must carry a multi-byte character, or it tests nothing: \
+         {source:?}"
+    );
+
+    let minimal = shrink(source, &unterminated_string);
+    assert!(
+        minimal.len() < source.len(),
+        "the character pass should have shortened {} bytes, got {minimal:?}",
+        source.len()
+    );
+    assert!(
+        minimal.is_char_boundary(0) && minimal.chars().count() < source.chars().count(),
+        "the reduction must be a whole number of characters, not a slice of one: \
+         {minimal:?}"
+    );
+    assert!(
+        unterminated_string(&minimal),
+        "the shrunken program must still reproduce the property"
+    );
+
+    // And every one-character deletion off it is a program the predicate can see,
+    // which is the assertion that could not even be written before: it walked
+    // byte indices.
+    for index in 0..minimal.chars().count() {
+        let candidate = without_char(&minimal, index);
+        assert!(
+            candidate.len() < minimal.len() || minimal.chars().count() == 1,
+            "removing one character must not grow the program: {candidate:?}"
+        );
+    }
