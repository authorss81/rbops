+        collisions
+            .entry(generator::generate(seed).source)
+            .or_default()
+            .push(seed);
     }
+
+    let distinct = collisions.len();
+    assert!(
+        distinct * 100 >= SEEDS as usize * 95,
+        "only {distinct} of {SEEDS} seeds produced a program of their own; the seed \
+         is not driving the grammar"
+    );
+
+    // Any collision is named, so "5% is allowed" does not become "any number is
+    // allowed" the next time the grammar changes.
+    let shared: Vec<(&str, &Vec<u64>)> = collisions
+        .iter()
+        .filter(|(_, seeds)| seeds.len() > 1)
+        .map(|(source, seeds)| (source.as_str(), seeds))
+        .collect();
+    assert!(
+        shared.len() * 20 <= SEEDS as usize,
+        "{} programs are shared by more than one seed: {:?}",
+        shared.len(),
