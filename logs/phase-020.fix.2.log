+/// The **position** is compared too, on both sides of the runner.
+///
+/// Two halves, and either alone would be a test that cannot fail: an `.expected`
+/// naming the right failure at the wrong place has to be rejected by
+/// `compare`, and the two VMs have to agree about where a failure happened.
+#[test]
+fn edge_a_failure_that_moved_is_a_difference_on_both_sides() {
+    let source = "set xs to [1]\nsay 1\nsay xs[9]\n";
+    let outcome = vm::tree_walk(source);
+    let failure = outcome
+        .result
+        .as_ref()
+        .expect_err("the program should have faulted")
+        .clone();
+    let path = Path::new("fixtures/moved-failure.rb");
+
+    // Half one: the recorded position is compared, not merely parsed.
+    let mut moved = corpus::parse_recorded(&corpus::record(&outcome));
+    assert!(
+        moved.position.is_some(),
+        "the outcome was recorded without a position: {moved:?}"
+    );
+    corpus::compare(path, &outcome, &moved);
+    moved.position = Some(Span::new(failure.position.expect("a fault").line + 1, 1));
+    let reported = panic::catch_unwind(AssertUnwindSafe(|| {
+        corpus::compare(path, &outcome, &moved)
+    }));
+    assert!(
+        reported.is_err(),
+        "an .expected naming the right failure at the wrong line was accepted; \
+         nothing in the corpus compared where a failure happened"
+    );
+
+    // Half two: the two VMs agree about where it happened, which is what makes
+    // the `.expected` file above a statement about both of them.
+    assert_eq!(
+        failure.position,
+        vm::bytecode(source)
+            .result
+            .as_ref()
+            .expect_err("the bytecode VM should have faulted too")
+            .position,
+        "the two VMs reported the same failure at two different places"
+    );
+}
+
+/// Every failure the corpus records is at a place, and every one of them is
+/// recorded with the place it is at.
+///
+/// A golden file that omits the position is a file that cannot notice the
+/// position moving, which is the half of the outcome the two VMs were never
+/// being compared on.
+#[test]
+fn edge_every_recorded_failure_records_the_place_it_happened_at() {
+    let mut recorded_positions = 0usize;
+    for path in corpus::corpus() {
+        let recorded = corpus::read_recorded(&path);
+        let outcome = corpus::outcome_of(&path);
+        let failure = match &outcome.result {
+            Ok(_) => continue,
+            Err(failure) => failure,
+        };
+        assert_eq!(
+            recorded.position, failure.position,
+            "{}: the recorded position and the reported one differ",
+            path.display()
+        );
+        recorded_positions += 1;
+    }
+    assert!(
+        recorded_positions >= 40,
+        "only {recorded_positions} corpus programs carry a position to compare; the \
+         corpus's error paths have shrunk"
+    );
+}
