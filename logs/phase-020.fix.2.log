+
+/// Programs whose *last statement is a bare expression*, so the program ends
+/// with that expression's value rather than with `nothing`.
+///
+/// Every other family ends in `say`, `set`, `if` or `end`, and each of those is
+/// worth `nothing` — `src/vm.rs:397` makes the program's value the last
+/// statement's value, and none of them produces one. A corpus of nothing but
+/// those records `#value nothing` on all 228 programs and therefore compares
+/// printed lines and failure labels and never a program's value, which is how
+/// `set t to 5 / say t / t` — `Ok("5")` on the tree-walking VM and `Ok("nothing")`
+/// on the bytecode one (phases/phase-020/FINDINGS.md §4) — sits behind a green
+/// gate.
+///
+/// So this family records values, and two thirds of its programs are worth
+/// something on both VMs and two thirds of those are worth something other than
+/// `nothing`: a value that only one of the two VMs reports is the divergence
+/// this corpus exists to find.
+fn values(rng: &mut Rng, index: usize) -> String {
+    let n = rng.between(-9, 9);
+    let text = text_literal(rng.pick(&["Redblue", "", "é", "a b c", "🎉"]));
+    let xs = format!("[{}, {}]", rng.between(-9, 9), rng.between(-9, 9));
+    let pivot = rng.between(-5, 5);
+    let cases: &[(&str, &str)] = &[
+        ("{n}", "a bound number"),
+        ("{text}", "a bound text"),
+        ("(({n} + 1) * 2)", "arithmetic over the bound number"),
+        ("{text} + \"|\"", "text concatenation"),
+        ("({n} is {pivot})", "a yes/no, which is a value too"),
+        ("{xs}", "a list, whole"),
+        ("{rec}", "a record, whole"),
+        ("type_of({xs})", "a builtin call"),
+        ("length({text})", "a builtin call on text"),
+        ("{rec}.key", "a property read"),
+        ("{xs}[0]", "an index into the list"),
+        ("twice({n})", "a call that gives a value back"),
+        ("nothing", "the value `nothing` itself"),
+        ("{rec}.missing", "a key that is not there, so `nothing`"),
+        (
+            "if {n} is {pivot} then\n    {text}\nelse\n    {xs}\nend",
+            "a block tail: worth `nothing` whatever the branch produced",
+        ),
+        (
+            "for each item in {xs}\n    say item\nend",
+            "a loop tail: worth `nothing` whatever the body produced",
+        ),
+    ];
+    let (tail, why) = cases[index % cases.len()];
+    let tail = tail
+        .replace("{n}", &n.to_string())
+        .replace("{pivot}", &pivot.to_string())
+        .replace("{xs}", &xs)
+        .replace("{rec}", &format!("{{key: {n}}}"))
+        .replace("{text}", &text);
+    program(
+        "values",
+        index,
+        &format!(
+            "// {why}\n\
+             to twice(x)\n    \
+               give back x * 2\n\
+             end\n\
+             set n to {n}\n\
+             set text to {text}\n\
+             set xs to {xs}\n\
+             set rec to {{key: {n}}}\n\
+             say n\n\
+             say text\n\
+             say length(xs)\n\
+             say rec.key\n\
+             say twice(n)\n\
+             {tail}\n"
+        ),
+    )
+}

