+        assert_ne!(
+            two_numbers.result, two_texts.result,
+            "a Number and a Text that render alike are one outcome"
+        );
+        assert_ne!(bytecode(number).result, bytecode(text).result);
+
+        // And the mirror: the same value on both VMs still has to agree.
+        assert_eq!(two_numbers, bytecode(number), "{number:?}: the VMs disagree");
+        assert_eq!(two_texts, bytecode(text), "{text:?}: the VMs disagree");
+    }
+}
+
+/// A failure's position is part of it, so two VMs reporting the same failure
+/// at different places are not agreeing.
+///
+/// The reason a position used to be dropped was that a `.rbc` carries no
+/// source text to *render* one from. Rendering is a presentation question;
+/// this is not — both VMs have the position, and a line or column that moved
+/// is a regression in the language whether or not anything can draw it.
+#[test]
+fn edge_a_failure_carries_the_position_it_happened_at() {
+    let source = "set xs to [1]\nsay 1\nsay xs[9]\n";
+    let tree = tree_walk(source);
+    let byte = bytecode(source);
+    assert_eq!(tree, byte, "{tree:?} vs {byte:?}");
+
+    let failure = tree.result.as_ref().expect_err("the program should fault");
+    assert_eq!(failure.label, "RuntimeError");
+    assert_eq!(
+        failure.position,
+        Some(Span::new(3, 5)),
+        "the failure names the third line, and the column its expression starts at"
+    );
+    // Two failures that agree in label and message but not in place are two
+    // failures, which is the whole reason the position is in the outcome.
+    let elsewhere = Failure {
+        position: Some(Span::new(2, 5)),
+        ..failure.clone()
+    };
+    assert_ne!(
+        *tree.result.as_ref().unwrap_err(),
+        elsewhere,
+        "a failure that moved a line is a different failure"
+    );
+}
+
+/// Nothing in this harness reads a limit out of the environment.
+///
+/// `Vm::new()` and `BytecodeVm::new()` both resolve `REDBLUE_MAX_STEPS`,
+/// `REDBLUE_MAX_ITERATIONS` and `REDBLUE_MAX_CALL_DEPTH`, so an outcome that
+/// depended on them would make the corpus's golden files mean whatever the
+/// environment happened to say. Setting all three to something no program can
+/// survive must therefore change nothing at all.
+#[test]
+fn edge_a_limit_left_in_the_environment_cannot_change_an_outcome() {
+    const LIMITS: [&str; 3] = [
+        redblue::vm::MAX_STEPS_ENV,
+        redblue::vm::MAX_ITERATIONS_ENV,
+        redblue::vm::MAX_CALL_DEPTH_ENV,
+    ];
+
+    let program = "set n to 0\nrepeat 3 times\nset n to n + 1\nend\nsay n\nn\n";
+    let before = tree_walk(program);
+    assert_eq!(before, bytecode(program));
+
+    for name in LIMITS {
+        std::env::set_var(name, "1");
+    }
+    let with_the_environment = tree_walk(program);
+    for name in LIMITS {
+        std::env::remove_var(name);
+    }
+
+    assert_eq!(
+        before, with_the_environment,
+        "the outcome followed the environment, so it would not reproduce \
+         anywhere else"
+    );
+    assert_eq!(
+        with_the_environment.output,
+        vec!["3".to_string()],
+        "and the run really did happen: a program with no steps left would \
+         have printed nothing"
+    );
+    assert_eq!(with_the_environment.result, Ok(Value::Number(3.0)));
+}
