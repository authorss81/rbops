use redblue::{run_isolated, Error};

fn fail(e: &Error) -> String { format!("{}: {}", e.label(), e.message()) }

fn tree_walk(source: &str) -> String {
    let tokens = match redblue::lexer::Lexer::tokenize(source) { Ok(t) => t, Err(e) => return fail(&e) };
    let ast = match redblue::parser::parse(tokens) { Ok(a) => a, Err(e) => return fail(&e) };
    if let Err(e) = redblue::analyzer::analyze(&ast) { return fail(&e); }
    let (mut vm, result) = run_isolated(&ast);
    let out = vm.take_output();
    format!("out={out:?} result={:?}", result.as_ref().map(|v| v.to_string()).map_err(|e| fail(e)))
}

fn bytecode(source: &str) -> String {
    let chunk = match redblue::bytecode::compile_source(source) { Ok(c) => c, Err(e) => return fail(&e) };
    let mut vm = redblue::bytecode::vm::BytecodeVm::new();
    let r = vm.run(&chunk);
    let out = vm.take_output();
    format!("out={out:?} result={:?}", r.as_ref().map(|v| v.to_string()).map_err(|e| fail(e)))
}

fn main() {
    for path in std::env::args().skip(1) {
        let src = std::fs::read_to_string(&path).unwrap();
        println!("== {path}");
        println!("  tree: {}", tree_walk(&src));
        println!("  byte: {}", bytecode(&src));
    }
}
