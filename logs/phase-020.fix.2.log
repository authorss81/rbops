+#[test]
+fn the_corpus_holds_programs_that_are_worth_something() {
+    // Every corpus program ends in a statement, and `say`, `set`, `if` and `end`
+    // are all worth `nothing` — so a corpus of nothing but them records
+    // `#value nothing` throughout and the `.expected` comparison is over printed
+    // lines and failure labels only. `set t to 5 / say t / t` is `Ok("5")` on the
+    // tree-walking VM and `Ok("nothing")` on the bytecode one
+    // (phases/phase-020/FINDINGS.md §4), and a corpus that never ends in an
+    // expression cannot tell that from agreement.
+    //
+    // So this counts the programs that recorded a value other than `nothing`,
+    // asks *both* VMs about each of them — the recorded value alone would only
+    // pin the tree-walking one — and requires the values to span types, because
+    // one number repeated is a comparison of one number.
+    let mut valued = 0usize;
+    let mut values: BTreeSet<String> = BTreeSet::new();
+    for (path, source, expected) in loaded_corpus() {
+        let Some(recorded) = expected.value.as_deref() else {
+            continue;
+        };
+        if recorded == "nothing" {
+            continue;
+        }
+        valued += 1;
+        values.insert(recorded.to_string());
+        assert_eq!(
+            tree_walk(&source),
+            bytecode(&source),
+            "{}: a program recorded as worth {recorded:?} must be worth the same on \
+             both VMs",
+            path.display()
+        );
+    }
+    assert!(
+        valued >= 10,
+        "only {valued} corpus programs record a value other than `nothing`, so the \
+         `.expected` comparison never looks at what a program was worth; the \
+         `values` family is missing, or every tail in it is worth nothing"
+    );
+    assert!(
+        values.len() >= 4,
+        "the values the corpus records are {values:?} — the corpus must hold a \
+         program's worth across types, not one number repeated"
+    );
+}
