+/// Every keyword that opens a *statement*, so a line can be told from a
+/// program's trailing expression.
+///
+/// The keywords the generator can emit, plus the ones it cannot: the list is
+/// deliberately generous, because a word left off it turns a statement into an
+/// "expression tail" and the assertion below starts passing for the wrong reason.
+const STATEMENT_OPENERS: [&str; 16] = [
+    "set ",
+    "say ",
+    "end",
+    "for each ",
+    "repeat ",
+    "if ",
+    "while ",
+    "to ",
+    "give back",
+    "object ",
+    "constant ",
+    "import ",
+    "catch ",
+    "try",
+    "test ",
+    "break",
+];
+
+/// Whether `line` is a bare expression rather than a statement.
+///
+/// An `if`, a `repeat` and a `for each` line are statements, which is the whole
+/// point: the check this feeds used to exclude only `set`, `say`, `end` and
+/// `for each`, so a program ending in `if 1 is 1 then` satisfied "has an
+/// expression tail" while being worth `nothing` — the very thing the assertion
+/// exists to guarantee coverage of.
+fn is_expression_tail(line: &str) -> bool {
+    let line = line.trim();
+    !line.is_empty() && !STATEMENT_OPENERS.iter().any(|opener| line.starts_with(opener))
+}
