+#[test]
+fn edge_the_generated_corpus_compares_a_program_s_value_not_only_its_output() {
+    // The agreement property compares three things: the lines printed, the
+    // value or the failure the program ended with, and — for a failure — its
+    // label and message. A generator whose programs all end in `set`, `say`,
+    // `if` or `repeat` compares only the first two, because every one of those
+    // statements is worth `nothing`. That is how `set t to 5 / say t / t` —
+    // `Ok("5")` on one VM and `Ok("nothing")` on the other
+    // (phases/phase-020/FINDINGS.md §4) — sits behind a green gate.
+    //
+    // So this counts the programs worth something, asserts both VMs are asked
+    // about each of them, and requires enough of them that the count cannot be
+    // satisfied by one lucky arm. The distinct values are counted too: one
+    // number repeated is a comparison of a number, not of the language.
+    let mut completed = 0usize;
+    let mut valued = 0usize;
+    let mut values: BTreeSet<String> = BTreeSet::new();
+    let mut a_worthless_program = String::new();
+    for seed in SEEDS {
+        for source in generated(*seed) {
+            let context = format!("seed {seed:#x}");
+            let tree = tree_walk_or_panic(&source, &context);
+            let Ok(value) = tree.result.as_deref() else {
+                continue;
+            };
+            completed += 1;
+            if value == "nothing" {
+                if a_worthless_program.is_empty() {
+                    a_worthless_program = source.clone();
+                }
+                continue;
+            }
+            valued += 1;
+            values.insert(value.to_string());
+            assert_eq!(
+                tree,
+                bytecode(&source),
+                "{context}: a program worth {value:?} is worth the same on both \
+                 VMs:\n{source}"
+            );
+        }
+    }
+
+    assert!(
+        completed > 0,
+        "no generated program ran to completion, so there is no value to compare"
+    );
+    assert!(
+        valued * 2 >= completed,
+        "only {valued} of {completed} generated programs ended with a value other \
+         than `nothing`, so the agreement property is comparing printed lines and \
+         failure labels and nothing else; the value-bearing arm of \
+         `random_statement` is unreachable or over-shadowed. A program worth \
+         nothing, for contrast:\n{a_worthless_program}"
+    );
+    assert!(
+        values.len() >= 3,
+        "the values being compared are {values:?} — a single value repeated is a \
+         comparison of one value, not of the language"
+    );
+}
