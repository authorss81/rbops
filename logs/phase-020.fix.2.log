    /// no position at all (`Io`) and for failures reported as `unknown`.
    pub fn span(&self) -> Option<&Span> {
        let span = match self {
            Error::Lexer(_, span)
            | Error::Parser(_, span)
            | Error::Analyzer(_, span)
            | Error::Runtime(_, span) => span,
            Error::Io(_) => return None,
