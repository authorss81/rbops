+    /// outcome that does not reproduce — has no way to ask for one without this.
+    pub fn with_limits(max_call_depth: usize, max_steps: usize, max_iterations: usize) -> Self {
+        let mut vm = Self::new();
+        if max_call_depth > 0 {
+            vm.max_call_depth = max_call_depth;
+        }
+        vm.max_steps = resolve_max_steps_from(Some(max_steps));
+        vm.max_iterations = resolve_max_iterations_from(Some(max_iterations));
+        vm
+    }
