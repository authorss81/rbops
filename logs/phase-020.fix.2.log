        failures >= 40,
        "only {failures} corpus programs failed on both VMs; the comparison is over \\
         nothing"
    );
    assert!(
        with_a_position >= failures,
        "only {with_a_position} of {failures} failures carry a position, so most of \\
         them are comparing two things that are both absent"
    );
}

