+/// Runs an analyzed program on the tree-walking VM, under this module's limits.
+///
+/// `run_isolated` is what the language itself runs a program on, and it reads
+/// `REDBLUE_MAX_CALL_DEPTH`, `REDBLUE_MAX_STEPS` and `REDBLUE_MAX_ITERATIONS`
+/// out of the environment — as does `Vm::new()`. A differential harness whose
+/// outcomes depend on the environment it happens to run in is not reproducible,
+/// and a green run proves nothing about a different one, so the VM is built here
+/// with [`HARNESS_MAX_CALL_DEPTH`] and its two siblings instead.
+///
+/// The thread is the interpreter's own arrangement (a call frame is six nested
+/// Rust frames) for the same reason: 64 Redblue frames do not fit in the 2 MiB
+/// a test thread gets by default.
+fn run_tree(program: &Program) -> (Vec<String>, Result<Value, Error>) {
+    let program = program.clone();
+    let spawned = std::thread::Builder::new()
+        .name("redblue-differential".to_string())
+        .stack_size(HARNESS_MAX_CALL_DEPTH.saturating_mul(STACK_BYTES_PER_CALL))
+        .spawn(move || {
+            let mut vm = Vm::new()
+                .with_max_call_depth(HARNESS_MAX_CALL_DEPTH)
+                .with_max_iterations(HARNESS_MAX_ITERATIONS)
+                .with_max_steps(HARNESS_MAX_STEPS);
+            let result = vm.run(&program);
+            (vm.take_output(), result)
+        });
+
+    let joined = match spawned {
+        Ok(handle) => handle.join(),
+        Err(error) => {
+            return (
+                Vec::new(),
+                Err(Error::Io(format!(
+                    "Cannot start the interpreter thread: {error}"
+                ))),
+            )
+        }
+    };
+
+    match joined {
+        Ok(outcome) => outcome,
+        Err(_) => (
+            Vec::new(),
+            Err(Error::Runtime(
+                "The interpreter thread stopped unexpectedly".to_string(),
+                Span::unknown(),
+            )),
+        ),
+    }
+}
