use crate::error::{Error, Result, Span};
use crate::lexer::{Token, TokenKind};

#[derive(Debug, Clone)]
pub enum Expr {
    // Literals
    Number(f64),
    Text(String),
    YesNo(bool),
    Nothing,

    // Variables
    Variable(String),

    // Binary operations
    Binary {
        op: BinaryOp,
