fn a_chain_desugars_to_nested_if_statements_one_end_apart() {
    // The chain is sugar for nested `if`s, so the tree it parses to has to be
    // the nested tree: each arm holds the rest of the chain as its one and only
    // `else` statement, and each desugared arm is positioned at the `if` it was
    // written as. A parser that built a chain of its own node would pass every
    // behavioural test above and fail this one.
    let source = "set hit to \\"none\\"\\n\\
                  if 1 is 2 then\\n    set hit to \\"a\\"\\n\\
                  else if 2 is 3 then\\n    set hit to \\"b\\"\\n\\
                  else if 3 is 3 then\\n    set hit to \\"c\\"\\n\\
                  else\\n    set hit to \\"d\\"\\nend\\n";
    let program = lex_and_parse(source).expect("a three-arm chain should parse");
    let chain = &program.statements[1];
    assert_eq!(chain.span.line, 2, "the outermost `if` is on line 2");

    let mut arm = 1;
    let mut statement = &chain.statement;
    while let Statement::If {
        then_branch,
        else_branch,
        ..
    } = statement
    {
        assert_eq!(
            then_branch.len(),
            1,
            "arm {arm} holds one statement, the one it was written with"
        );
        assert_eq!(
            else_branch.len(),
            1,
            "arm {arm} holds the rest of the chain as one nested `if`"
        );
        statement = &else_branch[0].statement;
        assert_eq!(
            else_branch[0].span.line,
            arm + 2,
            "arm {arm} is positioned at the `else if` it was written as"
        );
        arm += 1;
    }
    assert_eq!(arm, 3, "a three-arm chain plus its `if` is four nested arms");
    match statement {
        Statement::If {
            then_branch,
            else_branch,
            ..
        } => {
            assert_eq!(then_branch.len(), 1, "the innermost arm holds its statement");
            assert_eq!(
                else_branch.len(),
                1,
                "the trailing `else` is the innermost arm's else_branch"
            );
        }
        other => panic!("the innermost arm is an `if`, got {other:?}"),
    }
}

'''
