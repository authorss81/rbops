    pub fn is_truthy(&self) -> bool {
        match self {
            Value::Nothing => false,
            Value::YesNo(b) => *b,
            Value::Number(n) => *n != 0.0,
            Value::Text(s) => !s.is_empty(),
            Value::List(items) => !items.is_empty(),
            Value::Record(_) => true,
            Value::Object(_, _) => true,
            Value::Function(_) => true,
            Value::Builtin(_) => true,
        }
    }
