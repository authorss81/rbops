fn edge_a_long_chain_takes_the_arm_that_matches_and_needs_no_stack_per_arm() {
    // The chain is read by a loop rather than by recursion — a recursive
    // desugar would put one frame per arm on the stack — so a program with more
    // arms than a comfortable recursion budget still parses and still picks the
    // right arm.
    let arms = 400;
    let mut source = String::from("set hit to \\"none\\"\\nif 1 is 1 then\\n    set hit to \\"first\\"\\n");
    for arm in 0..arms {
        source.push_str(&format!(
            "else if 1 is {} then\\n    set hit to \\"arm-{arm}\\"\\n",
            arm + 2
        ));
    }
    source.push_str("end\\n");
    assert_eq!(
        branch_taken_by(&source),
        "first",
        "the first arm of a {arms}-arm chain must still win"
    );
    // The last arm, read on a program that has to hold all of them.
    let mut source = String::from("set hit to \\"none\\"\\nif 1 is 1 then\\n    set hit to \\"first\\"\\n");
    for arm in 0..arms {
        source.push_str(&format!(
            "else if 1 is {} then\\n    set hit to \\"arm-{arm}\\"\\n",
            arm + 2
        ));
    }
    source.push_str(&format!(
        "else if 1 is {} then\\n    set hit to \\"last\\"\\nend\\n",
        arms + 2
    ));
    assert_eq!(
        branch_on_both_engines(&source),
        "last",
        "the {arms}th arm of a long chain must be reachable"
    );
}

#[test]
fn edge_the_repl_block_depth_reads_a_chain_as_one_block_and_a_nested_if_as_two() {
    // The depth is what tells a REPL to read another line, so the two readings of
    // `else` + `if` have to count differently or a REPL either runs half a chain
    // or asks for an `end` the chain is never written with.
    let tokens = |source: &str| -> Vec<redblue::lexer::Token> {
        Lexer::tokenize(source).unwrap_or_else(|e| panic!("{source:?} should lex: {e}"))
    };
    let chain = "if x is 1 then\\n    say \\"a\\"\\nelse if x is 2 then\\n    say \\"b\\"\\nelse\\n    say \\"c\\"\\n";
    assert_eq!(
        open_block_depth(&tokens(chain)),
        1,
        "a chain waits for the one `end` that closes it"
    );
    assert_eq!(
        open_block_depth(&tokens(&format!("{chain}end\\n"))),
        0,
        "that `end` closes the whole chain"
    );
    let nested = "if x is 1 then\\n    say \\"a\\"\\nelse\\n    if x is 2 then\\n        say \\"b\\"\\n    end\\n";
    assert_eq!(
        open_block_depth(&tokens(nested)),
        2,
        "an `if` on the line after `else` opens a block of its own"
    );
    assert_eq!(
        open_block_depth(&tokens(&format!("{nested}end\\nend\\n"))),
        0,
        "and each of the two `end`s closes one"
    );
}

// --- malformed chains are refused'''
