fn parse_if(&mut self) -> Result<Option<Statement>> {
        let if_span = self.span();
        self.advance(); // consume 'if'
        let condition = self.parse_expression()?;

        self.skip_newlines();
        self.expect(&TokenKind::Then)?;
        self.skip_newlines();

        let then_branch = self.parse_if_arm_body()?;

        // Every arm of the chain, outermost first: the `if` arm plus one entry
        // per `else if`. A chain is sugar for nested `if`s, so it is
        // desugared below rather than given its own node.
        let mut arms = vec![(condition, then_branch, if_span)];
        let mut else_branch = Vec::new();

        if let Some(Token {
            kind: TokenKind::Else,
            ..
        }) = self.current()
        {
            self.advance();
            self.skip_newlines();

            // An `else` may introduce another arm or be the chain's last
            // branch, and the token after it is what tells them apart: an `if`
            // makes another arm, anything else makes the last branch — a nested
            // `if` included, which is the form this chain desugars to.
            loop {
                if self.current().map(|t| &t.kind) == Some(&TokenKind::If) {
                    let arm_span = self.span();
                    self.advance(); // consume 'if'
                    let arm_condition = self.parse_expression()?;
                    self.skip_newlines();
                    self.expect(&TokenKind::Then)?;
                    self.skip_newlines();
                    arms.push((arm_condition, self.parse_if_arm_body()?, arm_span));
                    self.skip_newlines();
                    if self.current().map(|t| &t.kind) != Some(&TokenKind::Else) {
                        // The chain ends here and its `end` closes it.
                        break;
                    }
                    self.advance();
                    self.skip_newlines();
                    continue;
                }
                else_branch = self.parse_if_arm_body()?;
                break;
            }
        }

        self.expect(&TokenKind::End)?;

        // The innermost arm is the `if` it desugars to; every earlier arm holds
        // the rest of the chain as its `else`. One `end` closes the whole chain,
        // so no arm below carries an `end` of its own.
        let (condition, then_branch, span) = arms.pop().expect("the if arm is always pushed");
        let mut statement = Stmt {
            span,
            statement: Statement::If {
                condition,
                then_branch,
                else_branch,
            },
