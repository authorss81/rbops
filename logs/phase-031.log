+    // a real target to come back to.
+    let dir = scratch_dir("circular");
+    fs::write(dir.join("CircleMod.rb"), "import CircleMod\nconstant X to 1\n").unwrap();
+    let source = "import CircleMod\ntry\n    say X\ncatch error\n    say \"caught\"\nend\n".to_string();
+    let byte = bytecode(&source);
+    assert!(
+        byte.result.as_ref().is_err() || byte.output == vec!["caught".to_string()],
+        "a circular import must end as a caught error, not a hang: {byte:?}"
+    );
+    assert!(
+        byte
+            .result
+            .as_ref()
+            .err()
+            .map(|message| message.contains("Circular import"))
+            .unwrap_or(false),
+        "the refusal must name the cycle: {byte:?}"
+    );
+}

