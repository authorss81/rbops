                 sys.parse(options, [\"--count\", \"three\"])\n\
             catch error problem\n\
                 set caught to yes\n\
             end\n\
             say caught\n\
             say \"after\"",
        );
        assert_eq!(
            lines,
            vec!["yes".to_string(), "after".to_string()],
            "the wrong-type failure should be caught and execution should continue"
        );
    }
}
