import re, subprocess, difflib
from pathlib import Path
survey = Path('SURVEY.md')
text = survey.read_text()
paths = sorted(set(re.findall(r'(src/[A-Za-z0-9_/]+\.rs):(\d+)', text)))
mapping = {}
for path in paths:
    old = subprocess.check_output(['git','show',f'HEAD:{path}'], text=True).splitlines()
    new = Path(path).read_text().splitlines()
    sm = difflib.SequenceMatcher(None, old, new, autojunk=False)
    m = {}
    for tag, i1, i2, j1, j2 in sm.get_matching_blocks():
        for k in range(i2-i1):
            m[i1+k+1] = j1+k+1
    mapping[path] = m
    # for old lines that were replaced, map to nearest following matched line
    for line in range(1, len(old)+1):
        if line not in m:
            after = [v for k,v in m.items() if k > line]
            m[line] = min(after) if after else len(new)

def repl(mo):
    path, num = mo.group(1), int(mo.group(2))
    return f"{path}:{mapping.get(path, {}).get(num, num)}"
text = re.sub(r'(src/[A-Za-z0-9_/]+\.rs):(\d+)', repl, text)
survey.write_text(text)
