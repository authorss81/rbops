    for line in range(1, len(old)+1):
        if line not in m:
            after = [v for k,v in m.items() if k > line]
            m[line] = min(after) if after else len(new)
    mapping[doc] = m

for name in files:
    p = Path(name)
    text = p.read_text()
    def repl(mo):
        doc, num = mo.group(1), int(mo.group(2))
        return f"{doc}:{mapping.get(doc, {}).get(num, num)}"
    text = re.sub(r'((?:docs/)?[A-Za-z_]+\.md):(\d+)', repl, text)
    p.write_text(text)
