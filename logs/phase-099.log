[0m$ [0mcat >> tests/collections_test.rs <<'EOF'

/// A list has no constant-time removal from the front: `shift` only *reads* the
/// first item, and the removal spelling is `skip(xs, 1)`, which copies the rest
/// of the list on every call. A deque is the value that does have it.
///
/// The claim is measured rather than asserted from the shape of the code. The
/// margin is deliberately wide — a deque that was secretly quadratic would be
/// indistinguishable from this one at small sizes, and the list side is already
/// several times slower at four thousand items — so the test is about the
/// growth, not about a machine's speed. It times the tree-walker only, because
/// the cost is in `skip` and the deque's representation, and both engines reach
/// the same builtins.
#[test]
fn deque_removal_from_the_front_is_not_quadratic_like_skip() {
    let n = 4000;
    let deque_source = format!(
        "set q to collections.deque([])\n\
         set i to 0\n\
         repeat {n} times\n\
             set q to collections.push_right(q, i)\n\
             set i to i + 1\n\
         end\n\
         set i to 0\n\
         repeat {n} times\n\
             set p to collections.pop_left(q)\n\
             set q to p.deque\n\
             set i to i + 1\n\
         end\n\
         say i"
    );
    let list_source = format!(
        "set xs to []\n\
         set i to 0\n\
         repeat {n} times\n\
             set xs to push(xs, i)\n\
             set i to i + 1\n\
         end\n\
         set i to 0\n\
         repeat {n} times\n\
             set xs to skip(xs, 1)\n\
             set i to i + 1\n\
         end\n\
         say i"
    );

    let timed = |source: &str| {
        let started = std::time::Instant::now();
        let answer = tree(source);
        assert_eq!(answer.to_string(), n.to_string());
        started.elapsed()
    };

    // Warm the process so the first program is not the one that pays for page
    // faults and the allocator's first arenas.
    let _ = timed(&deque_source);
    let deque_time = timed(&deque_source);
    let list_time = timed(&list_source);
    assert!(
        deque_time * 2 < list_time,
        "removing {n} items from the front took {deque_time:?} with a deque and \
         {list_time:?} with skip(xs, 1); the deque is supposed to avoid the copy \
         that makes the list spelling quadratic"
    );
}
EOF
