    old = subprocess.check_output(['git','show',f'HEAD:{doc}'], text=True).splitlines()
    new = Path(doc).read_text().splitlines()
    sm = difflib.SequenceMatcher(None, old, new, autojunk=False)
    m = {}
    for i, j, n in sm.get_matching_blocks():
        for k in range(n):
