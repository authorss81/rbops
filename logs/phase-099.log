    }

    fn binary_op(&self, op: &BinaryOp, left: Value, right: Value) -> Result<Value> {
        runtime::binary_op(self.span(), op, left, right)
    }

    fn unary_op(&self, op: &UnaryOp, value: Value) -> Result<Value> {
        runtime::unary_op(self.span(), op, value)
    }

