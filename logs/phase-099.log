         repeat {n} times\\n\\
             set q to collections.push_right(q, i)\\n\\
             set i to i + 1\\n\\
         end\\n\\
         set total to 0\\n\\
         repeat {n} times\\n\\
             set p to collections.pop_left(q)\\n\\
             set total to total + p.value\\n\\
             set q to p.deque\\n\\
         end\\n\\
         total"
    );
    let list_source = format!(
        "set xs to {literal}\\n\\
         set total to 0\\n\\
         repeat {n} times\\n\\
             set first to shift(xs)\\n\\
             set total to total + first\\n\\
             set xs to skip(xs, 1)\\n\\
         end\\n\\
         total"
    );

    // `shift` only reads the first item; removing it is `skip`. Timing the read
    // on its own separates the constant-time half from the quadratic one.
    let shift_source = format!(
        "set xs to {literal}\\n\\
         set total to 0\\n\\
         repeat {n} times\\n\\
             set total to total + shift(xs)\\n\\
         end\\n\\
         total"
    );

    // Warm every program so the first run's allocator and code-cache cost does
    // not decide the comparison.
    assert_eq!(tree(&deque_source).to_string(), expected);
    assert_eq!(tree(&list_source).to_string(), expected);
    assert_eq!(tree(&shift_source).to_string(), "0");

    let (deque_time, deque_answer) = fastest(&deque_source, 2);
    let (list_time, list_answer) = fastest(&list_source, 2);
    let (shift_time, shift_answer) = fastest(&shift_source, 2);

    assert_eq!(
        deque_answer.to_string(),
        expected,
        "the deque queue must pop every pushed value exactly once"
    );
    assert_eq!(
        list_answer.to_string(),
        expected,
        "the list-based queue must pop every pushed value exactly once"
    );
    assert_eq!(
        shift_answer.to_string(),
        "0",
        "shift must read the first item without removing it"
    );
    println!(
        "deque: {deque_time:?}, list shift+skip: {list_time:?}, \\
         shift read alone: {shift_time:?} (n={n})"
    );
    assert!(
        deque_time * 2 < list_time,
        "a deque must beat the list's quadratic front removal, not merely claim it: \\
         deque {deque_time:?}, list shift+skip {list_time:?} (n={n})"
    );
    assert!(
        shift_time * 8 < list_time,
        "shift is a constant-time read and must not carry the list queue's cost: \\
         shift read {shift_time:?}, list shift+skip {list_time:?} (n={n})"
    );
}
