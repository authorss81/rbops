/// The wall-clock of the fastest of `runs` tree-walker executions.
fn fastest(source: &str, runs: usize) -> (Duration, Value) {
    let mut best = Duration::MAX;
    let mut answer = Value::Nothing;
    for _ in 0..runs {
        let started = Instant::now();
        answer = tree(source);
        best = best.min(started.elapsed());
    }
    (best, answer)
}

/// A list of the numbers `0..n` as the language prints it.
fn list_text(items: impl Iterator<Item = usize>) -> String {
    let parts = items.map(|item| item.to_string()).collect::<Vec<_>>();
    format!("[{}]", parts.join(", "))
}

#[test]
fn edge_a_single_entry_counter_counts_it_once() {
    let value = both(
        "set c to collections.counter([42])\\n\\
         [collections.count(c, 42), collections.count(c, 43), collections.most_common(c)]",
    );
    assert_eq!(
        value.to_string(),
        "[1, 0, [[42, 1]]]",
        "a one-item counter must count that item once and answer the documented \
         missing value for every other key"
    );
}

#[test]
fn edge_a_counter_refuses_a_negative_forged_count() {
    both_refuse(
        "say collections.most_common({counts: [[1, -1]], missing: 0})",
        "non-negative number",
    );
}

#[test]
fn edge_a_deque_built_from_a_list_pops_both_ends_for_every_length() {
    for n in [
        0usize, 1, 2, 3, 4, 5, 6, 7, 8, 9, 15, 16, 17, 31, 32, 33, 63, 64, 65, 127,
    ] {
        let source = format!(
            "set xs to []\\n\\
             set i to 0\\n\\
             repeat {n} times\\n\\
                 set xs to push(xs, i)\\n\\
                 set i to i + 1\\n\\
             end\\n\\
             set q to collections.deque(xs)\\n\\
             set left to []\\n\\
             repeat {n} times\\n\\
                 set p to collections.pop_left(q)\\n\\
                 set left to push(left, p.value)\\n\\
                 set q to p.deque\\n\\
             end\\n\\
             set q to collections.deque(xs)\\n\\
             set right to []\\n\\
             repeat {n} times\\n\\
                 set p to collections.pop_right(q)\\n\\
                 set right to push(right, p.value)\\n\\
                 set q to p.deque\\n\\
             end\\n\\
             [left, right]"
        );
        let value = both(&source);
        let expected = format!(
            "[{}, {}]",
            list_text(0..n),
            list_text((0..n).rev())
        );
        assert_eq!(
            value.to_string(),
            expected,
            "a deque built from a {n}-item list must pop the list in order from \
             the left and in reverse from the right"
        );
    }
}

#[test]
fn edge_a_deque_beats_a_list_work_queue_at_the_front() {
    let n = 6000usize;
    let expected = ((n as u64 * (n as u64 - 1)) / 2).to_string();
    let deque_source = format!(
        "set q to collections.deque([])\\n\\
         set i to 0\\n\\
         repeat {n} times\\n\\
             set q to collections.push_right(q, i)\\n\\
             set i to i + 1\\n\\
         end\\n\\
         set total to 0\\n\\
         repeat {n} times\\n\\
             set p to collections.pop_left(q)\\n\\
             set total to total + p.value\\n\\
             set q to p.deque\\n\\
         end\\n\\
         total"
    );
    let list_source = format!(
        "set xs to []\\n\\
         set i to 0\\n\\
         repeat {n} times\\n\\
             set xs to push(xs, i)\\n\\
             set i to i + 1\\n\\
         end\\n\\
         set total to 0\\n\\
         repeat {n} times\\n\\
             set first to shift(xs)\\n\\
             set total to total + first\\n\\
             set xs to skip(xs, 1)\\n\\
         end\\n\\
         total"
    );

    // Warm both programs so the first run's allocator and code-cache cost does
    // not decide the comparison.
    assert_eq!(tree(&deque_source).to_string(), expected);
    assert_eq!(tree(&list_source).to_string(), expected);

    let (deque_time, deque_answer) = fastest(&deque_source, 2);
    let (list_time, list_answer) = fastest(&list_source, 2);

    assert_eq!(
        deque_answer.to_string(),
        expected,
        "the deque queue must pop every pushed value exactly once"
    );
    assert_eq!(
        list_answer.to_string(),
        expected,
        "the list-based queue must pop every pushed value exactly once"
    );
    println!("deque: {deque_time:?}, list shift+skip: {list_time:?} (n={n})");
    assert!(
        deque_time * 4 < list_time,
        "a deque must beat the list's quadratic front removal, not merely claim it: \\
         deque {deque_time:?}, list shift+skip {list_time:?} (n={n})"
    );
}
