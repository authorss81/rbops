use std::collections::VecDeque;

use redblue::{Span, Value};

fn b(name: &str, args: &[Value]) -> Value {
    redblue::stdlib::builtin(Span::new(1, 1), name, args).unwrap().unwrap()
}

#[test]
fn fuzz_deque_model() {
    let mut seed = 0x1234_5678_9abc_def0u64;
    let mut rand = || { seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1); seed >> 33 };
    for round in 0..200 {
        let mut q = b("collections_deque", &[Value::list(vec![])]);
        let mut model: VecDeque<f64> = VecDeque::new();
        for step in 0..200 {
            let op = rand() % 4;
            match op {
                0 => { let v = (rand()%1000) as f64; q = b("collections_push_left", &[q, Value::Number(v)]); model.push_front(v); }
                1 => { let v = (rand()%1000) as f64; q = b("collections_push_right", &[q, Value::Number(v)]); model.push_back(v); }
                2 => {
                    let p = b("collections_pop_left", &[q]);
                    let got = match p { Value::Record(ref f) => f.get("value").unwrap().clone(), _ => panic!() };
                    let want = model.pop_front().map(Value::Number).unwrap_or(Value::Nothing);
                    assert_eq!(got, want, "round {round} step {step} pop_left");
                    q = match p { Value::Record(f) => f.get("deque").unwrap().clone(), _ => panic!() };
                }
                _ => {
                    let p = b("collections_pop_right", &[q]);
                    let got = match p { Value::Record(ref f) => f.get("value").unwrap().clone(), _ => panic!() };
                    let want = model.pop_back().map(Value::Number).unwrap_or(Value::Nothing);
                    assert_eq!(got, want, "round {round} step {step} pop_right");
                    q = match p { Value::Record(f) => f.get("deque").unwrap().clone(), _ => panic!() };
                }
            }
            let built = b("collections_deque", &[Value::list(model.iter().cloned().map(Value::Number).collect())]);
            assert_eq!(q, built, "round {round} step {step} equality vs model {:?}", model);
        }
    }
}
