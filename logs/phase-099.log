use std::time::{Duration, Instant};
use redblue::run_source_value;

fn best(source: &str, runs: usize) -> (Duration, String) {
    let mut best = Duration::MAX;
    let mut out = String::new();
    for _ in 0..runs {
        let started = Instant::now();
        let value = run_source_value(source).unwrap();
        best = best.min(started.elapsed());
        out = value.to_string();
    }
    (best, out)
}

#[test]
fn measure() {
    let n = 6000usize;
    let build = format!("set xs to []\nset i to 0\nrepeat {n} times\n    set xs to push(xs, i)\n    set i to i + 1\nend\n");
    let shift = format!("{build}set total to 0\nrepeat {n} times\n    set total to total + shift(xs)\nend\ntotal");
    let len = format!("{build}set total to 0\nrepeat {n} times\n    set total to total + length(xs)\nend\ntotal");
    let first_index = format!("{build}set total to 0\nrepeat {n} times\n    set total to total + xs[0]\nend\ntotal");
    let noop = format!("set total to 0\nrepeat {n} times\n    set total to total + 0\nend\ntotal");
    for (name, src, want) in [("shift", &shift, "0"), ("length", &len, "36000000"), ("xs[0]", &first_index, "0"), ("noop", &noop, "0")] {
        let (t, out) = best(src, 2);
        println!("{name}: {t:?} -> {out} (want {want})");
    }
}
