+#[test]
+fn a_freed_word_is_only_spelled_as_a_keyword_under_a_not_implemented_note() {
+    // A freed word may still appear in the grammar as the shape a future
+    // implementation has to match — `when_statement`, `async_call`,
+    // `parallel_block`, `object_literal` all do. What it may not do is sit in a
+    // section that reads as live grammar, because a reader writes the production
+    // down and the program then dies in the parser. Every section that spells one
+    // has to say out loud that nothing in it parses today.
+    let sections = grammar_sections();
+
+    for word in FREED {
+        let quoted = format!("'{}'", word);
+        let carrying: Vec<&String> = sections
+            .iter()
+            .filter(|section| section.contains(&quoted))
+            .collect();
+
+        assert!(
+            !carrying.is_empty(),
+            "docs/GRAMMAR.md no longer spells `'{}'` anywhere, so the production a future \
+             implementation has to match has been deleted rather than marked; either restore it \
+             under a Not-implemented note or say in the phase report that it was removed",
+            word
+        );
+
+        for section in carrying {
+            let heading = section
+                .lines()
+                .find(|line| line.starts_with('#'))
+                .unwrap_or("<no heading>");
+            assert!(
+                section.to_lowercase().contains("not implemented"),
+                "docs/GRAMMAR.md spells `'{}'` in `{}`, which does not say the form is \
+                 Not implemented; a freed word is an identifier, so a production that reads it \
+                 is a promise the parser cannot keep",
+                word,
+                heading
+            );
+        }
+    }
+}

