503-  REAL="$(grep -oE '[0-9]+ passed' /tmp/test.log | awk '{s+=$1} END{print s+0}')"
504-  CLAIM="$(grep -oE '[0-9]+ passed' "$REPORT" | head -1 | awk '{print $1}')"
505-  if [ -n "${CLAIM:-}" ]; then
506-    # Asymmetric by design. The threat model is FABRICATION: claiming green
507-    # that was never earned. A claim ABOVE reality (+2 tolerance for reruns)
508-    # fails the phase. A claim BELOW reality is sloppiness in prose, not a lie
509-    # that ships bad code — the gate itself measured the real number, so warn
510-    # and move on. This distinction once blocked a phase with 59 green tests
511-    # over a "0 passing" typo.
512-    if [ "$CLAIM" -gt $((REAL + 2)) ]; then
513-      bad "report claims $CLAIM passing, actual run has $REAL — over-claiming is fabrication"
514-    elif [ "$CLAIM" -lt $((REAL - 2)) ]; then
515-      warn "report claims $CLAIM passing, actual run has $REAL — under-claimed, fix the number"
516:      ok "reported test count ($CLAIM) does not exceed actual ($REAL)"
