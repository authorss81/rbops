/// A fresh, empty directory under the project's own `target/tmp/`.
fn scratch(name: &str) -> PathBuf {
    let dir = Path::new(env!("CARGO_MANIFEST_DIR"))
        .join("target/tmp/project-test")
        .join(name);
    let _ = fs::remove_dir_all(&dir);
    fs::create_dir_all(&dir).expect("scratch dir should be creatable");
    dir
}

/// A fresh, empty directory outside the checkout.
///
/// Discovery walks every ancestor, so a scratch directory under `target/tmp/`
/// is only "outside a project" until the checkout root gains a manifest. The
/// system temp directory has no such ancestor.
fn outside_scratch(name: &str) -> PathBuf {
    let dir = std::env::temp_dir()
        .join("rb-redblue-discovery")
        .join(format!("{}-{name}", std::process::id()));
    let _ = fs::remove_dir_all(&dir);
    fs::create_dir_all(&dir).expect("outside scratch dir should be creatable");
    dir
}

/// The `rb` binary under test.
fn rb() -> Command {
    Command::new(env!("CARGO_BIN_EXE_rb"))
}

/// Runs `rb` in `dir` with `args`.
fn run_in(dir: &Path, args: &[&str]) -> Output {
    rb().current_dir(dir)
        .args(args)
        .output()
        .expect("rb should be runnable")
}

fn stderr(output: &Output) -> String {
    String::from_utf8_lossy(&output.stderr).to_string()
}

fn stdout(output: &Output) -> String {
    String::from_utf8_lossy(&output.stdout).to_string()
}

