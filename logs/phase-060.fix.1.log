+    /// network as net` becomes `… to net`, and `give` and `back` are one kind to
+    /// the parser — and a session that quietly rewrote the words a user typed
+    /// would export a program they never ran and name definitions with lines they
+    /// never wrote. A program the formatter would change beyond its layout is run
+    /// exactly as it was typed.
+    fn format_on_enter(code: &str) -> String {
+        match crate::formatter::format(code) {
+            Ok(formatted) if formatted.trim_end() != code.trim_end() => {
+                if Self::same_tokens(code, &formatted) {
+                    formatted
+                } else {
+                    code.to_string()
+                }
