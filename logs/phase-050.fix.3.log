        ("push", "say push([1], 2)".into(), "[1, 2]\n".into()),
        // `append` is the one builtin that takes a *name*: it has to bind.
        (
            "append",
            "set xs to [1]\nappend(\"xs\", 2)\nsay xs".into(),
