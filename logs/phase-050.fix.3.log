        ("is_text", r#"say is_text("a")"#.into(), "yes\n".into()),
        ("is_list", "say is_list([1])".into(), "yes\n".into()),
        ("is_record", "say is_record({a: 1})".into(), "yes\n".into()),
        ("to_text", "say to_text(1)".into(), "1\n".into()),
