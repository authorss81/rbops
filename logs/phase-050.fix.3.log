+/// `length` answers a text and a list. It does not answer a record.
+///
+/// SPEC.md said all three, and the claim is not one a reader could check by
+/// reading: `runtime::builtin` refuses a record as `length requires a list or
+/// text`, `tests/test_text.rb` pins that refusal as a caught error and
+/// `corpus/stdlib-0005` and `corpus/stdlib-0006` record it. This walks every
+/// spelling of the name, so the two cannot drift apart again the way the sentence
+/// and the runtime did.
+#[test]
+fn edge_length_answers_a_text_or_a_list_and_refuses_a_record() {
+    for (source, expected) in [
+        (r#"say length("abc")"#, "3"),
+        (r#"say text.length("abc")"#, "3"),
+        (r#"say length([1, 2, 3])"#, "3"),
+        (r#"say list.length([1, 2, 3])"#, "3"),
+    ] {
+        let (ok, stdout, stderr) = run_named("length_answers", source);
+        assert!(ok, "{source} did not run:\n--- stderr\n{stderr}");
+        assert_eq!(
+            stdout.trim_end(),
+            expected,
+            "length did not answer {source} as both documents write it"
+        );
+    }
+
+    // A record is the third thing SPEC.md used to claim `length` answered. Every
+    // spelling of the name is asked, because the sentence named the function
+    // rather than one spelling of it.
+    for source in [
+        r#"say length({a: 1})"#,
+        r#"say text.length({a: 1})"#,
+        r#"say list.length({a: 1})"#,
+        r#"say length({})"#,
+    ] {
+        let (ok, stdout, stderr) = run_named("length_refuses_a_record", source);
+        assert!(
+            !ok,
+            "{source} answered, so `length` answers a record as well as a text and a list \
+             and SPEC.md's sentence is right after all:\n--- stdout\n{stdout}"
+        );
+        assert!(
+            stderr.contains("length requires a list or text"),
+            "{source} was refused by another rule than the one that says a record is not \
+             a length:\n--- stderr\n{stderr}"
+        );
+    }
+}

