            "yes\n".into(),
        ),
        (
            "ends_with",
            r#"say ends_with("hello", "lo")"#.into(),
            "yes\n".into(),
        ),
        (
            "replace",
            r#"say replace("a-b", "-", "+")"#.into(),
            "a+b\n".into(),
        ),
        (
            "length",
            r#"say length("abcd")
