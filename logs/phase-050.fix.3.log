+/// handled early: `length("é")` would have gone from 2 to 1 with no change to
+/// any program.
+///
+/// A text is a sequence of characters in this language, and `bytes` is the
+/// spelling that is explicit about the encoding, so characters is what the
+/// specification now says and what both implementations answer.
+#[test]
+fn edge_length_counts_characters_and_bytes_only_when_asked() {
+    let cases = [
+        (r#"say length("é")"#, "1", "one character, two bytes"),
+        (r#"say length("日本語")"#, "3", "three characters, nine bytes"),
+        (r#"say length("")"#, "0", "no characters at all"),
+        (r#"say length(bytes.from_text("é"))"#, "2", "two bytes as a list"),
+        (r#"say text.length("café")"#, "4", "the module spelling agrees"),
+        (r#"say length([1, 2, 3])"#, "3", "a list is still its own length"),
+    ];
+
+    for (source, expected, what) in cases {
+        let (ok, stdout, stderr) = run_named("length_case", source);
+        assert!(ok, "{source} did not run:\n--- stderr\n{stderr}");
+        assert_eq!(
+            stdout.trim_end(),
+            expected,
+            "length did not answer {what} for {source}"
+        );
+    }
+}
