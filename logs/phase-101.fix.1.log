+#[test]
+fn edge_text_utilities_refuse_invalid_widths_and_sides_on_both_engines() {
+    for source in [
+        format!("text.wrap({}, 0)", rb_text("x")),
+        format!("text.pad({}, 0, {})", rb_text("x"), rb_text(".")),
+        format!("text.align({}, 2, {})", rb_text("x"), rb_text("middle")),
