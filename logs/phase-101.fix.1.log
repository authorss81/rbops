import re
from pathlib import Path
doc=Path('SURVEY.md').read_text()
pat=re.compile(r'(?<![\w/.-])((?:[\w.-]+/)+[\w.-]+):(\d+)')
seen=[]
for m in pat.finditer(doc):
    path,line=m.group(1),int(m.group(2))
    if path.startswith('/') or path.endswith('/'): continue
    if (path,line) in seen: continue
    seen.append((path,line))
    p=Path(path)
    if p.is_file():
        lines=p.read_text().splitlines()
        content=lines[line-1] if 1<=line<=len(lines) else '<PAST END>'
        print(f'{path}:{line}: {content.strip()}')
    else:
        print(f'{path}:{line}: <NO FILE>')
