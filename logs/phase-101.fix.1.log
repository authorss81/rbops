                self.analyze_expr(object, span);
                self.analyze_expr(index, span);
            }
            Expr::InterpolatedText(parts) => {
                for part in parts {
                    self.analyze_expr(part, span);
                }
            }
            Expr::List(items) => {
                for item in items {
                    self.analyze_expr(item, span);
                }
