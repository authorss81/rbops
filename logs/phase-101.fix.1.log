+/// Whether `name` is a registry entry whose only spelling is as a member of a
+/// module.
+///
+/// The six phase-101 text utilities are stored under `text_<member>` because
+/// that is the name a dotted call resolves to, but they are not part of the flat
+/// builtin surface: `text.wrap` answers and a bare `text_wrap` does not. A
+/// program that wants a flat text helper keeps writing `wrap`, which remains an
+/// ordinary name it may declare. Both engines refuse the bare spelling before
+/// asking [`builtin`], so this cannot depend on which one ran the program.
+pub fn is_module_only_builtin(name: &str) -> bool {
+    matches!(
+        name,
+        "text_wrap" | "text_diff" | "text_dedent" | "text_template" | "text_pad" | "text_align"
+    )
