            "split",
            r#"say split("a,b", ",")"#.into(),
            "[a, b]\n".into(),
        ),
        (
            "join",
            r#"say join(["a", "b"], "-")"#.into(),
            "a-b\n".into(),
        ),
        (
            "contains",
            r#"say contains("hello", "ell")"#.into(),
            "yes\n".into(),
        ),
        (
            "starts_with",
            r#"say starts_with("hello", "he")"#.into(),
