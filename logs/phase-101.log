#[derive(Debug, Clone, PartialEq, Eq)]
struct DiffLine {
    text: String,
    has_newline: bool,
}

/// Splits `text` into the lines a unified diff counts.
fn diff_lines(text: &str) -> Vec<DiffLine> {
    text.split_inclusive('\n')
        .map(|chunk| match chunk.strip_suffix('\n') {
            Some(line) => DiffLine {
                text: line.to_string(),
                has_newline: true,
            },
            None => DiffLine {
                text: chunk.to_string(),
                has_newline: false,
            },
        })
        .collect()
}

