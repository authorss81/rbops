fn template_text(
    span: crate::error::Span,
    template: &str,
    values: &Fields,
) -> crate::error::Result<String> {
    let mut result = String::new();
    let mut rest = template;

    while let Some(open) = rest.find("<<") {
        result.push_str(&rest[..open]);
        let after_open = &rest[open..];

        if let Some(stripped) = after_open.strip_prefix("<<<<") {
            result.push_str("<<");
            rest = stripped;
            continue;
        }

        let after = &after_open[2..];
        let Some(close) = after.find(">>") else {
            return Err(text_utility_error(
                span,
                "template",
                "a placeholder has no closing '>>'",
            ));
        };
        let name = after[..close].trim();
        if name.is_empty() {
            return Err(text_utility_error(
                span,
                "template",
                "a placeholder has no name",
            ));
        }
        let Some(value) = values.get(name) else {
            return Err(text_utility_error(
                span,
                "template",
                &format!("unknown placeholder '{name}'"),
            ));
        };
        result.push_str(&value.to_string());
        rest = &after[close + 2..];
    }

    result.push_str(rest);
    Ok(result)
}

/// Right-pads `text` to `width` characters with repeated `fill`.
fn pad_text(
    span: crate::error::Span,
    text: &str,
    width: usize,
    fill: &str,
) -> crate::error::Result<String> {
    if fill.is_empty() {
        return Err(text_utility_error(
            span,
            "pad",
            "the fill must be at least one character",
        ));
    }
    let current = text.chars().count();
    if current >= width {
        return Ok(text.to_string());
    }
    let padding: String = fill.chars().cycle().take(width - current).collect();
    Ok(format!("{text}{padding}"))
}

/// Pads `text` to `width` characters on the named side.
fn align_text(
    span: crate::error::Span,
    text: &str,
    width: usize,
    side: &str,
) -> crate::error::Result<String> {
    let current = text.chars().count();
    if current >= width {
        return Ok(text.to_string());
