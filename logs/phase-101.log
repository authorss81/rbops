    // "é" is two bytes and one character; U+1F600 is four bytes and one
    // character, the surrogate-pair trap a byte count answers 4 for.
    both_engines_say("1", "say length(\"é\")\n");
    both_engines_say("1", "say text.length(\"\u{1F600}\")\n");
