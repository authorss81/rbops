#!/bin/bash
set -u
dir=target/tmp/difftest/cases2
rm -rf "$dir"; mkdir -p "$dir"
i=0
run() {
  i=$((i+1)); local name="$1" old="$2" new="$3"
  printf '%b' "$old" > "$dir/old"; printf '%b' "$new" > "$dir/new"
  cat > "$dir/mk.rb" <<RB
set old to files.read("$dir/old")
set new to files.read("$dir/new")
files.write("$dir/out.diff", text.diff(old, new))
RB
  target/debug/rb run "$dir/mk.rb" >"$dir/rb.log" 2>&1 || { echo "CASE $name RB FAIL"; cat "$dir/rb.log"; return; }
  cp "$dir/old" "$dir/applied"
  if ! patch -s "$dir/applied" < "$dir/out.diff" >"$dir/patch.log" 2>&1; then echo "CASE $name PATCH FAIL"; cat "$dir/out.diff"; cat "$dir/patch.log"; return; fi
  if ! cmp -s "$dir/applied" "$dir/new"; then echo "CASE $name MISMATCH"; cat "$dir/out.diff"; echo APPLIED; cat -A "$dir/applied"; echo NEW; cat -A "$dir/new"; return; fi
  echo "CASE $name OK"
}
