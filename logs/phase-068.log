            _ => {
                println!(
                    "{}",
                    self.style.paint(
                        Paint::Error,
                        &format!(
                            "Error: unknown .macro subcommand '{word}'.                              Usage: .macro start <name> | .macro stop | .macro list | .macro run <name>"
                        )
                    )
                );
            }
