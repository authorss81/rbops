            "start" => {
                if let Err(message) = self.start_macro(rest) {
                    println!("{}", self.style.paint(Paint::Error, &message));
                }
            }
            "stop" => {
                if let Err(message) = self.stop_macro() {
                    println!("{}", self.style.paint(Paint::Error, &message));
                }
            }
            "list" | "ls" => self.print_macros(),
            "run" | "play" => {
                if rest.is_empty() {
                    println!(
                        "{}",
                        self.style.paint(
                            Paint::Error,
                            "Error: .macro run needs a macro name.                              Usage: .macro run <name>"
                        )
