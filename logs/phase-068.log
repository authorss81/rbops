    fn run_macro(&mut self, name: &str) {
        let Some(lines) = self.macros.get(name).cloned() else {
            println!(
                "{}",
                self.style.paint(
                    Paint::Error,
                    &format!("Error: no macro named '{name}'. Usage: .macro list")
