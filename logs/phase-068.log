    pub fn session_loop<S: LineSource + ?Sized>(
        &mut self,
        source: &mut S,
        names: &SessionNames,
    ) -> SessionEnd {
        loop {
            if !self.running {
                return SessionEnd::Quit;
            }

            let prompt = self.prompt_for_next_line();

