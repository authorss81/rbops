mod tests {
    use std::cell::RefCell;
    use std::io;
    use std::path::PathBuf;
    use std::rc::Rc;
    use std::sync::atomic::{AtomicUsize, Ordering};

    use super::{farewell, Repl, SessionEnd};
    use crate::repl::editor::{Line, LineSource};
    use crate::value::Value;

    /// Where the `.rb` file under test is written, inside the project checkout
    /// rather than in a user's temp directory.
    fn scratch_file(name: &str, source: &str) -> PathBuf {
        static COUNTER: AtomicUsize = AtomicUsize::new(0);
        let serial = COUNTER.fetch_add(1, Ordering::SeqCst);
        let dir = PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("target/tmp/repl-load");
        std::fs::create_dir_all(&dir).expect("scratch directory should be creatable");
        let path = dir.join(format!("{}-{}.rb", name, serial));
        std::fs::write(&path, source).expect("the file should be writable");
        path
    }

    /// Where a non-`.rb` file under test — a history file — is written.
    fn scratch_path(name: &str, extension: &str) -> PathBuf {
        static COUNTER: AtomicUsize = AtomicUsize::new(0);
        let serial = COUNTER.fetch_add(1, Ordering::SeqCst);
        let dir = PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("target/tmp/repl-session");
        std::fs::create_dir_all(&dir).expect("scratch directory should be creatable");
        let path = dir.join(format!("{}-{}.{}", name, serial, extension));
        std::fs::write(&path, "").expect("the file should be creatable");
        path
    }

    /// A path under `target/tmp/` that nothing has written to.
    ///
    /// For the file a call *would* have written if it were allowed to write
    /// it: the assertion is that the file is not there afterwards, so the path
    /// has to be one that is not there to begin with. The serial keeps two
    /// tests running in parallel from sharing a path.
    fn unwritten_path(name: &str) -> PathBuf {
        static COUNTER: AtomicUsize = AtomicUsize::new(0);
        let serial = COUNTER.fetch_add(1, Ordering::SeqCst);
        let dir = PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("target/tmp/repl-debug-watch");
        std::fs::create_dir_all(&dir).expect("scratch directory should be creatable");
        let path = dir.join(format!("{}-{}.txt", name, serial));
        let _ = std::fs::remove_file(&path);
        path
    }

    /// A directory under `target/tmp/` for a test that needs one, named after
    /// the test so two running in parallel cannot collide.
    fn scratch_dir(name: &str) -> PathBuf {
        static COUNTER: AtomicUsize = AtomicUsize::new(0);
        let serial = COUNTER.fetch_add(1, Ordering::SeqCst);
        let base = PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("target/tmp/repl-debug-dirs");
        let dir = base.join(format!("{}-{}", name, serial));
        std::fs::create_dir_all(&dir).expect("scratch directory should be creatable");
        dir
    }

    /// Feeds `lines` to the session one at a time, as the read loop does: each line
    /// is recorded in the history before it is dispatched, because that is the
    /// order the loop keeps them in.
    fn feed(repl: &mut Repl, lines: &[&str]) {
        for line in lines {
            repl.history.push((*line).to_string());
            if repl.handle_command(line) {
                continue;
            }
            repl.execute_line(line);
        }
    }

    /// Feeds `count` copies of `line` to a session, as a piped input would.
    fn feed_repeatedly(repl: &mut Repl, line: &str, count: usize) {
        for _ in 0..count {
            repl.history.push(line.to_string());
            repl.execute_line(line);
        }
    }

    /// `.compare`, driven through the answer the command prints.
    ///
    /// The command is read-only by construction: the tree-walker runs on a
    /// fork and the bytecode VM on a fresh VM seeded from the session. Each
    /// test here pins one half of what makes that worth having — that the two
    /// values are both shown, that a real difference is called one, that a
    /// failing program does not become "agreement about nothing", and that no
    /// side effect reaches the session it was asked from.
    mod comparison {
        use super::{feed, Repl};

        #[test]
        fn compare_prints_both_values_and_agree() {
            let repl = Repl::new();

            let answer = repl
                .compare_answer("1 + 2")
                .expect("both engines can run arithmetic");
            let joined = answer.join("\n");

            assert!(
                answer.iter().any(|line| line.contains("tree-walker: 3")),
                "the tree-walker's value is printed: {joined}"
            );
            assert!(
                answer
                    .iter()
                    .any(|line| line.contains("bytecode:") && line.ends_with('3')),
                "the bytecode VM's value is printed beside it: {joined}"
            );
            assert!(
                answer.iter().any(|line| line.trim() == "AGREE"),
                "and the verdict word is its own line, so printing one side twice                  cannot pass this test: {joined}"
            );
        }

        #[test]
        fn edge_compare_reports_differ_when_one_engine_places_a_failure_elsewhere() {
            // The two engines genuinely disagree here: the failure inside a
            // function is placed at the call by the tree-walker, while a
            // bytecode instruction carries a line and no column.
            // `tests/common/vm.rs` calls that a format limit rather than a
            // divergence; `.compare` names it, because the whole point of
            // asking is to see it.
            let repl = Repl::new();

            let answer = repl
                .compare_answer("to f(n)\n    give back sqrt(\"x\")\nend\nsay f(1)")
                .expect("the program compiles and both engines run it");
            let joined = answer.join("\n");

            assert!(
                answer.iter().any(|line| line.trim() == "DIFFER"),
                "a difference is named as one: {joined}"
            );
            assert_eq!(
                joined
                    .matches("sqrt was called with arguments it cannot use")
                    .count(),
                2,
                "both failures are named, one per engine: {joined}"
            );
            assert!(
                joined.contains("2:10") && joined.contains("2:1"),
                "the difference is the position: the tree-walker names the call's \
                 column and a bytecode instruction cannot: {joined}"
            );
        }

        #[test]
        fn edge_compare_with_no_argument_is_a_usage_error() {
            use crate::repl::commands::ReplCommand;

            assert_eq!(
                ReplCommand::parse(".compare"),
                ReplCommand::MissingArgument {
                    command: "compare",
                    usage: "<expression>"
                },
                "a bare .compare says what it needs instead of running an empty program"
            );

            let repl = Repl::new();
            let refusal = repl
                .compare_answer("   ")
                .expect_err("nothing to compare is not an agreement");
            assert!(
                refusal.contains(".compare needs an expression"),
                "the refusal names the command and what is missing: {refusal}"
            );
        }

        #[test]
        fn edge_compare_leaves_the_session_vm_and_its_bindings_untouched() {
            let mut repl = Repl::new();
            feed(&mut repl, &["set counter to 7"]);
            let before = repl.session_bindings();

            let answer = repl
                .compare_answer("counter + 1")
                .expect("both engines can read the session's binding");
            assert!(
                answer.iter().any(|line| line.trim() == "AGREE"),
                "the seeded bytecode side reads the same value: {:?}",
                answer
            );

            assert_eq!(
                repl.session_bindings(),
                before,
                "the comparison did not bind, rebind or add a name in the session"
            );
            assert_eq!(
                repl.lookup("counter").map(ToString::to_string),
                Some("7".to_string()),
                "and the name it read still holds what it held"
            );
        }

        #[test]
        fn edge_compare_runs_a_side_effect_once_on_each_engine() {
            let repl = Repl::new();

            let answer = repl
                .compare_answer("say \"tick\"")
                .expect("both engines can say one line");
            let joined = answer.join("\n");

            assert!(
                answer.iter().any(|line| line == "  tree-walker said:"),
                "the tree-walker's output is attributed to it: {joined}"
            );
            assert!(
                answer.iter().any(|line| line == "  bytecode said:"),
                "and so is the bytecode VM's: {joined}"
            );
            assert_eq!(
                answer.iter().filter(|line| line.trim() == "tick").count(),
                2,
                "one output line per engine, so the effect was never doubled: {joined}"
            );
            assert_eq!(
                joined.matches("tick").count(),
                2,
                "and the program's text is not echoed back as if it had said it: {joined}"
            );
            assert!(
                repl.last_output.is_empty(),
                "the session's own last output is still empty: {:?}",
                repl.last_output
            );
        }

        #[test]
        fn edge_compare_reports_a_compile_failure_once() {
            let repl = Repl::new();

            let refusal = repl
                .compare_answer("1 +")
                .expect_err("a program that does not parse cannot be compared");
            assert!(
                refusal.contains("ParserError"),
                "the compile error is reported, not an absence on each side: {refusal}"
            );
            assert_eq!(
                refusal
                    .lines()
                    .filter(|line| line.starts_with("Error:"))
                    .count(),
                1,
                "and it is reported once: {refusal}"
            );
            assert!(
                !refusal.contains("AGREE") && !refusal.contains("DIFFER"),
                "nothing was compared, so there is no verdict: {refusal}"
            );
        }

        #[test]
        fn edge_compare_agrees_on_unicode_nesting_and_a_numeric_boundary() {
            let repl = Repl::new();

            for (program, needle) in [
                // Unicode, including a combining mark and an emoji, through a
                // nested list and record: the two engines render the same value.
                (r#"[["héllo 😀", { 鍵: ["e\u0301", 1] }]]"#, "😀"),
                // A numeric boundary neither engine can answer as a value: the
                // failure is compared too, and both place it on line 1.
                ("1 / 0", "Division by zero"),
            ] {
                let answer = repl
                    .compare_answer(program)
                    .unwrap_or_else(|error| panic!("{program:?} must be compared: {error}"));
                let joined = answer.join("\n");

                assert!(
                    answer.iter().any(|line| line.trim() == "AGREE"),
                    "{program:?} agreed on both engines: {joined}"
                );
                assert!(
                    joined.contains(needle),
                    "{program:?} names {needle:?} in its answer: {joined}"
                );
            }
        }

        #[test]
        fn edge_compare_runs_a_ten_kilobyte_program_on_both_engines() {
            let script = format!(
                "set payload to \"{}\"\ntext.length(payload)",
                "a".repeat(10 * 1024)
            );
            assert!(
                script.len() >= 10 * 1024,
                "the fixture is the size the edge asks for: {} bytes",
                script.len()
            );
            let repl = Repl::new();

            let answer = repl
                .compare_answer(&script)
                .expect("a ten-kilobyte program is still a program");
            let joined = answer.join("\n");

            assert!(
                answer.iter().any(|line| line.trim() == "AGREE"),
                "both engines finished and answered the same thing: {joined}"
            );
            assert!(
                answer
                    .iter()
                    .any(|line| line.contains("tree-walker: 10240")),
                "and the value is the one the program computes: {joined}"
            );
        }
    }

    /// A line source that answers with what the test tells it to, so the read
    /// loop can be driven through the parts a terminal owns — an interrupt, end
    /// of input, a failed read — without one.
    struct ScriptedSource {
        lines: std::collections::VecDeque<io::Result<Line>>,
        /// Every prompt the session asked at, in the order it asked.
        ///
        /// Recorded rather than discarded because the prompt is the whole subject
        /// of the continuation-numbering and `:prompt` tests: what a session
        /// prints at the user is only observable from the reader's side.
        prompts: Vec<String>,
    }

    impl ScriptedSource {
        fn new(lines: Vec<io::Result<Line>>) -> Self {
            Self {
                lines: lines.into_iter().collect(),
                prompts: Vec::new(),
            }
        }

        /// The prompts the session asked at, in order.
        fn prompts(&self) -> &[String] {
            &self.prompts
        }
    }

    impl LineSource for ScriptedSource {
        fn read_line(&mut self, prompt: &str) -> io::Result<Line> {
            self.prompts.push(prompt.to_string());
            self.lines.pop_front().unwrap_or(Ok(Line::Eof))
        }
    }

    /// Runs the read loop over `source`, the way [`Repl::run`] runs it over a
    /// terminal.
    fn drive(repl: &mut Repl, source: &mut ScriptedSource) -> SessionEnd {
        let names = Rc::new(RefCell::new(repl.session_names()));
        repl.session_loop(source, &names)
    }

    /// An editor with no names and no history file of its own, over `path`.
    fn editor_at(path: Option<PathBuf>) -> crate::repl::editor::EditSource {
        crate::repl::editor::EditSource::new(Rc::new(RefCell::new(Vec::new())), path)
            .expect("an editor that never reads a line should be creatable")
    }

    #[test]
    fn a_session_restores_what_a_previous_one_typed_and_not_the_history_files_header() {
        let path = scratch_path("restored", "history");
        std::fs::remove_file(&path).expect("the empty scratch file should be removable");

        let mut previous = editor_at(Some(path.clone()));
        previous.record("set restored_probe to 1");
        previous
            .save(&path)
            .expect("the history file should be writable");

        let restored = editor_at(Some(path));
        let mut repl = Repl::new();
        repl.restore_history(&restored);

        assert_eq!(
            repl.history.search("set restored_probe to 1"),
            Some("set restored_probe to 1".to_string()),
            "the line the previous session typed is in this session's history"
        );
        assert_eq!(
            repl.history.search("#"),
            None,
            "and the history file's own version header is not a line anyone typed"
        );
    }

