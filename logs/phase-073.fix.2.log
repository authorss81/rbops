+        pad_left("answer", 20),
+        pad_left("wall time", 14)
     ));
     for row in rows {
+        let answer = truncate(&row.answer.to_string(), 20);
+        let elapsed = format!("{:.3} ms", row.elapsed.as_secs_f64() * 1000.0);
