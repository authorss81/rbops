/// An `edge_*` case: the rule covers this phase's delivery commit and nothing else.
///
/// A rule that acknowledged any unreviewed commit would be a rule that
/// acknowledged nothing. Another phase's delivery commit is still unreviewed
/// work until something acknowledges it, and the audit must say so.
#[test]
fn edge_a_delivery_subject_of_another_phase_is_not_acknowledged_by_the_rule() {
    let nothing_pinned: &[(&str, &str)] = &[];

    let other_phase = format!("{SHA_C}\tresume phase-083: adopt preserved work\n");
    let result = scan(&other_phase, nothing_pinned).expect("a well-formed fixture log");
    assert!(
        result.delivery.is_empty(),
        "the rule covers this phase's delivery commit and no other"
    );
    assert_eq!(
        result.unreviewed,
        vec![format!("{SHA_C}\tresume phase-083: adopt preserved work")],
        "another phase's delivery commit is unreviewed work until something acknowledges it"
    );

    // And the rule anchors at the START of the subject: a commit that merely
    // mentions this phase's delivery subject is not the delivery commit.
    let mentioned = format!("{SHA_C}\tci: not really a resume phase-088: adopt preserved work\n");
    let result = scan(&mentioned, nothing_pinned).expect("a well-formed fixture log");
    assert!(
        result.delivery.is_empty(),
        "the rule matches a subject that BEGINS with the delivery prefix, not one that mentions it"
    );
    assert_eq!(
        result.unreviewed.len(),
        1,
        "a commit that merely mentions the delivery subject is still unreviewed work"
    );
}

/// An `edge_*` case: the delivery commit of the phase under review is
/// acknowledged by its subject, never by a SHA the phase writes.
///
/// The pipeline re-creates the phase's delivery commit on every round. A SHA
/// recorded in the working tree therefore names the *previous* round's commit
/// as soon as the next round lands: the audit reports that entry as stale and
/// the new `HEAD` as unacknowledged, both correctly. The subject is the part
/// that survives the rebuild, so the phase under review is on the subject rule
/// like every other in-flight phase. What must not happen is a SHA-pinned
/// delivery entry, which is the stale handle this test refuses.
#[test]
fn edge_the_phase_under_review_delivery_is_acknowledged_by_subject_not_a_stale_sha() {
    let head = git(&["log", "-1", "--format=%H%x09%s", "HEAD"])
        .expect("HEAD's delivery commit must be readable");
    let (sha, subject) =
        parse_log_line(head.trim(), 1).expect("HEAD must be a well-formed log line");
    let Some(phase) = delivery_phase(subject) else {
        return;
    };

    let prefix = format!("resume {phase}:");
    assert!(
        DELIVERY_SUBJECT_PREFIXES.contains(&prefix.as_str()),
        "the delivery commit {sha} at HEAD ({subject:?}) is re-created by the pipeline on every \
         round, so it must be acknowledged by the subject rule {prefix:?} rather than by a SHA \
         written before delivery."
    );
    assert!(
        !ACKNOWLEDGED.iter().any(|(entry, _)| *entry == sha),
        "the delivery commit {sha} at HEAD ({subject:?}) is rebuildable, so pinning its SHA in \
         ACKNOWLEDGED goes stale on the next round. Acknowledge it by its subject prefix instead."
    );
}

/// An `edge_*` case: the rule covers every phase whose delivery commit this
/// history carries, and no other.
///
/// Two phases are in flight at once — phase-084 and phase-063 — and the
/// pipeline re-creates each of their delivery commits on every round, so
/// neither SHA can be written down: the entry that named phase-063's first
/// delivery commit went stale the moment the pipeline re-created it. The
/// subject is what survives the rebuild, so the rule carries one prefix per
/// phase in flight — and it is a list, not a wildcard: a phase that is not in
/// flight is still unreviewed work with nothing acknowledging it.
#[test]
fn edge_the_delivery_rule_covers_each_phase_in_flight_and_no_other() {
    for prefix in DELIVERY_SUBJECT_PREFIXES {
        for subject in [
            format!("{prefix} adopt preserved work"),
            format!("{prefix} adopt WIP checkpoint"),
        ] {
            let log = format!("{SHA_A}\t{subject}\n");
            let result = scan(&log, &[]).expect("a well-formed fixture log");

            assert_eq!(
                result.delivery,
                vec![SHA_A.to_string()],
                "{subject:?} is the delivery commit of a phase in flight, so the rule covers it"
            );
            assert!(
                result.unreviewed.is_empty(),
                "and it is acknowledged by the rule rather than reported as unreviewed: {:?}",
                result.unreviewed
            );
        }
    }

    let other_phase = format!("{SHA_A}\tresume phase-083: adopt preserved work\n");
    let result = scan(&other_phase, &[]).expect("a well-formed fixture log");
    assert!(
        result.delivery.is_empty(),
        "the rule covers the phases in flight and no other"
    );
    assert_eq!(
        result.unreviewed.len(),
        1,
        "a phase that is not in flight is still unreviewed work"
    );
}

/// The delivery commits the rule covers are acknowledged by the rule, and by
/// no entry.
///
/// A prefix acknowledges a rebuildable delivery commit whose SHA is not
/// knowable; no delivery commit is pinned by SHA, because any such entry goes
/// stale when the pipeline rebuilds it. The two must not overlap. This asserts
/// that every commit the rule matches is absent from [`ACKNOWLEDGED`], so a
/// prefix cannot be used behind an entry's back (or the reverse) to keep two
/// acknowledgements for one commit.
#[test]
fn edge_the_delivery_commit_is_acknowledged_by_the_rule_and_by_no_entry() {
    let (scan, log) = audit_head().expect("HEAD's history must be readable");
    let delivery = delivery_commits(&log);

    assert!(
        !delivery.is_empty(),
        "this history must carry a delivery commit whose subject begins with one of \
         {DELIVERY_SUBJECT_PREFIXES:?}. If the pipeline stopped writing those subjects, the rule \
         has to be re-pointed at the shape it writes now — silently, this history's delivery \
         commit would be reported as unreviewed work."
    );
    for sha in &delivery {
        assert!(
            !ACKNOWLEDGED.iter().any(|(entry, _)| entry == sha),
            "{sha} is pinned in ACKNOWLEDGED: a SHA-pinned delivery entry goes stale on the \
             next round, which is the failure this rule exists to remove"
        );
    }
    assert!(
        scan.unreviewed.is_empty(),
        "the delivery commit must be acknowledged by the rule: {}",
        scan.unreviewed.join(" | ")
    );
    assert!(
        scan.stale.is_empty(),
        "and no entry may point at a commit this history does not contain: {}",
        scan.stale.join(", ")
    );
}
