/// `time.add_days` and friends: a fixed span, with no daylight-saving rule.
fn add_fixed(
    span: Span,
    date: NaiveDateTime,
    amount: i64,
    delta: Option<TimeDelta>,
    builtin: &str,
) -> Result<Value> {
    let delta = delta.ok_or_else(|| {
        Error::Runtime(format!("{builtin} cannot move the date that far"), span)
    })?;
    date.checked_add_signed(delta).map(Value::Date).ok_or_else(|| {
        Error::Runtime(format!("{builtin} cannot move the date that far"), span)
    })
}

