# RBOPS state — committed markers are the state store.
!phases/*/
phases/*/*
!phases/*/PROMPT.md
!phases/*/REPORT.md
!phases/*/FINDINGS.md
!phases/*/.done
!phases/*/.failed
!phases/*/.deferred
!phases/*/.blocked
!phases/*/.checkpoint
!phases/*/.attempts
!phases/*/.deferred_attempts
!phases/.stop

# Compiled context + prompts are large; the audit record is kept, the ctx is not.
logs/*.ctx
logs/*.prompt

# Secrets — never commit
.env
.env.*
*.key
*.pem
*.keystore
secrets/

# Rust / redblue artifacts
target/
**/*.rs.bk
*.rbc
redblue/

# Editors / OS
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/