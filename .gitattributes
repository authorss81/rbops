# Normalise to LF in the repository. Shell scripts and workflows MUST be LF or
# they break on ubuntu-latest runners.
* text=auto eol=lf

*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md  text eol=lf
*.rb  text eol=lf

# Binary
*.png binary
*.jpg binary
*.pdf binary
*.rbc binary